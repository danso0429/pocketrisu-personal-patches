+package httpapi
+
+import (
+	"encoding/json"
+	"fmt"
+	"strings"
+)
+
+type pocketRisuResolvedExecutionContext struct {
+	ContractVersion          string
+	BackendInstanceID        string
+	SettingsDigest           string
+	Prepare                  pocketRisuDevicePrepareSettings
+	NarrativeSupportMaxChars int
+	PublisherGuidanceFormat  string
+	ChapterIntervalEpisodes  int
+	ArcIntervalChapters      int
+	SagaIntervalArcs         int
+	Main                     completeTurnLLMConfig
+	Supervisor               completeTurnLLMConfig
+	Critic                   completeTurnLLMConfig
+	Embedding                completeTurnEmbeddingConfig
+	SourceSearch             completeTurnLLMConfig
+	Preprocessing            multiAgentSettings
+}
+
+func resolvePocketRisuExecutionContext(
+	material pocketRisuExecutionContextMaterial,
+) (*pocketRisuResolvedExecutionContext, error) {
+	device, err := normalizePocketRisuExecutionDeviceSnapshot(material.Device)
+	if err != nil {
+		return nil, err
+	}
+	backend, err := normalizePocketRisuExecutionBackendSnapshot(material.Backend)
+	if err != nil {
+		return nil, err
+	}
+	digest, err := pocketRisuExecutionContextPublicDigest(device, backend)
+	if err != nil {
+		return nil, err
+	}
+	preprocessing, err := clonePocketRisuPreprocessingSettings(backend.Preprocessing)
+	if err != nil {
+		return nil, err
+	}
+	prepare := device.Prepare
+	prepare.MemoryDeliveryBudgets = clonePocketRisuMemoryDeliveryBudgets(
+		device.Prepare.MemoryDeliveryBudgets,
+	)
+	return &pocketRisuResolvedExecutionContext{
+		ContractVersion:          pocketRisuExecutionContextContractVersion,
+		BackendInstanceID:        backend.BackendInstanceID,
+		SettingsDigest:           digest,
+		Prepare:                  prepare,
+		NarrativeSupportMaxChars: device.NarrativeSupportMaxChars,
+		PublisherGuidanceFormat:  device.PublisherGuidanceFormat,
+		ChapterIntervalEpisodes:  device.ChapterIntervalEpisodes,
+		ArcIntervalChapters:      device.ArcIntervalChapters,
+		SagaIntervalArcs:         device.SagaIntervalArcs,
+		Main:                     resolvePocketRisuMainConfig(device.Main, backend.Runtime),
+		Supervisor:               resolvePocketRisuSupervisorConfig(device.Main, backend.Runtime),
+		Critic:                   resolvePocketRisuCriticConfig(device.Critic, backend.Runtime),
+		Embedding:                resolvePocketRisuEmbeddingConfig(device.Embedding, backend),
+		SourceSearch:             resolvePocketRisuSourceSearchConfig(device.SourceSearch, backend.Runtime),
+		Preprocessing:            preprocessing,
+	}, nil
+}
+
+func resolvePocketRisuMainConfig(
+	device pocketRisuExecutionLLMConfig,
+	runtime RuntimeConfig,
+) completeTurnLLMConfig {
+	if pocketRisuExecutionLLMHasAuthority(device) {
+		return pocketRisuExecutionLLMConfigValue(
+			device,
+			"execution_context.device.main",
+			runtime.LLMRetryCount,
+		)
+	}
+	temperature := 0.3
+	if runtime.MainTemperature != nil {
+		temperature = *runtime.MainTemperature
+	}
+	maxTokens := int64(1400)
+	if runtime.MainMaxTokens != nil && *runtime.MainMaxTokens > 0 {
+		maxTokens = *runtime.MainMaxTokens
+	}
+	return labelPocketRisuResolvedLLMConfig(completeTurnLLMConfig{
+		APIKey:                normalizeConfigSecret(runtime.MainAPIKey),
+		Endpoint:              proxyProviderBaseURL(runtime.MainProvider, runtime.MainEndpoint),
+		Model:                 strings.TrimSpace(runtime.MainModel),
+		Provider:              strings.TrimSpace(runtime.MainProvider),
+		TimeoutMs:             runtimeTimeoutMs(runtime.MainTimeoutSec),
+		Temperature:           temperature,
+		MaxTokens:             maxTokens,
+		ReasoningPreset:       strings.TrimSpace(runtime.MainReasoningPreset),
+		ReasoningEffort:       strings.TrimSpace(runtime.MainReasoningEffort),
+		ReasoningBudgetTokens: int64PtrValue(runtime.MainReasoningBudget, 0),
+		ExtraHeadersJSON:      strings.TrimSpace(runtime.MainExtraHeadersJSON),
+		ExtraBodyJSON:         strings.TrimSpace(runtime.MainExtraBodyJSON),
+		VertexFlexMode:        strings.TrimSpace(runtime.MainVertexFlexMode),
+		LLMGatewayServiceTier: strings.TrimSpace(runtime.MainLLMGatewayServiceTier),
+		ClaudePromptCacheMode: strings.TrimSpace(runtime.MainClaudePromptCacheMode),
+		RetryBudget:           newLLMRetryBudget(runtime.LLMRetryCount),
+	}, "execution_context.backend.main")
+}
+
+func resolvePocketRisuSupervisorConfig(
+	deviceMain pocketRisuExecutionLLMConfig,
+	runtime RuntimeConfig,
+) completeTurnLLMConfig {
+	if pocketRisuExecutionLLMHasAuthority(deviceMain) {
+		return pocketRisuExecutionLLMConfigValue(
+			deviceMain,
+			"execution_context.device.main_as_supervisor",
+			runtime.LLMRetryCount,
+		)
+	}
+	temperature := 0.3
+	if runtime.SupervisorTemperature != nil {
+		temperature = *runtime.SupervisorTemperature
+	}
+	maxTokens := int64(30000)
+	if runtime.SupervisorMaxTokens != nil && *runtime.SupervisorMaxTokens > 0 {
+		maxTokens = *runtime.SupervisorMaxTokens
+	}
+	return labelPocketRisuResolvedLLMConfig(completeTurnLLMConfig{
+		APIKey:                normalizeConfigSecret(runtime.SupervisorAPIKey),
+		Endpoint:              proxyProviderBaseURL(runtime.SupervisorProvider, runtime.SupervisorEndpoint),
+		Model:                 strings.TrimSpace(runtime.SupervisorModel),
+		Provider:              strings.TrimSpace(runtime.SupervisorProvider),
+		TimeoutMs:             runtimeTimeoutMs(runtime.SupervisorTimeoutSec),
+		Temperature:           temperature,
+		MaxTokens:             maxTokens,
+		ReasoningPreset:       strings.TrimSpace(runtime.SupervisorReasoningPreset),
+		ReasoningEffort:       strings.TrimSpace(runtime.SupervisorReasoningEffort),
+		ReasoningBudgetTokens: int64PtrValue(runtime.SupervisorReasoningBudget, 0),
+		ExtraHeadersJSON:      strings.TrimSpace(runtime.SupervisorExtraHeadersJSON),
+		ExtraBodyJSON:         strings.TrimSpace(runtime.SupervisorExtraBodyJSON),
+		VertexFlexMode:        strings.TrimSpace(runtime.SupervisorVertexFlexMode),
+		LLMGatewayServiceTier: strings.TrimSpace(runtime.SupervisorLLMGatewayServiceTier),
+		ClaudePromptCacheMode: strings.TrimSpace(runtime.SupervisorClaudePromptCacheMode),
+		RetryBudget:           newLLMRetryBudget(runtime.LLMRetryCount),
+	}, "execution_context.backend.supervisor")
+}
+
+func resolvePocketRisuCriticConfig(
+	device pocketRisuExecutionLLMConfig,
+	runtime RuntimeConfig,
+) completeTurnLLMConfig {
+	if pocketRisuExecutionLLMHasAuthority(device) {
+		return pocketRisuExecutionLLMConfigValue(
+			device,
+			"execution_context.device.critic",
+			runtime.LLMRetryCount,
+		)
+	}
+	temperature := 0.2
+	if runtime.CriticTemperature != nil {
+		temperature = *runtime.CriticTemperature
+	}
+	maxTokens := int64(30000)
+	if runtime.CriticMaxTokens != nil && *runtime.CriticMaxTokens > 0 {
+		maxTokens = *runtime.CriticMaxTokens
+	}
+	return labelPocketRisuResolvedLLMConfig(completeTurnLLMConfig{
+		APIKey:                normalizeConfigSecret(runtime.CriticAPIKey),
+		Endpoint:              proxyProviderBaseURL(runtime.CriticProvider, runtime.CriticEndpoint),
+		Model:                 strings.TrimSpace(runtime.CriticModel),
+		Provider:              strings.TrimSpace(runtime.CriticProvider),
+		TimeoutMs:             runtimeTimeoutMs(runtime.CriticTimeoutSec),
+		Temperature:           temperature,
+		MaxTokens:             maxTokens,
+		MaxCompletionTokens:   maxTokens,
+		ReasoningPreset:       strings.TrimSpace(runtime.CriticReasoningPreset),
+		ReasoningEffort:       strings.TrimSpace(runtime.CriticReasoningEffort),
+		ReasoningBudgetTokens: int64PtrValue(runtime.CriticReasoningBudget, 0),
+		ExtraHeadersJSON:      strings.TrimSpace(runtime.CriticExtraHeadersJSON),
+		ExtraBodyJSON:         strings.TrimSpace(runtime.CriticExtraBodyJSON),
+		VertexFlexMode:        strings.TrimSpace(runtime.CriticVertexFlexMode),
+		LLMGatewayServiceTier: strings.TrimSpace(runtime.CriticLLMGatewayServiceTier),
+		ClaudePromptCacheMode: strings.TrimSpace(runtime.CriticClaudePromptCacheMode),
+		RetryBudget:           newLLMRetryBudget(runtime.LLMRetryCount),
+	}, "execution_context.backend.critic")
+}
+
+func resolvePocketRisuEmbeddingConfig(
+	device pocketRisuExecutionEmbeddingConfig,
+	backend pocketRisuExecutionBackendSnapshot,
+) completeTurnEmbeddingConfig {
+	if pocketRisuExecutionEmbeddingHasAuthority(device) {
+		return labelPocketRisuResolvedEmbeddingConfig(completeTurnEmbeddingConfig{
+			Provider:  strings.TrimSpace(device.Provider),
+			APIKey:    normalizeConfigSecret(device.APIKey),
+			Endpoint:  strings.TrimSpace(device.Endpoint),
+			Model:     strings.TrimSpace(device.Model),
+			TimeoutMs: device.TimeoutMS,
+		}, "execution_context.device.embedding")
+	}
+	runtime := backend.Runtime
+	timeoutMS := runtimeTimeoutMs(runtime.EmbeddingTimeoutSec)
+	runtimeConfig := completeTurnEmbeddingConfig{
+		Provider:  strings.TrimSpace(runtime.EmbeddingProvider),
+		APIKey:    normalizeConfigSecret(runtime.EmbeddingAPIKey),
+		Endpoint:  strings.TrimSpace(runtime.EmbeddingEndpoint),
+		Model:     strings.TrimSpace(runtime.EmbeddingModel),
+		TimeoutMs: timeoutMS,
+	}
+	if runtimeConfig.hasAnyAuthorityConfigField() {
+		return labelPocketRisuResolvedEmbeddingConfig(
+			runtimeConfig,
+			"execution_context.backend.runtime_embedding",
+		)
+	}
+	fallback := backend.EmbeddingFallback
+	fallbackTimeout := fallback.TimeoutMS
+	if fallbackTimeout <= 0 {
+		fallbackTimeout = timeoutMS
+	}
+	return labelPocketRisuResolvedEmbeddingConfig(completeTurnEmbeddingConfig{
+		Provider:  strings.TrimSpace(fallback.Provider),
+		APIKey:    normalizeConfigSecret(fallback.APIKey),
+		Endpoint:  strings.TrimSpace(fallback.Endpoint),
+		Model:     strings.TrimSpace(fallback.Model),
+		TimeoutMs: fallbackTimeout,
+	}, "execution_context.backend.fallback_embedding")
+}
+
+func resolvePocketRisuSourceSearchConfig(
+	device pocketRisuExecutionLLMConfig,
+	runtime RuntimeConfig,
+) completeTurnLLMConfig {
+	if pocketRisuExecutionLLMHasAuthority(device) {
+		return pocketRisuExecutionLLMConfigValue(
+			device,
+			"execution_context.device.source_search",
+			runtime.LLMRetryCount,
+		)
+	}
+	temperature := 0.1
+	if runtime.SourceSearchPlannerTemperature != nil {
+		temperature = *runtime.SourceSearchPlannerTemperature
+	}
+	maxTokens := int64(512)
+	if runtime.SourceSearchPlannerMaxTokens != nil && *runtime.SourceSearchPlannerMaxTokens > 0 {
+		maxTokens = *runtime.SourceSearchPlannerMaxTokens
+	}
+	reasoningPreset := strings.TrimSpace(runtime.SourceSearchPlannerReasoningPreset)
+	if reasoningPreset == "" {
+		reasoningPreset = "auto"
+	}
+	reasoningEffort := strings.TrimSpace(runtime.SourceSearchPlannerReasoningEffort)
+	if reasoningEffort == "" {
+		reasoningEffort = "none"
+	}
+	return labelPocketRisuResolvedLLMConfig(completeTurnLLMConfig{
+		APIKey: normalizeConfigSecret(runtime.SourceSearchPlannerAPIKey),
+		Endpoint: proxyProviderBaseURL(
+			runtime.SourceSearchPlannerProvider,
+			runtime.SourceSearchPlannerEndpoint,
+		),
+		Model:                 strings.TrimSpace(runtime.SourceSearchPlannerModel),
+		Provider:              strings.TrimSpace(runtime.SourceSearchPlannerProvider),
+		TimeoutMs:             runtimeTimeoutMs(runtime.SourceSearchPlannerTimeoutSec),
+		Temperature:           temperature,
+		MaxTokens:             maxTokens,
+		ReasoningPreset:       reasoningPreset,
+		ReasoningEffort:       reasoningEffort,
+		ReasoningBudgetTokens: int64PtrValue(runtime.SourceSearchPlannerReasoningBudget, 0),
+		RetryBudget:           newLLMRetryBudget(runtime.LLMRetryCount),
+	}, "execution_context.backend.source_search")
+}
+
+func pocketRisuExecutionLLMConfigValue(
+	config pocketRisuExecutionLLMConfig,
+	source string,
+	retryCount int,
+) completeTurnLLMConfig {
+	result := completeTurnLLMConfig{
+		APIKey:                normalizeConfigSecret(config.APIKey),
+		Endpoint:              proxyProviderBaseURL(config.Provider, config.Endpoint),
+		Model:                 strings.TrimSpace(config.Model),
+		Provider:              strings.TrimSpace(config.Provider),
+		TimeoutMs:             config.TimeoutMS,
+		Temperature:           config.Temperature,
+		MaxTokens:             config.MaxCompletionTokens,
+		MaxCompletionTokens:   config.MaxCompletionTokens,
+		ReasoningPreset:       strings.TrimSpace(config.ReasoningPreset),
+		ReasoningEffort:       strings.TrimSpace(config.ReasoningEffort),
+		ReasoningBudgetTokens: config.ReasoningBudgetTokens,
+		ExtraHeadersJSON:      strings.TrimSpace(config.ExtraHeadersJSON),
+		ExtraBodyJSON:         strings.TrimSpace(config.ExtraBodyJSON),
+		VertexFlexMode:        strings.TrimSpace(config.VertexFlexMode),
+		LLMGatewayServiceTier: strings.TrimSpace(config.LLMGatewayServiceTier),
+		ClaudePromptCacheMode: strings.TrimSpace(config.ClaudePromptCacheMode),
+		RetryBudget:           newLLMRetryBudget(retryCount),
+	}
+	result.GlmThinkingType = glmThinkingTypeFromReasoning(
+		result.ReasoningPreset,
+		result.ReasoningEffort,
+	)
+	return labelPocketRisuResolvedLLMConfig(result, source)
+}
+
+func pocketRisuExecutionLLMHasAuthority(config pocketRisuExecutionLLMConfig) bool {
+	return strings.TrimSpace(normalizeConfigSecret(config.APIKey)) != "" ||
+		strings.TrimSpace(config.Endpoint) != "" ||
+		strings.TrimSpace(config.Model) != ""
+}
+
+func pocketRisuExecutionEmbeddingHasAuthority(config pocketRisuExecutionEmbeddingConfig) bool {
+	return strings.TrimSpace(normalizeConfigSecret(config.APIKey)) != "" ||
+		strings.TrimSpace(config.Endpoint) != "" ||
+		strings.TrimSpace(config.Model) != ""
+}
+
+func labelPocketRisuResolvedLLMConfig(config completeTurnLLMConfig, source string) completeTurnLLMConfig {
+	config.Source = source
+	if !config.hasAnyAuthorityConfigField() {
+		config.Source = "missing"
+	} else if !config.hasConfig() {
+		config.Source = source + "_partial"
+	}
+	return config
+}
+
+func labelPocketRisuResolvedEmbeddingConfig(config completeTurnEmbeddingConfig, source string) completeTurnEmbeddingConfig {
+	config.Source = source
+	if !config.hasAnyAuthorityConfigField() {
+		config.Source = "missing"
+	} else if !config.hasConfig() {
+		config.Source = source + "_partial"
+	}
+	return config
+}
+
+func clonePocketRisuMemoryDeliveryBudgets(source map[string]int) map[string]int {
+	result := make(map[string]int, len(source))
+	for key, value := range source {
+		result[key] = value
+	}
+	return result
+}
+
+func clonePocketRisuPreprocessingSettings(source multiAgentSettings) (multiAgentSettings, error) {
+	encoded, err := json.Marshal(source)
+	if err != nil {
+		return multiAgentSettings{}, fmt.Errorf("clone PocketRisu preprocessing settings: %w", err)
+	}
+	var result multiAgentSettings
+	if err := json.Unmarshal(encoded, &result); err != nil {
+		return multiAgentSettings{}, fmt.Errorf("clone PocketRisu preprocessing settings: %w", err)
+	}
+	return result, nil
+}
