+func TestHostPrepareMigrationDefinesDurableFencedRegistry(t *testing.T) {
+	raw, err := os.ReadFile("../../../migrations/016_host_prepare_registry.sql")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlText := string(raw)
+	if count := strings.Count(sqlText, "CREATE TABLE IF NOT EXISTS host_prepare_requests"); count != 1 {
