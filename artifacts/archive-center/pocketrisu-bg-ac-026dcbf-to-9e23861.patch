+func TestHostPrepareMariaDBReadyUnknownFailureAndSkipRaceSurviveRestart(t *testing.T) {
+	if os.Getenv("AC_HOST_PREPARE_TEST_DISPOSABLE") != "YES" {
+		t.Skip("requires an explicitly disposable MariaDB")
+	}
+	dsn := strings.TrimSpace(os.Getenv("AC_HOST_PREPARE_TEST_DSN"))
+	if dsn == "" {
+		t.Fatal("AC_HOST_PREPARE_TEST_DSN is required")
+	}
+	openStore := func() *mariadbStore {
+		raw, err := OpenMariaDB(dsn)
+		if err != nil {
+			t.Fatalf("open disposable MariaDB: %v", err)
+		}
+		store, ok := raw.(*mariadbStore)
+		if !ok {
+			t.Fatalf("store type=%T, want *mariadbStore", raw)
+		}
+		return store
+	}
+
+	ctx := context.Background()
+	suffix := strconv.FormatInt(time.Now().UTC().UnixNano(), 36)
+	hostID := "c0-prepare-host-" + suffix
+	characterID := "c0-prepare-character-" + suffix
+	chatID := "c0-prepare-chat-" + suffix
+	sessionID := "c0-prepare-session-" + suffix
+
+	admin := openStore()
+	cleanup := func() {
+		statements := []struct {
+			query string
+			args  []any
+		}{
+			{`DELETE FROM host_prepare_requests WHERE host_instance_id = ?`, []any{hostID}},
+			{`DELETE FROM host_session_execution_outcomes WHERE canonical_session_id = ?`, []any{sessionID}},
+			{`DELETE FROM host_session_execution_slots WHERE canonical_session_id = ?`, []any{sessionID}},
+			{`DELETE FROM session_route_bindings WHERE stable_character_id = ? AND host_chat_id = ?`, []any{characterID, chatID}},
+		}
+		for _, statement := range statements {
+			if _, err := admin.db.ExecContext(ctx, statement.query, statement.args...); err != nil {
+				t.Errorf("clean host prepare fixture: %v", err)
+			}
+		}
+	}
+	cleanup()
+	t.Cleanup(func() {
+		cleanup()
+		if err := admin.Close(); err != nil {
+			t.Errorf("close host prepare cleanup store: %v", err)
+		}
+	})
+
+	runtimeStore := openStore()
+	defer func() {
+		if err := runtimeStore.Close(); err != nil {
+			t.Errorf("close host prepare runtime store: %v", err)
+		}
+	}()
+	reopen := func() {
+		if err := runtimeStore.Close(); err != nil {
+			t.Fatalf("close host prepare store before restart: %v", err)
+		}
+		runtimeStore = openStore()
+	}
+	bindingResult, err := runtimeStore.BindSessionRoute(ctx, SessionRouteBindingRequest{
+		StableCharacterID: characterID, HostChatID: chatID,
+		RequestedSessionID: sessionID, Mode: SessionRouteBindingModeResolveOrCreate,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	bindingEpoch := SessionRouteBindingEpoch(bindingResult.Binding)
+
+	acquireAndRegister := func(label string) (HostPrepareLookup, uint64, HostPrepareRegisterRequest) {
+		operationID := "c0-prepare-operation-" + label + "-" + suffix
+		claim, err := runtimeStore.AcquireHostSessionExecution(ctx, HostSessionExecutionAcquireRequest{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+			OperationID: operationID, ExpectedBindingEpoch: bindingEpoch,
+		})
+		if err != nil || claim.Status != HostSessionExecutionStatusAcquired {
+			t.Fatalf("%s execution claim=%+v err=%v", label, claim, err)
+		}
+		request := HostPrepareRegisterRequest{
+			HostPrepareIdentity: HostPrepareIdentity{
+				HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+				BindingEpoch: bindingEpoch, OperationID: operationID,
+				ClaimEpoch: claim.ClaimEpoch, MainRequestID: "main-request-" + label + "-" + suffix,
+			},
+			ExecutionContextID:     "context-" + label + "-" + suffix,
+			SettingsSnapshotDigest: strings.Repeat("a", 63) + label[:1],
+			InputReceiptID:         "input-receipt-" + label + "-" + suffix,
+			SourceRevision:         "source-" + label + "-" + suffix,
+			SemanticPayloadHash:    strings.Repeat("b", 63) + label[:1],
+			RequestType:            "model",
+			ProtocolVersion:        HostPrepareProtocolVersion,
+		}
+		var registered *HostPrepareResult
