+		t.Fatalf("embedding fallback resolve failed: %v", err)
+	}
+	if resolved.Embedding.APIKey != "BACKEND-fallback-embedding" ||
+		resolved.Embedding.Endpoint != "https://fallback-embedding.invalid/?key=BACKEND" ||
+		resolved.Embedding.Model != "fallback-embedding-model" ||
+		resolved.Embedding.Source != "execution_context.backend.fallback_embedding" {
+		t.Fatalf("fallback embedding = %+v", resolved.Embedding)
+	}
+}
+
+func TestPocketRisuExecutionContextResolverReturnsIndependentSettings(t *testing.T) {
+	material := pocketRisuExecutionContextMaterialForTest("DEVICE", "BACKEND")
+	resolved, err := resolvePocketRisuExecutionContext(material)
+	if err != nil {
+		t.Fatalf("resolve failed: %v", err)
+	}
+	material.Device.Prepare.MemoryDeliveryBudgets["event_recent"] = 1
+	role := material.Backend.Preprocessing.Roles["event_recent"]
+	role.Prompt = "later prompt"
+	material.Backend.Preprocessing.Roles["event_recent"] = role
+	if resolved.Prepare.MemoryDeliveryBudgets["event_recent"] != 3500 ||
+		resolved.Preprocessing.Roles["event_recent"].Prompt != "private role prompt BACKEND" {
