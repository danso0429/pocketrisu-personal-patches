+	role.Prompt = "mutated prompt"
+	backend.Preprocessing.Roles["event_recent"] = role
+
+	material, loaded, err := registry.load(first.ExecutionContextID, firstIdentity("operation-1"))
+	if err != nil {
+		t.Fatalf("load failed: %v", err)
+	}
+	if loaded.Status != pocketRisuExecutionContextStatusCaptured || !loaded.Reused {
+		t.Fatalf("unexpected load result: %+v", loaded)
+	}
+	if material.Device.Prepare.MemoryDeliveryBudgets["event_recent"] != 3500 ||
+		material.Device.Main.APIKey != "DEVICE_SECRET_ONE" ||
+		material.Backend.Runtime.MainAPIKey != "BACKEND_SECRET_ONE-backend-main" ||
+		material.Backend.Preprocessing.Roles["event_recent"].Prompt != "private role prompt BACKEND_SECRET_ONE" {
+		t.Fatalf("captured material changed through caller mutation: %+v", material)
+	}
+
+	replay, err := registry.capture(
+		validPocketRisuExecutionContextRequest("operation-1", "DEVICE_SECRET_ONE"),
+		validPocketRisuExecutionBackendSnapshot("BACKEND_SECRET_ONE"),
+	)
+	if err != nil || !replay.Reused || replay.ExecutionContextID != first.ExecutionContextID {
+		t.Fatalf("exact replay = %+v, %v", replay, err)
+	}
+	changed := validPocketRisuExecutionContextRequest("operation-1", "DEVICE_SECRET_CHANGED")
+	conflict, err := registry.capture(changed, validPocketRisuExecutionBackendSnapshot("BACKEND_SECRET_ONE"))
+	if err != nil || conflict.Status != pocketRisuExecutionContextStatusConflict || conflict.ExecutionContextID != "" {
