+	}); err != nil || !inserted {
+		t.Fatalf("enqueue leased vector item inserted=%v err=%v", inserted, err)
+	}
+
+	firstOperationID := "c0-fence-operation-1-" + suffix
+	claim, err := runtimeStore.AcquireHostSessionExecution(ctx, HostSessionExecutionAcquireRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+		OperationID: firstOperationID, ExpectedBindingEpoch: identity.BindingEpoch,
+	})
+	if err != nil || claim.Status != HostSessionExecutionStatusAcquired {
+		t.Fatalf("initial execution claim=%+v err=%v", claim, err)
+	}
+	prepareRegistration, err := runtimeStore.RegisterHostPrepare(ctx, HostPrepareRegisterRequest{
+		HostPrepareIdentity: HostPrepareIdentity{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+			BindingEpoch: identity.BindingEpoch, OperationID: firstOperationID,
+			ClaimEpoch: claim.ClaimEpoch, MainRequestID: "c0-fence-main-request-" + suffix,
+		},
+		ExecutionContextID:     "c0-fence-context-" + suffix,
+		SettingsSnapshotDigest: strings.Repeat("a", 64),
+		InputReceiptID:         "c0-fence-input-receipt-" + suffix,
+		SourceRevision:         sourceRevision,
+		SemanticPayloadHash:    strings.Repeat("b", 64),
+		RequestType:            "model",
+		ProtocolVersion:        HostPrepareProtocolVersion,
+	})
+	if err != nil || prepareRegistration.Status != HostPrepareStatusRegistered {
+		t.Fatalf("source-fence prepare registration=%+v err=%v", prepareRegistration, err)
+	}
+	prepareStart, err := runtimeStore.StartHostPrepare(ctx, HostPrepareStartRequest{
+		HostPrepareLookup: HostPrepareLookup{
+			PrepareKey: prepareRegistration.PrepareKey, RequestFingerprint: prepareRegistration.RequestFingerprint,
+		},
+		ExternalOperationID: "c0-fence-external-" + suffix,
+	})
+	if err != nil || !prepareStart.StartAuthorized {
+		t.Fatalf("source-fence prepare start=%+v err=%v", prepareStart, err)
+	}
+	prepareJSON, prepareHash := hostPrepareReadyResult(`{"status":"ready","kind":"source-fence"}`)
+	prepareReady, err := runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+		HostPrepareLookup: HostPrepareLookup{
+			PrepareKey: prepareRegistration.PrepareKey, RequestFingerprint: prepareRegistration.RequestFingerprint,
+		},
+		RunEpoch: prepareStart.RunEpoch, ResultJSON: prepareJSON, ResultHash: prepareHash,
+	})
+	if err != nil || prepareReady.Status != HostPrepareStatusReady {
+		t.Fatalf("source-fence prepare ready=%+v err=%v", prepareReady, err)
+	}
+	intent := HostChangeIntent{
+		HostChangeStreamIdentity: identity,
+		EventID:                  "c0-fence-event-1-" + suffix,
+		Seq:                      1, PreviousSeq: 0, OperationID: firstOperationID, Kind: "edit",
+		BeforeRevision: "host-revision-before", AfterRevision: "host-revision-after",
+		MessageIdentities: []string{sourceMessageID}, SourceGeneration: sourceGenerationID,
+		CommittedAt: now, PayloadRef: "c0-fence-payload-" + suffix,
+	}
+	ingested, err := runtimeStore.IngestHostChangeIntent(ctx, intent)
+	if err != nil || ingested.IngestedSeq != 1 || ingested.SafeSeq != 0 || ingested.SafetyState != "pending" {
+		t.Fatalf("pending edit ingest=%+v err=%v", ingested, err)
+	}
+	blockedPrepare, err := runtimeStore.RegisterHostPrepare(ctx, HostPrepareRegisterRequest{
+		HostPrepareIdentity: HostPrepareIdentity{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+			BindingEpoch: identity.BindingEpoch, OperationID: firstOperationID,
+			ClaimEpoch: claim.ClaimEpoch, MainRequestID: "c0-fence-blocked-main-" + suffix,
+		},
+		ExecutionContextID:     "c0-fence-blocked-context-" + suffix,
+		SettingsSnapshotDigest: strings.Repeat("c", 64),
+		InputReceiptID:         "c0-fence-blocked-receipt-" + suffix,
+		SourceRevision:         sourceRevision,
+		SemanticPayloadHash:    strings.Repeat("d", 64),
+		RequestType:            "model",
+		ProtocolVersion:        HostPrepareProtocolVersion,
+	})
+	if err != nil || blockedPrepare.Status != HostPrepareStatusFenced ||
+		blockedPrepare.ReasonCode != "host_changes_not_safe" {
+		t.Fatalf("prepare across pending host change=%+v err=%v", blockedPrepare, err)
+	}
+	active, err := runtimeStore.GetHostSessionExecution(ctx, hostID, firstOperationID)
+	if err != nil || active.IngestedHostChangeSeq != 1 || active.SafeHostChangeSeq != 0 {
+		t.Fatalf("active execution watermarks=%+v err=%v", active, err)
+	}
+	if err := runtimeStore.Close(); err != nil {
+		t.Fatalf("close before durable source invalidation: %v", err)
+	}
+	runtimeStore = openStore()
+	defer runtimeStore.Close()
+
+	applied, err := runtimeStore.ApplyHostChangeSourceInvalidation(ctx, HostChangeSourceInvalidationRequest{
+		HostChangeStreamIdentity: identity, EventID: intent.EventID,
+	})
+	if err != nil || applied.Status != HostChangeStatusIngested || applied.SafeSeq != 1 ||
+		applied.SafetyState != "safe" || applied.SafetyDisposition != "source_invalidated" {
+		t.Fatalf("applied source invalidation=%+v err=%v", applied, err)
+	}
+	replayed, err := runtimeStore.ApplyHostChangeSourceInvalidation(ctx, HostChangeSourceInvalidationRequest{
+		HostChangeStreamIdentity: identity, EventID: intent.EventID,
+	})
+	if err != nil || !replayed.Reused || replayed.SafeSeq != 1 {
+		t.Fatalf("replayed source invalidation=%+v err=%v", replayed, err)
+	}
+	terminal, err := runtimeStore.GetHostSessionExecution(ctx, hostID, firstOperationID)
+	if err != nil || terminal.Status != HostSessionExecutionStatusTerminal || terminal.EndReason != "invalidated" ||
+		terminal.SourceDisposition != "superseded" || terminal.SafeHostChangeSeq != 1 {
+		t.Fatalf("invalidated execution outcome=%+v err=%v", terminal, err)
+	}
+	fencedPrepare, err := runtimeStore.GetHostPrepare(ctx, HostPrepareLookup{
+		PrepareKey: prepareRegistration.PrepareKey, RequestFingerprint: prepareRegistration.RequestFingerprint,
+	})
+	if err != nil || fencedPrepare.Status != HostPrepareStatusFenced || fencedPrepare.ResultJSON != "" ||
+		fencedPrepare.FailureCode != "host_source_changed" || !fencedPrepare.ExecutionClaimReleased {
+		t.Fatalf("source-changed prepare fence=%+v err=%v", fencedPrepare, err)
+	}
+	skipAfterSourceChange, err := runtimeStore.SkipHostPrepare(ctx, HostPrepareSkipRequest{
+		HostPrepareLookup: HostPrepareLookup{
+			PrepareKey: prepareRegistration.PrepareKey, RequestFingerprint: prepareRegistration.RequestFingerprint,
+		},
+		SkipEventID: "c0-fence-late-skip-" + suffix, SkipReason: "node_disposition_skipped",
+	})
+	if err != nil || skipAfterSourceChange.Status != HostPrepareStatusFenced ||
+		!skipAfterSourceChange.Reused || !skipAfterSourceChange.ExecutionClaimReleased {
+		t.Fatalf("skip after source-change release=%+v err=%v", skipAfterSourceChange, err)
+	}
+
+	var sourceState, jobState, vectorState string
+	if err := runtimeStore.db.QueryRowContext(ctx, `SELECT lifecycle_state FROM memory_source_revisions WHERE source_revision = ?`, sourceRevision).Scan(&sourceState); err != nil {
+		t.Fatal(err)
+	}
+	if err := runtimeStore.db.QueryRowContext(ctx, `SELECT status FROM memory_reprocessing_jobs WHERE idempotency_key = ?`, jobKey).Scan(&jobState); err != nil {
+		t.Fatal(err)
+	}
+	var vectorID int64
+	if err := runtimeStore.db.QueryRowContext(ctx, `SELECT id, status FROM memory_vector_outbox WHERE operation_key = ?`, vectorKey).Scan(&vectorID, &vectorState); err != nil {
+		t.Fatal(err)
+	}
+	if sourceState != "invalidated" || jobState != "stale_rejected" || vectorState != "stale_rejected" {
+		t.Fatalf("post-invalidation source=%q job=%q vector=%q", sourceState, jobState, vectorState)
+	}
+	var vectorDeleteCount int
+	if err := runtimeStore.db.QueryRowContext(ctx, `
+		SELECT COUNT(*)
+		FROM memory_vector_outbox
+		WHERE chat_session_id = ? AND operation = 'delete' AND status = 'pending'
+	`, sessionID).Scan(&vectorDeleteCount); err != nil {
+		t.Fatal(err)
+	}
+	if vectorDeleteCount < 1 {
+		t.Fatalf("durable vector delete count=%d want at least 1", vectorDeleteCount)
+	}
+	if memories, err := runtimeStore.ListMemories(ctx, sessionID, 0, 0); err != nil || len(memories) != 0 {
+		t.Fatalf("stale aggregate memories after invalidation=%d err=%v", len(memories), err)
+	}
+	if logs, err := runtimeStore.ListChatLogs(ctx, sessionID, 0, 0); err != nil || len(logs) != 0 {
+		t.Fatalf("stale canonical logs after invalidation=%d err=%v", len(logs), err)
+	}
+	if err := runtimeStore.CompleteMemoryVectorMaterializedOperation(ctx, vectorID, leaseOwner, now.Add(time.Second), MemoryVectorMaterialization{
+		ChatSessionID: sessionID, SourceRevision: sourceRevision,
+		DocumentID: "memory:" + sessionID + ":1", SourceRowID: 1,
+		EmbeddingJSON: "[0.1]", EmbeddingModel: "c0",
+	}); !errors.Is(err, ErrSourceRevisionStale) {
+		t.Fatalf("late vector completion error=%v, want ErrSourceRevisionStale", err)
+	}
+
+	secondOperationID := "c0-fence-operation-2-" + suffix
+	nextClaim, err := runtimeStore.AcquireHostSessionExecution(ctx, HostSessionExecutionAcquireRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+		OperationID: secondOperationID, ExpectedBindingEpoch: identity.BindingEpoch,
+		RequiredHostChangeSeq: 1,
+	})
+	if err != nil || nextClaim.Status != HostSessionExecutionStatusAcquired || nextClaim.SafeHostChangeSeq != 1 {
+		t.Fatalf("claim after safe source invalidation=%+v err=%v", nextClaim, err)
+	}
+}
