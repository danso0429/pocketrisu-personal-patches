+func (m *mariadbStore) SkipHostPrepare(ctx context.Context, request HostPrepareSkipRequest) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	lookup, err := normalizeHostPrepareLookup(request.HostPrepareLookup)
+	if err != nil {
+		return nil, err
+	}
+	skipEventID, err := normalizeHostSessionExecutionIdentifier("skip_event_id", request.SkipEventID, 255)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	skipReason := strings.ToLower(strings.TrimSpace(request.SkipReason))
+	if !hostPrepareSkipReasonAllowed(skipReason) {
+		return nil, fmt.Errorf("%w: unsupported skip_reason %q", ErrHostPrepareInvalid, skipReason)
+	}
+	return m.runHostPrepareMutation(ctx, func(tx *sql.Tx) (*HostPrepareResult, error) {
+		row, result, err := lockHostPrepareLookup(ctx, tx, lookup)
+		if err != nil || result != nil {
+			return result, err
+		}
+		if row.Status == HostPrepareStatusSkipped {
+			if row.SkipEventID != skipEventID || row.SkipReason != skipReason {
+				return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_skip_conflict"), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_skip_replayed", true), nil
+		}
+		if row.Status == HostPrepareStatusFenced && row.ExecutionClaimReleased {
+			return hostPrepareResultFromRow(row, "prepare_already_fenced", true), nil
+		}
+		if _, err := selectHostSessionExecutionOutcomeByOperation(ctx, tx, row.HostInstanceID, row.OperationID, true); err == nil {
+			if row.Status == HostPrepareStatusRegistered || row.Status == HostPrepareStatusRunning {
+				if err := fenceHostPrepareRequestTx(ctx, tx, row, "execution_already_terminal"); err != nil {
+					return nil, err
+				}
+				return hostPrepareResultFromRow(row, "prepare_skip_fenced", false), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_skip_after_terminal_ignored", true), nil
+		} else if !errors.Is(err, ErrNotFound) {
+			return nil, err
+		}
+		write, err := tx.ExecContext(ctx, `
+			UPDATE host_prepare_requests
+			SET status = 'skipped', result_json = NULL, result_hash = NULL,
+			    failure_code = NULL, failure_retryable = NULL,
+			    skip_event_id = ?, skip_reason = ?, finished_at = UTC_TIMESTAMP(3)
+			WHERE prepare_key = ? AND request_fingerprint = ? AND status <> 'skipped'
+		`, skipEventID, skipReason, row.PrepareKey, row.RequestFingerprint)
+		if err != nil {
+			return nil, err
+		}
+		if err := requireHostPrepareRowsAffected(write, "skip"); err != nil {
+			return nil, err
+		}
+		row.Status = HostPrepareStatusSkipped
+		row.ResultJSON = ""
+		row.ResultHash = ""
+		row.FailureCode = ""
+		row.FailureRetryable = false
+		row.SkipEventID = skipEventID
+		row.SkipReason = skipReason
+		released, err := releaseHostPrepareExecutionForSkipTx(ctx, tx, row)
+		if err != nil {
+			return nil, err
+		}
+		if released {
+			write, err := tx.ExecContext(ctx, `
+				UPDATE host_prepare_requests
+				SET execution_claim_released = TRUE
+				WHERE prepare_key = ? AND request_fingerprint = ? AND status = 'skipped'
+			`, row.PrepareKey, row.RequestFingerprint)
+			if err != nil {
+				return nil, err
+			}
+			if err := requireHostPrepareRowsAffected(write, "skip release receipt"); err != nil {
+				return nil, err
+			}
+			row.ExecutionClaimReleased = true
+		}
+		result = hostPrepareResultFromRow(row, "prepare_skipped", false)
+		return result, nil
+	})
+}
+
+func (m *mariadbStore) GetHostPrepare(ctx context.Context, lookup HostPrepareLookup) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	normalized, err := normalizeHostPrepareLookup(lookup)
+	if err != nil {
+		return nil, err
+	}
+	row, err := selectHostPrepareRequest(ctx, m.db, normalized.PrepareKey, false)
+	if errors.Is(err, ErrNotFound) {
+		return newHostPrepareResult(HostPrepareStatusRejected, "prepare_not_found", normalized.PrepareKey, normalized.RequestFingerprint), nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if row.ContractVersion != HostPrepareRegistryContractVersion {
+		return nil, fmt.Errorf("unsupported host prepare contract %q", row.ContractVersion)
+	}
+	if !hostPrepareStatusAllowed(row.Status) {
+		return nil, fmt.Errorf("unsupported host prepare status %q", row.Status)
+	}
+	if row.RequestFingerprint != normalized.RequestFingerprint {
+		return newHostPrepareConflictResult(normalized.PrepareKey, normalized.RequestFingerprint, "prepare_fingerprint_conflict"), nil
+	}
+	return hostPrepareResultFromRow(row, "prepare_status", true), nil
+}
+
+func (m *mariadbStore) runHostPrepareMutation(ctx context.Context, mutate func(*sql.Tx) (*HostPrepareResult, error)) (*HostPrepareResult, error) {
+	for attempt := 1; attempt <= hostSessionExecutionTransactionMaxAttempts; attempt++ {
+		tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelSerializable})
+		if err != nil {
+			if !isRetryableHostCoordinationTransactionError(err) || attempt == hostSessionExecutionTransactionMaxAttempts {
+				return nil, err
+			}
+			if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		result, mutationErr := mutate(tx)
+		if mutationErr == nil {
+			mutationErr = tx.Commit()
+		}
+		if mutationErr != nil {
+			_ = tx.Rollback()
+		}
+		if mutationErr == nil {
+			return result, nil
+		}
+		if !isRetryableHostCoordinationTransactionError(mutationErr) || attempt == hostSessionExecutionTransactionMaxAttempts {
+			return nil, mutationErr
+		}
+		if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+			return nil, err
+		}
+	}
+	return nil, errors.New("host prepare transaction exhausted without result")
+}
+
+func lockHostPrepareLookup(ctx context.Context, tx *sql.Tx, lookup HostPrepareLookup) (*hostPrepareRequestRow, *HostPrepareResult, error) {
+	row, err := selectHostPrepareRequest(ctx, tx, lookup.PrepareKey, true)
+	if errors.Is(err, ErrNotFound) {
+		return nil, newHostPrepareResult(HostPrepareStatusRejected, "prepare_not_found", lookup.PrepareKey, lookup.RequestFingerprint), nil
+	}
+	if err != nil {
+		return nil, nil, err
+	}
+	if row.RequestFingerprint != lookup.RequestFingerprint {
+		return nil, newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_fingerprint_conflict"), nil
+	}
+	if row.ContractVersion != HostPrepareRegistryContractVersion {
+		return nil, nil, fmt.Errorf("unsupported host prepare contract %q", row.ContractVersion)
+	}
+	if !hostPrepareStatusAllowed(row.Status) {
+		return nil, nil, fmt.Errorf("unsupported host prepare status %q", row.Status)
+	}
+	return row, nil, nil
+}
+
+func hostPrepareExecutionClaimCurrent(ctx context.Context, tx *sql.Tx, row *hostPrepareRequestRow) (bool, string, error) {
+	binding, err := selectSessionRouteBindingTx(ctx, tx, row.StableCharacterID, row.HostChatID, true)
+	if errors.Is(err, ErrNotFound) {
+		return false, "binding_not_found", nil
+	}
+	if err != nil {
+		return false, "", err
+	}
+	if !hostSessionExecutionBindingUsable(binding) ||
+		binding.CanonicalSessionID != row.CanonicalSessionID ||
+		SessionRouteBindingEpoch(*binding) != row.BindingEpoch {
+		return false, "binding_changed", nil
+	}
+	slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, row.CanonicalSessionID, true)
+	if errors.Is(err, ErrNotFound) {
+		return false, "execution_claim_changed", nil
+	}
+	if err != nil {
+		return false, "", err
+	}
+	identity := HostPrepareIdentity{
+		HostInstanceID: row.HostInstanceID, StableCharacterID: row.StableCharacterID,
+		HostChatID: row.HostChatID, BindingEpoch: row.BindingEpoch,
+		OperationID: row.OperationID, ClaimEpoch: row.ClaimEpoch, MainRequestID: row.MainRequestID,
+	}
+	if !hostPrepareSlotMatchesIdentity(slot, identity, row.CanonicalSessionID) {
+		return false, "execution_claim_changed", nil
+	}
+	if !hostPrepareSlotAllowsPreparation(slot) {
+		return false, "host_changes_not_safe", nil
+	}
+	return true, "", nil
+}
+
+func hostPrepareSlotMatchesIdentity(slot *hostSessionExecutionSlot, identity HostPrepareIdentity, canonicalSessionID string) bool {
+	return slot != nil && slot.ContractVersion == HostSessionExecutionContractVersion &&
+		slot.CanonicalSessionID == canonicalSessionID &&
+		slot.ActiveHostInstanceID == identity.HostInstanceID &&
+		slot.ActiveStableCharacterID == identity.StableCharacterID &&
+		slot.ActiveHostChatID == identity.HostChatID &&
+		slot.ActiveBindingEpoch == identity.BindingEpoch &&
+		slot.ActiveOperationID == identity.OperationID &&
+		slot.ClaimEpoch == identity.ClaimEpoch && slot.Phase == "claimed"
+}
+
+func hostPrepareSlotAllowsPreparation(slot *hostSessionExecutionSlot) bool {
+	return slot != nil && slot.SafeHostChangeSeq >= slot.RequiredHostChangeSeq &&
+		slot.SafeHostChangeSeq >= slot.IngestedHostChangeSeq
+}
+
+func fenceHostPrepareRequestTx(ctx context.Context, tx *sql.Tx, row *hostPrepareRequestRow, reason string) error {
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_prepare_requests
+		SET status = 'fenced', result_json = NULL, result_hash = NULL,
+		    failure_code = ?, failure_retryable = FALSE,
+		    finished_at = UTC_TIMESTAMP(3)
+		WHERE prepare_key = ? AND request_fingerprint = ?
+		  AND status IN ('registered_not_started', 'running')
+	`, reason, row.PrepareKey, row.RequestFingerprint)
+	if err != nil {
+		return err
+	}
+	if err := requireHostPrepareRowsAffected(write, "fence"); err != nil {
+		return err
+	}
+	row.Status = HostPrepareStatusFenced
+	row.ResultJSON = ""
+	row.ResultHash = ""
+	row.FailureCode = reason
+	row.FailureRetryable = false
+	return nil
+}
+
+func releaseHostPrepareExecutionForSkipTx(ctx context.Context, tx *sql.Tx, row *hostPrepareRequestRow) (bool, error) {
+	slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, row.CanonicalSessionID, true)
+	if errors.Is(err, ErrNotFound) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	identity := HostPrepareIdentity{
+		HostInstanceID: row.HostInstanceID, StableCharacterID: row.StableCharacterID,
+		HostChatID: row.HostChatID, BindingEpoch: row.BindingEpoch,
+		OperationID: row.OperationID, ClaimEpoch: row.ClaimEpoch, MainRequestID: row.MainRequestID,
+	}
+	if !hostPrepareSlotMatchesIdentity(slot, identity, row.CanonicalSessionID) {
+		return false, nil
+	}
+	outcome := &hostSessionExecutionOutcome{
+		ContractVersion:       HostSessionExecutionContractVersion,
+		HostInstanceID:        row.HostInstanceID,
+		StableCharacterID:     row.StableCharacterID,
+		HostChatID:            row.HostChatID,
+		CanonicalSessionID:    row.CanonicalSessionID,
+		BindingEpoch:          row.BindingEpoch,
+		OperationID:           row.OperationID,
+		ClaimEpoch:            row.ClaimEpoch,
+		EndEventID:            row.SkipEventID,
+		RequestedEndReason:    "ac_skipped_prepare_unavailable",
+		EndReason:             "ac_skipped_prepare_unavailable",
+		TerminalPhase:         hostSessionExecutionTerminalPhase("ac_skipped_prepare_unavailable"),
+		SourceDisposition:     "not_stored",
+		RequiredHostChangeSeq: slot.RequiredHostChangeSeq,
+		SafeHostChangeSeq:     slot.SafeHostChangeSeq,
+	}
+	if _, err := tx.ExecContext(ctx, `
+		INSERT INTO host_session_execution_outcomes (
+			contract_version, host_instance_id, stable_character_id, host_chat_id,
+			canonical_session_id, binding_epoch, operation_id, claim_epoch,
+			end_event_id, requested_end_reason, end_reason, terminal_phase, source_disposition,
+			final_required_host_change_seq, final_safe_host_change_seq
+		) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+	`, outcome.ContractVersion, outcome.HostInstanceID, outcome.StableCharacterID,
+		outcome.HostChatID, outcome.CanonicalSessionID, outcome.BindingEpoch,
+		outcome.OperationID, outcome.ClaimEpoch, outcome.EndEventID,
+		outcome.RequestedEndReason, outcome.EndReason, outcome.TerminalPhase,
+		outcome.SourceDisposition, outcome.RequiredHostChangeSeq, outcome.SafeHostChangeSeq); err != nil {
+		return false, err
+	}
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_session_execution_slots
+		SET active_host_instance_id = NULL,
+		    active_stable_character_id = NULL,
+		    active_host_chat_id = NULL,
+		    active_binding_epoch = NULL,
+		    active_operation_id = NULL,
+		    phase = 'idle', required_host_change_seq = 0, claimed_at = NULL
+		WHERE canonical_session_id = ?
+		  AND active_host_instance_id = ?
+		  AND active_operation_id = ?
+		  AND claim_epoch = ?
+	`, row.CanonicalSessionID, row.HostInstanceID, row.OperationID, row.ClaimEpoch)
+	if err != nil {
+		return false, err
+	}
+	if err := requireHostPrepareRowsAffected(write, "skip release"); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+func requireHostPrepareRowsAffected(result sql.Result, operation string) error {
+	rows, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if rows != 1 {
+		return fmt.Errorf("host prepare %s lost compare-and-set", operation)
+	}
+	return nil
+}
+
+func hostPrepareSkipReasonAllowed(reason string) bool {
+	switch reason {
+	case "prepare_unavailable", "transport_timeout", "outcome_unknown", "node_disposition_skipped":
+		return true
+	default:
+		return false
+	}
+}
+
+func hostPrepareStatusAllowed(status string) bool {
+	switch status {
+	case HostPrepareStatusRegistered, HostPrepareStatusRunning, HostPrepareStatusReady,
+		HostPrepareStatusFailedKnown, HostPrepareStatusOutcomeUnknown,
+		HostPrepareStatusSkipped, HostPrepareStatusFenced:
+		return true
+	default:
+		return false
+	}
+}
+
+func hostPrepareKnownCallDisposition(started bool) string {
+	if started {
+		return "started"
+	}
+	return "not_started"
+}
+
+func selectHostPrepareRequest(ctx context.Context, queryer hostSessionExecutionQueryer, prepareKey string, forUpdate bool) (*hostPrepareRequestRow, error) {
+	query := `
+		SELECT prepare_key, contract_version, host_instance_id,
+		       stable_character_id, host_chat_id, canonical_session_id,
+		       binding_epoch, operation_id, claim_epoch, main_request_id,
+		       request_fingerprint, execution_context_id,
+		       settings_snapshot_digest, input_receipt_id,
+		       COALESCE(source_revision, ''), semantic_payload_hash,
+		       request_type, protocol_version, status, run_epoch,
+		       COALESCE(external_operation_id, ''), COALESCE(result_json, ''),
+		       COALESCE(result_hash, ''), COALESCE(failure_code, ''),
+		       COALESCE(failure_retryable, FALSE), external_call_disposition,
+		       COALESCE(skip_event_id, ''), COALESCE(skip_reason, ''),
+		       execution_claim_released
+		FROM host_prepare_requests
+		WHERE prepare_key = ?`
+	if forUpdate {
+		query += " FOR UPDATE"
+	}
+	var row hostPrepareRequestRow
+	err := queryer.QueryRowContext(ctx, query, prepareKey).Scan(
+		&row.PrepareKey, &row.ContractVersion, &row.HostInstanceID,
+		&row.StableCharacterID, &row.HostChatID, &row.CanonicalSessionID,
+		&row.BindingEpoch, &row.OperationID, &row.ClaimEpoch, &row.MainRequestID,
+		&row.RequestFingerprint, &row.ExecutionContextID,
+		&row.SettingsSnapshotDigest, &row.InputReceiptID, &row.SourceRevision,
+		&row.SemanticPayloadHash, &row.RequestType, &row.ProtocolVersion,
+		&row.Status, &row.RunEpoch, &row.ExternalOperationID,
+		&row.ResultJSON, &row.ResultHash, &row.FailureCode,
+		&row.FailureRetryable, &row.ExternalCallDisposition,
+		&row.SkipEventID, &row.SkipReason, &row.ExecutionClaimReleased,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &row, nil
+}
+
+func hostPrepareRowMatchesRegistration(row *hostPrepareRequestRow, request HostPrepareRegisterRequest, prepareKey, fingerprint string) bool {
+	return row != nil && row.ContractVersion == HostPrepareRegistryContractVersion &&
+		row.PrepareKey == prepareKey && row.RequestFingerprint == fingerprint &&
+		row.HostInstanceID == request.HostInstanceID &&
+		row.StableCharacterID == request.StableCharacterID &&
+		row.HostChatID == request.HostChatID && row.BindingEpoch == request.BindingEpoch &&
+		row.OperationID == request.OperationID && row.ClaimEpoch == request.ClaimEpoch &&
+		row.MainRequestID == request.MainRequestID &&
+		row.ExecutionContextID == request.ExecutionContextID &&
+		row.SettingsSnapshotDigest == request.SettingsSnapshotDigest &&
+		row.InputReceiptID == request.InputReceiptID && row.SourceRevision == request.SourceRevision &&
+		row.SemanticPayloadHash == request.SemanticPayloadHash &&
+		row.RequestType == request.RequestType && row.ProtocolVersion == request.ProtocolVersion
+}
+
+func hostPrepareRowFromRegistration(request HostPrepareRegisterRequest, prepareKey, fingerprint, canonicalSessionID string) *hostPrepareRequestRow {
+	return &hostPrepareRequestRow{
+		PrepareKey: prepareKey, ContractVersion: HostPrepareRegistryContractVersion,
+		HostInstanceID: request.HostInstanceID, StableCharacterID: request.StableCharacterID,
+		HostChatID: request.HostChatID, CanonicalSessionID: canonicalSessionID,
+		BindingEpoch: request.BindingEpoch, OperationID: request.OperationID,
+		ClaimEpoch: request.ClaimEpoch, MainRequestID: request.MainRequestID,
+		RequestFingerprint: fingerprint, ExecutionContextID: request.ExecutionContextID,
+		SettingsSnapshotDigest: request.SettingsSnapshotDigest, InputReceiptID: request.InputReceiptID,
+		SourceRevision: request.SourceRevision, SemanticPayloadHash: request.SemanticPayloadHash,
+		RequestType: request.RequestType, ProtocolVersion: request.ProtocolVersion,
+		Status: HostPrepareStatusRegistered, ExternalCallDisposition: "not_recorded",
+	}
+}
+
+func newHostPrepareResult(status, reason, prepareKey, fingerprint string) *HostPrepareResult {
+	return &HostPrepareResult{
+		ContractVersion: HostPrepareRegistryContractVersion,
+		Status:          status, ReasonCode: reason,
+		PrepareKey: prepareKey, RequestFingerprint: fingerprint,
+	}
+}
+
+func newHostPrepareConflictResult(prepareKey, fingerprint, reason string) *HostPrepareResult {
+	return newHostPrepareResult(HostPrepareStatusConflict, reason, prepareKey, fingerprint)
+}
+
+func hostPrepareResultFromRow(row *hostPrepareRequestRow, reason string, reused bool) *HostPrepareResult {
+	if row == nil {
+		return newHostPrepareResult(HostPrepareStatusRejected, reason, "", "")
+	}
+	result := newHostPrepareResult(row.Status, reason, row.PrepareKey, row.RequestFingerprint)
+	result.ResolvedSessionID = row.CanonicalSessionID
+	result.BindingEpoch = row.BindingEpoch
+	result.OperationID = row.OperationID
+	result.ClaimEpoch = row.ClaimEpoch
+	result.MainRequestID = row.MainRequestID
+	result.RunEpoch = row.RunEpoch
+	result.ExternalOperationID = row.ExternalOperationID
+	result.ExecutionContextID = row.ExecutionContextID
+	result.ResultJSON = row.ResultJSON
+	result.ResultHash = row.ResultHash
+	result.FailureCode = row.FailureCode
+	result.FailureRetryable = row.FailureRetryable
+	result.ExternalCallDisposition = row.ExternalCallDisposition
+	result.SkipEventID = row.SkipEventID
+	result.SkipReason = row.SkipReason
+	result.ExecutionClaimReleased = row.ExecutionClaimReleased
+	result.Reused = reused
+	return result
+}
