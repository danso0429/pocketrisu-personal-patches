+		recoveredFailure.ExternalCallDisposition != "not_started" {
+		t.Fatalf("known failure recovery=%+v err=%v", recoveredFailure, err)
+	}
+	skip("e", failureLookup)
+
+	raceLookup, _, _ := acquireAndRegister("f")
+	raceStart := start("f", raceLookup)
+	var completeAttempt, skipAttempt attempt
+	startRace := make(chan struct{})
+	var waitGroup sync.WaitGroup
+	waitGroup.Add(2)
+	go func() {
+		defer waitGroup.Done()
+		<-startRace
+		completeAttempt.result, completeAttempt.err = runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+			HostPrepareLookup: raceLookup, RunEpoch: raceStart.RunEpoch,
+			ResultJSON: readyJSON, ResultHash: readyHash,
+		})
+	}()
+	go func() {
+		defer waitGroup.Done()
+		<-startRace
+		skipAttempt.result, skipAttempt.err = runtimeStore.SkipHostPrepare(ctx, HostPrepareSkipRequest{
+			HostPrepareLookup: raceLookup,
+			SkipEventID:       "skip-f-" + suffix,
+			SkipReason:        "transport_timeout",
+		})
+	}()
+	close(startRace)
+	waitGroup.Wait()
+	if completeAttempt.err != nil || skipAttempt.err != nil {
+		t.Fatalf("ready/skip race complete=%+v/%v skip=%+v/%v", completeAttempt.result, completeAttempt.err, skipAttempt.result, skipAttempt.err)
+	}
+	if skipAttempt.result.Status != HostPrepareStatusSkipped || !skipAttempt.result.ExecutionClaimReleased {
+		t.Fatalf("ready/skip race skip=%+v", skipAttempt.result)
+	}
+	finalRace, err := runtimeStore.GetHostPrepare(ctx, raceLookup)
+	if err != nil || finalRace.Status != HostPrepareStatusSkipped || finalRace.ResultJSON != "" ||
+		!finalRace.ExecutionClaimReleased {
+		t.Fatalf("ready/skip final=%+v err=%v", finalRace, err)
+	}
+	lateRace, err := runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+		HostPrepareLookup: raceLookup, RunEpoch: raceStart.RunEpoch,
+		ResultJSON: readyJSON, ResultHash: readyHash,
+	})
+	if err != nil || lateRace.Status != HostPrepareStatusSkipped || lateRace.ResultJSON != "" {
+		t.Fatalf("late result after skip=%+v err=%v", lateRace, err)
+	}
+
+	terminalLookup, terminalClaimEpoch, terminalRegistration := acquireAndRegister("2")
+	terminalStart := start("2", terminalLookup)
+	terminalReady, err := runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+		HostPrepareLookup: terminalLookup, RunEpoch: terminalStart.RunEpoch,
+		ResultJSON: readyJSON, ResultHash: readyHash,
+	})
+	if err != nil || terminalReady.Status != HostPrepareStatusReady {
+		t.Fatalf("terminal fixture ready=%+v err=%v", terminalReady, err)
+	}
+	terminalOutcome, err := runtimeStore.SettleHostSessionExecution(ctx, HostSessionExecutionSettleRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+		OperationID: terminalRegistration.OperationID, ExpectedBindingEpoch: bindingEpoch,
+		ClaimEpoch: terminalClaimEpoch, EndEventID: "end-model-failed-" + suffix,
+		EndReason: "model_failed", SourceDisposition: "not_stored",
+	})
+	if err != nil || terminalOutcome.Status != HostSessionExecutionStatusTerminal {
+		t.Fatalf("terminal fixture settle=%+v err=%v", terminalOutcome, err)
+	}
+	ignoredSkip, err := runtimeStore.SkipHostPrepare(ctx, HostPrepareSkipRequest{
+		HostPrepareLookup: terminalLookup,
+		SkipEventID:       "late-skip-terminal-" + suffix,
+		SkipReason:        "transport_timeout",
+	})
+	if err != nil || ignoredSkip.Status != HostPrepareStatusReady ||
+		ignoredSkip.ReasonCode != "prepare_skip_after_terminal_ignored" || ignoredSkip.ResultJSON != readyJSON {
+		t.Fatalf("late skip after terminal=%+v err=%v", ignoredSkip, err)
+	}
+
+	fencedLookup, _, _ := acquireAndRegister("1")
+	fencedStart := start("1", fencedLookup)
+	remapped, err := runtimeStore.BindSessionRoute(ctx, SessionRouteBindingRequest{
+		StableCharacterID: characterID, HostChatID: chatID,
+		RequestedSessionID: sessionID, Mode: SessionRouteBindingModeManualAttach,
+	})
+	if err != nil {
+		t.Fatalf("advance prepare binding: %v", err)
+	}
+	if SessionRouteBindingEpoch(remapped.Binding) == bindingEpoch {
+		t.Fatal("prepare binding epoch did not advance")
+	}
+	fenced, err := runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+		HostPrepareLookup: fencedLookup, RunEpoch: fencedStart.RunEpoch,
+		ResultJSON: readyJSON, ResultHash: readyHash,
+	})
+	if err != nil || fenced.Status != HostPrepareStatusFenced || fenced.ResultJSON != "" ||
+		fenced.FailureCode != "binding_changed" {
+		t.Fatalf("late ready after binding change=%+v err=%v", fenced, err)
+	}
+	fencedSkip, err := runtimeStore.SkipHostPrepare(ctx, HostPrepareSkipRequest{
+		HostPrepareLookup: fencedLookup,
+		SkipEventID:       "skip-binding-changed-" + suffix,
+		SkipReason:        "transport_timeout",
+	})
+	if err != nil || fencedSkip.Status != HostPrepareStatusSkipped || !fencedSkip.ExecutionClaimReleased {
+		t.Fatalf("binding-changed prepare skip=%+v err=%v", fencedSkip, err)
+	}
+
+	var prepareCount, outcomeCount int
+	if err := runtimeStore.db.QueryRowContext(ctx, `SELECT COUNT(*) FROM host_prepare_requests WHERE host_instance_id = ?`, hostID).Scan(&prepareCount); err != nil {
+		t.Fatal(err)
+	}
+	if err := runtimeStore.db.QueryRowContext(ctx, `SELECT COUNT(*) FROM host_session_execution_outcomes WHERE canonical_session_id = ?`, sessionID).Scan(&outcomeCount); err != nil {
+		t.Fatal(err)
+	}
+	if prepareCount != 6 || outcomeCount != 6 {
+		t.Fatalf("durable prepare/outcome counts=%d/%d want=6/6", prepareCount, outcomeCount)
+	}
+}
+
+func hostPrepareReadyResult(raw string) (string, string) {
+	var compact bytes.Buffer
+	if err := json.Compact(&compact, []byte(raw)); err != nil {
+		panic(err)
+	}
+	sum := sha256.Sum256(compact.Bytes())
+	return compact.String(), hex.EncodeToString(sum[:])
+}
