+	server := NewServer(config.Default())
+	server.RuntimeConfigMu.Lock()
+	server.RuntimeConfig = validPocketRisuExecutionBackendSnapshot("FROZEN_BACKEND").Runtime
+	server.RuntimeConfigMu.Unlock()
+	request := validPocketRisuExecutionContextRequest("operation-server-capture", "FROZEN_DEVICE")
+	result, err := server.capturePocketRisuExecutionContext(request)
+	if err != nil {
+		t.Fatalf("server capture failed: %v", err)
+	}
+
+	server.RuntimeConfigMu.Lock()
+	server.RuntimeConfig.MainAPIKey = "LATER_BACKEND_SECRET"
+	server.RuntimeConfig.MainModel = "later-model"
+	server.RuntimeConfigMu.Unlock()
+	preprocessing.SharedPrompt = "LATER_SHARED_PROMPT"
+	raw, _ = json.Marshal(preprocessing)
+	if err := os.WriteFile(filepath.Join(dataDir, "memory-preprocessing.json"), raw, 0o600); err != nil {
+		t.Fatalf("rewrite preprocessing: %v", err)
+	}
+
+	material, _, err := server.HostExecutionContexts.load(result.ExecutionContextID, request.Identity)
+	if err != nil {
+		t.Fatalf("load captured server context: %v", err)
+	}
+	if material.Backend.Runtime.MainAPIKey != "FROZEN_BACKEND-backend-main" ||
+		material.Backend.Runtime.MainModel != "backend-main-model" ||
+		material.Backend.Preprocessing.SharedPrompt != "FROZEN_SHARED_PROMPT" {
+		t.Fatalf("captured backend changed after global update: %+v", material.Backend)
+	}
+	if result.BackendInstanceID != server.backendInstanceID() {
+		t.Fatalf("backend instance = %q, want %q", result.BackendInstanceID, server.backendInstanceID())
+	}
+	resolved, err := resolvePocketRisuExecutionContext(*material)
+	if err != nil {
+		t.Fatalf("resolve captured server context: %v", err)
+	}
+	if resolved.Main.APIKey != "FROZEN_DEVICE" || resolved.Critic.APIKey != "FROZEN_DEVICE-critic" ||
+		resolved.Preprocessing.SharedPrompt != "FROZEN_SHARED_PROMPT" {
+		t.Fatalf("resolved context reread later globals: %+v", resolved)
+	}
+}
