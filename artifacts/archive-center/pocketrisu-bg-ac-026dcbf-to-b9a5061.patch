+	resultDigest := sha256.Sum256([]byte(resultJSON))
+	result, err := prepares.CompleteHostPrepare(r.Context(), store.HostPrepareCompleteRequest{
+		HostPrepareLookup: store.HostPrepareLookup{PrepareKey: request.PrepareKey, RequestFingerprint: request.RequestFingerprint},
+		RunEpoch:          request.RunEpoch,
+		ResultJSON:        resultJSON,
+		ResultHash:        hex.EncodeToString(resultDigest[:]),
+	})
+	writePocketRisuHostPrepareMutation(w, result, current, err)
+}
