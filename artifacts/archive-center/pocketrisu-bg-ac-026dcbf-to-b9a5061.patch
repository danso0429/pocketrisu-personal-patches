+func (s *Server) pocketRisuHostStores() (store.HostSessionExecutionStore, store.HostPrepareRegistryStore, bool) {
+	executions, executionOK := s.Store.(store.HostSessionExecutionStore)
+	prepares, prepareOK := s.Store.(store.HostPrepareRegistryStore)
+	return executions, prepares, executionOK && prepareOK
+}
+
+// reconcilePocketRisuHostPreparesAfterRestart closes the only durable state
+// that cannot be resumed after a process restart. A running prepare may have
+// reached an external provider, but its captured credentials and exact runtime
+// material lived only in the previous process. The outcome is therefore
+// unknown until the host explicitly settles or abandons the execution.
+func (s *Server) reconcilePocketRisuHostPreparesAfterRestart(ctx context.Context) (int, error) {
+	if s == nil || s.Store == nil {
+		return 0, nil
+	}
+	recovery, enabled := s.Store.(store.HostPrepareRestartRecoveryStore)
+	if !enabled {
+		return 0, nil
+	}
+	prepares, ok := s.Store.(store.HostPrepareRegistryStore)
+	if !ok {
+		return 0, errors.New("running prepare recovery is enabled without the prepare registry")
+	}
+
+	recovered := 0
+	for {
+		if err := ctx.Err(); err != nil {
+			return recovered, err
+		}
+		running, err := recovery.ListRunningHostPrepares(ctx, pocketRisuHostRecoveryBatchSize)
+		if err != nil {
+			return recovered, err
+		}
+		if len(running) == 0 {
+			return recovered, nil
+		}
+		if len(running) > pocketRisuHostRecoveryBatchSize || recovered+len(running) > pocketRisuHostRecoveryMaxPrepares {
+			return recovered, fmt.Errorf("running prepare recovery exceeded the bounded startup limit of %d", pocketRisuHostRecoveryMaxPrepares)
+		}
+		for i := range running {
+			item := &running[i]
+			result, err := prepares.MarkHostPrepareOutcomeUnknown(ctx, store.HostPrepareOutcomeUnknownRequest{
+				HostPrepareLookup: store.HostPrepareLookup{
+					PrepareKey:         item.PrepareKey,
+					RequestFingerprint: item.RequestFingerprint,
+				},
+				RunEpoch: item.RunEpoch,
+			})
+			if err != nil {
+				return recovered, fmt.Errorf("prepare %q: %w", item.PrepareKey, err)
+			}
+			if !pocketRisuHostPrepareRestartRecoveryTerminal(result) {
+				return recovered, fmt.Errorf("prepare %q remained nonterminal after restart recovery", item.PrepareKey)
+			}
+			recovered++
+		}
+	}
+}
+
+func pocketRisuHostPrepareRestartRecoveryTerminal(result *store.HostPrepareResult) bool {
+	if result == nil {
+		return false
+	}
+	switch result.Status {
+	case store.HostPrepareStatusReady, store.HostPrepareStatusFailedKnown,
+		store.HostPrepareStatusOutcomeUnknown, store.HostPrepareStatusSkipped,
+		store.HostPrepareStatusFenced:
+		return true
+	default:
+		return false
+	}
+}
