+
+	testStore.execution.ClaimEpoch++
+	if _, _, err := server.resolvePocketRisuHostConsumerContext(context.Background(), pocketRisuHostConsumerMeta(reference), pocketRisuHostConsumerStagePrepare); err == nil {
+		t.Fatal("changed claim epoch was accepted")
