+			binding.Revision, binding.CreatedAt, binding.UpdatedAt,
+		))
+}
+
+func expectHostChangeExecutionStream(mock sqlmock.Sqlmock, hostInstanceID string, binding SessionRouteBinding, stream *hostChangeStream) {
+	identity := HostChangeStreamIdentity{
