+func TestNormalizeHostPrepareRegistrationBindsSemanticFingerprint(t *testing.T) {
+	base := hostPrepareRegisterFixture(hostSessionExecutionBindingFixture(3), 7, "operation-1", "request-1")
+	normalized, key, fingerprint, err := normalizeHostPrepareRegisterRequest(base)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if key != HostPrepareKey(normalized.HostPrepareIdentity) || len(key) != len("prepare_v1_")+64 || len(fingerprint) != 64 {
+		t.Fatalf("key=%q fingerprint=%q", key, fingerprint)
+	}
+
+	semanticMutations := []struct {
+		name   string
+		mutate func(*HostPrepareRegisterRequest)
+	}{
+		{name: "execution context", mutate: func(request *HostPrepareRegisterRequest) { request.ExecutionContextID = "context-2" }},
+		{name: "settings", mutate: func(request *HostPrepareRegisterRequest) { request.SettingsSnapshotDigest = strings.Repeat("c", 64) }},
+		{name: "input receipt", mutate: func(request *HostPrepareRegisterRequest) { request.InputReceiptID = "receipt-2" }},
+		{name: "source revision", mutate: func(request *HostPrepareRegisterRequest) { request.SourceRevision = "source-2" }},
+		{name: "semantic payload", mutate: func(request *HostPrepareRegisterRequest) { request.SemanticPayloadHash = strings.Repeat("d", 64) }},
+	}
+	for _, test := range semanticMutations {
+		t.Run(test.name, func(t *testing.T) {
+			changed := base
+			test.mutate(&changed)
+			_, changedKey, changedFingerprint, err := normalizeHostPrepareRegisterRequest(changed)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if changedKey != key || changedFingerprint == fingerprint {
+				t.Fatalf("key=%q fingerprint=%q want same key and changed fingerprint", changedKey, changedFingerprint)
+			}
+		})
+	}
+
+	changedIdentity := base
+	changedIdentity.MainRequestID = "request-2"
+	_, changedKey, _, err := normalizeHostPrepareRegisterRequest(changedIdentity)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if changedKey == key {
+		t.Fatal("main request identity did not change prepare key")
+	}
+
+	upper := base
+	upper.SettingsSnapshotDigest = strings.ToUpper(upper.SettingsSnapshotDigest)
+	upper.SemanticPayloadHash = strings.ToUpper(upper.SemanticPayloadHash)
+	_, upperKey, upperFingerprint, err := normalizeHostPrepareRegisterRequest(upper)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if upperKey != key || upperFingerprint != fingerprint {
+		t.Fatalf("uppercase digest normalization key=%q fingerprint=%q", upperKey, upperFingerprint)
