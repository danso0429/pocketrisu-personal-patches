+	}
+	backend, err := s.pocketRisuExecutionBackendSnapshot()
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", errPocketRisuExecutionBackendUnavailable, err)
 	}
+	return s.HostExecutionContexts.capture(request, backend)
 }
 
