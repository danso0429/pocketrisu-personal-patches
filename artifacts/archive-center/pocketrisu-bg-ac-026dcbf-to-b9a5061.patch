+func cloneHostExecutionResult(value *store.HostSessionExecutionResult) *store.HostSessionExecutionResult {
+	if value == nil {
+		return nil
+	}
+	copyValue := *value
+	return &copyValue
+}
+
+func cloneHostPrepareResult(value *store.HostPrepareResult) *store.HostPrepareResult {
+	if value == nil {
+		return nil
+	}
+	copyValue := *value
+	return &copyValue
+}
