+				result *HostPrepareResult
+				err    error
+			}
+			attempts := []registrationAttempt{{}, {}}
+			startRegistration := make(chan struct{})
+			var registrationWaitGroup sync.WaitGroup
+			for index := range attempts {
+				registrationWaitGroup.Add(1)
+				go func(index int) {
+					defer registrationWaitGroup.Done()
+					<-startRegistration
+					attempts[index].result, attempts[index].err = runtimeStore.RegisterHostPrepare(ctx, request)
+				}(index)
+			}
+			close(startRegistration)
+			registrationWaitGroup.Wait()
+			nonReused := 0
+			for index, attempt := range attempts {
+				if attempt.err != nil || attempt.result.Status != HostPrepareStatusRegistered {
+					t.Fatalf("concurrent registration %d result=%+v err=%v", index, attempt.result, attempt.err)
+				}
+				if !attempt.result.Reused {
+					nonReused++
+				}
+			}
+			if nonReused != 1 {
+				t.Fatalf("concurrent registration owners=%d want=1", nonReused)
+			}
+			registered = attempts[0].result
+		} else {
+			registered, err = runtimeStore.RegisterHostPrepare(ctx, request)
+			if err != nil || registered.Status != HostPrepareStatusRegistered || registered.Reused {
+				t.Fatalf("%s registration=%+v err=%v", label, registered, err)
+			}
+		}
+		replayed, err := runtimeStore.RegisterHostPrepare(ctx, request)
+		if err != nil || !replayed.Reused || replayed.PrepareKey != registered.PrepareKey {
+			t.Fatalf("%s registration replay=%+v err=%v", label, replayed, err)
+		}
+		return HostPrepareLookup{
+			PrepareKey: registered.PrepareKey, RequestFingerprint: registered.RequestFingerprint,
+		}, claim.ClaimEpoch, request
+	}
+	start := func(label string, lookup HostPrepareLookup) *HostPrepareResult {
+		result, err := runtimeStore.StartHostPrepare(ctx, HostPrepareStartRequest{
+			HostPrepareLookup: lookup, ExternalOperationID: "external-" + label + "-" + suffix,
+		})
+		if err != nil || result.Status != HostPrepareStatusRunning || result.RunEpoch != 1 || !result.StartAuthorized {
+			t.Fatalf("%s prepare start=%+v err=%v", label, result, err)
+		}
+		return result
+	}
+	skip := func(label string, lookup HostPrepareLookup) *HostPrepareResult {
+		result, err := runtimeStore.SkipHostPrepare(ctx, HostPrepareSkipRequest{
+			HostPrepareLookup: lookup,
+			SkipEventID:       "skip-" + label + "-" + suffix,
+			SkipReason:        "node_disposition_skipped",
+		})
+		if err != nil || result.Status != HostPrepareStatusSkipped || !result.ExecutionClaimReleased {
+			t.Fatalf("%s prepare skip=%+v err=%v", label, result, err)
+		}
+		return result
+	}
+
+	readyLookup, _, readyRegistration := acquireAndRegister("c")
+	changedRegistration := readyRegistration
+	changedRegistration.SettingsSnapshotDigest = strings.Repeat("c", 64)
+	registrationConflict, err := runtimeStore.RegisterHostPrepare(ctx, changedRegistration)
+	if err != nil || registrationConflict.Status != HostPrepareStatusConflict ||
+		registrationConflict.ReasonCode != "prepare_key_conflict" {
+		t.Fatalf("changed registration conflict=%+v err=%v", registrationConflict, err)
+	}
+	type attempt struct {
+		result *HostPrepareResult
+		err    error
+	}
+	readyStarts := []attempt{{}, {}}
+	startReadyRace := make(chan struct{})
+	var readyWaitGroup sync.WaitGroup
+	for index := range readyStarts {
+		readyWaitGroup.Add(1)
+		go func(index int) {
+			defer readyWaitGroup.Done()
+			<-startReadyRace
+			readyStarts[index].result, readyStarts[index].err = runtimeStore.StartHostPrepare(ctx, HostPrepareStartRequest{
+				HostPrepareLookup: readyLookup, ExternalOperationID: "external-c-" + suffix,
+			})
+		}(index)
+	}
+	close(startReadyRace)
+	readyWaitGroup.Wait()
+	nonReusedStarts := 0
+	authorizedStarts := 0
+	for index, attempt := range readyStarts {
+		if attempt.err != nil || attempt.result.Status != HostPrepareStatusRunning || attempt.result.RunEpoch != 1 {
+			t.Fatalf("concurrent ready start %d result=%+v err=%v", index, attempt.result, attempt.err)
+		}
+		if !attempt.result.Reused {
+			nonReusedStarts++
+		}
+		if attempt.result.StartAuthorized {
+			authorizedStarts++
+		}
+	}
+	if nonReusedStarts != 1 || authorizedStarts != 1 {
+		t.Fatalf("concurrent prepare start owners/authorized=%d/%d want=1/1", nonReusedStarts, authorizedStarts)
+	}
+	readyStart := readyStarts[0].result
+	readyJSON, readyHash := hostPrepareReadyResult(`{"status":"ready","plan":{"kind":"synthetic"}}`)
+	ready, err := runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+		HostPrepareLookup: readyLookup, RunEpoch: readyStart.RunEpoch,
+		ResultJSON: readyJSON, ResultHash: readyHash,
+	})
+	if err != nil || ready.Status != HostPrepareStatusReady || ready.ResultHash != readyHash {
+		t.Fatalf("ready completion=%+v err=%v", ready, err)
+	}
+	reopen()
+	recoveredReady, err := runtimeStore.GetHostPrepare(ctx, readyLookup)
+	if err != nil || recoveredReady.Status != HostPrepareStatusReady || recoveredReady.ResultJSON != readyJSON {
+		t.Fatalf("ready recovery=%+v err=%v", recoveredReady, err)
+	}
+	readyReplay, err := runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+		HostPrepareLookup: readyLookup, RunEpoch: readyStart.RunEpoch,
+		ResultJSON: readyJSON, ResultHash: readyHash,
+	})
+	if err != nil || !readyReplay.Reused || readyReplay.Status != HostPrepareStatusReady {
+		t.Fatalf("ready replay=%+v err=%v", readyReplay, err)
+	}
+	skip("c", readyLookup)
+
+	unknownLookup, _, _ := acquireAndRegister("d")
+	unknownStart := start("d", unknownLookup)
+	reopen()
+	running, err := runtimeStore.GetHostPrepare(ctx, unknownLookup)
+	if err != nil || running.Status != HostPrepareStatusRunning || running.RunEpoch != unknownStart.RunEpoch {
+		t.Fatalf("running restart recovery=%+v err=%v", running, err)
+	}
+	unknown, err := runtimeStore.MarkHostPrepareOutcomeUnknown(ctx, HostPrepareOutcomeUnknownRequest{
+		HostPrepareLookup: unknownLookup, RunEpoch: unknownStart.RunEpoch,
+	})
+	if err != nil || unknown.Status != HostPrepareStatusOutcomeUnknown ||
+		unknown.ExternalCallDisposition != "unknown" {
+		t.Fatalf("outcome unknown=%+v err=%v", unknown, err)
+	}
+	lateUnknown, err := runtimeStore.CompleteHostPrepare(ctx, HostPrepareCompleteRequest{
+		HostPrepareLookup: unknownLookup, RunEpoch: unknownStart.RunEpoch,
+		ResultJSON: readyJSON, ResultHash: readyHash,
+	})
+	if err != nil || lateUnknown.Status != HostPrepareStatusOutcomeUnknown || lateUnknown.ResultJSON != "" {
+		t.Fatalf("late unknown result=%+v err=%v", lateUnknown, err)
+	}
