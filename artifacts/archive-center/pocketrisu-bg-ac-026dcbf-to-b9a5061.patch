+func pocketRisuHostPreparedResultForTest(t *testing.T, server *Server, reference pocketRisuHostPrepareReference, payload any) json.RawMessage {
+	t.Helper()
+	prepare, err := server.Store.(store.HostPrepareRegistryStore).GetHostPrepare(context.Background(), store.HostPrepareLookup{
+		PrepareKey: reference.PrepareKey, RequestFingerprint: reference.RequestFingerprint,
+	})
+	if err != nil {
+		t.Fatalf("get prepare result fixture: %v", err)
+	}
+	assembled, err := json.Marshal(payload)
+	if err != nil {
+		t.Fatalf("marshal assembled payload: %v", err)
+	}
+	digest := sha256.Sum256(assembled)
+	encoded, err := json.Marshal(pocketRisuHostPreparedResult{
+		ContractVersion:        pocketRisuHostPreparedResultVersion,
+		Status:                 "ready",
+		PayloadStage:           "archive_center_prepare_response",
+		ExecutionContextID:     prepare.ExecutionContextID,
+		SettingsSnapshotDigest: prepare.SettingsSnapshotDigest,
+		InputReceiptID:         prepare.InputReceiptID,
+		SourceRevision:         prepare.SourceRevision,
+		SemanticPayloadHash:    prepare.SemanticPayloadHash,
+		RequestType:            prepare.RequestType,
+		ProtocolVersion:        prepare.ProtocolVersion,
+		AssembledPayload:       assembled,
+		AssembledPayloadSHA256: hex.EncodeToString(digest[:]),
+	})
+	if err != nil {
+		t.Fatalf("marshal prepared result: %v", err)
+	}
+	return encoded
+}
