+func TestHostPrepareMariaDBReadyUnknownFailureAndSkipRaceSurviveRestart(t *testing.T) {
+	if os.Getenv("AC_HOST_PREPARE_TEST_DISPOSABLE") != "YES" {
+		t.Skip("requires an explicitly disposable MariaDB")
+	}
+	dsn := strings.TrimSpace(os.Getenv("AC_HOST_PREPARE_TEST_DSN"))
