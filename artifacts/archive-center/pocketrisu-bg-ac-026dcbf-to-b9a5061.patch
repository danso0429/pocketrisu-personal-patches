+	return sqlmock.NewRows([]string{
+		"contract_version", "stream_key", "event_id", "seq", "previous_seq",
+		"operation_id", "event_kind", "before_revision", "after_revision",
+		"message_identities_json", "source_generation", "committed_at", "payload_ref",
+		"event_fingerprint", "safety_state", "safety_disposition",
+	})
+}
