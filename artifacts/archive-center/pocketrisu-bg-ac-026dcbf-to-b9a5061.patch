+	reopen()
+	recoveredSkip, err := runtimeStore.GetHostPrepare(ctx, unknownLookup)
+	if err != nil || recoveredSkip.Status != HostPrepareStatusSkipped || !recoveredSkip.ExecutionClaimReleased {
+		t.Fatalf("skip recovery=%+v err=%v", recoveredSkip, err)
+	}
+	unknownSkipReplay, err := runtimeStore.SkipHostPrepare(ctx, HostPrepareSkipRequest{
+		HostPrepareLookup: unknownLookup, SkipEventID: unknownSkip.SkipEventID, SkipReason: unknownSkip.SkipReason,
+	})
+	if err != nil || !unknownSkipReplay.Reused || !unknownSkipReplay.ExecutionClaimReleased {
+		t.Fatalf("skip replay=%+v err=%v", unknownSkipReplay, err)
+	}
+
+	failureLookup, _, _ := acquireAndRegister("e")
+	failureStart := start("e", failureLookup)
+	failed, err := runtimeStore.FailHostPrepare(ctx, HostPrepareFailureRequest{
+		HostPrepareLookup: failureLookup, RunEpoch: failureStart.RunEpoch,
+		FailureCode: "provider_not_started", Retryable: true, ExternalCallStarted: false,
