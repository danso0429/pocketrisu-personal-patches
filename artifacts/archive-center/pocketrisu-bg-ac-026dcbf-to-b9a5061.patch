+func (s *Server) handlePocketRisuHostCapabilities(w http.ResponseWriter, _ *http.Request) {
+	_, _, storesReady := s.pocketRisuHostStores()
+	_, recoveryReady := s.Store.(store.HostPrepareRecoveryStore)
+	_, restartReady := s.Store.(store.HostPrepareRestartRecoveryStore)
+	if !storesReady || !recoveryReady || !restartReady || s.HostExecutionContexts == nil {
+		writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_unavailable", "PocketRisu host owners are unavailable")
+		return
+	}
+	writeJSON(w, http.StatusOK, pocketRisuHostCapabilitiesResponse{
+		ContractVersion:           pocketRisuHostCapabilitiesVersion,
+		TransportVersion:          1,
+		ExecutionVersion:          1,
+		PrepareVersion:            1,
+		ExecutionContextVersion:   1,
+		ContextReleaseVersion:     1,
+		ProductionConsumerVersion: 0,
+		ProductActivation:         false,
+	})
+}
+
+func (s *Server) handlePocketRisuHostExecutionAcquire(w http.ResponseWriter, r *http.Request) {
+	var request pocketRisuHostExecutionRequest
+	if !decodePocketRisuHostRequest(w, r, &request) || !requirePocketRisuHostTransportVersion(w, request.ContractVersion) {
+		return
+	}
+	executions, _, ok := s.pocketRisuHostStores()
+	if !ok {
+		writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_store_unavailable", "PocketRisu host store is unavailable")
+		return
+	}
+	result, err := executions.AcquireHostSessionExecution(r.Context(), store.HostSessionExecutionAcquireRequest{
+		HostInstanceID:        request.HostInstanceID,
+		StableCharacterID:     request.StableCharacterID,
+		HostChatID:            request.HostChatID,
+		OperationID:           request.OperationID,
+		ExpectedBindingEpoch:  request.ExpectedBindingEpoch,
+		RequiredHostChangeSeq: request.RequiredHostChangeSeq,
+	})
+	if err != nil {
+		writePocketRisuHostStoreError(w, err)
+		return
+	}
+	writeJSON(w, pocketRisuHostExecutionHTTPStatus(result), result)
+}
+
+func (s *Server) handlePocketRisuHostContextCapture(w http.ResponseWriter, r *http.Request) {
+	var request pocketRisuHostContextCaptureRequest
+	if !decodePocketRisuHostRequest(w, r, &request) || !requirePocketRisuHostTransportVersion(w, request.ContractVersion) {
+		return
+	}
+	executions, prepares, ok := s.pocketRisuHostStores()
+	if !ok || s.HostExecutionContexts == nil {
+		writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_store_unavailable", "PocketRisu host owners are unavailable")
+		return
+	}
+	identity := request.Context.Identity
+	execution, err := executions.GetHostSessionExecution(r.Context(), identity.HostInstanceID, identity.OperationID)
+	if err != nil {
+		writePocketRisuHostStoreError(w, err)
+		return
+	}
+	if !pocketRisuHostExecutionMatchesIdentity(execution, identity) {
+		writeError(w, http.StatusConflict, "pocketrisu_host_claim_mismatch", "PocketRisu execution claim does not match the context owner")
+		return
+	}
+	recovery, supported := s.Store.(store.HostPrepareRecoveryStore)
+	if !supported {
+		writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_recovery_unavailable", "PocketRisu host recovery store is unavailable")
+		return
+	}
+	prepareKey := store.HostPrepareKey(store.HostPrepareIdentity{
+		HostInstanceID: identity.HostInstanceID, StableCharacterID: identity.StableCharacterID,
+		HostChatID: identity.HostChatID, BindingEpoch: identity.BindingEpoch,
+		OperationID: identity.OperationID, ClaimEpoch: identity.ClaimEpoch,
+		MainRequestID: request.Prepare.MainRequestID,
+	})
+	existing, recoveryErr := recovery.GetHostPrepareByKey(r.Context(), prepareKey)
+	switch {
+	case recoveryErr == nil:
+		if !pocketRisuHostPrepareMatchesCaptureRequest(existing, execution, request) {
+			writeError(w, http.StatusConflict, "pocketrisu_host_prepare_recovery_conflict", "durable PocketRisu prepare does not match the capture request")
+			return
+		}
+		material, recoveredContext, loadErr := s.HostExecutionContexts.load(existing.ExecutionContextID, identity)
+		if loadErr != nil {
+			writeError(w, http.StatusBadRequest, "pocketrisu_execution_context_invalid", "PocketRisu execution context identity is invalid")
+			return
+		}
+		if material != nil {
+			if !pocketRisuHostCaptureDeviceMatchesMaterial(request.Context, *material) {
+				writeError(w, http.StatusConflict, "pocketrisu_execution_context_fingerprint_conflict", "PocketRisu execution context changed under the same identity")
+				return
+			}
+			if _, resolveErr := resolvePocketRisuExecutionContext(*material); resolveErr != nil {
+				writeError(w, http.StatusInternalServerError, "pocketrisu_execution_context_resolution_failed", "PocketRisu execution context could not be resolved")
+				return
+			}
+		} else if recoveredContext != nil && recoveredContext.Status == pocketRisuExecutionContextStatusMissing {
+			recoveredContext.ExecutionContextID = existing.ExecutionContextID
+			recoveredContext.SettingsDigest = existing.SettingsSnapshotDigest
+			recoveredContext.ReasonCode = "settings_context_unavailable"
+			recoveredContext.Reused = true
+		}
+		responseStatus := pocketRisuExecutionContextHTTPStatus(recoveredContext)
+		if recoveredContext != nil && recoveredContext.Status == pocketRisuExecutionContextStatusCaptured {
+			responseStatus = pocketRisuHostPrepareHTTPStatus(existing)
+		}
+		writeJSON(w, responseStatus, pocketRisuHostContextCaptureResponse{
+			ContractVersion: pocketRisuHostTransportContractVersion,
+			Execution:       execution,
+			Context:         recoveredContext,
+			Prepare:         existing,
+		})
+		return
+	case !errors.Is(recoveryErr, store.ErrNotFound):
+		writePocketRisuHostStoreError(w, recoveryErr)
+		return
+	}
+	contextResult, err := s.capturePocketRisuExecutionContext(request.Context)
+	if err != nil {
+		if errors.Is(err, errPocketRisuExecutionBackendUnavailable) {
+			writeError(w, http.StatusServiceUnavailable, "pocketrisu_execution_context_capture_unavailable", "PocketRisu execution backend snapshot is unavailable")
+			return
+		}
+		writeError(w, http.StatusBadRequest, "pocketrisu_execution_context_invalid", "PocketRisu execution context is invalid")
+		return
+	}
+	if contextResult.Status != pocketRisuExecutionContextStatusCaptured {
+		writeJSON(w, pocketRisuExecutionContextHTTPStatus(contextResult), pocketRisuHostContextCaptureResponse{
+			ContractVersion: pocketRisuHostTransportContractVersion,
+			Execution:       execution,
+			Context:         contextResult,
+		})
+		return
+	}
+	prepareResult, err := prepares.RegisterHostPrepare(r.Context(), store.HostPrepareRegisterRequest{
+		HostPrepareIdentity: store.HostPrepareIdentity{
+			HostInstanceID:    identity.HostInstanceID,
+			StableCharacterID: identity.StableCharacterID,
+			HostChatID:        identity.HostChatID,
+			BindingEpoch:      identity.BindingEpoch,
+			OperationID:       identity.OperationID,
+			ClaimEpoch:        identity.ClaimEpoch,
+			MainRequestID:     request.Prepare.MainRequestID,
+		},
+		ExecutionContextID:     contextResult.ExecutionContextID,
+		SettingsSnapshotDigest: contextResult.SettingsDigest,
+		InputReceiptID:         request.Prepare.InputReceiptID,
+		SourceRevision:         request.Prepare.SourceRevision,
+		SemanticPayloadHash:    request.Prepare.SemanticPayloadHash,
+		RequestType:            request.Prepare.RequestType,
+		ProtocolVersion:        request.Prepare.ProtocolVersion,
+	})
+	if err != nil {
+		if !contextResult.Reused {
+			s.HostExecutionContexts.discard(contextResult.ExecutionContextID, identity)
+		}
+		writePocketRisuHostStoreError(w, err)
+		return
+	}
+	if !pocketRisuHostPrepareRegistered(prepareResult) {
+		if !contextResult.Reused {
+			s.HostExecutionContexts.discard(contextResult.ExecutionContextID, identity)
+		}
+		contextResult = newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusConflict,
+			"execution_context_prepare_registration_conflict",
+		)
+	}
+	writeJSON(w, pocketRisuHostPrepareHTTPStatus(prepareResult), pocketRisuHostContextCaptureResponse{
+		ContractVersion: pocketRisuHostTransportContractVersion,
+		Execution:       execution,
+		Context:         contextResult,
+		Prepare:         prepareResult,
+	})
+}
