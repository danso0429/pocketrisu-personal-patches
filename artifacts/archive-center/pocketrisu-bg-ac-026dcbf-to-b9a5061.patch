+func pocketRisuHostConsumerStageAllowsPrepare(stage, status string) bool {
+	switch strings.TrimSpace(stage) {
+	case pocketRisuHostConsumerStagePrepare, pocketRisuHostConsumerStageSearch:
+		return status == store.HostPrepareStatusRunning
+	case pocketRisuHostConsumerStageMain, pocketRisuHostConsumerStageComplete:
+		return status == store.HostPrepareStatusReady
+	default:
+		return false
+	}
+}
