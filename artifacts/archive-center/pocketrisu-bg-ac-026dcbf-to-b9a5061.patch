+func TestPocketRisuExecutionContextConcurrentCaptureHasOneOwner(t *testing.T) {
+	registry := deterministicPocketRisuContextRegistry()
+	request := validPocketRisuExecutionContextRequest("operation-concurrent", "SECRET")
+	backend := validPocketRisuExecutionBackendSnapshot("BACKEND")
+	const callers = 16
+	type outcome struct {
+		result *pocketRisuExecutionContextResult
+		err    error
+	}
+	start := make(chan struct{})
+	results := make(chan outcome, callers)
+	var workers sync.WaitGroup
+	for range callers {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			<-start
+			result, err := registry.capture(request, backend)
+			results <- outcome{result: result, err: err}
+		}()
+	}
+	close(start)
+	workers.Wait()
+	close(results)
+	contextID := ""
+	owners := 0
+	for item := range results {
+		if item.err != nil || item.result == nil || item.result.Status != pocketRisuExecutionContextStatusCaptured {
+			t.Fatalf("capture outcome = %+v, %v", item.result, item.err)
+		}
+		if contextID == "" {
+			contextID = item.result.ExecutionContextID
+		}
+		if item.result.ExecutionContextID != contextID {
+			t.Fatalf("context ID split: %q != %q", item.result.ExecutionContextID, contextID)
+		}
+		if !item.result.Reused {
+			owners++
+		}
+	}
+	if owners != 1 {
+		t.Fatalf("capture owners = %d, want 1", owners)
+	}
+	contexts, _, _, _ := registry.stats()
+	if contexts != 1 {
+		t.Fatalf("stored contexts = %d, want 1", contexts)
+	}
+}
