+func (s *pocketRisuHostTestStore) AcquireHostSessionExecution(_ context.Context, request store.HostSessionExecutionAcquireRequest) (*store.HostSessionExecutionResult, error) {
+	s.acquireRequests = append(s.acquireRequests, request)
