+func pocketRisuHostPrepareMatchesCaptureRequest(
+	result *store.HostPrepareResult,
+	execution *store.HostSessionExecutionResult,
+	request pocketRisuHostContextCaptureRequest,
+) bool {
+	identity := request.Context.Identity
+	return result != nil && execution != nil &&
+		result.PrepareKey == store.HostPrepareKey(store.HostPrepareIdentity{
+			HostInstanceID: identity.HostInstanceID, StableCharacterID: identity.StableCharacterID,
+			HostChatID: identity.HostChatID, BindingEpoch: identity.BindingEpoch,
+			OperationID: identity.OperationID, ClaimEpoch: identity.ClaimEpoch,
+			MainRequestID: request.Prepare.MainRequestID,
+		}) &&
+		result.HostInstanceID == strings.TrimSpace(identity.HostInstanceID) &&
+		result.StableCharacterID == strings.TrimSpace(identity.StableCharacterID) &&
+		result.HostChatID == strings.TrimSpace(identity.HostChatID) &&
+		result.ResolvedSessionID == execution.ResolvedSessionID &&
+		result.BindingEpoch == strings.TrimSpace(identity.BindingEpoch) &&
+		result.OperationID == strings.TrimSpace(identity.OperationID) &&
+		result.ClaimEpoch == identity.ClaimEpoch &&
+		result.MainRequestID == strings.TrimSpace(request.Prepare.MainRequestID) &&
+		result.InputReceiptID == strings.TrimSpace(request.Prepare.InputReceiptID) &&
+		result.SourceRevision == strings.TrimSpace(request.Prepare.SourceRevision) &&
+		result.SemanticPayloadHash == strings.ToLower(strings.TrimSpace(request.Prepare.SemanticPayloadHash)) &&
+		result.RequestType == strings.ToLower(strings.TrimSpace(request.Prepare.RequestType)) &&
+		result.ProtocolVersion == strings.TrimSpace(request.Prepare.ProtocolVersion)
+}
+
+func pocketRisuHostCaptureDeviceMatchesMaterial(
+	request pocketRisuExecutionContextCaptureRequest,
+	material pocketRisuExecutionContextMaterial,
+) bool {
+	normalized, err := normalizePocketRisuExecutionContextCapture(request)
+	if err != nil {
+		return false
+	}
+	requested, err := json.Marshal(normalized.Device)
+	if err != nil {
+		return false
+	}
+	captured, err := json.Marshal(material.Device)
+	return err == nil && bytes.Equal(requested, captured)
+}
