+func (s *Server) handlePocketRisuHostExecutionSettle(w http.ResponseWriter, r *http.Request) {
+	var request pocketRisuHostExecutionSettleRequest
+	if !decodePocketRisuHostRequest(w, r, &request) || !requirePocketRisuHostTransportVersion(w, request.ContractVersion) {
+		return
+	}
+	executions, prepares, ok := s.pocketRisuHostStores()
+	if !ok {
+		writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_store_unavailable", "PocketRisu host store is unavailable")
+		return
+	}
+	current, _, ok := s.lookupPocketRisuHostPrepareContext(w, r, prepares, request.pocketRisuHostPrepareReference, true)
+	if !ok {
+		return
+	}
+	result, err := executions.SettleHostSessionExecution(r.Context(), store.HostSessionExecutionSettleRequest{
+		HostInstanceID:       request.Identity.HostInstanceID,
+		StableCharacterID:    request.Identity.StableCharacterID,
+		HostChatID:           request.Identity.HostChatID,
+		OperationID:          request.Identity.OperationID,
+		ExpectedBindingEpoch: request.Identity.BindingEpoch,
+		ClaimEpoch:           request.Identity.ClaimEpoch,
+		EndEventID:           request.EndEventID,
+		EndReason:            request.EndReason,
+		SourceDisposition:    request.SourceDisposition,
+	})
+	if err != nil {
+		writePocketRisuHostStoreError(w, err)
+		return
+	}
+	if !pocketRisuHostExecutionOwnerMatches(result, request.Identity) || !pocketRisuHostPrepareMatchesReference(current, request.pocketRisuHostPrepareReference) {
+		writeError(w, http.StatusConflict, "pocketrisu_host_execution_owner_conflict", "PocketRisu execution owner changed during settle")
+		return
+	}
+	var contextResult *pocketRisuExecutionContextResult
+	if result.Status == store.HostSessionExecutionStatusTerminal {
+		contextResult, err = s.HostExecutionContexts.release(request.ExecutionContextID, request.Identity, result.EndReason)
+		if err != nil {
+			writeError(w, http.StatusInternalServerError, "pocketrisu_execution_context_release_failed", "PocketRisu execution context release failed")
+			return
+		}
+	}
+	writeJSON(w, pocketRisuHostExecutionHTTPStatus(result), pocketRisuHostSettleResponse{
+		ContractVersion: pocketRisuHostTransportContractVersion,
+		Execution:       result,
+		Context:         contextResult,
+	})
+}
