diff --git a/go-service/internal/store/mariadb_session_execution.go b/go-service/internal/store/mariadb_session_execution.go
new file mode 100644
index 0000000000000000000000000000000000000000..b2eb40e169051800a6eccb7fc3749f01a718edb5
--- /dev/null
+++ b/go-service/internal/store/mariadb_session_execution.go
@@ -0,0 +1,836 @@
+package store
+
+import (
+	"context"
+	"crypto/sha256"
+	"database/sql"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/go-sql-driver/mysql"
+)
+
+const (
+	HostSessionExecutionContractVersion = "host_session_execution.v1"
+
+	HostSessionExecutionStatusAcquired       = "acquired"
+	HostSessionExecutionStatusWait           = "wait"
+	HostSessionExecutionStatusBindingChanged = "binding_changed"
+	HostSessionExecutionStatusTerminal       = "terminal"
+	HostSessionExecutionStatusRejected       = "rejected"
+
+	hostSessionExecutionTransactionMaxAttempts = 3
+)
+
+var ErrHostSessionExecutionInvalid = errors.New("invalid host session execution request")
+
+// HostSessionExecutionAcquireRequest is the store-side form of the proposed
+// server-host acquire contract. The HTTP surface remains unmounted until the
+// authenticated PocketRisu host capability is implemented.
+type HostSessionExecutionAcquireRequest struct {
+	HostInstanceID        string
+	StableCharacterID     string
+	HostChatID            string
+	OperationID           string
+	ExpectedBindingEpoch  string
+	RequiredHostChangeSeq uint64
+}
+
+type HostSessionExecutionSettleRequest struct {
+	HostInstanceID       string
+	StableCharacterID    string
+	HostChatID           string
+	OperationID          string
+	ExpectedBindingEpoch string
+	ClaimEpoch           uint64
+	EndEventID           string
+	EndReason            string
+	SourceDisposition    string
+}
+
+type HostSessionExecutionResult struct {
+	ContractVersion       string `json:"contract_version"`
+	Status                string `json:"status"`
+	ReasonCode            string `json:"reason_code"`
+	HostInstanceID        string `json:"host_instance_id,omitempty"`
+	StableCharacterID     string `json:"stable_character_id,omitempty"`
+	HostChatID            string `json:"host_chat_id,omitempty"`
+	ResolvedSessionID     string `json:"resolved_session_id,omitempty"`
+	BindingEpoch          string `json:"binding_epoch,omitempty"`
+	OperationID           string `json:"operation_id,omitempty"`
+	ClaimEpoch            uint64 `json:"claim_epoch,omitempty"`
+	Phase                 string `json:"phase,omitempty"`
+	BlockingOperationID   string `json:"blocking_operation_id,omitempty"`
+	RequiredHostChangeSeq uint64 `json:"required_host_change_seq"`
+	IngestedHostChangeSeq uint64 `json:"ingested_host_change_seq"`
+	SafeHostChangeSeq     uint64 `json:"safe_host_change_seq"`
+	EndEventID            string `json:"end_event_id,omitempty"`
+	EndReason             string `json:"end_reason,omitempty"`
+	SourceDisposition     string `json:"source_disposition,omitempty"`
+	Reused                bool   `json:"reused"`
+}
+
+type HostSessionExecutionStore interface {
+	AcquireHostSessionExecution(context.Context, HostSessionExecutionAcquireRequest) (*HostSessionExecutionResult, error)
+	GetHostSessionExecution(context.Context, string, string) (*HostSessionExecutionResult, error)
+	SettleHostSessionExecution(context.Context, HostSessionExecutionSettleRequest) (*HostSessionExecutionResult, error)
+}
+
+var _ HostSessionExecutionStore = (*mariadbStore)(nil)
+
+type hostSessionExecutionSlot struct {
+	ContractVersion         string
+	CanonicalSessionID      string
+	ActiveHostInstanceID    string
+	ActiveStableCharacterID string
+	ActiveHostChatID        string
+	ActiveBindingEpoch      string
+	ActiveOperationID       string
+	ClaimEpoch              uint64
+	Phase                   string
+	RequiredHostChangeSeq   uint64
+	IngestedHostChangeSeq   uint64
+	SafeHostChangeSeq       uint64
+}
+
+type hostSessionExecutionOutcome struct {
+	ContractVersion       string
+	HostInstanceID        string
+	StableCharacterID     string
+	HostChatID            string
+	CanonicalSessionID    string
+	BindingEpoch          string
+	OperationID           string
+	ClaimEpoch            uint64
+	EndEventID            string
+	RequestedEndReason    string
+	EndReason             string
+	TerminalPhase         string
+	SourceDisposition     string
+	RequiredHostChangeSeq uint64
+	SafeHostChangeSeq     uint64
+}
+
+type hostSessionExecutionQueryer interface {
+	QueryRowContext(context.Context, string, ...any) *sql.Row
+}
+
+// SessionRouteBindingEpoch turns the durable route identity into an opaque
+// epoch. It changes when the route is recreated, redirected, or explicitly
+// rebound, without exposing host identifiers in the token itself.
+func SessionRouteBindingEpoch(binding SessionRouteBinding) string {
+	seed := strings.Join([]string{
+		binding.ContractVersion,
+		binding.StableCharacterID,
+		binding.HostChatID,
+		binding.CanonicalSessionID,
+		strconv.FormatUint(binding.Revision, 10),
+		binding.CreatedAt.UTC().Format("2006-01-02T15:04:05.000000000Z07:00"),
+	}, "\x1f")
+	sum := sha256.Sum256([]byte(seed))
+	return "binding_v1_" + hex.EncodeToString(sum[:])
+}
+
+func (m *mariadbStore) AcquireHostSessionExecution(ctx context.Context, request HostSessionExecutionAcquireRequest) (*HostSessionExecutionResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	req, err := normalizeHostSessionExecutionAcquireRequest(request)
+	if err != nil {
+		return nil, err
+	}
+	for attempt := 1; attempt <= hostSessionExecutionTransactionMaxAttempts; attempt++ {
+		result, err := m.acquireHostSessionExecutionOnce(ctx, req)
+		if err == nil {
+			return result, nil
+		}
+		if !isRetryableHostCoordinationTransactionError(err) || attempt == hostSessionExecutionTransactionMaxAttempts {
+			return nil, err
+		}
+		if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+			return nil, err
+		}
+	}
+	return nil, errors.New("host session execution acquire exhausted without result")
+}
+
+func (m *mariadbStore) acquireHostSessionExecutionOnce(ctx context.Context, req HostSessionExecutionAcquireRequest) (*HostSessionExecutionResult, error) {
+	tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelSerializable})
+	if err != nil {
+		return nil, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_ = tx.Rollback()
+		}
+	}()
+	finish := func(result *HostSessionExecutionResult) (*HostSessionExecutionResult, error) {
+		if err := tx.Commit(); err != nil {
+			return nil, err
+		}
+		committed = true
+		return result, nil
+	}
+
+	binding, bindingErr := selectSessionRouteBindingTx(ctx, tx, req.StableCharacterID, req.HostChatID, true)
+	if bindingErr != nil && !errors.Is(bindingErr, ErrNotFound) {
+		return nil, bindingErr
+	}
+	if outcome, err := selectHostSessionExecutionOutcomeByOperation(ctx, tx, req.HostInstanceID, req.OperationID, true); err == nil {
+		if !hostSessionExecutionOutcomeMatchesAcquire(outcome, req) {
+			return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "operation_identity_conflict"))
+		}
+		return finish(hostSessionExecutionOutcomeResult(outcome, true))
+	} else if !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+	if errors.Is(bindingErr, ErrNotFound) {
+		return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "binding_not_found"))
+	}
+	if !hostSessionExecutionBindingUsable(binding) {
+		return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "binding_not_active"))
+	}
+	bindingEpoch := SessionRouteBindingEpoch(*binding)
+	if req.ExpectedBindingEpoch != bindingEpoch {
+		result := newHostSessionExecutionResult(HostSessionExecutionStatusBindingChanged, "expected_binding_epoch_mismatch")
+		result.ResolvedSessionID = binding.CanonicalSessionID
+		result.BindingEpoch = bindingEpoch
+		return finish(result)
+	}
+	changeStream, err := selectHostChangeStreamForExecutionTx(ctx, tx, req, binding.CanonicalSessionID)
+	if err != nil {
+		return nil, err
+	}
+
+	if active, err := selectActiveHostSessionExecutionByOperation(ctx, tx, req.HostInstanceID, req.OperationID, true); err == nil {
+		if !hostSessionExecutionSlotMatchesAcquire(active, req) {
+			return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "operation_identity_conflict"))
+		}
+		if active.CanonicalSessionID != binding.CanonicalSessionID || active.ActiveBindingEpoch != bindingEpoch {
+			result := hostSessionExecutionSlotResult(active, HostSessionExecutionStatusBindingChanged, "active_binding_changed", true)
+			result.BindingEpoch = bindingEpoch
+			result.ResolvedSessionID = binding.CanonicalSessionID
+			return finish(result)
+		}
+		return finish(hostSessionExecutionSlotResult(active, HostSessionExecutionStatusAcquired, "active_execution_idempotent", true))
+	} else if !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+
+	if _, err := tx.ExecContext(ctx, `
+		INSERT INTO host_session_execution_slots (
+			canonical_session_id, contract_version, phase
+		) VALUES (?, ?, 'idle')
+		ON DUPLICATE KEY UPDATE canonical_session_id = VALUES(canonical_session_id)
+	`, binding.CanonicalSessionID, HostSessionExecutionContractVersion); err != nil {
+		return nil, err
+	}
+	slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, binding.CanonicalSessionID, true)
+	if err != nil {
+		return nil, err
+	}
+	if slot.ContractVersion != HostSessionExecutionContractVersion {
+		return nil, fmt.Errorf("unsupported host session execution slot contract %q", slot.ContractVersion)
+	}
+	if slot.ActiveOperationID != "" {
+		result := hostSessionExecutionSlotResult(slot, HostSessionExecutionStatusWait, "session_execution_active", false)
+		result.ResolvedSessionID = binding.CanonicalSessionID
+		result.BindingEpoch = bindingEpoch
+		return finish(result)
+	}
+	if slot.Phase != "idle" {
+		return nil, fmt.Errorf("host session execution slot has no owner but phase is %q", slot.Phase)
+	}
+	slot.IngestedHostChangeSeq = changeStream.IngestedSeq
+	slot.SafeHostChangeSeq = changeStream.SafeSeq
+	if changeStream.SafeSeq < req.RequiredHostChangeSeq {
+		result := hostSessionExecutionSlotResult(slot, HostSessionExecutionStatusWait, "host_changes_not_safe", false)
+		result.RequiredHostChangeSeq = req.RequiredHostChangeSeq
+		return finish(result)
+	}
+
+	if slot.ClaimEpoch == ^uint64(0) {
+		return nil, errors.New("host session execution claim epoch exhausted")
+	}
+	claimEpoch := slot.ClaimEpoch + 1
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_session_execution_slots
+		SET contract_version = ?,
+		    active_host_instance_id = ?,
+		    active_stable_character_id = ?,
+		    active_host_chat_id = ?,
+		    active_binding_epoch = ?,
+		    active_operation_id = ?,
+			claim_epoch = ?,
+			phase = 'claimed',
+			required_host_change_seq = ?,
+			ingested_host_change_seq = ?,
+			safe_host_change_seq = ?,
+			claimed_at = UTC_TIMESTAMP(3)
+		WHERE canonical_session_id = ?
+		  AND claim_epoch = ?
+		  AND active_operation_id IS NULL
+	`, HostSessionExecutionContractVersion, req.HostInstanceID, req.StableCharacterID,
+		req.HostChatID, bindingEpoch, req.OperationID, claimEpoch,
+		req.RequiredHostChangeSeq, changeStream.IngestedSeq, changeStream.SafeSeq,
+		binding.CanonicalSessionID, slot.ClaimEpoch)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := write.RowsAffected()
+	if err != nil {
+		return nil, err
+	}
+	if rows != 1 {
+		return nil, errors.New("host session execution acquire lost compare-and-set")
+	}
+
+	result := newHostSessionExecutionResult(HostSessionExecutionStatusAcquired, "execution_claimed")
+	result.ResolvedSessionID = binding.CanonicalSessionID
+	result.BindingEpoch = bindingEpoch
+	result.OperationID = req.OperationID
+	result.ClaimEpoch = claimEpoch
+	result.Phase = "claimed"
+	result.RequiredHostChangeSeq = req.RequiredHostChangeSeq
+	result.IngestedHostChangeSeq = changeStream.IngestedSeq
+	result.SafeHostChangeSeq = changeStream.SafeSeq
+	return finish(result)
+}
+
+func (m *mariadbStore) GetHostSessionExecution(ctx context.Context, hostInstanceID, operationID string) (*HostSessionExecutionResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	hostID, err := normalizeHostSessionExecutionIdentifier("host_instance_id", hostInstanceID, 255)
+	if err != nil {
+		return nil, err
+	}
+	opID, err := normalizeHostSessionExecutionIdentifier("operation_id", operationID, 255)
+	if err != nil {
+		return nil, err
+	}
+
+	tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelRepeatableRead, ReadOnly: true})
+	if err != nil {
+		return nil, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_ = tx.Rollback()
+		}
+	}()
+	finish := func(result *HostSessionExecutionResult) (*HostSessionExecutionResult, error) {
+		if err := tx.Commit(); err != nil {
+			return nil, err
+		}
+		committed = true
+		return result, nil
+	}
+
+	if outcome, err := selectHostSessionExecutionOutcomeByOperation(ctx, tx, hostID, opID, false); err == nil {
+		return finish(hostSessionExecutionOutcomeResult(outcome, true))
+	} else if !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+	active, err := selectActiveHostSessionExecutionByOperation(ctx, tx, hostID, opID, false)
+	if errors.Is(err, ErrNotFound) {
+		return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "execution_not_found"))
+	}
+	if err != nil {
+		return nil, err
+	}
+	binding, bindingErr := selectSessionRouteBindingTx(ctx, tx, active.ActiveStableCharacterID, active.ActiveHostChatID, false)
+	if bindingErr != nil && !errors.Is(bindingErr, ErrNotFound) {
+		return nil, bindingErr
+	}
+	if bindingErr != nil || !hostSessionExecutionBindingUsable(binding) ||
+		binding.CanonicalSessionID != active.CanonicalSessionID ||
+		SessionRouteBindingEpoch(*binding) != active.ActiveBindingEpoch {
+		return finish(hostSessionExecutionSlotResult(active, HostSessionExecutionStatusBindingChanged, "active_binding_changed", true))
+	}
+	return finish(hostSessionExecutionSlotResult(active, HostSessionExecutionStatusAcquired, "execution_active", true))
+}
+
+func (m *mariadbStore) SettleHostSessionExecution(ctx context.Context, request HostSessionExecutionSettleRequest) (*HostSessionExecutionResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	req, err := normalizeHostSessionExecutionSettleRequest(request)
+	if err != nil {
+		return nil, err
+	}
+	for attempt := 1; attempt <= hostSessionExecutionTransactionMaxAttempts; attempt++ {
+		result, err := m.settleHostSessionExecutionOnce(ctx, req)
+		if err == nil {
+			return result, nil
+		}
+		if !isRetryableHostCoordinationTransactionError(err) || attempt == hostSessionExecutionTransactionMaxAttempts {
+			return nil, err
+		}
+		if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+			return nil, err
+		}
+	}
+	return nil, errors.New("host session execution settle exhausted without result")
+}
+
+func (m *mariadbStore) settleHostSessionExecutionOnce(ctx context.Context, req HostSessionExecutionSettleRequest) (*HostSessionExecutionResult, error) {
+	if outcome, err := selectHostSessionExecutionOutcomeByOperation(ctx, m.db, req.HostInstanceID, req.OperationID, false); err == nil {
+		if !hostSessionExecutionOutcomeMatchesSettle(outcome, req) {
+			return newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "terminal_identity_conflict"), nil
+		}
+		return hostSessionExecutionOutcomeResult(outcome, true), nil
+	} else if !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+	preflight, err := selectActiveHostSessionExecutionByOperation(ctx, m.db, req.HostInstanceID, req.OperationID, false)
+	if errors.Is(err, ErrNotFound) {
+		return newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "execution_not_found"), nil
+	}
+	if err != nil {
+		return nil, err
+	}
+
+	tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelSerializable})
+	if err != nil {
+		return nil, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_ = tx.Rollback()
+		}
+	}()
+	finish := func(result *HostSessionExecutionResult) (*HostSessionExecutionResult, error) {
+		if err := tx.Commit(); err != nil {
+			return nil, err
+		}
+		committed = true
+		return result, nil
+	}
+
+	binding, bindingErr := selectSessionRouteBindingTx(ctx, tx, req.StableCharacterID, req.HostChatID, true)
+	if bindingErr != nil && !errors.Is(bindingErr, ErrNotFound) {
+		return nil, bindingErr
+	}
+	if outcome, err := selectHostSessionExecutionOutcomeByOperation(ctx, tx, req.HostInstanceID, req.OperationID, true); err == nil {
+		if !hostSessionExecutionOutcomeMatchesSettle(outcome, req) {
+			return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "terminal_identity_conflict"))
+		}
+		return finish(hostSessionExecutionOutcomeResult(outcome, true))
+	} else if !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+	if endOutcome, err := selectHostSessionExecutionOutcomeByEndEvent(ctx, tx, req.HostInstanceID, req.EndEventID, true); err == nil {
+		if !hostSessionExecutionOutcomeMatchesSettle(endOutcome, req) {
+			return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "end_event_identity_conflict"))
+		}
+		return finish(hostSessionExecutionOutcomeResult(endOutcome, true))
+	} else if !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+
+	slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, preflight.CanonicalSessionID, true)
+	if errors.Is(err, ErrNotFound) {
+		return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "execution_not_found"))
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !hostSessionExecutionSlotMatchesSettle(slot, req) {
+		return finish(newHostSessionExecutionResult(HostSessionExecutionStatusRejected, "stale_claim"))
+	}
+
+	endReason := req.EndReason
+	bindingChanged := bindingErr != nil || !hostSessionExecutionBindingUsable(binding) ||
+		binding.CanonicalSessionID != slot.CanonicalSessionID ||
+		SessionRouteBindingEpoch(*binding) != slot.ActiveBindingEpoch
+	if bindingChanged {
+		endReason = "binding_changed"
+	}
+	terminalPhase := hostSessionExecutionTerminalPhase(endReason)
+	outcome := &hostSessionExecutionOutcome{
+		ContractVersion:       HostSessionExecutionContractVersion,
+		HostInstanceID:        req.HostInstanceID,
+		StableCharacterID:     req.StableCharacterID,
+		HostChatID:            req.HostChatID,
+		CanonicalSessionID:    slot.CanonicalSessionID,
+		BindingEpoch:          slot.ActiveBindingEpoch,
+		OperationID:           req.OperationID,
+		ClaimEpoch:            req.ClaimEpoch,
+		EndEventID:            req.EndEventID,
+		RequestedEndReason:    req.EndReason,
+		EndReason:             endReason,
+		TerminalPhase:         terminalPhase,
+		SourceDisposition:     req.SourceDisposition,
+		RequiredHostChangeSeq: slot.RequiredHostChangeSeq,
+		SafeHostChangeSeq:     slot.SafeHostChangeSeq,
+	}
+	if _, err := tx.ExecContext(ctx, `
+		INSERT INTO host_session_execution_outcomes (
+			contract_version, host_instance_id, stable_character_id, host_chat_id,
+			canonical_session_id, binding_epoch, operation_id, claim_epoch,
+			end_event_id, requested_end_reason, end_reason, terminal_phase, source_disposition,
+			final_required_host_change_seq, final_safe_host_change_seq
+		) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+	`, outcome.ContractVersion, outcome.HostInstanceID, outcome.StableCharacterID,
+		outcome.HostChatID, outcome.CanonicalSessionID, outcome.BindingEpoch,
+		outcome.OperationID, outcome.ClaimEpoch, outcome.EndEventID,
+		outcome.RequestedEndReason, outcome.EndReason, outcome.TerminalPhase, outcome.SourceDisposition,
+		outcome.RequiredHostChangeSeq, outcome.SafeHostChangeSeq); err != nil {
+		return nil, err
+	}
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_session_execution_slots
+		SET active_host_instance_id = NULL,
+		    active_stable_character_id = NULL,
+		    active_host_chat_id = NULL,
+		    active_binding_epoch = NULL,
+		    active_operation_id = NULL,
+		    phase = 'idle',
+		    required_host_change_seq = 0,
+		    claimed_at = NULL
+		WHERE canonical_session_id = ?
+		  AND active_host_instance_id = ?
+		  AND active_operation_id = ?
+		  AND claim_epoch = ?
+	`, slot.CanonicalSessionID, req.HostInstanceID, req.OperationID, req.ClaimEpoch)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := write.RowsAffected()
+	if err != nil {
+		return nil, err
+	}
+	if rows != 1 {
+		return nil, errors.New("host session execution settle lost compare-and-set")
+	}
+	return finish(hostSessionExecutionOutcomeResult(outcome, false))
+}
+
+func normalizeHostSessionExecutionAcquireRequest(request HostSessionExecutionAcquireRequest) (HostSessionExecutionAcquireRequest, error) {
+	var err error
+	if request.HostInstanceID, err = normalizeHostSessionExecutionIdentifier("host_instance_id", request.HostInstanceID, 255); err != nil {
+		return request, err
+	}
+	if request.StableCharacterID, err = normalizeHostSessionExecutionIdentifier("stable_character_id", request.StableCharacterID, 255); err != nil {
+		return request, err
+	}
+	if request.HostChatID, err = normalizeHostSessionExecutionIdentifier("host_chat_id", request.HostChatID, 255); err != nil {
+		return request, err
+	}
+	if request.OperationID, err = normalizeHostSessionExecutionIdentifier("operation_id", request.OperationID, 255); err != nil {
+		return request, err
+	}
+	if request.ExpectedBindingEpoch, err = normalizeHostSessionExecutionIdentifier("expected_binding_epoch", request.ExpectedBindingEpoch, 96); err != nil {
+		return request, err
+	}
+	return request, nil
+}
+
+func isRetryableHostCoordinationTransactionError(err error) bool {
+	var mysqlErr *mysql.MySQLError
+	if !errors.As(err, &mysqlErr) {
+		return false
+	}
+	return mysqlErr.Number == 1205 || mysqlErr.Number == 1213
+}
+
+func waitHostCoordinationTransactionRetry(ctx context.Context, failedAttempt int) error {
+	timer := time.NewTimer(time.Duration(failedAttempt) * 25 * time.Millisecond)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
+
+func normalizeHostSessionExecutionSettleRequest(request HostSessionExecutionSettleRequest) (HostSessionExecutionSettleRequest, error) {
+	var err error
+	if request.HostInstanceID, err = normalizeHostSessionExecutionIdentifier("host_instance_id", request.HostInstanceID, 255); err != nil {
+		return request, err
+	}
+	if request.StableCharacterID, err = normalizeHostSessionExecutionIdentifier("stable_character_id", request.StableCharacterID, 255); err != nil {
+		return request, err
+	}
+	if request.HostChatID, err = normalizeHostSessionExecutionIdentifier("host_chat_id", request.HostChatID, 255); err != nil {
+		return request, err
+	}
+	if request.OperationID, err = normalizeHostSessionExecutionIdentifier("operation_id", request.OperationID, 255); err != nil {
+		return request, err
+	}
+	if request.ExpectedBindingEpoch, err = normalizeHostSessionExecutionIdentifier("expected_binding_epoch", request.ExpectedBindingEpoch, 96); err != nil {
+		return request, err
+	}
+	if request.EndEventID, err = normalizeHostSessionExecutionIdentifier("end_event_id", request.EndEventID, 255); err != nil {
+		return request, err
+	}
+	request.EndReason = strings.TrimSpace(request.EndReason)
+	if !hostSessionExecutionTerminalReasonAllowed(request.EndReason) {
+		return request, fmt.Errorf("%w: unsupported end_reason %q", ErrHostSessionExecutionInvalid, request.EndReason)
+	}
+	request.SourceDisposition = strings.TrimSpace(request.SourceDisposition)
+	if request.SourceDisposition == "" {
+		request.SourceDisposition = "not_stored"
+	}
+	if !hostSessionExecutionSourceDispositionAllowed(request.SourceDisposition) {
+		return request, fmt.Errorf("%w: unsupported source_disposition %q", ErrHostSessionExecutionInvalid, request.SourceDisposition)
+	}
+	if request.ClaimEpoch == 0 {
+		return request, fmt.Errorf("%w: claim_epoch is required", ErrHostSessionExecutionInvalid)
+	}
+	return request, nil
+}
+
+func normalizeHostSessionExecutionIdentifier(name, value string, maxBytes int) (string, error) {
+	value = strings.TrimSpace(value)
+	if value == "" || len(value) > maxBytes || !utf8.ValidString(value) || strings.IndexFunc(value, unicode.IsControl) >= 0 {
+		return "", fmt.Errorf("%w: %s is missing or invalid", ErrHostSessionExecutionInvalid, name)
+	}
+	return value, nil
+}
+
+func hostSessionExecutionTerminalReasonAllowed(reason string) bool {
+	switch reason {
+	case "completed", "invalid_input", "source_changed", "model_failed",
+		"cancelled", "deleted", "conflict_copy",
+		"ac_skipped_prepare_unavailable", "invalidated", "abandoned":
+		return true
+	default:
+		return false
+	}
+}
+
+func hostSessionExecutionSourceDispositionAllowed(disposition string) bool {
+	switch disposition {
+	case "original", "conflict_copy", "not_stored", "superseded", "deleted":
+		return true
+	default:
+		return false
+	}
+}
+
+func hostSessionExecutionTerminalPhase(reason string) string {
+	switch reason {
+	case "completed":
+		return "settled"
+	case "cancelled":
+		return "cancelled"
+	case "deleted":
+		return "deleted"
+	case "conflict_copy":
+		return "blocked_conflict"
+	case "ac_skipped_prepare_unavailable":
+		return "degraded"
+	case "invalidated", "binding_changed", "source_changed":
+		return "invalidated"
+	case "abandoned":
+		return "abandoned"
+	default:
+		return "aborted"
+	}
+}
+
+func hostSessionExecutionBindingUsable(binding *SessionRouteBinding) bool {
+	return binding != nil && binding.ContractVersion == SessionRouteBindingContractVersion &&
+		binding.BindingState == "active" && strings.TrimSpace(binding.CanonicalSessionID) != ""
+}
+
+func hostSessionExecutionOutcomeMatchesAcquire(outcome *hostSessionExecutionOutcome, request HostSessionExecutionAcquireRequest) bool {
+	return outcome != nil && outcome.ContractVersion == HostSessionExecutionContractVersion &&
+		outcome.HostInstanceID == request.HostInstanceID &&
+		outcome.StableCharacterID == request.StableCharacterID &&
+		outcome.HostChatID == request.HostChatID &&
+		outcome.OperationID == request.OperationID &&
+		outcome.BindingEpoch == request.ExpectedBindingEpoch &&
+		outcome.RequiredHostChangeSeq == request.RequiredHostChangeSeq
+}
+
+func hostSessionExecutionSlotMatchesAcquire(slot *hostSessionExecutionSlot, request HostSessionExecutionAcquireRequest) bool {
+	return slot != nil && slot.ContractVersion == HostSessionExecutionContractVersion &&
+		slot.ActiveHostInstanceID == request.HostInstanceID &&
+		slot.ActiveStableCharacterID == request.StableCharacterID &&
+		slot.ActiveHostChatID == request.HostChatID &&
+		slot.ActiveOperationID == request.OperationID &&
+		slot.ActiveBindingEpoch == request.ExpectedBindingEpoch &&
+		slot.RequiredHostChangeSeq == request.RequiredHostChangeSeq
+}
+
+func hostSessionExecutionOutcomeMatchesSettle(outcome *hostSessionExecutionOutcome, request HostSessionExecutionSettleRequest) bool {
+	return outcome != nil && outcome.ContractVersion == HostSessionExecutionContractVersion &&
+		outcome.HostInstanceID == request.HostInstanceID &&
+		outcome.StableCharacterID == request.StableCharacterID &&
+		outcome.HostChatID == request.HostChatID &&
+		outcome.OperationID == request.OperationID &&
+		outcome.BindingEpoch == request.ExpectedBindingEpoch &&
+		outcome.ClaimEpoch == request.ClaimEpoch &&
+		outcome.EndEventID == request.EndEventID &&
+		outcome.RequestedEndReason == request.EndReason &&
+		outcome.SourceDisposition == request.SourceDisposition
+}
+
+func hostSessionExecutionSlotMatchesSettle(slot *hostSessionExecutionSlot, request HostSessionExecutionSettleRequest) bool {
+	return slot != nil && slot.ContractVersion == HostSessionExecutionContractVersion &&
+		slot.ActiveHostInstanceID == request.HostInstanceID &&
+		slot.ActiveStableCharacterID == request.StableCharacterID &&
+		slot.ActiveHostChatID == request.HostChatID &&
+		slot.ActiveOperationID == request.OperationID &&
+		slot.ActiveBindingEpoch == request.ExpectedBindingEpoch &&
+		slot.ClaimEpoch == request.ClaimEpoch && slot.Phase == "claimed"
+}
+
+func newHostSessionExecutionResult(status, reason string) *HostSessionExecutionResult {
+	return &HostSessionExecutionResult{
+		ContractVersion: HostSessionExecutionContractVersion,
+		Status:          status,
+		ReasonCode:      reason,
+	}
+}
+
+func hostSessionExecutionSlotResult(slot *hostSessionExecutionSlot, status, reason string, reused bool) *HostSessionExecutionResult {
+	result := newHostSessionExecutionResult(status, reason)
+	if slot == nil {
+		return result
+	}
+	result.HostInstanceID = slot.ActiveHostInstanceID
+	result.StableCharacterID = slot.ActiveStableCharacterID
+	result.HostChatID = slot.ActiveHostChatID
+	result.ResolvedSessionID = slot.CanonicalSessionID
+	result.BindingEpoch = slot.ActiveBindingEpoch
+	result.OperationID = slot.ActiveOperationID
+	result.ClaimEpoch = slot.ClaimEpoch
+	result.Phase = slot.Phase
+	result.BlockingOperationID = slot.ActiveOperationID
+	result.RequiredHostChangeSeq = slot.RequiredHostChangeSeq
+	result.IngestedHostChangeSeq = slot.IngestedHostChangeSeq
+	result.SafeHostChangeSeq = slot.SafeHostChangeSeq
+	result.Reused = reused
+	return result
+}
+
+func hostSessionExecutionOutcomeResult(outcome *hostSessionExecutionOutcome, reused bool) *HostSessionExecutionResult {
+	result := newHostSessionExecutionResult(HostSessionExecutionStatusTerminal, "execution_terminal")
+	if outcome == nil {
+		return result
+	}
+	result.HostInstanceID = outcome.HostInstanceID
+	result.StableCharacterID = outcome.StableCharacterID
+	result.HostChatID = outcome.HostChatID
+	result.ResolvedSessionID = outcome.CanonicalSessionID
+	result.BindingEpoch = outcome.BindingEpoch
+	result.OperationID = outcome.OperationID
+	result.ClaimEpoch = outcome.ClaimEpoch
+	result.Phase = outcome.TerminalPhase
+	result.RequiredHostChangeSeq = outcome.RequiredHostChangeSeq
+	result.SafeHostChangeSeq = outcome.SafeHostChangeSeq
+	result.EndEventID = outcome.EndEventID
+	result.EndReason = outcome.EndReason
+	result.SourceDisposition = outcome.SourceDisposition
+	result.Reused = reused
+	return result
+}
+
+func selectHostSessionExecutionSlotBySession(ctx context.Context, queryer hostSessionExecutionQueryer, sessionID string, forUpdate bool) (*hostSessionExecutionSlot, error) {
+	query := `
+		SELECT contract_version, canonical_session_id,
+		       COALESCE(active_host_instance_id, ''),
+		       COALESCE(active_stable_character_id, ''),
+		       COALESCE(active_host_chat_id, ''),
+		       COALESCE(active_binding_epoch, ''),
+		       COALESCE(active_operation_id, ''),
+		       claim_epoch, phase, required_host_change_seq,
+		       ingested_host_change_seq, safe_host_change_seq
+		FROM host_session_execution_slots
+		WHERE canonical_session_id = ?`
+	if forUpdate {
+		query += " FOR UPDATE"
+	}
+	return scanHostSessionExecutionSlot(queryer.QueryRowContext(ctx, query, sessionID))
+}
+
+func selectActiveHostSessionExecutionByOperation(ctx context.Context, queryer hostSessionExecutionQueryer, hostInstanceID, operationID string, forUpdate bool) (*hostSessionExecutionSlot, error) {
+	query := `
+		SELECT contract_version, canonical_session_id,
+		       COALESCE(active_host_instance_id, ''),
+		       COALESCE(active_stable_character_id, ''),
+		       COALESCE(active_host_chat_id, ''),
+		       COALESCE(active_binding_epoch, ''),
+		       COALESCE(active_operation_id, ''),
+		       claim_epoch, phase, required_host_change_seq,
+		       ingested_host_change_seq, safe_host_change_seq
+		FROM host_session_execution_slots
+		WHERE active_host_instance_id = ? AND active_operation_id = ?`
+	if forUpdate {
+		query += " FOR UPDATE"
+	}
+	return scanHostSessionExecutionSlot(queryer.QueryRowContext(ctx, query, hostInstanceID, operationID))
+}
+
+func scanHostSessionExecutionSlot(row *sql.Row) (*hostSessionExecutionSlot, error) {
+	var slot hostSessionExecutionSlot
+	err := row.Scan(
+		&slot.ContractVersion, &slot.CanonicalSessionID,
+		&slot.ActiveHostInstanceID, &slot.ActiveStableCharacterID,
+		&slot.ActiveHostChatID, &slot.ActiveBindingEpoch,
+		&slot.ActiveOperationID, &slot.ClaimEpoch, &slot.Phase,
+		&slot.RequiredHostChangeSeq, &slot.IngestedHostChangeSeq,
+		&slot.SafeHostChangeSeq,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &slot, nil
+}
+
+func selectHostSessionExecutionOutcomeByOperation(ctx context.Context, queryer hostSessionExecutionQueryer, hostInstanceID, operationID string, forUpdate bool) (*hostSessionExecutionOutcome, error) {
+	return selectHostSessionExecutionOutcome(ctx, queryer,
+		"host_instance_id = ? AND operation_id = ?", forUpdate, hostInstanceID, operationID)
+}
+
+func selectHostSessionExecutionOutcomeByEndEvent(ctx context.Context, queryer hostSessionExecutionQueryer, hostInstanceID, endEventID string, forUpdate bool) (*hostSessionExecutionOutcome, error) {
+	return selectHostSessionExecutionOutcome(ctx, queryer,
+		"host_instance_id = ? AND end_event_id = ?", forUpdate, hostInstanceID, endEventID)
+}
+
+func selectHostSessionExecutionOutcome(ctx context.Context, queryer hostSessionExecutionQueryer, predicate string, forUpdate bool, args ...any) (*hostSessionExecutionOutcome, error) {
+	query := `
+		SELECT contract_version, host_instance_id, stable_character_id, host_chat_id,
+		       canonical_session_id, binding_epoch, operation_id, claim_epoch,
+		       end_event_id, requested_end_reason, end_reason, terminal_phase, source_disposition,
+		       final_required_host_change_seq, final_safe_host_change_seq
+		FROM host_session_execution_outcomes
+		WHERE ` + predicate
+	if forUpdate {
+		query += " FOR UPDATE"
+	}
+	var outcome hostSessionExecutionOutcome
+	err := queryer.QueryRowContext(ctx, query, args...).Scan(
+		&outcome.ContractVersion, &outcome.HostInstanceID,
+		&outcome.StableCharacterID, &outcome.HostChatID,
+		&outcome.CanonicalSessionID, &outcome.BindingEpoch,
+		&outcome.OperationID, &outcome.ClaimEpoch,
+		&outcome.EndEventID, &outcome.RequestedEndReason, &outcome.EndReason,
+		&outcome.TerminalPhase, &outcome.SourceDisposition,
+		&outcome.RequiredHostChangeSeq, &outcome.SafeHostChangeSeq,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &outcome, nil
+}
diff --git a/go-service/internal/store/mariadb_session_execution_integration_test.go b/go-service/internal/store/mariadb_session_execution_integration_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..635119ac98e1ac7a90ad374828eab990eb3d172b
--- /dev/null
+++ b/go-service/internal/store/mariadb_session_execution_integration_test.go
@@ -0,0 +1,240 @@
+package store
+
+import (
+	"context"
+	"os"
+	"strconv"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestHostSessionExecutionMariaDBConcurrentClaimRestartAndTerminalRelease(t *testing.T) {
+	if os.Getenv("AC_HOST_EXECUTION_TEST_DISPOSABLE") != "YES" {
+		t.Skip("requires an explicitly disposable MariaDB")
+	}
+	dsn := strings.TrimSpace(os.Getenv("AC_HOST_EXECUTION_TEST_DSN"))
+	if dsn == "" {
+		t.Fatal("AC_HOST_EXECUTION_TEST_DSN is required")
+	}
+
+	openStore := func() *mariadbStore {
+		raw, err := OpenMariaDB(dsn)
+		if err != nil {
+			t.Fatalf("open disposable MariaDB: %v", err)
+		}
+		store, ok := raw.(*mariadbStore)
+		if !ok {
+			t.Fatalf("store type=%T, want *mariadbStore", raw)
+		}
+		return store
+	}
+
+	ctx := context.Background()
+	suffix := strconv.FormatInt(time.Now().UTC().UnixNano(), 36)
+	hostID := "c0-host-" + suffix
+	characterID := "c0-character-" + suffix
+	chatIDs := []string{"c0-chat-a-" + suffix, "c0-chat-b-" + suffix}
+	sessionID := "c0-session-" + suffix
+
+	admin := openStore()
+	cleanup := func() {
+		if _, err := admin.db.ExecContext(ctx, `DELETE FROM host_session_execution_outcomes WHERE host_instance_id = ?`, hostID); err != nil {
+			t.Errorf("clean host execution outcomes: %v", err)
+		}
+		if _, err := admin.db.ExecContext(ctx, `DELETE FROM host_session_execution_slots WHERE canonical_session_id = ?`, sessionID); err != nil {
+			t.Errorf("clean host execution slot: %v", err)
+		}
+		if _, err := admin.db.ExecContext(ctx, `DELETE FROM session_route_bindings WHERE stable_character_id = ? AND host_chat_id IN (?, ?)`, characterID, chatIDs[0], chatIDs[1]); err != nil {
+			t.Errorf("clean host route bindings: %v", err)
+		}
+	}
+	cleanup()
+	t.Cleanup(func() {
+		cleanup()
+		if err := admin.Close(); err != nil {
+			t.Errorf("close cleanup store: %v", err)
+		}
+	})
+
+	runtimeStore := openStore()
+	bindings := make([]SessionRouteBinding, len(chatIDs))
+	for index, chatID := range chatIDs {
+		result, err := runtimeStore.BindSessionRoute(ctx, SessionRouteBindingRequest{
+			StableCharacterID: characterID, HostChatID: chatID,
+			RequestedSessionID: sessionID, Mode: SessionRouteBindingModeResolveOrCreate,
+		})
+		if err != nil {
+			t.Fatalf("bind route %d: %v", index, err)
+		}
+		bindings[index] = result.Binding
+	}
+
+	type acquireAttempt struct {
+		request HostSessionExecutionAcquireRequest
+		result  *HostSessionExecutionResult
+		err     error
+	}
+	attempts := []acquireAttempt{
+		{request: HostSessionExecutionAcquireRequest{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatIDs[0],
+			OperationID: "c0-operation-a-" + suffix, ExpectedBindingEpoch: SessionRouteBindingEpoch(bindings[0]),
+		}},
+		{request: HostSessionExecutionAcquireRequest{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatIDs[1],
+			OperationID: "c0-operation-b-" + suffix, ExpectedBindingEpoch: SessionRouteBindingEpoch(bindings[1]),
+		}},
+	}
+	start := make(chan struct{})
+	var waitGroup sync.WaitGroup
+	for index := range attempts {
+		waitGroup.Add(1)
+		go func(index int) {
+			defer waitGroup.Done()
+			<-start
+			attempts[index].result, attempts[index].err = runtimeStore.AcquireHostSessionExecution(ctx, attempts[index].request)
+		}(index)
+	}
+	close(start)
+	waitGroup.Wait()
+
+	winnerIndex, loserIndex := -1, -1
+	for index := range attempts {
+		if attempts[index].err != nil {
+			t.Fatalf("concurrent acquire %d: %v", index, attempts[index].err)
+		}
+		switch attempts[index].result.Status {
+		case HostSessionExecutionStatusAcquired:
+			if winnerIndex >= 0 {
+				t.Fatalf("two concurrent owners: %+v", attempts)
+			}
+			winnerIndex = index
+		case HostSessionExecutionStatusWait:
+			loserIndex = index
+		default:
+			t.Fatalf("concurrent acquire %d result=%+v", index, attempts[index].result)
+		}
+	}
+	if winnerIndex < 0 || loserIndex < 0 || attempts[loserIndex].result.BlockingOperationID != attempts[winnerIndex].request.OperationID {
+		t.Fatalf("winner=%d loser=%d attempts=%+v", winnerIndex, loserIndex, attempts)
+	}
+	winner := attempts[winnerIndex]
+	loser := attempts[loserIndex]
+
+	if err := runtimeStore.Close(); err != nil {
+		t.Fatalf("close first store: %v", err)
+	}
+	runtimeStore = openStore()
+	defer runtimeStore.Close()
+	restored, err := runtimeStore.GetHostSessionExecution(ctx, hostID, winner.request.OperationID)
+	if err != nil {
+		t.Fatalf("status after store restart: %v", err)
+	}
+	if restored.Status != HostSessionExecutionStatusAcquired || restored.ClaimEpoch != winner.result.ClaimEpoch {
+		t.Fatalf("restored claim=%+v winner=%+v", restored, winner.result)
+	}
+
+	winnerSettle := HostSessionExecutionSettleRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: winner.request.HostChatID,
+		OperationID: winner.request.OperationID, ExpectedBindingEpoch: winner.request.ExpectedBindingEpoch,
+		ClaimEpoch: winner.result.ClaimEpoch, EndEventID: "c0-end-winner-" + suffix,
+		EndReason: "completed", SourceDisposition: "original",
+	}
+	settled, err := runtimeStore.SettleHostSessionExecution(ctx, winnerSettle)
+	if err != nil || settled.Status != HostSessionExecutionStatusTerminal || settled.EndReason != "completed" {
+		t.Fatalf("settle winner result=%+v err=%v", settled, err)
+	}
+
+	loser.result, err = runtimeStore.AcquireHostSessionExecution(ctx, loser.request)
+	if err != nil || loser.result.Status != HostSessionExecutionStatusAcquired || loser.result.ClaimEpoch <= winner.result.ClaimEpoch {
+		t.Fatalf("acquire loser after release result=%+v err=%v", loser.result, err)
+	}
+	remapped, err := runtimeStore.BindSessionRoute(ctx, SessionRouteBindingRequest{
+		StableCharacterID: characterID, HostChatID: loser.request.HostChatID,
+		RequestedSessionID: sessionID, Mode: SessionRouteBindingModeManualAttach,
+	})
+	if err != nil {
+		t.Fatalf("advance binding epoch: %v", err)
+	}
+	newBindingEpoch := SessionRouteBindingEpoch(remapped.Binding)
+	if newBindingEpoch == loser.request.ExpectedBindingEpoch {
+		t.Fatal("manual route readback did not advance binding epoch")
+	}
+	changed, err := runtimeStore.GetHostSessionExecution(ctx, hostID, loser.request.OperationID)
+	if err != nil || changed.Status != HostSessionExecutionStatusBindingChanged {
+		t.Fatalf("binding-changed status=%+v err=%v", changed, err)
+	}
+
+	thirdRequest := HostSessionExecutionAcquireRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: loser.request.HostChatID,
+		OperationID: "c0-operation-c-" + suffix, ExpectedBindingEpoch: newBindingEpoch,
+	}
+	blocked, err := runtimeStore.AcquireHostSessionExecution(ctx, thirdRequest)
+	if err != nil || blocked.Status != HostSessionExecutionStatusWait || blocked.BlockingOperationID != loser.request.OperationID {
+		t.Fatalf("changed owner did not remain fenced pending settle: result=%+v err=%v", blocked, err)
+	}
+	loserSettle := HostSessionExecutionSettleRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: loser.request.HostChatID,
+		OperationID: loser.request.OperationID, ExpectedBindingEpoch: loser.request.ExpectedBindingEpoch,
+		ClaimEpoch: loser.result.ClaimEpoch, EndEventID: "c0-end-loser-" + suffix,
+		EndReason: "completed", SourceDisposition: "not_stored",
+	}
+	fenced, err := runtimeStore.SettleHostSessionExecution(ctx, loserSettle)
+	if err != nil || fenced.Status != HostSessionExecutionStatusTerminal || fenced.EndReason != "binding_changed" {
+		t.Fatalf("route-change settle result=%+v err=%v", fenced, err)
+	}
+
+	third, err := runtimeStore.AcquireHostSessionExecution(ctx, thirdRequest)
+	if err != nil || third.Status != HostSessionExecutionStatusAcquired {
+		t.Fatalf("third acquire after fence result=%+v err=%v", third, err)
+	}
+	replayed, err := runtimeStore.SettleHostSessionExecution(ctx, loserSettle)
+	if err != nil || replayed.Status != HostSessionExecutionStatusTerminal || !replayed.Reused || replayed.EndReason != "binding_changed" {
+		t.Fatalf("late settle replay result=%+v err=%v", replayed, err)
+	}
+	thirdStatus, err := runtimeStore.GetHostSessionExecution(ctx, hostID, thirdRequest.OperationID)
+	if err != nil || thirdStatus.Status != HostSessionExecutionStatusAcquired || thirdStatus.ClaimEpoch != third.ClaimEpoch {
+		t.Fatalf("late settle disturbed current owner: status=%+v err=%v", thirdStatus, err)
+	}
+	thirdSettle := HostSessionExecutionSettleRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: thirdRequest.HostChatID,
+		OperationID: thirdRequest.OperationID, ExpectedBindingEpoch: thirdRequest.ExpectedBindingEpoch,
+		ClaimEpoch: third.ClaimEpoch, EndEventID: "c0-end-third-" + suffix,
+		EndReason: "completed", SourceDisposition: "original",
+	}
+	if result, err := runtimeStore.SettleHostSessionExecution(ctx, thirdSettle); err != nil || result.EndReason != "completed" {
+		t.Fatalf("settle third result=%+v err=%v", result, err)
+	}
+
+	terminalReasons := []string{
+		"invalid_input", "source_changed", "model_failed", "cancelled", "deleted",
+		"conflict_copy", "ac_skipped_prepare_unavailable", "invalidated", "abandoned",
+	}
+	lastClaim := third.ClaimEpoch
+	for index, reason := range terminalReasons {
+		operationID := "c0-terminal-" + strconv.Itoa(index) + "-" + suffix
+		request := HostSessionExecutionAcquireRequest{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: loser.request.HostChatID,
+			OperationID: operationID, ExpectedBindingEpoch: newBindingEpoch,
+		}
+		claim, err := runtimeStore.AcquireHostSessionExecution(ctx, request)
+		if err != nil || claim.Status != HostSessionExecutionStatusAcquired || claim.ClaimEpoch <= lastClaim {
+			t.Fatalf("acquire for terminal %s result=%+v err=%v", reason, claim, err)
+		}
+		disposition := "not_stored"
+		if reason == "conflict_copy" {
+			disposition = "conflict_copy"
+		}
+		terminal, err := runtimeStore.SettleHostSessionExecution(ctx, HostSessionExecutionSettleRequest{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: loser.request.HostChatID,
+			OperationID: operationID, ExpectedBindingEpoch: newBindingEpoch, ClaimEpoch: claim.ClaimEpoch,
+			EndEventID: "c0-terminal-end-" + strconv.Itoa(index) + "-" + suffix,
+			EndReason:  reason, SourceDisposition: disposition,
+		})
+		if err != nil || terminal.Status != HostSessionExecutionStatusTerminal || terminal.EndReason != reason {
+			t.Fatalf("settle terminal %s result=%+v err=%v", reason, terminal, err)
+		}
+		lastClaim = claim.ClaimEpoch
+	}
+}
