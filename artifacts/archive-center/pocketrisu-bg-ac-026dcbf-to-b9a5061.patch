+	mock.ExpectBegin()
+	mock.ExpectRollback()
+	mock.ExpectBegin()
+	mock.ExpectCommit()
+	attempts := 0
+	result, err := store.runHostPrepareMutation(context.Background(), func(*sql.Tx) (*HostPrepareResult, error) {
+		attempts++
