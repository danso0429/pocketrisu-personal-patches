index 0000000000000000000000000000000000000000..56494ebdc0625fd94fb6147d68338641fe06f977
--- /dev/null
+++ b/go-service/internal/httpapi/pocketrisu_execution_context_resolver_test.go
@@ -0,0 +1,223 @@
+package httpapi
+
+import (
+	"os"
+	"testing"
+
+	"github.com/risulongmemory/archive-center-go/internal/config"
+)
+
+func pocketRisuExecutionContextMaterialForTest(deviceSecret, backendSecret string) pocketRisuExecutionContextMaterial {
+	return pocketRisuExecutionContextMaterial{
+		Device:  validPocketRisuExecutionContextRequest("operation-resolver", deviceSecret).Device,
+		Backend: validPocketRisuExecutionBackendSnapshot(backendSecret),
+	}
+}
+
+func clearPocketRisuDeviceProviderAuthority(device *pocketRisuExecutionDeviceSnapshot) {
+	for _, config := range []*pocketRisuExecutionLLMConfig{
+		&device.Main,
+		&device.Critic,
+		&device.SourceSearch,
+	} {
+		config.APIKey = ""
+		config.Endpoint = ""
+		config.Model = ""
+	}
+	device.Embedding.APIKey = ""
+	device.Embedding.Endpoint = ""
+	device.Embedding.Model = ""
+}
+
+func TestPocketRisuExecutionContextResolverUsesCompleteDeviceProviders(t *testing.T) {
+	material := pocketRisuExecutionContextMaterialForTest("DEVICE", "BACKEND")
+	resolved, err := resolvePocketRisuExecutionContext(material)
+	if err != nil {
+		t.Fatalf("resolve failed: %v", err)
+	}
+	if resolved.Main.APIKey != "DEVICE" || resolved.Main.Source != "execution_context.device.main" {
+		t.Fatalf("main config = %+v", resolved.Main)
+	}
+	if resolved.Supervisor.APIKey != "DEVICE" || resolved.Supervisor.Source != "execution_context.device.main_as_supervisor" {
+		t.Fatalf("supervisor config = %+v", resolved.Supervisor)
+	}
+	if resolved.Critic.APIKey != "DEVICE-critic" || resolved.Critic.Source != "execution_context.device.critic" {
+		t.Fatalf("critic config = %+v", resolved.Critic)
+	}
+	if resolved.Embedding.APIKey != "DEVICE-embedding" || resolved.Embedding.Source != "execution_context.device.embedding" {
+		t.Fatalf("embedding config = %+v", resolved.Embedding)
+	}
+	if resolved.SourceSearch.APIKey != "DEVICE-source" || resolved.SourceSearch.Source != "execution_context.device.source_search" {
+		t.Fatalf("source search config = %+v", resolved.SourceSearch)
+	}
+	for name, config := range map[string]completeTurnLLMConfig{
+		"main": resolved.Main, "supervisor": resolved.Supervisor,
+		"critic": resolved.Critic, "source_search": resolved.SourceSearch,
+	} {
+		if config.RetryBudget == nil || config.RetryBudget.remaining != 3 {
+			t.Fatalf("%s retry budget = %+v", name, config.RetryBudget)
+		}
+	}
+	if resolved.Main.MaxTokens != material.Device.Main.MaxCompletionTokens ||
+		resolved.Main.MaxCompletionTokens != material.Device.Main.MaxCompletionTokens {
+		t.Fatalf("main token mapping = max:%d completion:%d", resolved.Main.MaxTokens, resolved.Main.MaxCompletionTokens)
+	}
+}
+
+func TestPocketRisuExecutionContextResolverFallsBackWithoutMixingPartialDeviceCredentials(t *testing.T) {
+	material := pocketRisuExecutionContextMaterialForTest("DEVICE", "BACKEND")
+	clearPocketRisuDeviceProviderAuthority(&material.Device)
+	resolved, err := resolvePocketRisuExecutionContext(material)
+	if err != nil {
+		t.Fatalf("fallback resolve failed: %v", err)
+	}
+	if resolved.Main.APIKey != "BACKEND-backend-main" || resolved.Main.Source != "execution_context.backend.main" {
+		t.Fatalf("backend main = %+v", resolved.Main)
+	}
+	if resolved.Supervisor.APIKey != "BACKEND-backend-supervisor" || resolved.Supervisor.Source != "execution_context.backend.supervisor" {
+		t.Fatalf("backend supervisor = %+v", resolved.Supervisor)
+	}
+	if resolved.Critic.APIKey != "BACKEND-backend-critic" || resolved.Critic.Source != "execution_context.backend.critic" {
+		t.Fatalf("backend critic = %+v", resolved.Critic)
+	}
+	if resolved.Embedding.APIKey != "BACKEND-backend-embedding" || resolved.Embedding.Source != "execution_context.backend.runtime_embedding" {
