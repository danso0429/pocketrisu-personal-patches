+var _ HostPrepareRegistryStore = (*mariadbStore)(nil)
+
+// HostPrepareRestartRecoveryStore enumerates only running prepares so a new
+// backend process can convert work whose external outcome is no longer
+// provable into the durable outcome_unknown state before readiness.
+type HostPrepareRestartRecoveryStore interface {
+	ListRunningHostPrepares(context.Context, int) ([]HostPrepareResult, error)
+}
+
+var _ HostPrepareRestartRecoveryStore = (*mariadbStore)(nil)
+
+// HostPrepareRecoveryStore resolves the durable row by its stable key when an
+// authenticated caller lost the original capture response or the process lost
+// its secret-bearing context. It does not authorize work by itself.
+type HostPrepareRecoveryStore interface {
+	GetHostPrepareByKey(context.Context, string) (*HostPrepareResult, error)
+}
+
+var _ HostPrepareRecoveryStore = (*mariadbStore)(nil)
+
+type hostPrepareRequestRow struct {
+	PrepareKey              string
+	ContractVersion         string
+	HostInstanceID          string
+	StableCharacterID       string
+	HostChatID              string
+	CanonicalSessionID      string
+	BindingEpoch            string
+	OperationID             string
+	ClaimEpoch              uint64
+	MainRequestID           string
+	RequestFingerprint      string
+	ExecutionContextID      string
+	SettingsSnapshotDigest  string
+	InputReceiptID          string
+	SourceRevision          string
+	SemanticPayloadHash     string
+	RequestType             string
+	ProtocolVersion         string
+	Status                  string
+	RunEpoch                uint64
+	ExternalOperationID     string
+	ResultJSON              string
+	ResultHash              string
+	FailureCode             string
+	FailureRetryable        bool
+	ExternalCallDisposition string
+	SkipEventID             string
+	SkipReason              string
+	ExecutionClaimReleased  bool
+}
+
+func HostPrepareKey(identity HostPrepareIdentity) string {
+	seed := strings.Join([]string{
+		strings.TrimSpace(identity.HostInstanceID),
+		strings.TrimSpace(identity.BindingEpoch),
+		strings.TrimSpace(identity.OperationID),
+		fmt.Sprintf("%d", identity.ClaimEpoch),
+		strings.TrimSpace(identity.MainRequestID),
+	}, "\x1f")
+	sum := sha256.Sum256([]byte(seed))
+	return "prepare_v1_" + hex.EncodeToString(sum[:])
+}
+
+func normalizeHostPrepareRegisterRequest(request HostPrepareRegisterRequest) (HostPrepareRegisterRequest, string, string, error) {
+	identity, err := normalizeHostPrepareIdentity(request.HostPrepareIdentity)
+	if err != nil {
+		return request, "", "", err
+	}
+	request.HostPrepareIdentity = identity
+	if request.ExecutionContextID, err = normalizeHostSessionExecutionIdentifier("execution_context_id", request.ExecutionContextID, 255); err != nil {
+		return request, "", "", fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if request.SettingsSnapshotDigest, err = normalizeHostPrepareDigest("settings_snapshot_digest", request.SettingsSnapshotDigest); err != nil {
+		return request, "", "", err
+	}
+	if request.InputReceiptID, err = normalizeHostSessionExecutionIdentifier("input_receipt_id", request.InputReceiptID, 255); err != nil {
+		return request, "", "", fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if request.SourceRevision, err = normalizeOptionalHostChangeIdentifier("source_revision", request.SourceRevision, 255); err != nil {
+		return request, "", "", fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if request.SemanticPayloadHash, err = normalizeHostPrepareDigest("semantic_payload_hash", request.SemanticPayloadHash); err != nil {
+		return request, "", "", err
+	}
+	request.RequestType = strings.ToLower(strings.TrimSpace(request.RequestType))
+	if request.RequestType != "model" {
+		return request, "", "", fmt.Errorf("%w: unsupported request_type %q", ErrHostPrepareInvalid, request.RequestType)
+	}
+	request.ProtocolVersion = strings.TrimSpace(request.ProtocolVersion)
+	if request.ProtocolVersion != HostPrepareProtocolVersion {
+		return request, "", "", fmt.Errorf("%w: unsupported protocol_version %q", ErrHostPrepareInvalid, request.ProtocolVersion)
+	}
+	prepareKey := HostPrepareKey(identity)
+	fingerprintPayload := struct {
+		HostPrepareIdentity
+		ExecutionContextID     string `json:"execution_context_id"`
+		SettingsSnapshotDigest string `json:"settings_snapshot_digest"`
+		InputReceiptID         string `json:"input_receipt_id"`
+		SourceRevision         string `json:"source_revision"`
+		SemanticPayloadHash    string `json:"semantic_payload_hash"`
+		RequestType            string `json:"request_type"`
+		ProtocolVersion        string `json:"protocol_version"`
+	}{
+		HostPrepareIdentity: identity,
+		ExecutionContextID:  request.ExecutionContextID, SettingsSnapshotDigest: request.SettingsSnapshotDigest,
+		InputReceiptID: request.InputReceiptID, SourceRevision: request.SourceRevision,
+		SemanticPayloadHash: request.SemanticPayloadHash, RequestType: request.RequestType,
+		ProtocolVersion: request.ProtocolVersion,
+	}
+	encoded, err := json.Marshal(fingerprintPayload)
+	if err != nil {
+		return request, "", "", err
+	}
+	sum := sha256.Sum256(encoded)
+	return request, prepareKey, hex.EncodeToString(sum[:]), nil
+}
+
+func normalizeHostPrepareIdentity(identity HostPrepareIdentity) (HostPrepareIdentity, error) {
+	var err error
+	if identity.HostInstanceID, err = normalizeHostSessionExecutionIdentifier("host_instance_id", identity.HostInstanceID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if identity.StableCharacterID, err = normalizeHostSessionExecutionIdentifier("stable_character_id", identity.StableCharacterID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if identity.HostChatID, err = normalizeHostSessionExecutionIdentifier("host_chat_id", identity.HostChatID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if identity.BindingEpoch, err = normalizeHostSessionExecutionIdentifier("binding_epoch", identity.BindingEpoch, 96); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if identity.OperationID, err = normalizeHostSessionExecutionIdentifier("operation_id", identity.OperationID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if identity.MainRequestID, err = normalizeHostSessionExecutionIdentifier("main_request_id", identity.MainRequestID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if identity.ClaimEpoch == 0 {
+		return identity, fmt.Errorf("%w: claim_epoch is required", ErrHostPrepareInvalid)
+	}
+	return identity, nil
+}
+
+func normalizeHostPrepareLookup(lookup HostPrepareLookup) (HostPrepareLookup, error) {
+	var err error
+	if lookup.PrepareKey, err = normalizeHostSessionExecutionIdentifier("prepare_key", lookup.PrepareKey, 80); err != nil {
+		return lookup, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	if lookup.RequestFingerprint, err = normalizeHostPrepareDigest("request_fingerprint", lookup.RequestFingerprint); err != nil {
+		return lookup, err
+	}
+	return lookup, nil
+}
+
+func normalizeHostPrepareDigest(name, value string) (string, error) {
+	value = strings.ToLower(strings.TrimSpace(value))
+	decoded, err := hex.DecodeString(value)
+	if err != nil || len(decoded) != sha256.Size {
+		return "", fmt.Errorf("%w: %s must be a SHA-256 hex digest", ErrHostPrepareInvalid, name)
+	}
+	return value, nil
+}
+
+func normalizeHostPrepareResult(resultJSON, resultHash string) (string, string, error) {
+	if len(resultJSON) == 0 || len(resultJSON) > hostPrepareResultMaxBytes || !json.Valid([]byte(resultJSON)) {
+		return "", "", fmt.Errorf("%w: result_json is missing, invalid, or too large", ErrHostPrepareInvalid)
+	}
+	var compact bytes.Buffer
+	if err := json.Compact(&compact, []byte(resultJSON)); err != nil {
+		return "", "", fmt.Errorf("%w: result_json is invalid", ErrHostPrepareInvalid)
+	}
+	normalizedHash, err := normalizeHostPrepareDigest("result_hash", resultHash)
+	if err != nil {
+		return "", "", err
+	}
+	sum := sha256.Sum256(compact.Bytes())
+	if normalizedHash != hex.EncodeToString(sum[:]) {
+		return "", "", fmt.Errorf("%w: result_hash does not match result_json", ErrHostPrepareInvalid)
+	}
+	return compact.String(), normalizedHash, nil
+}
+
+func (m *mariadbStore) RegisterHostPrepare(ctx context.Context, request HostPrepareRegisterRequest) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	normalized, prepareKey, fingerprint, err := normalizeHostPrepareRegisterRequest(request)
+	if err != nil {
+		return nil, err
+	}
+	return m.runHostPrepareMutation(ctx, func(tx *sql.Tx) (*HostPrepareResult, error) {
+		row, rowErr := selectHostPrepareRequest(ctx, tx, prepareKey, true)
+		if rowErr != nil && !errors.Is(rowErr, ErrNotFound) {
+			return nil, rowErr
+		}
+		if row != nil {
+			if !hostPrepareRowMatchesRegistration(row, normalized, prepareKey, fingerprint) {
+				return newHostPrepareConflictResult(prepareKey, fingerprint, "prepare_key_conflict"), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_registration_replayed", true), nil
+		}
+		binding, bindingErr := selectSessionRouteBindingTx(ctx, tx, normalized.StableCharacterID, normalized.HostChatID, true)
+		if bindingErr != nil && !errors.Is(bindingErr, ErrNotFound) {
+			return nil, bindingErr
+		}
+		if errors.Is(bindingErr, ErrNotFound) {
+			return newHostPrepareResult(HostPrepareStatusRejected, "binding_not_found", prepareKey, fingerprint), nil
+		}
+		if !hostSessionExecutionBindingUsable(binding) {
+			return newHostPrepareResult(HostPrepareStatusRejected, "binding_not_active", prepareKey, fingerprint), nil
+		}
+		currentEpoch := SessionRouteBindingEpoch(*binding)
+		if currentEpoch != normalized.BindingEpoch {
+			result := newHostPrepareResult(HostPrepareStatusFenced, "binding_epoch_changed", prepareKey, fingerprint)
+			result.ResolvedSessionID = binding.CanonicalSessionID
+			result.BindingEpoch = currentEpoch
+			return result, nil
+		}
+		slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, binding.CanonicalSessionID, true)
+		if err != nil && !errors.Is(err, ErrNotFound) {
+			return nil, err
+		}
+		if errors.Is(err, ErrNotFound) || !hostPrepareSlotMatchesIdentity(slot, normalized.HostPrepareIdentity, binding.CanonicalSessionID) {
+			return newHostPrepareResult(HostPrepareStatusFenced, "execution_claim_not_active", prepareKey, fingerprint), nil
+		}
+		if !hostPrepareSlotAllowsPreparation(slot) {
+			return newHostPrepareResult(HostPrepareStatusFenced, "host_changes_not_safe", prepareKey, fingerprint), nil
+		}
+		if _, err := tx.ExecContext(ctx, `
+			INSERT INTO host_prepare_requests (
+				prepare_key, contract_version, host_instance_id, stable_character_id,
+				host_chat_id, canonical_session_id, binding_epoch, operation_id,
+				claim_epoch, main_request_id, request_fingerprint,
+				execution_context_id, settings_snapshot_digest, input_receipt_id,
+				source_revision, semantic_payload_hash, request_type, protocol_version,
+				status
+			) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'registered_not_started')
+		`, prepareKey, HostPrepareRegistryContractVersion, normalized.HostInstanceID,
+			normalized.StableCharacterID, normalized.HostChatID, binding.CanonicalSessionID,
+			normalized.BindingEpoch, normalized.OperationID, normalized.ClaimEpoch,
+			normalized.MainRequestID, fingerprint, normalized.ExecutionContextID,
+			normalized.SettingsSnapshotDigest, normalized.InputReceiptID,
+			nullableString(normalized.SourceRevision), normalized.SemanticPayloadHash,
+			normalized.RequestType, normalized.ProtocolVersion); err != nil {
+			return nil, err
+		}
+		row = hostPrepareRowFromRegistration(normalized, prepareKey, fingerprint, binding.CanonicalSessionID)
+		return hostPrepareResultFromRow(row, "prepare_registered", false), nil
+	})
+}
+
+func (m *mariadbStore) StartHostPrepare(ctx context.Context, request HostPrepareStartRequest) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	lookup, err := normalizeHostPrepareLookup(request.HostPrepareLookup)
+	if err != nil {
+		return nil, err
+	}
+	externalOperationID := strings.TrimSpace(request.ExternalOperationID)
+	if externalOperationID != "" {
+		externalOperationID, err = normalizeHostSessionExecutionIdentifier("external_operation_id", externalOperationID, 255)
+		if err != nil {
+			return nil, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+		}
+	}
+	return m.runHostPrepareMutation(ctx, func(tx *sql.Tx) (*HostPrepareResult, error) {
+		row, result, err := lockHostPrepareLookup(ctx, tx, lookup)
+		if err != nil || result != nil {
+			return result, err
+		}
+		switch row.Status {
+		case HostPrepareStatusRegistered:
+		case HostPrepareStatusRunning:
+			if row.ExternalOperationID != externalOperationID {
+				return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "external_operation_identity_conflict"), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_running_replayed", true), nil
+		default:
+			return hostPrepareResultFromRow(row, "prepare_start_fenced", true), nil
+		}
+		claimCurrent, fenceReason, err := hostPrepareExecutionClaimCurrent(ctx, tx, row)
+		if err != nil {
+			return nil, err
+		}
+		if !claimCurrent {
+			if err := fenceHostPrepareRequestTx(ctx, tx, row, fenceReason); err != nil {
+				return nil, err
+			}
+			return hostPrepareResultFromRow(row, "prepare_fenced", false), nil
+		}
+		if row.RunEpoch == ^uint64(0) {
+			return nil, errors.New("host prepare run epoch exhausted")
+		}
+		nextRunEpoch := row.RunEpoch + 1
+		write, err := tx.ExecContext(ctx, `
+			UPDATE host_prepare_requests
+			SET status = 'running', run_epoch = ?, external_operation_id = ?,
+				    external_call_disposition = 'not_recorded', started_at = UTC_TIMESTAMP(3),
+			    finished_at = NULL, failure_code = NULL, failure_retryable = NULL
+			WHERE prepare_key = ? AND request_fingerprint = ?
+			  AND status = 'registered_not_started' AND run_epoch = ?
+		`, nextRunEpoch, nullableString(externalOperationID), row.PrepareKey,
+			row.RequestFingerprint, row.RunEpoch)
+		if err != nil {
+			return nil, err
+		}
+		if err := requireHostPrepareRowsAffected(write, "start"); err != nil {
+			return nil, err
+		}
+		row.Status = HostPrepareStatusRunning
+		row.RunEpoch = nextRunEpoch
+		row.ExternalOperationID = externalOperationID
+		row.ExternalCallDisposition = "not_recorded"
+		result = hostPrepareResultFromRow(row, "prepare_started", false)
+		result.StartAuthorized = true
+		return result, nil
+	})
+}
+
+func (m *mariadbStore) CompleteHostPrepare(ctx context.Context, request HostPrepareCompleteRequest) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	lookup, err := normalizeHostPrepareLookup(request.HostPrepareLookup)
+	if err != nil {
+		return nil, err
+	}
+	if request.RunEpoch == 0 {
+		return nil, fmt.Errorf("%w: run_epoch is required", ErrHostPrepareInvalid)
+	}
+	resultJSON, resultHash, err := normalizeHostPrepareResult(request.ResultJSON, request.ResultHash)
+	if err != nil {
+		return nil, err
+	}
+	return m.runHostPrepareMutation(ctx, func(tx *sql.Tx) (*HostPrepareResult, error) {
+		row, result, err := lockHostPrepareLookup(ctx, tx, lookup)
+		if err != nil || result != nil {
+			return result, err
+		}
+		if row.Status == HostPrepareStatusReady {
+			if row.RunEpoch != request.RunEpoch || row.ResultHash != resultHash || row.ResultJSON != resultJSON {
+				return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_result_conflict"), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_ready_replayed", true), nil
+		}
+		if row.Status != HostPrepareStatusRunning {
+			return hostPrepareResultFromRow(row, "prepare_result_fenced", true), nil
+		}
+		if row.RunEpoch != request.RunEpoch {
+			return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_run_epoch_conflict"), nil
+		}
+		claimCurrent, fenceReason, err := hostPrepareExecutionClaimCurrent(ctx, tx, row)
+		if err != nil {
+			return nil, err
+		}
+		if !claimCurrent {
+			if err := fenceHostPrepareRequestTx(ctx, tx, row, fenceReason); err != nil {
+				return nil, err
+			}
+			return hostPrepareResultFromRow(row, "prepare_result_fenced", false), nil
+		}
+		write, err := tx.ExecContext(ctx, `
+			UPDATE host_prepare_requests
+			SET status = 'ready', result_json = ?, result_hash = ?,
+				    external_call_disposition = 'started', failure_code = NULL,
+			    failure_retryable = NULL, finished_at = UTC_TIMESTAMP(3)
+			WHERE prepare_key = ? AND request_fingerprint = ?
+			  AND status = 'running' AND run_epoch = ?
+		`, resultJSON, resultHash, row.PrepareKey, row.RequestFingerprint, row.RunEpoch)
+		if err != nil {
+			return nil, err
+		}
+		if err := requireHostPrepareRowsAffected(write, "complete"); err != nil {
+			return nil, err
+		}
+		row.Status = HostPrepareStatusReady
+		row.ResultJSON = resultJSON
+		row.ResultHash = resultHash
+		row.ExternalCallDisposition = "started"
+		return hostPrepareResultFromRow(row, "prepare_ready", false), nil
+	})
+}
+
+func (m *mariadbStore) FailHostPrepare(ctx context.Context, request HostPrepareFailureRequest) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	lookup, err := normalizeHostPrepareLookup(request.HostPrepareLookup)
+	if err != nil {
+		return nil, err
+	}
+	if request.RunEpoch == 0 {
+		return nil, fmt.Errorf("%w: run_epoch is required", ErrHostPrepareInvalid)
+	}
+	failureCode, err := normalizeHostSessionExecutionIdentifier("failure_code", request.FailureCode, 160)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	return m.runHostPrepareMutation(ctx, func(tx *sql.Tx) (*HostPrepareResult, error) {
+		row, result, err := lockHostPrepareLookup(ctx, tx, lookup)
+		if err != nil || result != nil {
+			return result, err
+		}
+		if row.Status == HostPrepareStatusFailedKnown {
+			if row.RunEpoch != request.RunEpoch || row.FailureCode != failureCode ||
+				row.FailureRetryable != request.Retryable ||
+				row.ExternalCallDisposition != hostPrepareKnownCallDisposition(request.ExternalCallStarted) {
+				return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_failure_conflict"), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_failure_replayed", true), nil
+		}
+		if row.Status != HostPrepareStatusRunning {
+			return hostPrepareResultFromRow(row, "prepare_failure_fenced", true), nil
+		}
+		if row.RunEpoch != request.RunEpoch {
+			return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_run_epoch_conflict"), nil
+		}
+		claimCurrent, fenceReason, err := hostPrepareExecutionClaimCurrent(ctx, tx, row)
+		if err != nil {
+			return nil, err
+		}
+		if !claimCurrent {
+			if err := fenceHostPrepareRequestTx(ctx, tx, row, fenceReason); err != nil {
+				return nil, err
+			}
+			return hostPrepareResultFromRow(row, "prepare_failure_fenced", false), nil
+		}
+		write, err := tx.ExecContext(ctx, `
+			UPDATE host_prepare_requests
+				SET status = 'failed_known', failure_code = ?, failure_retryable = ?,
+				    external_call_disposition = ?, finished_at = UTC_TIMESTAMP(3)
+			WHERE prepare_key = ? AND request_fingerprint = ?
+			  AND status = 'running' AND run_epoch = ?
+		`, failureCode, request.Retryable, hostPrepareKnownCallDisposition(request.ExternalCallStarted),
+			row.PrepareKey, row.RequestFingerprint, row.RunEpoch)
+		if err != nil {
+			return nil, err
+		}
+		if err := requireHostPrepareRowsAffected(write, "fail"); err != nil {
+			return nil, err
+		}
+		row.Status = HostPrepareStatusFailedKnown
+		row.FailureCode = failureCode
+		row.FailureRetryable = request.Retryable
+		row.ExternalCallDisposition = hostPrepareKnownCallDisposition(request.ExternalCallStarted)
+		return hostPrepareResultFromRow(row, "prepare_failed_known", false), nil
+	})
+}
+
+func (m *mariadbStore) MarkHostPrepareOutcomeUnknown(ctx context.Context, request HostPrepareOutcomeUnknownRequest) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	lookup, err := normalizeHostPrepareLookup(request.HostPrepareLookup)
+	if err != nil {
+		return nil, err
+	}
+	if request.RunEpoch == 0 {
+		return nil, fmt.Errorf("%w: run_epoch is required", ErrHostPrepareInvalid)
+	}
+	return m.runHostPrepareMutation(ctx, func(tx *sql.Tx) (*HostPrepareResult, error) {
+		row, result, err := lockHostPrepareLookup(ctx, tx, lookup)
+		if err != nil || result != nil {
+			return result, err
+		}
+		if row.Status == HostPrepareStatusOutcomeUnknown {
+			if row.RunEpoch != request.RunEpoch {
+				return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_run_epoch_conflict"), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_outcome_unknown_replayed", true), nil
+		}
+		if row.Status != HostPrepareStatusRunning {
+			return hostPrepareResultFromRow(row, "prepare_unknown_fenced", true), nil
+		}
+		if row.RunEpoch != request.RunEpoch {
+			return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_run_epoch_conflict"), nil
+		}
+		claimCurrent, fenceReason, err := hostPrepareExecutionClaimCurrent(ctx, tx, row)
+		if err != nil {
+			return nil, err
+		}
+		if !claimCurrent {
+			if err := fenceHostPrepareRequestTx(ctx, tx, row, fenceReason); err != nil {
+				return nil, err
+			}
+			return hostPrepareResultFromRow(row, "prepare_unknown_fenced", false), nil
+		}
+		write, err := tx.ExecContext(ctx, `
+			UPDATE host_prepare_requests
+			SET status = 'outcome_unknown', failure_code = 'prepare_outcome_unknown',
+				    failure_retryable = FALSE, external_call_disposition = 'unknown',
+			    finished_at = UTC_TIMESTAMP(3)
+			WHERE prepare_key = ? AND request_fingerprint = ?
+			  AND status = 'running' AND run_epoch = ?
+		`, row.PrepareKey, row.RequestFingerprint, row.RunEpoch)
+		if err != nil {
+			return nil, err
+		}
+		if err := requireHostPrepareRowsAffected(write, "outcome unknown"); err != nil {
+			return nil, err
+		}
+		row.Status = HostPrepareStatusOutcomeUnknown
+		row.FailureCode = "prepare_outcome_unknown"
+		row.FailureRetryable = false
+		row.ExternalCallDisposition = "unknown"
+		return hostPrepareResultFromRow(row, "prepare_outcome_unknown", false), nil
+	})
+}
+
+func (m *mariadbStore) SkipHostPrepare(ctx context.Context, request HostPrepareSkipRequest) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	lookup, err := normalizeHostPrepareLookup(request.HostPrepareLookup)
+	if err != nil {
+		return nil, err
+	}
+	skipEventID, err := normalizeHostSessionExecutionIdentifier("skip_event_id", request.SkipEventID, 255)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	skipReason := strings.ToLower(strings.TrimSpace(request.SkipReason))
+	if !hostPrepareSkipReasonAllowed(skipReason) {
+		return nil, fmt.Errorf("%w: unsupported skip_reason %q", ErrHostPrepareInvalid, skipReason)
+	}
+	return m.runHostPrepareMutation(ctx, func(tx *sql.Tx) (*HostPrepareResult, error) {
+		row, result, err := lockHostPrepareLookup(ctx, tx, lookup)
+		if err != nil || result != nil {
+			return result, err
+		}
+		if row.Status == HostPrepareStatusSkipped {
+			if row.SkipEventID != skipEventID || row.SkipReason != skipReason {
+				return newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_skip_conflict"), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_skip_replayed", true), nil
+		}
+		if row.Status == HostPrepareStatusFenced && row.ExecutionClaimReleased {
+			return hostPrepareResultFromRow(row, "prepare_already_fenced", true), nil
+		}
+		if _, err := selectHostSessionExecutionOutcomeByOperation(ctx, tx, row.HostInstanceID, row.OperationID, true); err == nil {
+			if row.Status == HostPrepareStatusRegistered || row.Status == HostPrepareStatusRunning {
+				if err := fenceHostPrepareRequestTx(ctx, tx, row, "execution_already_terminal"); err != nil {
+					return nil, err
+				}
+				return hostPrepareResultFromRow(row, "prepare_skip_fenced", false), nil
+			}
+			return hostPrepareResultFromRow(row, "prepare_skip_after_terminal_ignored", true), nil
+		} else if !errors.Is(err, ErrNotFound) {
+			return nil, err
+		}
+		write, err := tx.ExecContext(ctx, `
+			UPDATE host_prepare_requests
+			SET status = 'skipped', result_json = NULL, result_hash = NULL,
+			    failure_code = NULL, failure_retryable = NULL,
+			    skip_event_id = ?, skip_reason = ?, finished_at = UTC_TIMESTAMP(3)
+			WHERE prepare_key = ? AND request_fingerprint = ? AND status <> 'skipped'
+		`, skipEventID, skipReason, row.PrepareKey, row.RequestFingerprint)
+		if err != nil {
+			return nil, err
+		}
+		if err := requireHostPrepareRowsAffected(write, "skip"); err != nil {
+			return nil, err
+		}
+		row.Status = HostPrepareStatusSkipped
+		row.ResultJSON = ""
+		row.ResultHash = ""
+		row.FailureCode = ""
+		row.FailureRetryable = false
+		row.SkipEventID = skipEventID
+		row.SkipReason = skipReason
+		released, err := releaseHostPrepareExecutionForSkipTx(ctx, tx, row)
+		if err != nil {
+			return nil, err
+		}
+		if released {
+			write, err := tx.ExecContext(ctx, `
+				UPDATE host_prepare_requests
+				SET execution_claim_released = TRUE
+				WHERE prepare_key = ? AND request_fingerprint = ? AND status = 'skipped'
+			`, row.PrepareKey, row.RequestFingerprint)
+			if err != nil {
+				return nil, err
+			}
+			if err := requireHostPrepareRowsAffected(write, "skip release receipt"); err != nil {
+				return nil, err
+			}
+			row.ExecutionClaimReleased = true
+		}
+		result = hostPrepareResultFromRow(row, "prepare_skipped", false)
+		return result, nil
+	})
+}
+
+func (m *mariadbStore) GetHostPrepare(ctx context.Context, lookup HostPrepareLookup) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	normalized, err := normalizeHostPrepareLookup(lookup)
+	if err != nil {
+		return nil, err
+	}
+	row, err := selectHostPrepareRequest(ctx, m.db, normalized.PrepareKey, false)
+	if errors.Is(err, ErrNotFound) {
+		return newHostPrepareResult(HostPrepareStatusRejected, "prepare_not_found", normalized.PrepareKey, normalized.RequestFingerprint), nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if row.ContractVersion != HostPrepareRegistryContractVersion {
+		return nil, fmt.Errorf("unsupported host prepare contract %q", row.ContractVersion)
+	}
+	if !hostPrepareStatusAllowed(row.Status) {
+		return nil, fmt.Errorf("unsupported host prepare status %q", row.Status)
+	}
+	if row.RequestFingerprint != normalized.RequestFingerprint {
+		return newHostPrepareConflictResult(normalized.PrepareKey, normalized.RequestFingerprint, "prepare_fingerprint_conflict"), nil
+	}
+	return hostPrepareResultFromRow(row, "prepare_status", true), nil
+}
+
+func (m *mariadbStore) GetHostPrepareByKey(ctx context.Context, prepareKey string) (*HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	prepareKey, err := normalizeHostSessionExecutionIdentifier("prepare_key", prepareKey, 96)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrHostPrepareInvalid, err)
+	}
+	row, err := selectHostPrepareRequest(ctx, m.db, prepareKey, false)
+	if err != nil {
+		return nil, err
+	}
+	if row.ContractVersion != HostPrepareRegistryContractVersion || !hostPrepareStatusAllowed(row.Status) {
+		return nil, fmt.Errorf("unsupported durable host prepare row")
+	}
+	return hostPrepareResultFromRow(row, "prepare_recovery_status", true), nil
+}
+
+func (m *mariadbStore) ListRunningHostPrepares(ctx context.Context, limit int) ([]HostPrepareResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	if limit <= 0 || limit > 1000 {
+		return nil, fmt.Errorf("%w: running prepare limit must be between 1 and 1000", ErrHostPrepareInvalid)
+	}
+	rows, err := m.db.QueryContext(ctx, `
+		SELECT prepare_key, contract_version, host_instance_id,
+		       stable_character_id, host_chat_id, canonical_session_id,
+		       binding_epoch, operation_id, claim_epoch, main_request_id,
+		       request_fingerprint, execution_context_id,
+		       settings_snapshot_digest, input_receipt_id,
+		       COALESCE(source_revision, ''), semantic_payload_hash,
+		       request_type, protocol_version, status, run_epoch,
+		       COALESCE(external_operation_id, ''), COALESCE(result_json, ''),
+		       COALESCE(result_hash, ''), COALESCE(failure_code, ''),
+		       COALESCE(failure_retryable, FALSE), external_call_disposition,
+		       COALESCE(skip_event_id, ''), COALESCE(skip_reason, ''),
+		       execution_claim_released
+		FROM host_prepare_requests
+		WHERE status = 'running'
+		ORDER BY started_at, prepare_key
+		LIMIT ?
+	`, limit)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	results := make([]HostPrepareResult, 0)
+	for rows.Next() {
+		var row hostPrepareRequestRow
+		if err := rows.Scan(
+			&row.PrepareKey, &row.ContractVersion, &row.HostInstanceID,
+			&row.StableCharacterID, &row.HostChatID, &row.CanonicalSessionID,
+			&row.BindingEpoch, &row.OperationID, &row.ClaimEpoch, &row.MainRequestID,
+			&row.RequestFingerprint, &row.ExecutionContextID,
+			&row.SettingsSnapshotDigest, &row.InputReceiptID, &row.SourceRevision,
+			&row.SemanticPayloadHash, &row.RequestType, &row.ProtocolVersion,
+			&row.Status, &row.RunEpoch, &row.ExternalOperationID,
+			&row.ResultJSON, &row.ResultHash, &row.FailureCode,
+			&row.FailureRetryable, &row.ExternalCallDisposition,
+			&row.SkipEventID, &row.SkipReason, &row.ExecutionClaimReleased,
+		); err != nil {
+			return nil, err
+		}
+		results = append(results, *hostPrepareResultFromRow(&row, "prepare_running_recovery", true))
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return results, nil
+}
+
+func (m *mariadbStore) runHostPrepareMutation(ctx context.Context, mutate func(*sql.Tx) (*HostPrepareResult, error)) (*HostPrepareResult, error) {
+	for attempt := 1; attempt <= hostSessionExecutionTransactionMaxAttempts; attempt++ {
+		tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelSerializable})
+		if err != nil {
+			if !isRetryableHostCoordinationTransactionError(err) || attempt == hostSessionExecutionTransactionMaxAttempts {
+				return nil, err
+			}
+			if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+				return nil, err
+			}
+			continue
+		}
+		result, mutationErr := mutate(tx)
+		if mutationErr == nil {
+			mutationErr = tx.Commit()
+		}
+		if mutationErr != nil {
+			_ = tx.Rollback()
+		}
+		if mutationErr == nil {
+			return result, nil
+		}
+		if !isRetryableHostCoordinationTransactionError(mutationErr) || attempt == hostSessionExecutionTransactionMaxAttempts {
+			return nil, mutationErr
+		}
+		if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+			return nil, err
+		}
+	}
+	return nil, errors.New("host prepare transaction exhausted without result")
+}
+
+func lockHostPrepareLookup(ctx context.Context, tx *sql.Tx, lookup HostPrepareLookup) (*hostPrepareRequestRow, *HostPrepareResult, error) {
+	row, err := selectHostPrepareRequest(ctx, tx, lookup.PrepareKey, true)
+	if errors.Is(err, ErrNotFound) {
+		return nil, newHostPrepareResult(HostPrepareStatusRejected, "prepare_not_found", lookup.PrepareKey, lookup.RequestFingerprint), nil
+	}
+	if err != nil {
+		return nil, nil, err
+	}
+	if row.RequestFingerprint != lookup.RequestFingerprint {
+		return nil, newHostPrepareConflictResult(lookup.PrepareKey, lookup.RequestFingerprint, "prepare_fingerprint_conflict"), nil
+	}
+	if row.ContractVersion != HostPrepareRegistryContractVersion {
+		return nil, nil, fmt.Errorf("unsupported host prepare contract %q", row.ContractVersion)
+	}
+	if !hostPrepareStatusAllowed(row.Status) {
+		return nil, nil, fmt.Errorf("unsupported host prepare status %q", row.Status)
+	}
+	return row, nil, nil
+}
+
+func hostPrepareExecutionClaimCurrent(ctx context.Context, tx *sql.Tx, row *hostPrepareRequestRow) (bool, string, error) {
+	binding, err := selectSessionRouteBindingTx(ctx, tx, row.StableCharacterID, row.HostChatID, true)
+	if errors.Is(err, ErrNotFound) {
+		return false, "binding_not_found", nil
+	}
+	if err != nil {
+		return false, "", err
+	}
+	if !hostSessionExecutionBindingUsable(binding) ||
+		binding.CanonicalSessionID != row.CanonicalSessionID ||
+		SessionRouteBindingEpoch(*binding) != row.BindingEpoch {
+		return false, "binding_changed", nil
+	}
+	slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, row.CanonicalSessionID, true)
+	if errors.Is(err, ErrNotFound) {
+		return false, "execution_claim_changed", nil
+	}
+	if err != nil {
+		return false, "", err
+	}
+	identity := HostPrepareIdentity{
+		HostInstanceID: row.HostInstanceID, StableCharacterID: row.StableCharacterID,
+		HostChatID: row.HostChatID, BindingEpoch: row.BindingEpoch,
+		OperationID: row.OperationID, ClaimEpoch: row.ClaimEpoch, MainRequestID: row.MainRequestID,
+	}
+	if !hostPrepareSlotMatchesIdentity(slot, identity, row.CanonicalSessionID) {
+		return false, "execution_claim_changed", nil
+	}
+	if !hostPrepareSlotAllowsPreparation(slot) {
+		return false, "host_changes_not_safe", nil
+	}
+	return true, "", nil
+}
+
+func hostPrepareSlotMatchesIdentity(slot *hostSessionExecutionSlot, identity HostPrepareIdentity, canonicalSessionID string) bool {
+	return slot != nil && slot.ContractVersion == HostSessionExecutionContractVersion &&
+		slot.CanonicalSessionID == canonicalSessionID &&
+		slot.ActiveHostInstanceID == identity.HostInstanceID &&
+		slot.ActiveStableCharacterID == identity.StableCharacterID &&
+		slot.ActiveHostChatID == identity.HostChatID &&
+		slot.ActiveBindingEpoch == identity.BindingEpoch &&
+		slot.ActiveOperationID == identity.OperationID &&
+		slot.ClaimEpoch == identity.ClaimEpoch && slot.Phase == "claimed"
+}
+
+func hostPrepareSlotAllowsPreparation(slot *hostSessionExecutionSlot) bool {
+	return slot != nil && slot.SafeHostChangeSeq >= slot.RequiredHostChangeSeq &&
+		slot.SafeHostChangeSeq >= slot.IngestedHostChangeSeq
+}
+
+func fenceHostPrepareRequestTx(ctx context.Context, tx *sql.Tx, row *hostPrepareRequestRow, reason string) error {
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_prepare_requests
+		SET status = 'fenced', result_json = NULL, result_hash = NULL,
+		    failure_code = ?, failure_retryable = FALSE,
+		    finished_at = UTC_TIMESTAMP(3)
+		WHERE prepare_key = ? AND request_fingerprint = ?
+		  AND status IN ('registered_not_started', 'running')
+	`, reason, row.PrepareKey, row.RequestFingerprint)
+	if err != nil {
+		return err
+	}
+	if err := requireHostPrepareRowsAffected(write, "fence"); err != nil {
+		return err
+	}
+	row.Status = HostPrepareStatusFenced
+	row.ResultJSON = ""
+	row.ResultHash = ""
+	row.FailureCode = reason
+	row.FailureRetryable = false
+	return nil
+}
+
+func releaseHostPrepareExecutionForSkipTx(ctx context.Context, tx *sql.Tx, row *hostPrepareRequestRow) (bool, error) {
+	slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, row.CanonicalSessionID, true)
+	if errors.Is(err, ErrNotFound) {
+		return false, nil
+	}
+	if err != nil {
+		return false, err
+	}
+	identity := HostPrepareIdentity{
+		HostInstanceID: row.HostInstanceID, StableCharacterID: row.StableCharacterID,
+		HostChatID: row.HostChatID, BindingEpoch: row.BindingEpoch,
+		OperationID: row.OperationID, ClaimEpoch: row.ClaimEpoch, MainRequestID: row.MainRequestID,
+	}
+	if !hostPrepareSlotMatchesIdentity(slot, identity, row.CanonicalSessionID) {
+		return false, nil
+	}
+	outcome := &hostSessionExecutionOutcome{
+		ContractVersion:       HostSessionExecutionContractVersion,
+		HostInstanceID:        row.HostInstanceID,
+		StableCharacterID:     row.StableCharacterID,
+		HostChatID:            row.HostChatID,
+		CanonicalSessionID:    row.CanonicalSessionID,
+		BindingEpoch:          row.BindingEpoch,
+		OperationID:           row.OperationID,
+		ClaimEpoch:            row.ClaimEpoch,
+		EndEventID:            row.SkipEventID,
+		RequestedEndReason:    "ac_skipped_prepare_unavailable",
+		EndReason:             "ac_skipped_prepare_unavailable",
+		TerminalPhase:         hostSessionExecutionTerminalPhase("ac_skipped_prepare_unavailable"),
+		SourceDisposition:     "not_stored",
+		RequiredHostChangeSeq: slot.RequiredHostChangeSeq,
+		SafeHostChangeSeq:     slot.SafeHostChangeSeq,
+	}
+	if _, err := tx.ExecContext(ctx, `
+		INSERT INTO host_session_execution_outcomes (
+			contract_version, host_instance_id, stable_character_id, host_chat_id,
+			canonical_session_id, binding_epoch, operation_id, claim_epoch,
+			end_event_id, requested_end_reason, end_reason, terminal_phase, source_disposition,
+			final_required_host_change_seq, final_safe_host_change_seq
+		) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+	`, outcome.ContractVersion, outcome.HostInstanceID, outcome.StableCharacterID,
+		outcome.HostChatID, outcome.CanonicalSessionID, outcome.BindingEpoch,
+		outcome.OperationID, outcome.ClaimEpoch, outcome.EndEventID,
+		outcome.RequestedEndReason, outcome.EndReason, outcome.TerminalPhase,
+		outcome.SourceDisposition, outcome.RequiredHostChangeSeq, outcome.SafeHostChangeSeq); err != nil {
+		return false, err
+	}
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_session_execution_slots
+		SET active_host_instance_id = NULL,
+		    active_stable_character_id = NULL,
+		    active_host_chat_id = NULL,
+		    active_binding_epoch = NULL,
+		    active_operation_id = NULL,
+		    phase = 'idle', required_host_change_seq = 0, claimed_at = NULL
+		WHERE canonical_session_id = ?
+		  AND active_host_instance_id = ?
+		  AND active_operation_id = ?
+		  AND claim_epoch = ?
+	`, row.CanonicalSessionID, row.HostInstanceID, row.OperationID, row.ClaimEpoch)
+	if err != nil {
+		return false, err
+	}
+	if err := requireHostPrepareRowsAffected(write, "skip release"); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+func requireHostPrepareRowsAffected(result sql.Result, operation string) error {
+	rows, err := result.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if rows != 1 {
+		return fmt.Errorf("host prepare %s lost compare-and-set", operation)
+	}
+	return nil
+}
+
+func hostPrepareSkipReasonAllowed(reason string) bool {
+	switch reason {
+	case "prepare_unavailable", "transport_timeout", "outcome_unknown", "node_disposition_skipped":
+		return true
+	default:
+		return false
+	}
+}
+
+func hostPrepareStatusAllowed(status string) bool {
+	switch status {
+	case HostPrepareStatusRegistered, HostPrepareStatusRunning, HostPrepareStatusReady,
+		HostPrepareStatusFailedKnown, HostPrepareStatusOutcomeUnknown,
+		HostPrepareStatusSkipped, HostPrepareStatusFenced:
+		return true
+	default:
+		return false
+	}
+}
+
+func hostPrepareKnownCallDisposition(started bool) string {
+	if started {
+		return "started"
+	}
+	return "not_started"
+}
+
+func selectHostPrepareRequest(ctx context.Context, queryer hostSessionExecutionQueryer, prepareKey string, forUpdate bool) (*hostPrepareRequestRow, error) {
+	query := `
+		SELECT prepare_key, contract_version, host_instance_id,
+		       stable_character_id, host_chat_id, canonical_session_id,
+		       binding_epoch, operation_id, claim_epoch, main_request_id,
+		       request_fingerprint, execution_context_id,
+		       settings_snapshot_digest, input_receipt_id,
+		       COALESCE(source_revision, ''), semantic_payload_hash,
+		       request_type, protocol_version, status, run_epoch,
+		       COALESCE(external_operation_id, ''), COALESCE(result_json, ''),
+		       COALESCE(result_hash, ''), COALESCE(failure_code, ''),
+		       COALESCE(failure_retryable, FALSE), external_call_disposition,
+		       COALESCE(skip_event_id, ''), COALESCE(skip_reason, ''),
+		       execution_claim_released
+		FROM host_prepare_requests
+		WHERE prepare_key = ?`
+	if forUpdate {
+		query += " FOR UPDATE"
+	}
+	var row hostPrepareRequestRow
+	err := queryer.QueryRowContext(ctx, query, prepareKey).Scan(
+		&row.PrepareKey, &row.ContractVersion, &row.HostInstanceID,
+		&row.StableCharacterID, &row.HostChatID, &row.CanonicalSessionID,
+		&row.BindingEpoch, &row.OperationID, &row.ClaimEpoch, &row.MainRequestID,
+		&row.RequestFingerprint, &row.ExecutionContextID,
+		&row.SettingsSnapshotDigest, &row.InputReceiptID, &row.SourceRevision,
+		&row.SemanticPayloadHash, &row.RequestType, &row.ProtocolVersion,
+		&row.Status, &row.RunEpoch, &row.ExternalOperationID,
+		&row.ResultJSON, &row.ResultHash, &row.FailureCode,
+		&row.FailureRetryable, &row.ExternalCallDisposition,
+		&row.SkipEventID, &row.SkipReason, &row.ExecutionClaimReleased,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &row, nil
+}
+
+func hostPrepareRowMatchesRegistration(row *hostPrepareRequestRow, request HostPrepareRegisterRequest, prepareKey, fingerprint string) bool {
+	return row != nil && row.ContractVersion == HostPrepareRegistryContractVersion &&
+		row.PrepareKey == prepareKey && row.RequestFingerprint == fingerprint &&
+		row.HostInstanceID == request.HostInstanceID &&
+		row.StableCharacterID == request.StableCharacterID &&
+		row.HostChatID == request.HostChatID && row.BindingEpoch == request.BindingEpoch &&
+		row.OperationID == request.OperationID && row.ClaimEpoch == request.ClaimEpoch &&
+		row.MainRequestID == request.MainRequestID &&
+		row.ExecutionContextID == request.ExecutionContextID &&
+		row.SettingsSnapshotDigest == request.SettingsSnapshotDigest &&
+		row.InputReceiptID == request.InputReceiptID && row.SourceRevision == request.SourceRevision &&
+		row.SemanticPayloadHash == request.SemanticPayloadHash &&
+		row.RequestType == request.RequestType && row.ProtocolVersion == request.ProtocolVersion
+}
+
+func hostPrepareRowFromRegistration(request HostPrepareRegisterRequest, prepareKey, fingerprint, canonicalSessionID string) *hostPrepareRequestRow {
+	return &hostPrepareRequestRow{
+		PrepareKey: prepareKey, ContractVersion: HostPrepareRegistryContractVersion,
+		HostInstanceID: request.HostInstanceID, StableCharacterID: request.StableCharacterID,
+		HostChatID: request.HostChatID, CanonicalSessionID: canonicalSessionID,
+		BindingEpoch: request.BindingEpoch, OperationID: request.OperationID,
+		ClaimEpoch: request.ClaimEpoch, MainRequestID: request.MainRequestID,
+		RequestFingerprint: fingerprint, ExecutionContextID: request.ExecutionContextID,
+		SettingsSnapshotDigest: request.SettingsSnapshotDigest, InputReceiptID: request.InputReceiptID,
+		SourceRevision: request.SourceRevision, SemanticPayloadHash: request.SemanticPayloadHash,
+		RequestType: request.RequestType, ProtocolVersion: request.ProtocolVersion,
+		Status: HostPrepareStatusRegistered, ExternalCallDisposition: "not_recorded",
+	}
+}
+
+func newHostPrepareResult(status, reason, prepareKey, fingerprint string) *HostPrepareResult {
+	return &HostPrepareResult{
+		ContractVersion: HostPrepareRegistryContractVersion,
+		Status:          status, ReasonCode: reason,
+		PrepareKey: prepareKey, RequestFingerprint: fingerprint,
+	}
+}
+
+func newHostPrepareConflictResult(prepareKey, fingerprint, reason string) *HostPrepareResult {
+	return newHostPrepareResult(HostPrepareStatusConflict, reason, prepareKey, fingerprint)
+}
+
+func hostPrepareResultFromRow(row *hostPrepareRequestRow, reason string, reused bool) *HostPrepareResult {
+	if row == nil {
+		return newHostPrepareResult(HostPrepareStatusRejected, reason, "", "")
+	}
+	result := newHostPrepareResult(row.Status, reason, row.PrepareKey, row.RequestFingerprint)
+	result.HostInstanceID = row.HostInstanceID
+	result.StableCharacterID = row.StableCharacterID
+	result.HostChatID = row.HostChatID
+	result.ResolvedSessionID = row.CanonicalSessionID
+	result.BindingEpoch = row.BindingEpoch
+	result.OperationID = row.OperationID
+	result.ClaimEpoch = row.ClaimEpoch
+	result.MainRequestID = row.MainRequestID
+	result.RunEpoch = row.RunEpoch
+	result.ExternalOperationID = row.ExternalOperationID
+	result.ExecutionContextID = row.ExecutionContextID
+	result.SettingsSnapshotDigest = row.SettingsSnapshotDigest
+	result.InputReceiptID = row.InputReceiptID
+	result.SourceRevision = row.SourceRevision
+	result.SemanticPayloadHash = row.SemanticPayloadHash
+	result.RequestType = row.RequestType
+	result.ProtocolVersion = row.ProtocolVersion
+	result.ResultJSON = row.ResultJSON
+	result.ResultHash = row.ResultHash
+	result.FailureCode = row.FailureCode
+	result.FailureRetryable = row.FailureRetryable
+	result.ExternalCallDisposition = row.ExternalCallDisposition
+	result.SkipEventID = row.SkipEventID
+	result.SkipReason = row.SkipReason
+	result.ExecutionClaimReleased = row.ExecutionClaimReleased
+	result.Reused = reused
+	return result
+}
