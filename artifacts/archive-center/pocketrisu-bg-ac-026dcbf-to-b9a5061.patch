+func (r *pocketRisuExecutionContextRegistry) capture(
+	request pocketRisuExecutionContextCaptureRequest,
+	backend pocketRisuExecutionBackendSnapshot,
+) (*pocketRisuExecutionContextResult, error) {
+	if r == nil {
+		return nil, errors.New("PocketRisu execution context registry is unavailable")
+	}
+	normalized, err := normalizePocketRisuExecutionContextCapture(request)
+	if err != nil {
+		return nil, err
+	}
+	backend, err = normalizePocketRisuExecutionBackendSnapshot(backend)
+	if err != nil {
+		return nil, err
+	}
+	identityBytes, err := json.Marshal(normalized.Identity)
+	if err != nil {
+		return nil, err
+	}
+	identityKey := pocketRisuExecutionContextIdentityKey(identityBytes)
+	materialBytes, err := json.Marshal(pocketRisuExecutionContextMaterial{
+		Device: normalized.Device, Backend: backend,
+	})
+	if err != nil {
+		return nil, err
+	}
+	if len(materialBytes) == 0 || len(materialBytes) > pocketRisuExecutionContextMaxRecordBytes {
+		return nil, fmt.Errorf("%w: encoded context exceeds the per-context bound", errPocketRisuExecutionContextInvalid)
+	}
+	fingerprintHash := sha256.Sum256(append(append([]byte(nil), identityBytes...), materialBytes...))
+	fingerprint := hex.EncodeToString(fingerprintHash[:])
+	settingsDigest, err := pocketRisuExecutionContextPublicDigest(normalized.Device, backend)
+	if err != nil {
+		return nil, err
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if existing := r.byIdentity[identityKey]; existing != nil {
+		if existing.fingerprint != fingerprint {
+			return newPocketRisuExecutionContextResult(
+				pocketRisuExecutionContextStatusConflict,
+				"execution_context_fingerprint_conflict",
+			), nil
+		}
+		result := existing.result
+		result.Reused = true
+		return &result, nil
+	}
+	if released := r.releasedByIdentity[identityKey]; released != nil {
+		if released.fingerprint != fingerprint {
+			return newPocketRisuExecutionContextResult(
+				pocketRisuExecutionContextStatusConflict,
+				"execution_context_fingerprint_conflict",
+			), nil
+		}
+		result := released.result
+		result.Reused = true
+		return &result, nil
+	}
+	if len(r.byIdentity) >= r.maxEntries || r.totalBytes+len(materialBytes) > r.maxBytes {
+		return newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusCapacity,
+			"execution_context_capacity",
+		), nil
+	}
+	contextID, err := r.newID()
+	if err != nil {
+		return nil, err
+	}
+	if _, exists := r.byID[contextID]; exists {
+		return nil, errors.New("PocketRisu execution context identity collision")
+	}
+	result := pocketRisuExecutionContextResult{
+		ContractVersion:    pocketRisuExecutionContextContractVersion,
+		Status:             pocketRisuExecutionContextStatusCaptured,
+		ReasonCode:         "execution_context_captured",
+		ExecutionContextID: contextID,
+		SettingsDigest:     settingsDigest,
+		BackendInstanceID:  backend.BackendInstanceID,
+	}
+	record := &pocketRisuExecutionContextRecord{
+		identityKey: identityKey,
+		identity:    normalized.Identity,
+		fingerprint: fingerprint,
+		material:    append([]byte(nil), materialBytes...),
+		result:      result,
+	}
+	r.byIdentity[identityKey] = record
+	r.byID[contextID] = record
+	r.totalBytes += len(materialBytes)
+	copyResult := result
+	return &copyResult, nil
+}
+
+func (r *pocketRisuExecutionContextRegistry) load(
+	contextID string,
+	identity pocketRisuExecutionContextIdentity,
+) (*pocketRisuExecutionContextMaterial, *pocketRisuExecutionContextResult, error) {
+	if r == nil {
+		return nil, newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusMissing,
+			"execution_context_unavailable",
+		), nil
+	}
+	normalizedIdentity, err := normalizePocketRisuExecutionContextIdentity(identity)
+	if err != nil {
+		return nil, nil, err
+	}
+	contextID, err = boundedPocketRisuExecutionContextText("execution_context_id", contextID, 96, true)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	record := r.byID[contextID]
+	if record == nil {
+		if released := r.releasedByID[contextID]; released != nil {
+			if released.identity != normalizedIdentity {
+				return nil, newPocketRisuExecutionContextResult(
+					pocketRisuExecutionContextStatusConflict,
+					"execution_context_owner_conflict",
+				), nil
+			}
+			result := released.result
+			result.Reused = true
+			return nil, &result, nil
+		}
+		return nil, newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusMissing,
+			"execution_context_unavailable",
+		), nil
+	}
+	if record.identity != normalizedIdentity {
+		return nil, newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusConflict,
+			"execution_context_owner_conflict",
+		), nil
+	}
+	var material pocketRisuExecutionContextMaterial
+	if err := json.Unmarshal(record.material, &material); err != nil {
+		return nil, nil, err
+	}
+	result := record.result
+	result.Reused = true
+	return &material, &result, nil
+}
+
+func (r *pocketRisuExecutionContextRegistry) release(
+	contextID string,
+	identity pocketRisuExecutionContextIdentity,
+	reason string,
+) (*pocketRisuExecutionContextResult, error) {
+	if r == nil {
+		return newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusMissing,
+			"execution_context_unavailable",
+		), nil
+	}
+	normalizedIdentity, err := normalizePocketRisuExecutionContextIdentity(identity)
+	if err != nil {
+		return nil, err
+	}
+	contextID, err = boundedPocketRisuExecutionContextText("execution_context_id", contextID, 96, true)
+	if err != nil {
+		return nil, err
+	}
+	reason, err = normalizePocketRisuExecutionContextReleaseReason(reason)
+	if err != nil {
+		return nil, err
+	}
+
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if released := r.releasedByID[contextID]; released != nil {
+		if released.identity != normalizedIdentity {
+			return newPocketRisuExecutionContextResult(
+				pocketRisuExecutionContextStatusConflict,
+				"execution_context_owner_conflict",
+			), nil
+		}
+		result := released.result
+		if result.ReleaseReason != reason {
+			return newPocketRisuExecutionContextResult(
+				pocketRisuExecutionContextStatusConflict,
+				"execution_context_release_conflict",
+			), nil
+		}
+		result.Reused = true
+		return &result, nil
+	}
+	record := r.byID[contextID]
+	if record == nil {
+		return newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusMissing,
+			"execution_context_unavailable",
+		), nil
+	}
+	if record.identity != normalizedIdentity {
+		return newPocketRisuExecutionContextResult(
+			pocketRisuExecutionContextStatusConflict,
+			"execution_context_owner_conflict",
+		), nil
+	}
+	delete(r.byID, contextID)
+	delete(r.byIdentity, record.identityKey)
+	r.totalBytes -= len(record.material)
+	if r.totalBytes < 0 {
+		r.totalBytes = 0
+	}
+	for index := range record.material {
+		record.material[index] = 0
+	}
+	record.material = nil
+	record.result.Status = pocketRisuExecutionContextStatusReleased
+	record.result.ReasonCode = "execution_context_released"
+	record.result.ReleaseReason = reason
+	record.result.Reused = false
+	r.releasedByID[contextID] = record
+	r.releasedByIdentity[record.identityKey] = record
+	r.releaseOrder = append(r.releaseOrder, contextID)
+	r.compactReleasedLocked()
+	result := record.result
+	return &result, nil
+}
+
+func (r *pocketRisuExecutionContextRegistry) discard(
+	contextID string,
+	identity pocketRisuExecutionContextIdentity,
+) bool {
+	if r == nil {
+		return false
+	}
+	normalizedIdentity, err := normalizePocketRisuExecutionContextIdentity(identity)
+	if err != nil {
+		return false
+	}
+	contextID = strings.TrimSpace(contextID)
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	record := r.byID[contextID]
+	if record == nil || record.identity != normalizedIdentity {
+		return false
+	}
+	delete(r.byID, contextID)
+	delete(r.byIdentity, record.identityKey)
+	r.totalBytes -= len(record.material)
+	if r.totalBytes < 0 {
+		r.totalBytes = 0
+	}
+	for index := range record.material {
+		record.material[index] = 0
+	}
+	return true
+}
+
+func (r *pocketRisuExecutionContextRegistry) compactReleasedLocked() {
+	for len(r.releaseOrder) > r.maxTombstones {
+		contextID := r.releaseOrder[0]
+		r.releaseOrder = r.releaseOrder[1:]
+		record := r.releasedByID[contextID]
+		if record == nil {
+			continue
+		}
+		delete(r.releasedByID, contextID)
+		if r.releasedByIdentity[record.identityKey] == record {
+			delete(r.releasedByIdentity, record.identityKey)
+		}
+	}
+}
+
+func (r *pocketRisuExecutionContextRegistry) stats() (contexts, bytes, maxContexts, maxBytes int) {
+	if r == nil {
+		return 0, 0, 0, 0
+	}
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return len(r.byIdentity), r.totalBytes, r.maxEntries, r.maxBytes
+}
+
+func newPocketRisuExecutionContextID() (string, error) {
+	var value [24]byte
+	if _, err := rand.Read(value[:]); err != nil {
+		return "", err
+	}
+	return "execution_context_v1_" + hex.EncodeToString(value[:]), nil
+}
+
+func pocketRisuExecutionContextIdentityKey(identityBytes []byte) string {
+	identityHash := sha256.Sum256(identityBytes)
+	return hex.EncodeToString(identityHash[:])
+}
+
+func normalizePocketRisuExecutionContextReleaseReason(reason string) (string, error) {
+	reason = strings.ToLower(strings.TrimSpace(reason))
+	switch reason {
+	case "completed", "invalid_input", "source_changed", "model_failed",
+		"cancelled", "deleted", "conflict_copy",
+		"ac_skipped_prepare_unavailable", "invalidated", "abandoned",
+		"prepare_skipped":
+		return reason, nil
+	default:
+		return "", fmt.Errorf("%w: unsupported release_reason %q", errPocketRisuExecutionContextInvalid, reason)
+	}
+}
+
+func normalizePocketRisuExecutionContextCapture(
+	request pocketRisuExecutionContextCaptureRequest,
+) (pocketRisuExecutionContextCaptureRequest, error) {
+	identity, err := normalizePocketRisuExecutionContextIdentity(request.Identity)
+	if err != nil {
+		return request, err
+	}
+	device, err := normalizePocketRisuExecutionDeviceSnapshot(request.Device)
+	if err != nil {
+		return request, err
+	}
+	request.Identity = identity
+	request.Device = device
+	return request, nil
+}
+
+func normalizePocketRisuExecutionContextIdentity(
+	identity pocketRisuExecutionContextIdentity,
+) (pocketRisuExecutionContextIdentity, error) {
+	var err error
+	if identity.HostInstanceID, err = boundedPocketRisuExecutionContextText("host_instance_id", identity.HostInstanceID, 255, true); err != nil {
+		return identity, err
+	}
+	if identity.StableCharacterID, err = boundedPocketRisuExecutionContextText("stable_character_id", identity.StableCharacterID, 255, true); err != nil {
+		return identity, err
+	}
+	if identity.HostChatID, err = boundedPocketRisuExecutionContextText("host_chat_id", identity.HostChatID, 255, true); err != nil {
+		return identity, err
+	}
+	if identity.BindingEpoch, err = boundedPocketRisuExecutionContextText("binding_epoch", identity.BindingEpoch, 96, true); err != nil {
+		return identity, err
+	}
+	if identity.OperationID, err = boundedPocketRisuExecutionContextText("operation_id", identity.OperationID, 255, true); err != nil {
+		return identity, err
+	}
+	if identity.ClaimEpoch == 0 {
+		return identity, fmt.Errorf("%w: claim_epoch must be positive", errPocketRisuExecutionContextInvalid)
+	}
+	return identity, nil
+}
+
+func normalizePocketRisuExecutionDeviceSnapshot(
+	device pocketRisuExecutionDeviceSnapshot,
+) (pocketRisuExecutionDeviceSnapshot, error) {
+	var err error
+	if strings.TrimSpace(device.ContractVersion) != pocketRisuExecutionContextContractVersion {
+		return device, fmt.Errorf("%w: unsupported contract_version", errPocketRisuExecutionContextInvalid)
+	}
+	device.ContractVersion = pocketRisuExecutionContextContractVersion
+	prepare := &device.Prepare
+	if err := requirePocketRisuExecutionEnum("guide_mode", prepare.GuideMode,
+		"auto", "off", "standard", "romantic", "action", "mature_soft", "mature_direct"); err != nil {
+		return device, err
+	}
+	if err := requirePocketRisuExecutionEnum("guide_strength", prepare.GuideStrength,
+		"none", "weak", "medium", "strong", "extreme", "maximum"); err != nil {
+		return device, err
+	}
+	if err := requirePocketRisuExecutionEnum("apply_mode", prepare.ApplyMode,
+		"off", "shadow", "reviewed_apply"); err != nil {
+		return device, err
+	}
+	if err := requirePocketRisuExecutionEnum("takeover_mode", prepare.TakeoverMode, "off"); err != nil {
+		return device, err
+	}
+	if err := requirePocketRisuExecutionEnum("memory_transport_mode", prepare.MemoryTransportMode,
+		"text", "google_pdf", "llm_gateway_pdf", "provider_manager_pdf"); err != nil {
+		return device, err
+	}
+	if err := requirePocketRisuExecutionEnum("turn_finalization_mode", prepare.TurnFinalizationMode,
+		"immediate_after_response", "next_user_input"); err != nil {
+		return device, err
+	}
+	if err := requirePocketRisuExecutionEnum("memory_delivery_budget_mode", prepare.MemoryDeliveryBudgetMode,
+		"auto", "custom"); err != nil {
+		return device, err
+	}
+	if err := requirePocketRisuExecutionEnum("lorebook_reference_mode", prepare.LorebookReferenceMode,
+		"search_only", "reference_assist"); err != nil {
+		return device, err
+	}
+	if prepare.NarrativeStance, err = boundedPocketRisuExecutionContextText(
+		"narrative_stance", prepare.NarrativeStance, 128, true,
+	); err != nil {
+		return device, err
+	}
+	if len(prepare.MemoryDeliveryBudgets) != len(pocketRisuMemoryDeliveryBudgetKeys) {
+		return device, fmt.Errorf("%w: memory_delivery_budgets must contain the exact allowlist", errPocketRisuExecutionContextInvalid)
+	}
+	budgets := make(map[string]int, len(prepare.MemoryDeliveryBudgets))
+	for _, key := range pocketRisuMemoryDeliveryBudgetKeys {
+		value, ok := prepare.MemoryDeliveryBudgets[key]
+		if !ok || value < 0 || value > 50000 {
+			return device, fmt.Errorf("%w: invalid memory delivery budget %q", errPocketRisuExecutionContextInvalid, key)
+		}
+		budgets[key] = value
+	}
+	prepare.MemoryDeliveryBudgets = budgets
+	for name, value := range map[string]int{
+		"max_injection_chars":                    prepare.MaxInjectionChars,
+		"reference_injection_budget_basis_chars": prepare.ReferenceInjectionBudgetBasisChars,
+		"lorebook_reference_max_chars":           prepare.LorebookReferenceMaxChars,
+		"reference_recall_limit":                 prepare.ReferenceRecallLimit,
+		"primary_canon_base_max_chars":           prepare.PrimaryCanonBaseMaxChars,
+		"max_input_context_chars":                prepare.MaxInputContextChars,
+		"episode_interval_turns":                 prepare.EpisodeIntervalTurns,
+		"recent_conversation_reference_count":    prepare.RecentConversationReferenceCount,
+		"core_objective_memory_max_items":        prepare.CoreObjectiveMemoryMaxItems,
+		"top_k":                                  prepare.TopK,
+		"narrative_support_max_chars":            device.NarrativeSupportMaxChars,
+		"chapter_interval_episodes":              device.ChapterIntervalEpisodes,
+		"arc_interval_chapters":                  device.ArcIntervalChapters,
+		"saga_interval_arcs":                     device.SagaIntervalArcs,
+	} {
+		minimum := 0
+		if name == "episode_interval_turns" || name == "recent_conversation_reference_count" || name == "top_k" ||
+			name == "core_objective_memory_max_items" || name == "chapter_interval_episodes" ||
+			name == "arc_interval_chapters" || name == "saga_interval_arcs" {
+			minimum = 1
+		}
+		if value < minimum || value > 1_000_000 {
+			return device, fmt.Errorf("%w: %s is out of range", errPocketRisuExecutionContextInvalid, name)
+		}
+	}
+	if prepare.ReferenceInjectionBudgetBasisChars > 30000 || prepare.LorebookReferenceMaxChars > 30000 ||
+		prepare.PrimaryCanonBaseMaxChars > 30000 || device.NarrativeSupportMaxChars > 12000 {
+		return device, fmt.Errorf("%w: bounded context budget is out of range", errPocketRisuExecutionContextInvalid)
+	}
+	if err := requirePocketRisuExecutionEnum("publisher_guidance_format", device.PublisherGuidanceFormat,
+		"compact", "standard", "explicit"); err != nil {
+		return device, err
+	}
+	if device.Main, err = normalizePocketRisuExecutionLLMConfig("main", device.Main); err != nil {
+		return device, err
+	}
+	if device.Critic, err = normalizePocketRisuExecutionLLMConfig("critic", device.Critic); err != nil {
+		return device, err
+	}
+	if device.SourceSearch, err = normalizePocketRisuExecutionLLMConfig("source_search", device.SourceSearch); err != nil {
+		return device, err
+	}
+	if device.Embedding, err = normalizePocketRisuExecutionEmbeddingConfig(device.Embedding); err != nil {
+		return device, err
+	}
+	return device, nil
+}
+
+func normalizePocketRisuExecutionLLMConfig(
+	name string,
+	config pocketRisuExecutionLLMConfig,
+) (pocketRisuExecutionLLMConfig, error) {
+	var err error
+	if config.Provider, err = boundedPocketRisuExecutionContextText(name+".provider", config.Provider, 128, true); err != nil {
+		return config, err
+	}
+	for field, value := range map[string]*string{
+		"api_key": &config.APIKey, "endpoint": &config.Endpoint, "model": &config.Model,
+		"reasoning_preset": &config.ReasoningPreset, "reasoning_effort": &config.ReasoningEffort,
+		"vertex_flex_mode":         &config.VertexFlexMode,
+		"llm_gateway_service_tier": &config.LLMGatewayServiceTier,
+		"claude_prompt_cache_mode": &config.ClaudePromptCacheMode,
+		"extra_headers_json":       &config.ExtraHeadersJSON, "extra_body_json": &config.ExtraBodyJSON,
+	} {
+		limit := 8192
+		if field == "api_key" || field == "extra_headers_json" || field == "extra_body_json" {
+			limit = 65536
+		}
+		*value, err = boundedPocketRisuExecutionContextText(name+"."+field, *value, limit, false)
+		if err != nil {
+			return config, err
+		}
+	}
+	if config.TimeoutMS < 5000 || config.TimeoutMS > 300000 ||
+		config.Temperature < 0 || config.Temperature > 2 ||
+		config.MaxCompletionTokens < 1 || config.MaxCompletionTokens > 128000 ||
+		config.ReasoningBudgetTokens < 0 || config.ReasoningBudgetTokens > 131072 {
+		return config, fmt.Errorf("%w: %s provider numeric setting is out of range", errPocketRisuExecutionContextInvalid, name)
+	}
+	for field, raw := range map[string]string{
+		"extra_headers_json": config.ExtraHeadersJSON,
+		"extra_body_json":    config.ExtraBodyJSON,
+	} {
+		if raw == "" {
+			continue
+		}
+		var object map[string]any
+		if err := json.Unmarshal([]byte(raw), &object); err != nil || object == nil {
+			return config, fmt.Errorf("%w: %s.%s must be a JSON object", errPocketRisuExecutionContextInvalid, name, field)
+		}
+	}
+	return config, nil
+}
+
+func normalizePocketRisuExecutionEmbeddingConfig(
+	config pocketRisuExecutionEmbeddingConfig,
+) (pocketRisuExecutionEmbeddingConfig, error) {
+	var err error
+	if config.Provider, err = boundedPocketRisuExecutionContextText("embedding.provider", config.Provider, 128, true); err != nil {
+		return config, err
+	}
+	if config.APIKey, err = boundedPocketRisuExecutionContextText("embedding.api_key", config.APIKey, 65536, false); err != nil {
+		return config, err
+	}
+	if config.Endpoint, err = boundedPocketRisuExecutionContextText("embedding.endpoint", config.Endpoint, 8192, false); err != nil {
+		return config, err
+	}
+	if config.Model, err = boundedPocketRisuExecutionContextText("embedding.model", config.Model, 8192, false); err != nil {
+		return config, err
+	}
+	if config.TimeoutMS < 5000 || config.TimeoutMS > 3_000_000 {
+		return config, fmt.Errorf("%w: embedding.timeout_ms is out of range", errPocketRisuExecutionContextInvalid)
+	}
+	return config, nil
+}
+
+func normalizePocketRisuExecutionBackendSnapshot(
+	backend pocketRisuExecutionBackendSnapshot,
+) (pocketRisuExecutionBackendSnapshot, error) {
+	var err error
+	backend.BackendInstanceID, err = boundedPocketRisuExecutionContextText(
+		"backend_instance_id", backend.BackendInstanceID, 255, true,
+	)
+	if err != nil {
+		return backend, err
+	}
+	backend.SupervisorPrompt, err = normalizePocketRisuExecutionPromptSnapshot("supervisor_prompt", backend.SupervisorPrompt)
+	if err != nil {
+		return backend, err
+	}
+	backend.CriticPrompt, err = normalizePocketRisuExecutionPromptSnapshot("critic_prompt", backend.CriticPrompt)
+	if err != nil {
+		return backend, err
+	}
+	return backend, nil
+}
+
+func normalizePocketRisuExecutionPromptSnapshot(
+	name string,
+	snapshot pocketRisuExecutionPromptSnapshot,
+) (pocketRisuExecutionPromptSnapshot, error) {
+	var err error
+	snapshot.Source, err = boundedPocketRisuExecutionContextText(name+".source", snapshot.Source, 128, snapshot.Available)
+	if err != nil {
+		return snapshot, err
+	}
+	snapshot.FailureCode, err = boundedPocketRisuExecutionContextText(name+".failure_code", snapshot.FailureCode, 128, false)
+	if err != nil {
+		return snapshot, err
+	}
+	if snapshot.Available {
+		if strings.TrimSpace(snapshot.Content) == "" || snapshot.FailureCode != "" {
+			return snapshot, fmt.Errorf("%w: %s availability is inconsistent", errPocketRisuExecutionContextInvalid, name)
+		}
+	} else {
+		if snapshot.Content != "" || snapshot.FailureCode == "" {
+			return snapshot, fmt.Errorf("%w: %s unavailability is inconsistent", errPocketRisuExecutionContextInvalid, name)
+		}
+	}
+	return snapshot, nil
+}
+
+func pocketRisuExecutionContextPublicDigest(
+	device pocketRisuExecutionDeviceSnapshot,
+	backend pocketRisuExecutionBackendSnapshot,
+) (string, error) {
+	devicePrivateConfigured := map[string]bool{
+		"main":          strings.TrimSpace(device.Main.APIKey) != "" || strings.TrimSpace(device.Main.ExtraHeadersJSON) != "" || strings.TrimSpace(device.Main.ExtraBodyJSON) != "",
+		"critic":        strings.TrimSpace(device.Critic.APIKey) != "" || strings.TrimSpace(device.Critic.ExtraHeadersJSON) != "" || strings.TrimSpace(device.Critic.ExtraBodyJSON) != "",
+		"embedding":     strings.TrimSpace(device.Embedding.APIKey) != "",
+		"source_search": strings.TrimSpace(device.SourceSearch.APIKey) != "" || strings.TrimSpace(device.SourceSearch.ExtraHeadersJSON) != "" || strings.TrimSpace(device.SourceSearch.ExtraBodyJSON) != "",
+	}
+	deviceEndpointConfigured := map[string]bool{
+		"main":          strings.TrimSpace(device.Main.Endpoint) != "",
+		"critic":        strings.TrimSpace(device.Critic.Endpoint) != "",
+		"embedding":     strings.TrimSpace(device.Embedding.Endpoint) != "",
+		"source_search": strings.TrimSpace(device.SourceSearch.Endpoint) != "",
+	}
+	publicDevice := device
+	publicDevice.Main = redactPocketRisuExecutionLLMConfig(device.Main)
+	publicDevice.Critic = redactPocketRisuExecutionLLMConfig(device.Critic)
+	publicDevice.SourceSearch = redactPocketRisuExecutionLLMConfig(device.SourceSearch)
+	publicDevice.Embedding.APIKey = ""
+	publicDevice.Embedding.Endpoint = ""
+	publicRuntime := clonePocketRisuRuntimeConfig(backend.Runtime)
+	credentialConfigured := map[string]bool{
+		"main":          strings.TrimSpace(publicRuntime.MainAPIKey) != "" || strings.TrimSpace(publicRuntime.MainExtraHeadersJSON) != "" || strings.TrimSpace(publicRuntime.MainExtraBodyJSON) != "",
+		"critic":        strings.TrimSpace(publicRuntime.CriticAPIKey) != "" || strings.TrimSpace(publicRuntime.CriticExtraHeadersJSON) != "" || strings.TrimSpace(publicRuntime.CriticExtraBodyJSON) != "",
+		"supervisor":    strings.TrimSpace(publicRuntime.SupervisorAPIKey) != "" || strings.TrimSpace(publicRuntime.SupervisorExtraHeadersJSON) != "" || strings.TrimSpace(publicRuntime.SupervisorExtraBodyJSON) != "",
+		"embedding":     strings.TrimSpace(publicRuntime.EmbeddingAPIKey) != "",
+		"source_search": strings.TrimSpace(publicRuntime.SourceSearchPlannerAPIKey) != "",
+	}
+	endpointConfigured := map[string]bool{
+		"main":          strings.TrimSpace(publicRuntime.MainEndpoint) != "",
+		"critic":        strings.TrimSpace(publicRuntime.CriticEndpoint) != "",
+		"supervisor":    strings.TrimSpace(publicRuntime.SupervisorEndpoint) != "",
+		"embedding":     strings.TrimSpace(publicRuntime.EmbeddingEndpoint) != "",
+		"source_search": strings.TrimSpace(publicRuntime.SourceSearchPlannerEndpoint) != "",
+	}
+	fallbackEmbeddingPrivateConfigured := strings.TrimSpace(backend.EmbeddingFallback.APIKey) != ""
+	fallbackEmbeddingEndpointConfigured := strings.TrimSpace(backend.EmbeddingFallback.Endpoint) != ""
+	publicEmbeddingFallback := backend.EmbeddingFallback
+	publicEmbeddingFallback.APIKey = ""
+	publicEmbeddingFallback.Endpoint = ""
+	redactPocketRisuRuntimeConfig(&publicRuntime)
+	preprocessingPrivateConfigured := make(map[string]bool, len(backend.Preprocessing.Roles))
+	preprocessingEndpointConfigured := make(map[string]bool, len(backend.Preprocessing.Roles))
+	preprocessingPromptConfigured := make(map[string]bool, len(backend.Preprocessing.Roles))
+	for key, role := range backend.Preprocessing.Roles {
+		preprocessingPrivateConfigured[key] = strings.TrimSpace(role.APIKey) != ""
+		preprocessingEndpointConfigured[key] = strings.TrimSpace(role.Endpoint) != ""
+		preprocessingPromptConfigured[key] = strings.TrimSpace(role.Prompt) != ""
+	}
+	preprocessing := redactPocketRisuPreprocessingSettings(backend.Preprocessing)
+	promptState := map[string]map[string]any{
+		"supervisor": {
+			"available": backend.SupervisorPrompt.Available,
+			"source":    backend.SupervisorPrompt.Source,
+		},
+		"critic": {
+			"available": backend.CriticPrompt.Available,
+			"source":    backend.CriticPrompt.Source,
+		},
+	}
+	encoded, err := json.Marshal(struct {
+		Device                              pocketRisuExecutionDeviceSnapshot  `json:"device"`
+		DevicePrivateConfigured             map[string]bool                    `json:"device_private_configured"`
+		DeviceEndpointConfigured            map[string]bool                    `json:"device_endpoint_configured"`
+		Runtime                             RuntimeConfig                      `json:"runtime"`
+		CredentialConfigured                map[string]bool                    `json:"credential_configured"`
+		EndpointConfigured                  map[string]bool                    `json:"endpoint_configured"`
+		EmbeddingFallback                   pocketRisuExecutionEmbeddingConfig `json:"embedding_fallback"`
+		EmbeddingFallbackPrivateConfigured  bool                               `json:"embedding_fallback_private_configured"`
+		EmbeddingFallbackEndpointConfigured bool                               `json:"embedding_fallback_endpoint_configured"`
+		Preprocessing                       multiAgentSettings                 `json:"preprocessing"`
+		PreprocessingPrivateConfigured      map[string]bool                    `json:"preprocessing_private_configured"`
+		PreprocessingEndpointConfigured     map[string]bool                    `json:"preprocessing_endpoint_configured"`
+		PreprocessingPromptConfigured       map[string]bool                    `json:"preprocessing_prompt_configured"`
+		PromptState                         map[string]map[string]any          `json:"prompt_state"`
+	}{
+		Device:                              publicDevice,
+		DevicePrivateConfigured:             devicePrivateConfigured,
+		DeviceEndpointConfigured:            deviceEndpointConfigured,
+		Runtime:                             publicRuntime,
+		CredentialConfigured:                credentialConfigured,
+		EndpointConfigured:                  endpointConfigured,
+		EmbeddingFallback:                   publicEmbeddingFallback,
+		EmbeddingFallbackPrivateConfigured:  fallbackEmbeddingPrivateConfigured,
+		EmbeddingFallbackEndpointConfigured: fallbackEmbeddingEndpointConfigured,
+		Preprocessing:                       preprocessing,
+		PreprocessingPrivateConfigured:      preprocessingPrivateConfigured,
+		PreprocessingEndpointConfigured:     preprocessingEndpointConfigured,
+		PreprocessingPromptConfigured:       preprocessingPromptConfigured,
+		PromptState:                         promptState,
+	})
+	if err != nil {
+		return "", err
+	}
+	digest := sha256.Sum256(encoded)
+	return hex.EncodeToString(digest[:]), nil
+}
+
+func redactPocketRisuExecutionLLMConfig(config pocketRisuExecutionLLMConfig) pocketRisuExecutionLLMConfig {
+	config.APIKey = ""
+	config.Endpoint = ""
+	config.ExtraHeadersJSON = ""
+	config.ExtraBodyJSON = ""
+	return config
+}
+
+func clonePocketRisuRuntimeConfig(config RuntimeConfig) RuntimeConfig {
+	clone := config
+	clone.MainTemperature = cloneFloat64Pointer(config.MainTemperature)
+	clone.MainMaxTokens = cloneInt64Pointer(config.MainMaxTokens)
+	clone.MainReasoningBudget = cloneInt64Pointer(config.MainReasoningBudget)
+	clone.CriticTemperature = cloneFloat64Pointer(config.CriticTemperature)
+	clone.CriticMaxTokens = cloneInt64Pointer(config.CriticMaxTokens)
+	clone.CriticReasoningBudget = cloneInt64Pointer(config.CriticReasoningBudget)
+	clone.SupervisorTemperature = cloneFloat64Pointer(config.SupervisorTemperature)
+	clone.SupervisorMaxTokens = cloneInt64Pointer(config.SupervisorMaxTokens)
+	clone.SupervisorReasoningBudget = cloneInt64Pointer(config.SupervisorReasoningBudget)
+	clone.SourceSearchPlannerTemperature = cloneFloat64Pointer(config.SourceSearchPlannerTemperature)
+	clone.SourceSearchPlannerMaxTokens = cloneInt64Pointer(config.SourceSearchPlannerMaxTokens)
+	clone.SourceSearchPlannerReasoningBudget = cloneInt64Pointer(config.SourceSearchPlannerReasoningBudget)
+	return clone
+}
+
+func redactPocketRisuRuntimeConfig(config *RuntimeConfig) {
+	if config == nil {
+		return
+	}
+	config.MainAPIKey, config.MainEndpoint = "", ""
+	config.MainExtraHeadersJSON, config.MainExtraBodyJSON = "", ""
+	config.CriticAPIKey, config.CriticEndpoint = "", ""
+	config.CriticExtraHeadersJSON, config.CriticExtraBodyJSON = "", ""
+	config.SupervisorAPIKey, config.SupervisorEndpoint = "", ""
+	config.SupervisorExtraHeadersJSON, config.SupervisorExtraBodyJSON = "", ""
+	config.EmbeddingAPIKey, config.EmbeddingEndpoint = "", ""
+	config.SourceSearchPlannerAPIKey, config.SourceSearchPlannerEndpoint = "", ""
+}
+
+func redactPocketRisuPreprocessingSettings(settings multiAgentSettings) multiAgentSettings {
+	result := settings
+	result.SharedPrompt = ""
+	result.Roles = make(map[string]multiAgentRoleConfig, len(settings.Roles))
+	for key, role := range settings.Roles {
+		role.APIKey = ""
+		role.Endpoint = ""
+		role.Prompt = ""
+		result.Roles[key] = role
+	}
+	return result
+}
+
+func cloneFloat64Pointer(value *float64) *float64 {
+	if value == nil {
+		return nil
+	}
+	copyValue := *value
+	return &copyValue
+}
+
+func cloneInt64Pointer(value *int64) *int64 {
+	if value == nil {
+		return nil
+	}
+	copyValue := *value
+	return &copyValue
+}
+
+func boundedPocketRisuExecutionContextText(name, value string, maxBytes int, required bool) (string, error) {
+	value = strings.TrimSpace(value)
+	if (required && value == "") || len([]byte(value)) > maxBytes ||
+		strings.IndexFunc(value, unicode.IsControl) >= 0 {
+		return "", fmt.Errorf("%w: %s is invalid", errPocketRisuExecutionContextInvalid, name)
+	}
+	return value, nil
+}
+
+func requirePocketRisuExecutionEnum(name, value string, allowed ...string) error {
+	value = strings.TrimSpace(value)
+	for _, candidate := range allowed {
+		if value == candidate {
+			return nil
+		}
+	}
+	return fmt.Errorf("%w: %s is unsupported", errPocketRisuExecutionContextInvalid, name)
+}
diff --git a/go-service/internal/httpapi/pocketrisu_execution_context_consumer.go b/go-service/internal/httpapi/pocketrisu_execution_context_consumer.go
new file mode 100644
index 0000000000000000000000000000000000000000..cec7995185b6b3bcd284ed4ce84daf6e245a371f
--- /dev/null
+++ b/go-service/internal/httpapi/pocketrisu_execution_context_consumer.go
@@ -0,0 +1,389 @@
+package httpapi
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+
+	"github.com/risulongmemory/archive-center-go/internal/dto"
+	"github.com/risulongmemory/archive-center-go/internal/store"
+)
+
+const (
+	pocketRisuHostContextMetaKey        = "pocketrisu_host_context"
+	pocketRisuHostConsumerStagePrepare  = "prepare"
+	pocketRisuHostConsumerStageMain     = "main"
+	pocketRisuHostConsumerStageComplete = "complete"
+	pocketRisuHostConsumerStageSearch   = "source_search"
+)
+
+type pocketRisuHostConsumerContext struct {
+	Reference pocketRisuHostPrepareReference
+	Execution *store.HostSessionExecutionResult
+	Prepare   *store.HostPrepareResult
+	Resolved  *pocketRisuResolvedExecutionContext
+}
+
+type pocketRisuHostConsumerError struct {
+	HTTPStatus int
+	Code       string
+	Cause      error
+}
+
+type pocketRisuRedactedError struct {
+	message string
+	cause   error
+}
+
+func (e *pocketRisuRedactedError) Error() string { return e.message }
+
+func (e *pocketRisuRedactedError) Unwrap() error { return e.cause }
+
+func (s *Server) resolvePocketRisuHostConsumerRequest(
+	r *http.Request,
+	meta map[string]any,
+	stage string,
+) (*pocketRisuHostConsumerContext, bool, error) {
+	present, err := s.authenticatePocketRisuHostConsumerRequest(r, meta)
+	if err != nil || !present {
+		return nil, present, err
+	}
+	return s.resolvePocketRisuHostConsumerContext(r.Context(), meta, stage)
+}
+
+func (s *Server) authenticatePocketRisuHostConsumerRequest(r *http.Request, meta map[string]any) (bool, error) {
+	_, present := meta[pocketRisuHostContextMetaKey]
+	if !present {
+		return false, nil
+	}
+	switch s.pocketRisuHostAuthorizationStatus(r) {
+	case http.StatusOK:
+	case http.StatusServiceUnavailable:
+		return true, newPocketRisuHostConsumerError(http.StatusServiceUnavailable, "pocketrisu_host_consumer_auth_unconfigured", errors.New("PocketRisu host consumer authentication is unavailable"))
+	default:
+		return true, newPocketRisuHostConsumerError(http.StatusUnauthorized, "pocketrisu_host_consumer_unauthorized", errors.New("PocketRisu host consumer authentication failed"))
+	}
+	_, _, err := decodePocketRisuHostConsumerReference(meta)
+	return true, err
+}
+
+func (e *pocketRisuHostConsumerError) Error() string {
+	if e == nil || e.Cause == nil {
+		return "PocketRisu host context is unavailable"
+	}
+	return e.Cause.Error()
+}
+
+func newPocketRisuHostConsumerError(status int, code string, cause error) error {
+	return &pocketRisuHostConsumerError{HTTPStatus: status, Code: code, Cause: cause}
+}
+
+func (s *Server) resolvePocketRisuHostConsumerContext(
+	ctx context.Context,
+	meta map[string]any,
+	stage string,
+) (*pocketRisuHostConsumerContext, bool, error) {
+	reference, present, err := decodePocketRisuHostConsumerReference(meta)
+	if err != nil || !present {
+		return nil, present, err
+	}
+	if s == nil || s.HostExecutionContexts == nil {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusServiceUnavailable, "pocketrisu_host_consumer_unavailable", errors.New("PocketRisu host context owner is unavailable"))
+	}
+	executions, prepares, ok := s.pocketRisuHostStores()
+	if !ok {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusServiceUnavailable, "pocketrisu_host_consumer_unavailable", errors.New("PocketRisu host stores are unavailable"))
+	}
+	execution, err := executions.GetHostSessionExecution(ctx, reference.Identity.HostInstanceID, reference.Identity.OperationID)
+	if err != nil {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusInternalServerError, "pocketrisu_host_consumer_store_failed", errors.New("PocketRisu execution claim lookup failed"))
+	}
+	if !pocketRisuHostExecutionMatchesIdentity(execution, reference.Identity) {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusConflict, "pocketrisu_host_consumer_claim_conflict", errors.New("PocketRisu execution claim is no longer active"))
+	}
+	if execution.SafeHostChangeSeq < execution.RequiredHostChangeSeq ||
+		execution.SafeHostChangeSeq < execution.IngestedHostChangeSeq {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusConflict, "pocketrisu_host_consumer_host_changes_not_safe", errors.New("PocketRisu host changes are not fully safe for this execution"))
+	}
+	prepare, err := prepares.GetHostPrepare(ctx, store.HostPrepareLookup{
+		PrepareKey: reference.PrepareKey, RequestFingerprint: reference.RequestFingerprint,
+	})
+	if err != nil {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusInternalServerError, "pocketrisu_host_consumer_store_failed", errors.New("PocketRisu prepare lookup failed"))
+	}
+	if !pocketRisuHostPrepareMatchesReference(prepare, reference) {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusConflict, "pocketrisu_host_consumer_owner_conflict", errors.New("PocketRisu prepare owner does not match the execution context"))
+	}
+	if !pocketRisuHostConsumerStageAllowsPrepare(stage, prepare.Status) {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusConflict, "pocketrisu_host_consumer_stage_conflict", fmt.Errorf("PocketRisu prepare state %q is not valid for %s", prepare.Status, stage))
+	}
+	material, contextResult, err := s.HostExecutionContexts.load(reference.ExecutionContextID, reference.Identity)
+	if err != nil {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusBadRequest, "pocketrisu_host_consumer_reference_invalid", errors.New("PocketRisu execution context identity is invalid"))
+	}
+	if material == nil || contextResult == nil || contextResult.Status != pocketRisuExecutionContextStatusCaptured {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusConflict, "pocketrisu_host_consumer_context_unavailable", errors.New("PocketRisu execution context is unavailable"))
+	}
+	resolved, err := resolvePocketRisuExecutionContext(*material)
+	if err != nil {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusInternalServerError, "pocketrisu_host_consumer_resolution_failed", errors.New("PocketRisu execution context resolution failed"))
+	}
+	if resolved.SettingsDigest != reference.SettingsSnapshotDigest ||
+		contextResult.SettingsDigest != reference.SettingsSnapshotDigest ||
+		resolved.BackendInstanceID != contextResult.BackendInstanceID {
+		return nil, true, newPocketRisuHostConsumerError(http.StatusConflict, "pocketrisu_host_consumer_digest_conflict", errors.New("PocketRisu execution context digest does not match the durable prepare"))
+	}
+	return &pocketRisuHostConsumerContext{Reference: reference, Execution: execution, Prepare: prepare, Resolved: resolved}, true, nil
+}
+
+func decodePocketRisuHostConsumerReference(meta map[string]any) (pocketRisuHostPrepareReference, bool, error) {
+	var reference pocketRisuHostPrepareReference
+	raw, present := meta[pocketRisuHostContextMetaKey]
+	if !present {
+		return reference, false, nil
+	}
+	if raw == nil {
+		return reference, true, newPocketRisuHostConsumerError(http.StatusBadRequest, "pocketrisu_host_consumer_reference_invalid", errors.New("PocketRisu host context reference is null"))
+	}
+	encoded, err := json.Marshal(raw)
+	if err != nil {
+		return reference, true, newPocketRisuHostConsumerError(http.StatusBadRequest, "pocketrisu_host_consumer_reference_invalid", errors.New("PocketRisu host context reference is invalid"))
+	}
+	decoder := json.NewDecoder(bytes.NewReader(encoded))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&reference); err != nil {
+		return reference, true, newPocketRisuHostConsumerError(http.StatusBadRequest, "pocketrisu_host_consumer_reference_invalid", errors.New("PocketRisu host context reference is invalid"))
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return reference, true, newPocketRisuHostConsumerError(http.StatusBadRequest, "pocketrisu_host_consumer_reference_invalid", errors.New("PocketRisu host context reference has trailing data"))
+	}
+	if strings.TrimSpace(reference.ContractVersion) != pocketRisuHostTransportContractVersion {
+		return reference, true, newPocketRisuHostConsumerError(http.StatusBadRequest, "pocketrisu_host_consumer_version_unsupported", errors.New("PocketRisu host context version is unsupported"))
+	}
+	return reference, true, nil
+}
