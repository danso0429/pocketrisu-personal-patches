+func TestPocketRisuExecutionContextReleaseReclaimsSecretsAndBoundsTombstones(t *testing.T) {
+	registry := deterministicPocketRisuContextRegistry()
+	request := validPocketRisuExecutionContextRequest("operation-release-1", "RELEASE_SECRET")
+	backend := validPocketRisuExecutionBackendSnapshot("RELEASE_BACKEND")
+	captured, err := registry.capture(request, backend)
+	if err != nil {
+		t.Fatalf("capture failed: %v", err)
+	}
+	contexts, bytes, _, _ := registry.stats()
+	if contexts != 1 || bytes == 0 {
+		t.Fatalf("stats before release = %d/%d", contexts, bytes)
+	}
+
+	released, err := registry.release(captured.ExecutionContextID, request.Identity, "completed")
+	if err != nil {
+		t.Fatalf("release failed: %v", err)
+	}
+	if released.Status != pocketRisuExecutionContextStatusReleased || released.ReleaseReason != "completed" || released.Reused {
+		t.Fatalf("release result = %+v", released)
+	}
+	contexts, bytes, _, _ = registry.stats()
+	if contexts != 0 || bytes != 0 {
+		t.Fatalf("stats after release = %d/%d", contexts, bytes)
+	}
+	material, loaded, err := registry.load(captured.ExecutionContextID, request.Identity)
+	if err != nil || material != nil || loaded.Status != pocketRisuExecutionContextStatusReleased || !loaded.Reused {
+		t.Fatalf("released load = material=%+v result=%+v err=%v", material, loaded, err)
+	}
+	replay, err := registry.capture(request, backend)
+	if err != nil || replay.Status != pocketRisuExecutionContextStatusReleased || !replay.Reused || replay.ExecutionContextID != captured.ExecutionContextID {
+		t.Fatalf("released capture replay = %+v, %v", replay, err)
+	}
+	changed := validPocketRisuExecutionContextRequest("operation-release-1", "CHANGED_SECRET")
+	conflict, err := registry.capture(changed, backend)
+	if err != nil || conflict.Status != pocketRisuExecutionContextStatusConflict {
+		t.Fatalf("released changed replay = %+v, %v", conflict, err)
+	}
+	releasedReplay, err := registry.release(captured.ExecutionContextID, request.Identity, "completed")
+	if err != nil || !releasedReplay.Reused {
+		t.Fatalf("release replay = %+v, %v", releasedReplay, err)
+	}
+	releaseConflict, err := registry.release(captured.ExecutionContextID, request.Identity, "cancelled")
+	if err != nil || releaseConflict.Status != pocketRisuExecutionContextStatusConflict {
+		t.Fatalf("release conflict = %+v, %v", releaseConflict, err)
+	}
+
+	discardRequest := validPocketRisuExecutionContextRequest("operation-discard-1", "DISCARD_SECRET")
+	discarded, err := registry.capture(discardRequest, backend)
+	if err != nil || !registry.discard(discarded.ExecutionContextID, discardRequest.Identity) {
+		t.Fatalf("discard = %+v, %v", discarded, err)
+	}
+	recaptured, err := registry.capture(discardRequest, backend)
+	if err != nil || recaptured.ExecutionContextID == discarded.ExecutionContextID {
+		t.Fatalf("recapture after discard = %+v, %v", recaptured, err)
+	}
+
+	registry.maxTombstones = 1
+	firstTombstone := validPocketRisuExecutionContextRequest("operation-tombstone-1", "TOMBSTONE_ONE")
+	first, err := registry.capture(firstTombstone, backend)
+	if err != nil {
+		t.Fatalf("first tombstone capture: %v", err)
+	}
+	if _, err := registry.release(first.ExecutionContextID, firstTombstone.Identity, "cancelled"); err != nil {
+		t.Fatalf("first tombstone release: %v", err)
+	}
+	secondTombstone := validPocketRisuExecutionContextRequest("operation-tombstone-2", "TOMBSTONE_TWO")
+	second, err := registry.capture(secondTombstone, backend)
+	if err != nil {
+		t.Fatalf("second tombstone capture: %v", err)
+	}
+	if _, err := registry.release(second.ExecutionContextID, secondTombstone.Identity, "cancelled"); err != nil {
+		t.Fatalf("second tombstone release: %v", err)
+	}
+	material, missing, err := registry.load(first.ExecutionContextID, firstTombstone.Identity)
+	if err != nil || material != nil || missing.Status != pocketRisuExecutionContextStatusMissing {
+		t.Fatalf("compacted tombstone load = material=%+v result=%+v err=%v", material, missing, err)
+	}
+}
+
+func TestServerCapturesRuntimeAndPreprocessingUnderOneConfigurationLock(t *testing.T) {
+	dataDir := t.TempDir()
+	promptDir := t.TempDir()
+	t.Setenv("ARCHIVE_CENTER_DATA_DIR", dataDir)
+	if err := os.WriteFile(filepath.Join(promptDir, "supervisor_system.txt"), []byte("FROZEN_SUPERVISOR_PROMPT"), 0o600); err != nil {
+		t.Fatalf("write supervisor prompt: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(promptDir, "critic_system.txt"), []byte("FROZEN_CRITIC_PROMPT"), 0o600); err != nil {
+		t.Fatalf("write critic prompt: %v", err)
+	}
+	preprocessing := multiAgentSettings{
+		Enabled: true, CandidateChars: 12345, SharedPrompt: "FROZEN_SHARED_PROMPT",
+		Roles: map[string]multiAgentRoleConfig{
+			"event_recent": {
+				Enabled: true, Provider: "openai", Endpoint: "https://frozen.invalid",
+				Model: "frozen-model", APIKey: "FROZEN_PREPROCESS_SECRET",
+				Prompt: "FROZEN_ROLE_PROMPT", Temperature: 0.2,
+				MaxTokens: 512, TimeoutMs: 10000,
+			},
+		},
+	}
+	raw, err := json.Marshal(preprocessing)
+	if err != nil {
+		t.Fatalf("marshal preprocessing: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(dataDir, "memory-preprocessing.json"), raw, 0o600); err != nil {
+		t.Fatalf("write preprocessing: %v", err)
+	}
+
+	cfg := config.Default()
+	cfg.PromptDir = promptDir
+	server := NewServer(cfg)
+	server.RuntimeConfigMu.Lock()
+	server.RuntimeConfig = validPocketRisuExecutionBackendSnapshot("FROZEN_BACKEND").Runtime
+	server.RuntimeConfigMu.Unlock()
+	request := validPocketRisuExecutionContextRequest("operation-server-capture", "FROZEN_DEVICE")
+	result, err := server.capturePocketRisuExecutionContext(request)
+	if err != nil {
+		t.Fatalf("server capture failed: %v", err)
+	}
+
+	server.RuntimeConfigMu.Lock()
+	server.RuntimeConfig.MainAPIKey = "LATER_BACKEND_SECRET"
+	server.RuntimeConfig.MainModel = "later-model"
+	server.RuntimeConfigMu.Unlock()
+	preprocessing.SharedPrompt = "LATER_SHARED_PROMPT"
+	raw, _ = json.Marshal(preprocessing)
+	if err := os.WriteFile(filepath.Join(dataDir, "memory-preprocessing.json"), raw, 0o600); err != nil {
+		t.Fatalf("rewrite preprocessing: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(promptDir, "supervisor_system.txt"), []byte("LATER_SUPERVISOR_PROMPT"), 0o600); err != nil {
+		t.Fatalf("rewrite supervisor prompt: %v", err)
+	}
+	if err := os.WriteFile(filepath.Join(promptDir, "critic_system.txt"), []byte("LATER_CRITIC_PROMPT"), 0o600); err != nil {
+		t.Fatalf("rewrite critic prompt: %v", err)
+	}
+
+	material, _, err := server.HostExecutionContexts.load(result.ExecutionContextID, request.Identity)
+	if err != nil {
+		t.Fatalf("load captured server context: %v", err)
+	}
+	if material.Backend.Runtime.MainAPIKey != "FROZEN_BACKEND-backend-main" ||
+		material.Backend.Runtime.MainModel != "backend-main-model" ||
+		material.Backend.Preprocessing.SharedPrompt != "FROZEN_SHARED_PROMPT" ||
+		material.Backend.SupervisorPrompt.Content != "FROZEN_SUPERVISOR_PROMPT" ||
+		material.Backend.CriticPrompt.Content != "FROZEN_CRITIC_PROMPT" {
+		t.Fatalf("captured backend changed after global update: %+v", material.Backend)
+	}
+	if result.BackendInstanceID != server.backendInstanceID() {
+		t.Fatalf("backend instance = %q, want %q", result.BackendInstanceID, server.backendInstanceID())
+	}
+	resolved, err := resolvePocketRisuExecutionContext(*material)
+	if err != nil {
+		t.Fatalf("resolve captured server context: %v", err)
+	}
+	if resolved.Main.APIKey != "FROZEN_DEVICE" || resolved.Critic.APIKey != "FROZEN_DEVICE-critic" ||
+		resolved.Preprocessing.SharedPrompt != "FROZEN_SHARED_PROMPT" ||
+		resolved.SupervisorPrompt.Content != "FROZEN_SUPERVISOR_PROMPT" ||
+		resolved.CriticPrompt.Content != "FROZEN_CRITIC_PROMPT" {
+		t.Fatalf("resolved context reread later globals: %+v", resolved)
+	}
+}
diff --git a/go-service/internal/httpapi/pocketrisu_host_restart_integration_test.go b/go-service/internal/httpapi/pocketrisu_host_restart_integration_test.go
