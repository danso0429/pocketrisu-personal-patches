+func TestHostChangeMariaDBGapReplayRestartConcurrencyAndBindingEpoch(t *testing.T) {
+	if os.Getenv("AC_HOST_CHANGE_TEST_DISPOSABLE") != "YES" {
+		t.Skip("requires an explicitly disposable MariaDB")
+	}
+	dsn := strings.TrimSpace(os.Getenv("AC_HOST_CHANGE_TEST_DSN"))
+	if dsn == "" {
+		t.Fatal("AC_HOST_CHANGE_TEST_DSN is required")
+	}
+	openStore := func() *mariadbStore {
+		raw, err := OpenMariaDB(dsn)
+		if err != nil {
+			t.Fatalf("open disposable MariaDB: %v", err)
+		}
+		store, ok := raw.(*mariadbStore)
+		if !ok {
+			t.Fatalf("store type=%T, want *mariadbStore", raw)
+		}
+		return store
+	}
+
+	ctx := context.Background()
+	suffix := strconv.FormatInt(time.Now().UTC().UnixNano(), 36)
+	hostID := "c0-change-host-" + suffix
+	characterID := "c0-change-character-" + suffix
+	chatID := "c0-change-chat-" + suffix
+	sessionID := "c0-change-session-" + suffix
+
+	admin := openStore()
+	cleanup := func() {
+		if _, err := admin.db.ExecContext(ctx, `DELETE FROM host_change_streams WHERE host_instance_id = ?`, hostID); err != nil {
+			t.Errorf("clean host change streams: %v", err)
+		}
+		if _, err := admin.db.ExecContext(ctx, `DELETE FROM session_route_bindings WHERE stable_character_id = ? AND host_chat_id = ?`, characterID, chatID); err != nil {
+			t.Errorf("clean host change route binding: %v", err)
+		}
+	}
+	cleanup()
+	t.Cleanup(func() {
+		cleanup()
+		if err := admin.Close(); err != nil {
+			t.Errorf("close cleanup store: %v", err)
+		}
+	})
+
+	runtimeStore := openStore()
+	bindingResult, err := runtimeStore.BindSessionRoute(ctx, SessionRouteBindingRequest{
+		StableCharacterID: characterID, HostChatID: chatID,
+		RequestedSessionID: sessionID, Mode: SessionRouteBindingModeResolveOrCreate,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	identity := HostChangeStreamIdentity{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+		BindingEpoch: SessionRouteBindingEpoch(bindingResult.Binding),
+	}
+	intent := func(seq, previous uint64, kind string) HostChangeIntent {
+		before := "revision-" + strconv.FormatUint(previous, 10)
+		after := "revision-" + strconv.FormatUint(seq, 10)
+		if kind == "operation_end" || kind == "ac_skip" {
+			after = before
+		}
+		return HostChangeIntent{
+			HostChangeStreamIdentity: identity,
+			EventID:                  "event-" + strconv.FormatUint(seq, 10) + "-" + suffix,
+			Seq:                      seq, PreviousSeq: previous,
+			OperationID: "operation-" + suffix, Kind: kind,
+			BeforeRevision: before, AfterRevision: after,
+			MessageIdentities: []string{"message-" + strconv.FormatUint(seq, 10)},
+			SourceGeneration:  "generation-" + strconv.FormatUint(seq, 10),
+			CommittedAt:       time.Date(2026, 9, 13, 13, 0, int(seq), 0, time.UTC),
+			PayloadRef:        "payload-" + strconv.FormatUint(seq, 10) + "-" + suffix,
+		}
+	}
+
+	second := intent(2, 1, "response_commit")
+	gap, err := runtimeStore.IngestHostChangeIntent(ctx, second)
+	if err != nil || gap.Status != HostChangeStatusSequenceGap || gap.RequiredSeq != 1 || gap.IngestedSeq != 0 {
+		t.Fatalf("initial gap result=%+v err=%v", gap, err)
+	}
+	first := intent(1, 0, "input_commit")
+	firstResult, err := runtimeStore.IngestHostChangeIntent(ctx, first)
+	if err != nil || firstResult.Status != HostChangeStatusIngested || firstResult.IngestedSeq != 1 || firstResult.SafeSeq != 0 || firstResult.SafetyState != "pending" {
+		t.Fatalf("first ingest result=%+v err=%v", firstResult, err)
+	}
+	replay, err := runtimeStore.IngestHostChangeIntent(ctx, first)
+	if err != nil || !replay.Reused || replay.IngestedSeq != 1 {
+		t.Fatalf("first replay result=%+v err=%v", replay, err)
+	}
+	changedFirst := first
+	changedFirst.PayloadRef = "different-payload-" + suffix
+	conflict, err := runtimeStore.IngestHostChangeIntent(ctx, changedFirst)
+	if err != nil || conflict.Status != HostChangeStatusConflict || conflict.ReasonCode != "event_identity_conflict" {
+		t.Fatalf("changed replay result=%+v err=%v", conflict, err)
+	}
+	third := intent(3, 2, "edit")
+	gap, err = runtimeStore.IngestHostChangeIntent(ctx, third)
+	if err != nil || gap.Status != HostChangeStatusSequenceGap || gap.RequiredSeq != 2 {
+		t.Fatalf("second gap result=%+v err=%v", gap, err)
+	}
+	second = intent(2, 1, "operation_end")
+	secondResult, err := runtimeStore.IngestHostChangeIntent(ctx, second)
+	if err != nil || secondResult.IngestedSeq != 2 || secondResult.SafeSeq != 0 || secondResult.SafetyState != "safe" {
+		t.Fatalf("safe event behind pending prefix result=%+v err=%v", secondResult, err)
+	}
+
+	if err := runtimeStore.Close(); err != nil {
+		t.Fatalf("close first host-change store: %v", err)
+	}
+	runtimeStore = openStore()
+	defer runtimeStore.Close()
+	restored, err := runtimeStore.GetHostChangeStream(ctx, identity)
+	if err != nil || restored.Status != HostChangeStatusIngested || restored.IngestedSeq != 2 || restored.SafeSeq != 0 {
+		t.Fatalf("restored stream=%+v err=%v", restored, err)
+	}
+
+	fourth := intent(4, 3, "edit")
+	type attempt struct {
+		intent HostChangeIntent
+		result *HostChangeResult
+		err    error
+	}
+	attempts := []attempt{{intent: third}, {intent: fourth}}
+	start := make(chan struct{})
+	var waitGroup sync.WaitGroup
+	for index := range attempts {
+		waitGroup.Add(1)
+		go func(index int) {
+			defer waitGroup.Done()
+			<-start
+			attempts[index].result, attempts[index].err = runtimeStore.IngestHostChangeIntent(ctx, attempts[index].intent)
+		}(index)
+	}
+	close(start)
+	waitGroup.Wait()
+	for index := range attempts {
+		if attempts[index].err != nil {
+			t.Fatalf("concurrent host change %d: %v", index, attempts[index].err)
+		}
+		if attempts[index].result.Status == HostChangeStatusSequenceGap {
+			attempts[index].result, attempts[index].err = runtimeStore.IngestHostChangeIntent(ctx, attempts[index].intent)
+		}
+		if attempts[index].err != nil || attempts[index].result.Status != HostChangeStatusIngested {
+			t.Fatalf("concurrent/retry host change %d result=%+v err=%v", index, attempts[index].result, attempts[index].err)
+		}
+	}
+	current, err := runtimeStore.GetHostChangeStream(ctx, identity)
+	if err != nil || current.IngestedSeq != 4 || current.SafeSeq != 0 {
+		t.Fatalf("contiguous stream after concurrent delivery=%+v err=%v", current, err)
+	}
+
+	remapped, err := runtimeStore.BindSessionRoute(ctx, SessionRouteBindingRequest{
+		StableCharacterID: characterID, HostChatID: chatID,
+		RequestedSessionID: sessionID, Mode: SessionRouteBindingModeManualAttach,
+	})
+	if err != nil {
+		t.Fatalf("advance host-change binding: %v", err)
+	}
+	newEpoch := SessionRouteBindingEpoch(remapped.Binding)
+	if newEpoch == identity.BindingEpoch {
+		t.Fatal("host-change route epoch did not advance")
+	}
+	fifth := intent(5, 4, "edit")
+	changedBinding, err := runtimeStore.IngestHostChangeIntent(ctx, fifth)
+	if err != nil || changedBinding.Status != HostChangeStatusBindingChanged || changedBinding.CurrentBindingEpoch != newEpoch {
+		t.Fatalf("old stream new event result=%+v err=%v", changedBinding, err)
+	}
+	replay, err = runtimeStore.IngestHostChangeIntent(ctx, first)
+	if err != nil || !replay.Reused || replay.IngestedSeq != 4 {
+		t.Fatalf("old receipt replay after route change=%+v err=%v", replay, err)
+	}
+	oldStatus, err := runtimeStore.GetHostChangeStream(ctx, identity)
+	if err != nil || oldStatus.Status != HostChangeStatusBindingChanged || oldStatus.IngestedSeq != 4 || oldStatus.CurrentBindingEpoch != newEpoch {
+		t.Fatalf("old stream status after route change=%+v err=%v", oldStatus, err)
+	}
+
+	newIdentity := identity
+	newIdentity.BindingEpoch = newEpoch
+	newFirst := intent(1, 0, "operation_end")
+	newFirst.HostChangeStreamIdentity = newIdentity
+	newFirst.EventID = "new-epoch-event-1-" + suffix
+	newFirst.BeforeRevision = "revision-4"
+	newFirst.AfterRevision = "revision-4"
+	newFirstResult, err := runtimeStore.IngestHostChangeIntent(ctx, newFirst)
+	if err != nil || newFirstResult.Status != HostChangeStatusIngested || newFirstResult.IngestedSeq != 1 || newFirstResult.SafeSeq != 1 {
+		t.Fatalf("new epoch first event=%+v err=%v", newFirstResult, err)
+	}
+}
