+	}
+	bindingEpoch := SessionRouteBindingEpoch(bindingResult.Binding)
+
+	acquireAndRegister := func(label string) (HostPrepareLookup, uint64, HostPrepareRegisterRequest) {
+		operationID := "c0-prepare-operation-" + label + "-" + suffix
+		claim, err := runtimeStore.AcquireHostSessionExecution(ctx, HostSessionExecutionAcquireRequest{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+			OperationID: operationID, ExpectedBindingEpoch: bindingEpoch,
+		})
+		if err != nil || claim.Status != HostSessionExecutionStatusAcquired {
+			t.Fatalf("%s execution claim=%+v err=%v", label, claim, err)
+		}
+		request := HostPrepareRegisterRequest{
+			HostPrepareIdentity: HostPrepareIdentity{
+				HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+				BindingEpoch: bindingEpoch, OperationID: operationID,
+				ClaimEpoch: claim.ClaimEpoch, MainRequestID: "main-request-" + label + "-" + suffix,
+			},
+			ExecutionContextID:     "context-" + label + "-" + suffix,
+			SettingsSnapshotDigest: strings.Repeat("a", 63) + label[:1],
+			InputReceiptID:         "input-receipt-" + label + "-" + suffix,
+			SourceRevision:         "source-" + label + "-" + suffix,
