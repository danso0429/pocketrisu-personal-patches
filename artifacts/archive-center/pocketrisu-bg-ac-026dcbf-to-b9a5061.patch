+
+	_, reference := capturePocketRisuHostConsumerFixture(t, server, handler)
+	consumer, present, err := server.resolvePocketRisuHostConsumerContext(context.Background(), pocketRisuHostConsumerMeta(reference), pocketRisuHostConsumerStagePrepare)
+	if err != nil || !present || consumer == nil {
+		t.Fatalf("consumer=%+v present=%t err=%v", consumer, present, err)
+	}
+	if consumer.Resolved.Main.APIKey != "BACKEND_ROUTE_SECRET-backend-main" ||
+		consumer.Resolved.SupervisorPrompt.Content != "FROZEN_CONSUMER_SUPERVISOR" ||
+		consumer.Resolved.CriticPrompt.Content != "FROZEN_CONSUMER_CRITIC" ||
+		consumer.Resolved.Preprocessing.SharedPrompt != "FROZEN_CONSUMER_SHARED" {
+		t.Fatalf("resolved captured context=%+v", consumer.Resolved)
+	}
+	if _, _, err := server.resolvePocketRisuHostConsumerContext(context.Background(), pocketRisuHostConsumerMeta(reference), pocketRisuHostConsumerStageMain); err == nil {
+		t.Fatal("running prepare was accepted by the main consumer")
+	}
+
+	server.RuntimeConfigMu.Lock()
+	server.RuntimeConfig.MainAPIKey = "LATER_RUNTIME_SECRET"
+	server.RuntimeConfig.MainModel = "later-runtime-model"
+	server.RuntimeConfigMu.Unlock()
+	_ = os.WriteFile(filepath.Join(promptDir, "supervisor_system.txt"), []byte("LATER_SUPERVISOR"), 0o600)
+	_ = os.WriteFile(filepath.Join(promptDir, "critic_system.txt"), []byte("LATER_CRITIC"), 0o600)
+	preprocessing.SharedPrompt = "LATER_SHARED"
+	rawPreprocessing, _ = json.Marshal(preprocessing)
+	_ = os.WriteFile(filepath.Join(os.Getenv("ARCHIVE_CENTER_DATA_DIR"), "memory-preprocessing.json"), rawPreprocessing, 0o600)
+
+	again, _, err := server.resolvePocketRisuHostConsumerContext(context.Background(), pocketRisuHostConsumerMeta(reference), pocketRisuHostConsumerStagePrepare)
