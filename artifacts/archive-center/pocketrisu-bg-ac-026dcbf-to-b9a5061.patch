+	criticPrompt := capturePocketRisuExecutionPrompt("critic", s.Cfg.PromptDir)
+	return pocketRisuExecutionBackendSnapshot{
+		BackendInstanceID: s.backendInstanceID(),
+		Runtime:           clonePocketRisuRuntimeConfig(s.RuntimeConfig),
+		EmbeddingFallback: pocketRisuExecutionEmbeddingConfig{
+			Provider: strings.TrimSpace(extractionFirstNonEmpty(
+				s.Cfg.EmbedderProvider,
+				embeddingEnvFirst("AC_EMBEDDER_PROVIDER", "AC_LT_EMBEDDING_PROVIDER", "PROJECT_EMBEDDING_PROVIDER", "AC_PROJECT_EMBEDDING_PROVIDER"),
+			)),
+			APIKey: normalizeConfigSecret(embeddingEnvFirst(
+				"AC_EMBEDDER_API_KEY", "AC_LT_EMBEDDING_API_KEY", "PROJECT_EMBEDDING_API_KEY", "AC_PROJECT_EMBEDDING_API_KEY",
+			)),
+			Endpoint: strings.TrimSpace(extractionFirstNonEmpty(
+				s.Cfg.EmbedderEndpoint,
+				embeddingEnvFirst("AC_EMBEDDER_ENDPOINT", "AC_LT_EMBEDDING_ENDPOINT", "PROJECT_EMBEDDING_ENDPOINT", "AC_PROJECT_EMBEDDING_ENDPOINT"),
+			)),
+			Model: strings.TrimSpace(extractionFirstNonEmpty(
+				s.Cfg.EmbedderModel,
+				embeddingEnvFirst("AC_EMBEDDER_MODEL", "AC_LT_EMBEDDING_MODEL", "PROJECT_EMBEDDING_MODEL", "AC_PROJECT_EMBEDDING_MODEL"),
+			)),
+			TimeoutMS: runtimeTimeoutMs(s.RuntimeConfig.EmbeddingTimeoutSec),
+		},
+		Preprocessing:    preprocessing,
+		SupervisorPrompt: supervisorPrompt,
+		CriticPrompt:     criticPrompt,
+	}, nil
+}
+
+func capturePocketRisuExecutionPrompt(role, promptDir string) pocketRisuExecutionPromptSnapshot {
+	switch role {
+	case "supervisor":
+		content, source, err := readSupervisorSystemPrompt(promptDir)
+		if err != nil {
+			return pocketRisuExecutionPromptSnapshot{Source: "captured_missing", FailureCode: "publisher_system_prompt_unavailable"}
+		}
+		if source == "fallback_builtin" {
+			source = "captured_fallback_builtin"
+		} else {
+			source = "captured_prompt_file"
+		}
+		return pocketRisuExecutionPromptSnapshot{Content: content, Source: source, Available: true}
+	case "critic":
+		content, source := readCriticSystemPrompt(promptDir)
+		if source == "fallback_builtin" {
+			source = "captured_fallback_builtin"
+		} else {
+			source = "captured_prompt_file"
+		}
+		return pocketRisuExecutionPromptSnapshot{Content: content, Source: source, Available: true}
+	default:
+		return pocketRisuExecutionPromptSnapshot{Source: "captured_missing", FailureCode: "prompt_role_unsupported"}
+	}
+}
