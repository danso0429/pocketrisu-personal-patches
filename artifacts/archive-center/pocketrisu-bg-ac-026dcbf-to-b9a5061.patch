+func (s *pocketRisuRestartRecoveryTestStore) ListRunningHostPrepares(_ context.Context, limit int) ([]store.HostPrepareResult, error) {
+	if s.listErr != nil {
+		return nil, s.listErr
+	}
+	if limit > len(s.running) {
+		limit = len(s.running)
+	}
