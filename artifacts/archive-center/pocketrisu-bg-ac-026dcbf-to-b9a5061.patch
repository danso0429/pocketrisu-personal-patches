+}
+
+func (s *pocketRisuRestartRecoveryTestStore) MarkHostPrepareOutcomeUnknown(_ context.Context, request store.HostPrepareOutcomeUnknownRequest) (*store.HostPrepareResult, error) {
+	if s.markErr != nil {
+		return nil, s.markErr
+	}
+	s.marked = append(s.marked, request)
+	for i := range s.running {
+		item := s.running[i]
+		if item.PrepareKey != request.PrepareKey || item.RequestFingerprint != request.RequestFingerprint || item.RunEpoch != request.RunEpoch {
+			continue
+		}
+		s.running = append(s.running[:i], s.running[i+1:]...)
+		item.Status = store.HostPrepareStatusOutcomeUnknown
+		item.ReasonCode = "prepare_outcome_unknown"
+		return &item, nil
+	}
+	return &store.HostPrepareResult{Status: store.HostPrepareStatusRejected, PrepareKey: request.PrepareKey}, nil
+}
