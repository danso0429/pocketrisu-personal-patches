+package store
+
+import (
+	"os"
+	"strings"
+	"testing"
+)
+
+func TestHostSessionExecutionMigrationDefinesCASAndIdempotencyConstraints(t *testing.T) {
+	raw, err := os.ReadFile("../../../migrations/014_host_session_execution.sql")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlText := string(raw)
+	for _, table := range []string{
+		"host_session_execution_slots",
+		"host_session_execution_outcomes",
+	} {
+		if count := strings.Count(sqlText, "CREATE TABLE IF NOT EXISTS "+table); count != 1 {
+			t.Errorf("%s create count=%d want=1", table, count)
+		}
+	}
+	for _, fragment := range []string{
+		"canonical_session_id             VARCHAR(255)    NOT NULL PRIMARY KEY",
+		"claim_epoch                      BIGINT UNSIGNED NOT NULL DEFAULT 0",
+		"safe_host_change_seq             BIGINT UNSIGNED NOT NULL DEFAULT 0",
+		"UNIQUE KEY uq_host_session_execution_active_operation",
+		"UNIQUE KEY uq_host_session_execution_operation",
+		"UNIQUE KEY uq_host_session_execution_end_event",
+		"requested_end_reason            VARCHAR(80)     NOT NULL",
+	} {
+		if !strings.Contains(sqlText, fragment) {
+			t.Errorf("014 migration missing %q", fragment)
+		}
+	}
+}
