+
+type HostPrepareRegistryStore interface {
+	RegisterHostPrepare(context.Context, HostPrepareRegisterRequest) (*HostPrepareResult, error)
+	StartHostPrepare(context.Context, HostPrepareStartRequest) (*HostPrepareResult, error)
+	CompleteHostPrepare(context.Context, HostPrepareCompleteRequest) (*HostPrepareResult, error)
+	FailHostPrepare(context.Context, HostPrepareFailureRequest) (*HostPrepareResult, error)
+	MarkHostPrepareOutcomeUnknown(context.Context, HostPrepareOutcomeUnknownRequest) (*HostPrepareResult, error)
+	SkipHostPrepare(context.Context, HostPrepareSkipRequest) (*HostPrepareResult, error)
+	GetHostPrepare(context.Context, HostPrepareLookup) (*HostPrepareResult, error)
+}
