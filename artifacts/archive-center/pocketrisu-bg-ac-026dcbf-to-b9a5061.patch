+	PrepareKey              string `json:"prepare_key,omitempty"`
+	RequestFingerprint      string `json:"request_fingerprint,omitempty"`
+	HostInstanceID          string `json:"host_instance_id,omitempty"`
+	StableCharacterID       string `json:"stable_character_id,omitempty"`
+	HostChatID              string `json:"host_chat_id,omitempty"`
+	ResolvedSessionID       string `json:"resolved_session_id,omitempty"`
+	BindingEpoch            string `json:"binding_epoch,omitempty"`
+	OperationID             string `json:"operation_id,omitempty"`
+	ClaimEpoch              uint64 `json:"claim_epoch,omitempty"`
+	MainRequestID           string `json:"main_request_id,omitempty"`
+	RunEpoch                uint64 `json:"run_epoch,omitempty"`
+	ExternalOperationID     string `json:"external_operation_id,omitempty"`
+	ExecutionContextID      string `json:"execution_context_id,omitempty"`
+	SettingsSnapshotDigest  string `json:"settings_snapshot_digest,omitempty"`
+	InputReceiptID          string `json:"input_receipt_id,omitempty"`
