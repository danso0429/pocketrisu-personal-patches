+
+func HostChangeStreamKey(identity HostChangeStreamIdentity) string {
+	seed := strings.Join([]string{
+		strings.TrimSpace(identity.HostInstanceID),
+		strings.TrimSpace(identity.StableCharacterID),
+		strings.TrimSpace(identity.HostChatID),
+		strings.TrimSpace(identity.BindingEpoch),
+	}, "\x1f")
+	sum := sha256.Sum256([]byte(seed))
+	return hex.EncodeToString(sum[:])
+}
+
+func (m *mariadbStore) IngestHostChangeIntent(ctx context.Context, intent HostChangeIntent) (*HostChangeResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	normalized, messageJSON, fingerprint, err := normalizeHostChangeIntent(intent)
+	if err != nil {
+		return nil, err
+	}
+	for attempt := 1; attempt <= hostSessionExecutionTransactionMaxAttempts; attempt++ {
+		result, err := m.ingestHostChangeIntentOnce(ctx, normalized, messageJSON, fingerprint)
+		if err == nil {
+			return result, nil
+		}
+		if !isRetryableHostCoordinationTransactionError(err) || attempt == hostSessionExecutionTransactionMaxAttempts {
+			return nil, err
+		}
+		if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+			return nil, err
+		}
+	}
+	return nil, errors.New("host change ingest exhausted without result")
+}
+
+func (m *mariadbStore) ApplyHostChangeSourceInvalidation(ctx context.Context, request HostChangeSourceInvalidationRequest) (*HostChangeResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	identity, err := normalizeHostChangeStreamIdentity(request.HostChangeStreamIdentity)
+	if err != nil {
+		return nil, err
+	}
+	eventID, err := normalizeHostSessionExecutionIdentifier("event_id", request.EventID, 255)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	request.HostChangeStreamIdentity = identity
+	request.EventID = eventID
+
+	m.memoryDerivationWriteMu.Lock()
+	defer m.memoryDerivationWriteMu.Unlock()
+	for attempt := 1; attempt <= hostSessionExecutionTransactionMaxAttempts; attempt++ {
+		result, err := m.applyHostChangeSourceInvalidationOnce(ctx, request)
+		if err == nil {
+			return result, nil
+		}
+		if !isRetryableHostCoordinationTransactionError(err) || attempt == hostSessionExecutionTransactionMaxAttempts {
+			return nil, err
+		}
+		if err := waitHostCoordinationTransactionRetry(ctx, attempt); err != nil {
+			return nil, err
+		}
+	}
+	return nil, errors.New("host change source invalidation exhausted without result")
+}
+
+func (m *mariadbStore) applyHostChangeSourceInvalidationOnce(ctx context.Context, request HostChangeSourceInvalidationRequest) (*HostChangeResult, error) {
+	tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelSerializable})
+	if err != nil {
+		return nil, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_ = tx.Rollback()
+		}
+	}()
+	finish := func(result *HostChangeResult) (*HostChangeResult, error) {
+		if err := tx.Commit(); err != nil {
+			return nil, err
+		}
+		committed = true
+		return result, nil
+	}
+
+	streamKey := HostChangeStreamKey(request.HostChangeStreamIdentity)
+	stream, err := selectHostChangeStreamByKey(ctx, tx, streamKey, true)
+	if errors.Is(err, ErrNotFound) {
+		return finish(newHostChangeResult(HostChangeStatusRejected, "stream_not_found"))
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !hostChangeStreamMatchesBaseIdentity(stream, request.HostChangeStreamIdentity) {
+		return finish(newHostChangeResult(HostChangeStatusConflict, "stream_identity_conflict"))
+	}
+	event, err := selectHostChangeEvent(ctx, tx, streamKey, "event_id = ?", true, request.EventID)
+	if errors.Is(err, ErrNotFound) {
+		return finish(hostChangeStreamResult(stream, HostChangeStatusRejected, "event_not_found"))
+	}
+	if err != nil {
+		return nil, err
+	}
+	if event.ContractVersion != HostChangeEventContractVersion || event.StreamKey != streamKey {
+		return nil, fmt.Errorf("unsupported or mismatched host change event contract %q", event.ContractVersion)
+	}
+	if !hostChangeKindInvalidatesSource(event.Kind) {
+		return finish(hostChangeEventStatusResult(stream, event, HostChangeStatusRejected, "event_does_not_invalidate_source", false))
+	}
+	if event.SafetyState == "safe" {
+		return finish(hostChangeEventResult(stream, event, "source_invalidation_replayed", true))
+	}
+	if event.SafetyState != "pending" {
+		return nil, fmt.Errorf("unsupported host change safety state %q", event.SafetyState)
+	}
+
+	matchedTurns, err := selectHostChangeSourceTargetsTx(ctx, tx, stream.CanonicalSessionID, event)
+	if err != nil {
+		return nil, err
+	}
+	if len(matchedTurns) == 0 {
+		return finish(hostChangeEventStatusResult(stream, event, HostChangeStatusPending, "source_target_not_observed", false))
+	}
+
+	now := time.Now().UTC()
+	matchedFromTurn := 0
+	for _, target := range matchedTurns {
+		if matchedFromTurn == 0 || target.TurnIndex < matchedFromTurn {
+			matchedFromTurn = target.TurnIndex
+		}
+	}
+	lifecycleState, disposition := hostChangeInvalidationDisposition(event.Kind)
+	activeRange, err := hostChangeSourceRangeHasActiveRevisionTx(ctx, tx, stream.CanonicalSessionID, matchedFromTurn)
+	if err != nil {
+		return nil, err
+	}
+	if activeRange {
+		if err := invalidateMemorySourcesTx(
+			ctx, tx, stream.CanonicalSessionID, matchedFromTurn, false, "",
+			lifecycleState, "host_change_"+event.Kind, now,
+		); err != nil {
+			return nil, err
+		}
+	} else {
+		disposition = "source_already_inactive"
+	}
+	if err := excludeHostChangeSourceRangeTx(ctx, tx, stream.CanonicalSessionID, matchedFromTurn); err != nil {
+		return nil, err
+	}
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_change_events
+		SET safety_state = 'safe', safety_disposition = ?, safe_at = ?
+		WHERE stream_key = ? AND event_id = ? AND event_fingerprint = ?
+		  AND safety_state = 'pending'
+	`, disposition, now, streamKey, event.EventID, event.Fingerprint)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := write.RowsAffected()
+	if err != nil {
+		return nil, err
+	}
+	if rows != 1 {
+		return nil, errors.New("host change safety lost compare-and-set")
+	}
+	event.SafetyState = "safe"
+	event.SafetyDisposition = disposition
+
+	nextSafeSeq, err := selectHostChangeContiguousSafeSeq(ctx, tx, stream)
+	if err != nil {
+		return nil, err
+	}
+	write, err = tx.ExecContext(ctx, `
+		UPDATE host_change_streams
+		SET safe_seq = ?
+		WHERE stream_key = ? AND ingested_seq = ? AND safe_seq = ?
+	`, nextSafeSeq, streamKey, stream.IngestedSeq, stream.SafeSeq)
+	if err != nil {
+		return nil, err
+	}
+	rows, err = write.RowsAffected()
+	if err != nil {
+		return nil, err
+	}
+	if rows != 1 {
+		return nil, errors.New("host change safe watermark lost compare-and-set")
+	}
+	stream.SafeSeq = nextSafeSeq
+	if err := invalidateActiveHostSessionExecutionForChangeTx(ctx, tx, stream, event); err != nil {
+		return nil, err
+	}
+	return finish(hostChangeEventResult(stream, event, "source_invalidation_applied", false))
+}
+
+func (m *mariadbStore) ingestHostChangeIntentOnce(ctx context.Context, intent HostChangeIntent, messageJSON, fingerprint string) (*HostChangeResult, error) {
+	tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelSerializable})
+	if err != nil {
+		return nil, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_ = tx.Rollback()
+		}
+	}()
+	finish := func(result *HostChangeResult) (*HostChangeResult, error) {
+		if err := tx.Commit(); err != nil {
+			return nil, err
+		}
+		committed = true
+		return result, nil
+	}
+
+	binding, bindingErr := selectSessionRouteBindingTx(ctx, tx, intent.StableCharacterID, intent.HostChatID, true)
+	if bindingErr != nil && !errors.Is(bindingErr, ErrNotFound) {
+		return nil, bindingErr
+	}
+	streamKey := HostChangeStreamKey(intent.HostChangeStreamIdentity)
+	stream, streamErr := selectHostChangeStreamByKey(ctx, tx, streamKey, true)
+	if streamErr != nil && !errors.Is(streamErr, ErrNotFound) {
+		return nil, streamErr
+	}
+	if stream != nil && !hostChangeStreamMatchesBaseIdentity(stream, intent.HostChangeStreamIdentity) {
+		return finish(newHostChangeResult(HostChangeStatusConflict, "stream_identity_conflict"))
+	}
+	eventIDChecked := false
+	if stream != nil {
+		if event, err := selectHostChangeEvent(ctx, tx, streamKey, "event_id = ?", true, intent.EventID); err == nil {
+			if event.Fingerprint != fingerprint || event.Seq != intent.Seq || event.PreviousSeq != intent.PreviousSeq {
+				return finish(hostChangeConflictResult(stream, intent, "event_identity_conflict"))
+			}
+			return finish(hostChangeEventResult(stream, event, "event_replayed", true))
+		} else if !errors.Is(err, ErrNotFound) {
+			return nil, err
+		}
+		eventIDChecked = true
+	}
+	if errors.Is(bindingErr, ErrNotFound) {
+		return finish(newHostChangeResult(HostChangeStatusRejected, "binding_not_found"))
+	}
+	if !hostSessionExecutionBindingUsable(binding) {
+		return finish(newHostChangeResult(HostChangeStatusRejected, "binding_not_active"))
+	}
+	currentBindingEpoch := SessionRouteBindingEpoch(*binding)
+	if intent.BindingEpoch != currentBindingEpoch {
+		var result *HostChangeResult
+		if stream != nil {
+			result = hostChangeStreamResult(stream, HostChangeStatusBindingChanged, "expected_binding_epoch_mismatch")
+		} else {
+			result = newHostChangeResult(HostChangeStatusBindingChanged, "expected_binding_epoch_mismatch")
+			result.ResolvedSessionID = binding.CanonicalSessionID
+			result.BindingEpoch = intent.BindingEpoch
+		}
+		result.CurrentBindingEpoch = currentBindingEpoch
+		return finish(result)
+	}
+
+	if stream == nil {
+		if _, err := tx.ExecContext(ctx, `
+			INSERT INTO host_change_streams (
+				stream_key, contract_version, host_instance_id, stable_character_id,
+				host_chat_id, binding_epoch, canonical_session_id
+			) VALUES (?, ?, ?, ?, ?, ?, ?)
+			ON DUPLICATE KEY UPDATE stream_key = VALUES(stream_key)
+		`, streamKey, HostChangeStreamContractVersion, intent.HostInstanceID,
+			intent.StableCharacterID, intent.HostChatID, intent.BindingEpoch,
+			binding.CanonicalSessionID); err != nil {
+			return nil, err
+		}
+		stream, streamErr = selectHostChangeStreamByKey(ctx, tx, streamKey, true)
+	}
+	if streamErr != nil {
+		return nil, streamErr
+	}
+	if !hostChangeStreamMatchesIdentity(stream, intent.HostChangeStreamIdentity, binding.CanonicalSessionID) {
+		return finish(newHostChangeResult(HostChangeStatusConflict, "stream_identity_conflict"))
+	}
+
+	if !eventIDChecked {
+		if event, err := selectHostChangeEvent(ctx, tx, streamKey, "event_id = ?", true, intent.EventID); err == nil {
+			if event.Fingerprint != fingerprint || event.Seq != intent.Seq || event.PreviousSeq != intent.PreviousSeq {
+				return finish(hostChangeConflictResult(stream, intent, "event_identity_conflict"))
+			}
+			return finish(hostChangeEventResult(stream, event, "event_replayed", true))
+		} else if !errors.Is(err, ErrNotFound) {
+			return nil, err
+		}
+	}
+	if _, err := selectHostChangeEvent(ctx, tx, streamKey, "seq = ?", true, intent.Seq); err == nil {
+		return finish(hostChangeConflictResult(stream, intent, "sequence_event_id_conflict"))
+	} else if !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+
+	if stream.IngestedSeq == ^uint64(0) {
+		return nil, errors.New("host change sequence exhausted")
+	}
+	requiredSeq := stream.IngestedSeq + 1
+	if intent.Seq > requiredSeq {
+		result := hostChangeStreamResult(stream, HostChangeStatusSequenceGap, "sequence_gap")
+		result.EventID = intent.EventID
+		result.Seq = intent.Seq
+		result.RequiredSeq = requiredSeq
+		return finish(result)
+	}
+	if intent.Seq <= stream.IngestedSeq {
+		return finish(hostChangeConflictResult(stream, intent, "ingested_sequence_receipt_missing"))
+	}
+	if intent.PreviousSeq != stream.IngestedSeq {
+		return finish(hostChangeConflictResult(stream, intent, "previous_sequence_mismatch"))
+	}
+
+	safetyState := "pending"
+	safetyDisposition := ""
+	nextSafeSeq := stream.SafeSeq
+	if hostChangeKindSafeAtIngest(intent.Kind) {
+		safetyState = "safe"
+		safetyDisposition = "no_source_change"
+		if stream.SafeSeq == intent.PreviousSeq {
+			nextSafeSeq = intent.Seq
+		}
+	}
+	if _, err := tx.ExecContext(ctx, `
+		INSERT INTO host_change_events (
+			contract_version, stream_key, event_id, seq, previous_seq,
+			operation_id, event_kind, before_revision, after_revision,
+			message_identities_json, source_generation, committed_at,
+			payload_ref, event_fingerprint, safety_state, safety_disposition, safe_at
+		) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+	`, HostChangeEventContractVersion, streamKey, intent.EventID, intent.Seq,
+		intent.PreviousSeq, nullableString(intent.OperationID), intent.Kind,
+		nullableString(intent.BeforeRevision), nullableString(intent.AfterRevision),
+		messageJSON, nullableString(intent.SourceGeneration), intent.CommittedAt,
+		intent.PayloadRef, fingerprint, safetyState, nullableString(safetyDisposition),
+		nullableTimeForHostChange(safetyState == "safe", time.Now().UTC())); err != nil {
+		return nil, err
+	}
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_change_streams
+		SET ingested_seq = ?, safe_seq = ?
+		WHERE stream_key = ? AND ingested_seq = ? AND safe_seq = ?
+	`, intent.Seq, nextSafeSeq, streamKey, stream.IngestedSeq, stream.SafeSeq)
+	if err != nil {
+		return nil, err
+	}
+	rows, err := write.RowsAffected()
+	if err != nil {
+		return nil, err
+	}
+	if rows != 1 {
+		return nil, errors.New("host change ingest lost compare-and-set")
+	}
+	stream.IngestedSeq = intent.Seq
+	stream.SafeSeq = nextSafeSeq
+	if err := syncActiveHostSessionExecutionWatermarksTx(ctx, tx, stream); err != nil {
+		return nil, err
+	}
+	event := &hostChangeEvent{
+		ContractVersion: HostChangeEventContractVersion,
+		StreamKey:       streamKey, EventID: intent.EventID, Seq: intent.Seq,
+		PreviousSeq: intent.PreviousSeq, OperationID: intent.OperationID,
+		Kind: intent.Kind, BeforeRevision: intent.BeforeRevision,
+		AfterRevision: intent.AfterRevision, MessageIdentitiesJSON: messageJSON,
+		SourceGeneration: intent.SourceGeneration, CommittedAt: intent.CommittedAt,
+		PayloadRef: intent.PayloadRef, Fingerprint: fingerprint,
+		SafetyState: safetyState, SafetyDisposition: safetyDisposition,
+	}
+	return finish(hostChangeEventResult(stream, event, "event_ingested", false))
+}
+
+func (m *mariadbStore) GetHostChangeStream(ctx context.Context, identity HostChangeStreamIdentity) (*HostChangeResult, error) {
+	if err := m.ensureDB(); err != nil {
+		return nil, err
+	}
+	normalized, err := normalizeHostChangeStreamIdentity(identity)
+	if err != nil {
+		return nil, err
+	}
+	tx, err := m.db.BeginTx(ctx, &sql.TxOptions{Isolation: sql.LevelRepeatableRead, ReadOnly: true})
+	if err != nil {
+		return nil, err
+	}
+	committed := false
+	defer func() {
+		if !committed {
+			_ = tx.Rollback()
+		}
+	}()
+	finish := func(result *HostChangeResult) (*HostChangeResult, error) {
+		if err := tx.Commit(); err != nil {
+			return nil, err
+		}
+		committed = true
+		return result, nil
+	}
+
+	stream, err := selectHostChangeStreamByKey(ctx, tx, HostChangeStreamKey(normalized), false)
+	if err != nil && !errors.Is(err, ErrNotFound) {
+		return nil, err
+	}
+	if stream != nil && !hostChangeStreamMatchesBaseIdentity(stream, normalized) {
+		return finish(newHostChangeResult(HostChangeStatusConflict, "stream_identity_conflict"))
+	}
+	binding, bindingErr := selectSessionRouteBindingTx(ctx, tx, normalized.StableCharacterID, normalized.HostChatID, false)
+	if bindingErr != nil && !errors.Is(bindingErr, ErrNotFound) {
+		return nil, bindingErr
+	}
+	if errors.Is(bindingErr, ErrNotFound) {
+		if stream != nil {
+			return finish(hostChangeStreamResult(stream, HostChangeStatusBindingChanged, "binding_not_found"))
+		}
+		return finish(newHostChangeResult(HostChangeStatusRejected, "binding_not_found"))
+	}
+	currentEpoch := SessionRouteBindingEpoch(*binding)
+	if currentEpoch != normalized.BindingEpoch {
+		var result *HostChangeResult
+		if stream != nil {
+			result = hostChangeStreamResult(stream, HostChangeStatusBindingChanged, "expected_binding_epoch_mismatch")
+		} else {
+			result = newHostChangeResult(HostChangeStatusBindingChanged, "expected_binding_epoch_mismatch")
+			result.ResolvedSessionID = binding.CanonicalSessionID
+			result.BindingEpoch = normalized.BindingEpoch
+		}
+		result.CurrentBindingEpoch = currentEpoch
+		return finish(result)
+	}
+	if stream == nil {
+		result := newHostChangeResult(HostChangeStatusIngested, "stream_empty")
+		result.ResolvedSessionID = binding.CanonicalSessionID
+		result.BindingEpoch = currentEpoch
+		return finish(result)
+	}
+	if !hostChangeStreamMatchesIdentity(stream, normalized, binding.CanonicalSessionID) {
+		return finish(newHostChangeResult(HostChangeStatusConflict, "stream_identity_conflict"))
+	}
+	return finish(hostChangeStreamResult(stream, HostChangeStatusIngested, "stream_current"))
+}
+
+func normalizeHostChangeIntent(intent HostChangeIntent) (HostChangeIntent, string, string, error) {
+	identity, err := normalizeHostChangeStreamIdentity(intent.HostChangeStreamIdentity)
+	if err != nil {
+		return intent, "", "", err
+	}
+	intent.HostChangeStreamIdentity = identity
+	if intent.EventID, err = normalizeHostSessionExecutionIdentifier("event_id", intent.EventID, 255); err != nil {
+		return intent, "", "", fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	if strings.TrimSpace(intent.OperationID) != "" {
+		if intent.OperationID, err = normalizeHostSessionExecutionIdentifier("operation_id", intent.OperationID, 255); err != nil {
+			return intent, "", "", fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+		}
+	}
+	intent.Kind = strings.TrimSpace(intent.Kind)
+	if !hostChangeKindAllowed(intent.Kind) {
+		return intent, "", "", fmt.Errorf("%w: unsupported kind %q", ErrHostChangeIntentInvalid, intent.Kind)
+	}
+	intent.BeforeRevision = strings.TrimSpace(intent.BeforeRevision)
+	intent.AfterRevision = strings.TrimSpace(intent.AfterRevision)
+	if intent.BeforeRevision, err = normalizeOptionalHostChangeIdentifier("before_revision", intent.BeforeRevision, 255); err != nil {
+		return intent, "", "", err
+	}
+	if intent.AfterRevision, err = normalizeOptionalHostChangeIdentifier("after_revision", intent.AfterRevision, 255); err != nil {
+		return intent, "", "", err
+	}
+	if err := validateHostChangeRevisionTransition(intent); err != nil {
+		return intent, "", "", err
+	}
+	if strings.TrimSpace(intent.SourceGeneration) != "" {
+		if intent.SourceGeneration, err = normalizeHostSessionExecutionIdentifier("source_generation", intent.SourceGeneration, 255); err != nil {
+			return intent, "", "", fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+		}
+	}
+	if intent.PayloadRef, err = normalizeHostSessionExecutionIdentifier("payload_ref", intent.PayloadRef, 255); err != nil {
+		return intent, "", "", fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	if intent.Seq == 0 || intent.PreviousSeq >= intent.Seq {
+		return intent, "", "", fmt.Errorf("%w: invalid sequence", ErrHostChangeIntentInvalid)
+	}
+	if intent.CommittedAt.IsZero() {
+		return intent, "", "", fmt.Errorf("%w: committed_at is required", ErrHostChangeIntentInvalid)
+	}
+	intent.CommittedAt = intent.CommittedAt.UTC().Truncate(time.Millisecond)
+
+	identities := make([]string, 0, len(intent.MessageIdentities))
+	if len(intent.MessageIdentities) > hostChangeMaxMessageIdentities {
+		return intent, "", "", fmt.Errorf("%w: too many message identities", ErrHostChangeIntentInvalid)
+	}
+	seen := make(map[string]bool, len(intent.MessageIdentities))
+	for _, value := range intent.MessageIdentities {
+		normalized, err := normalizeHostSessionExecutionIdentifier("message_identity", value, 255)
+		if err != nil {
+			return intent, "", "", fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+		}
+		if seen[normalized] {
+			return intent, "", "", fmt.Errorf("%w: duplicate message identity", ErrHostChangeIntentInvalid)
+		}
+		seen[normalized] = true
+		identities = append(identities, normalized)
+	}
+	intent.MessageIdentities = identities
+	if !hostChangeKindSafeAtIngest(intent.Kind) && len(identities) == 0 {
+		return intent, "", "", fmt.Errorf("%w: content change requires a message identity", ErrHostChangeIntentInvalid)
+	}
+	encoded, err := json.Marshal(identities)
+	if err != nil {
+		return intent, "", "", err
+	}
+	if len(encoded) > hostChangeMaxMessageJSONBytes {
+		return intent, "", "", fmt.Errorf("%w: message identities are too large", ErrHostChangeIntentInvalid)
+	}
+	fingerprintPayload := struct {
+		EventID           string   `json:"event_id"`
+		Seq               uint64   `json:"seq"`
+		PreviousSeq       uint64   `json:"previous_seq"`
+		OperationID       string   `json:"operation_id"`
+		Kind              string   `json:"kind"`
+		BeforeRevision    string   `json:"before_revision"`
+		AfterRevision     string   `json:"after_revision"`
+		MessageIdentities []string `json:"message_identities"`
+		SourceGeneration  string   `json:"source_generation"`
+		CommittedAt       string   `json:"committed_at"`
+		PayloadRef        string   `json:"payload_ref"`
+	}{
+		EventID: intent.EventID, Seq: intent.Seq, PreviousSeq: intent.PreviousSeq,
+		OperationID: intent.OperationID, Kind: intent.Kind,
+		BeforeRevision: intent.BeforeRevision, AfterRevision: intent.AfterRevision,
+		MessageIdentities: intent.MessageIdentities, SourceGeneration: intent.SourceGeneration,
+		CommittedAt: intent.CommittedAt.Format(time.RFC3339Nano), PayloadRef: intent.PayloadRef,
+	}
+	fingerprintJSON, err := json.Marshal(fingerprintPayload)
+	if err != nil {
+		return intent, "", "", err
+	}
+	sum := sha256.Sum256(fingerprintJSON)
+	return intent, string(encoded), hex.EncodeToString(sum[:]), nil
+}
+
+func normalizeHostChangeStreamIdentity(identity HostChangeStreamIdentity) (HostChangeStreamIdentity, error) {
+	var err error
+	if identity.HostInstanceID, err = normalizeHostSessionExecutionIdentifier("host_instance_id", identity.HostInstanceID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	if identity.StableCharacterID, err = normalizeHostSessionExecutionIdentifier("stable_character_id", identity.StableCharacterID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	if identity.HostChatID, err = normalizeHostSessionExecutionIdentifier("host_chat_id", identity.HostChatID, 255); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	if identity.BindingEpoch, err = normalizeHostSessionExecutionIdentifier("binding_epoch", identity.BindingEpoch, 96); err != nil {
+		return identity, fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	return identity, nil
+}
+
+func normalizeOptionalHostChangeIdentifier(name, value string, maxBytes int) (string, error) {
+	if value = strings.TrimSpace(value); value == "" {
+		return "", nil
+	}
+	normalized, err := normalizeHostSessionExecutionIdentifier(name, value, maxBytes)
+	if err != nil {
+		return "", fmt.Errorf("%w: %v", ErrHostChangeIntentInvalid, err)
+	}
+	return normalized, nil
+}
+
+func validateHostChangeRevisionTransition(intent HostChangeIntent) error {
+	switch intent.Kind {
+	case "delete":
+		if intent.BeforeRevision == "" || intent.AfterRevision != "" {
+			return fmt.Errorf("%w: delete requires before revision and empty after revision", ErrHostChangeIntentInvalid)
+		}
+	case "ac_skip", "operation_end":
+		if intent.BeforeRevision == "" || intent.BeforeRevision != intent.AfterRevision {
+			return fmt.Errorf("%w: %s requires one unchanged revision", ErrHostChangeIntentInvalid, intent.Kind)
+		}
+	default:
+		if intent.AfterRevision == "" {
+			return fmt.Errorf("%w: %s requires after revision", ErrHostChangeIntentInvalid, intent.Kind)
+		}
+	}
+	return nil
+}
+
+func hostChangeKindAllowed(kind string) bool {
+	switch kind {
+	case "input_commit", "response_commit", "edit", "delete", "reroll", "branch", "ac_skip", "operation_end":
+		return true
+	default:
+		return false
+	}
+}
+
+func hostChangeKindSafeAtIngest(kind string) bool {
+	return kind == "ac_skip" || kind == "operation_end"
+}
+
+func hostChangeKindInvalidatesSource(kind string) bool {
+	switch kind {
+	case "edit", "delete", "reroll", "branch":
+		return true
+	default:
+		return false
+	}
+}
+
+func hostChangeInvalidationDisposition(kind string) (lifecycleState, disposition string) {
+	if kind == "delete" {
+		return "deleted", "source_deleted"
+	}
+	return "invalidated", "source_invalidated"
+}
+
+func hostChangeStreamMatchesIdentity(stream *hostChangeStream, identity HostChangeStreamIdentity, canonicalSessionID string) bool {
+	return hostChangeStreamMatchesBaseIdentity(stream, identity) &&
+		stream.CanonicalSessionID == canonicalSessionID
+}
+
+func hostChangeStreamMatchesBaseIdentity(stream *hostChangeStream, identity HostChangeStreamIdentity) bool {
+	return stream != nil && stream.ContractVersion == HostChangeStreamContractVersion &&
+		stream.StreamKey == HostChangeStreamKey(identity) &&
+		stream.HostInstanceID == identity.HostInstanceID &&
+		stream.StableCharacterID == identity.StableCharacterID &&
+		stream.HostChatID == identity.HostChatID &&
+		stream.BindingEpoch == identity.BindingEpoch
+}
+
+func newHostChangeResult(status, reason string) *HostChangeResult {
+	return &HostChangeResult{ContractVersion: HostChangeStreamContractVersion, Status: status, ReasonCode: reason}
+}
+
+func hostChangeStreamResult(stream *hostChangeStream, status, reason string) *HostChangeResult {
+	result := newHostChangeResult(status, reason)
+	if stream == nil {
+		return result
+	}
+	result.ResolvedSessionID = stream.CanonicalSessionID
+	result.BindingEpoch = stream.BindingEpoch
+	result.IngestedSeq = stream.IngestedSeq
+	result.SafeSeq = stream.SafeSeq
+	return result
+}
+
+func hostChangeEventResult(stream *hostChangeStream, event *hostChangeEvent, reason string, reused bool) *HostChangeResult {
+	return hostChangeEventStatusResult(stream, event, HostChangeStatusIngested, reason, reused)
+}
+
+func hostChangeEventStatusResult(stream *hostChangeStream, event *hostChangeEvent, status, reason string, reused bool) *HostChangeResult {
+	result := hostChangeStreamResult(stream, status, reason)
+	if event != nil {
+		result.EventID = event.EventID
+		result.Seq = event.Seq
+		result.SafetyState = event.SafetyState
+		result.SafetyDisposition = event.SafetyDisposition
+	}
+	result.Reused = reused
+	return result
+}
+
+func selectHostChangeSourceTargetsTx(ctx context.Context, tx *sql.Tx, canonicalSessionID string, event *hostChangeEvent) ([]hostChangeSourceTarget, error) {
+	var messageIdentities []string
+	if err := json.Unmarshal([]byte(event.MessageIdentitiesJSON), &messageIdentities); err != nil {
+		return nil, fmt.Errorf("decode host change message identities: %w", err)
+	}
+	identitySet := make(map[string]struct{}, len(messageIdentities))
+	identities := make([]string, 0, len(messageIdentities))
+	for _, identity := range messageIdentities {
+		normalized, err := normalizeHostSessionExecutionIdentifier("message_identity", identity, 255)
+		if err != nil {
+			return nil, fmt.Errorf("invalid stored host change message identity: %w", err)
+		}
+		if _, exists := identitySet[normalized]; exists {
+			return nil, errors.New("stored host change event has duplicate message identities")
+		}
+		identitySet[normalized] = struct{}{}
+		identities = append(identities, normalized)
+	}
+	if len(identities) == 0 && strings.TrimSpace(event.SourceGeneration) == "" {
+		return nil, errors.New("stored host change event has no source identity")
+	}
+
+	conditions := make([]string, 0, 3)
+	args := []any{canonicalSessionID}
+	if len(identities) > 0 {
+		placeholders := strings.TrimRight(strings.Repeat("?,", len(identities)), ",")
+		conditions = append(conditions, "source_message_id IN ("+placeholders+")")
+		for _, identity := range identities {
+			args = append(args, identity)
+		}
+		conditions = append(conditions, "source_generation_id IN ("+placeholders+")")
+		for _, identity := range identities {
+			args = append(args, identity)
+		}
+	}
+	if strings.TrimSpace(event.SourceGeneration) != "" {
+		conditions = append(conditions, "source_generation_id = ?")
+		args = append(args, event.SourceGeneration)
+	}
+	rows, err := tx.QueryContext(ctx, `
+		SELECT turn_index
+		FROM memory_source_revisions
+		WHERE chat_session_id = ? AND (`+strings.Join(conditions, " OR ")+`)
+		ORDER BY turn_index, id
+		FOR UPDATE
+	`, args...)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	targets := []hostChangeSourceTarget{}
+	for rows.Next() {
+		var target hostChangeSourceTarget
+		if err := rows.Scan(&target.TurnIndex); err != nil {
+			return nil, err
+		}
+		targets = append(targets, target)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, err
+	}
+	return targets, nil
+}
+
+func hostChangeSourceRangeHasActiveRevisionTx(ctx context.Context, tx *sql.Tx, canonicalSessionID string, fromTurn int) (bool, error) {
+	var active bool
+	if err := tx.QueryRowContext(ctx, `
+		SELECT EXISTS(
+			SELECT 1
+			FROM memory_source_revisions
+			WHERE chat_session_id = ? AND turn_index >= ? AND lifecycle_state = 'active'
+		)
+	`, canonicalSessionID, fromTurn).Scan(&active); err != nil {
+		return false, err
+	}
+	return active, nil
+}
+
+func excludeHostChangeSourceRangeTx(ctx context.Context, tx *sql.Tx, canonicalSessionID string, fromTurn int) error {
+	for _, command := range canonicalTailDeleteCommands(canonicalSessionID, fromTurn, false, true) {
+		if _, err := tx.ExecContext(ctx, command.query, command.args...); err != nil {
+			return err
+		}
+	}
+	return restoreActiveStatusCurrentValuesTx(ctx, tx, canonicalSessionID)
+}
+
+func selectHostChangeContiguousSafeSeq(ctx context.Context, tx *sql.Tx, stream *hostChangeStream) (uint64, error) {
+	if stream == nil || stream.SafeSeq > stream.IngestedSeq {
+		return 0, errors.New("invalid host change stream watermarks")
+	}
+	if stream.SafeSeq == stream.IngestedSeq {
+		return stream.SafeSeq, nil
+	}
+	var count, minimumSeq, maximumSeq, firstUnsafeSeq uint64
+	if err := tx.QueryRowContext(ctx, `
+		SELECT COUNT(*), COALESCE(MIN(seq), 0), COALESCE(MAX(seq), 0),
+		       COALESCE(MIN(CASE WHEN safety_state <> 'safe' THEN seq END), 0)
+		FROM host_change_events
+		WHERE stream_key = ? AND seq > ? AND seq <= ?
+	`, stream.StreamKey, stream.SafeSeq, stream.IngestedSeq).Scan(
+		&count, &minimumSeq, &maximumSeq, &firstUnsafeSeq,
+	); err != nil {
+		return 0, err
+	}
+	expectedCount := stream.IngestedSeq - stream.SafeSeq
+	if count != expectedCount || minimumSeq != stream.SafeSeq+1 || maximumSeq != stream.IngestedSeq {
+		return 0, errors.New("host change event sequence is not contiguous")
+	}
+	if firstUnsafeSeq == 0 {
+		return stream.IngestedSeq, nil
+	}
+	return firstUnsafeSeq - 1, nil
+}
+
+func invalidateActiveHostSessionExecutionForChangeTx(ctx context.Context, tx *sql.Tx, stream *hostChangeStream, event *hostChangeEvent) error {
+	slot, err := selectHostSessionExecutionSlotBySession(ctx, tx, stream.CanonicalSessionID, true)
+	if errors.Is(err, ErrNotFound) {
+		return nil
+	}
+	if err != nil {
+		return err
+	}
+	if slot.ActiveOperationID == "" {
+		return nil
+	}
+	if slot.ContractVersion != HostSessionExecutionContractVersion {
+		return fmt.Errorf("unsupported host session execution slot contract %q", slot.ContractVersion)
+	}
+	if _, err := tx.ExecContext(ctx, `
+		UPDATE host_prepare_requests
+		SET status = 'fenced', result_json = NULL, result_hash = NULL,
+		    failure_code = 'host_source_changed', failure_retryable = FALSE,
+		    execution_claim_released = TRUE, finished_at = UTC_TIMESTAMP(3)
+		WHERE canonical_session_id = ?
+		  AND host_instance_id = ? AND operation_id = ? AND claim_epoch = ?
+		  AND status NOT IN ('skipped', 'fenced')
+	`, slot.CanonicalSessionID, slot.ActiveHostInstanceID,
+		slot.ActiveOperationID, slot.ClaimEpoch); err != nil {
+		return err
+	}
+
+	finalIngestedSeq := slot.IngestedHostChangeSeq
+	finalSafeSeq := slot.SafeHostChangeSeq
+	if slot.ActiveHostInstanceID == stream.HostInstanceID &&
+		slot.ActiveStableCharacterID == stream.StableCharacterID &&
+		slot.ActiveHostChatID == stream.HostChatID &&
+		slot.ActiveBindingEpoch == stream.BindingEpoch {
+		finalIngestedSeq = stream.IngestedSeq
+		finalSafeSeq = stream.SafeSeq
+	}
+	endReason := "invalidated"
+	sourceDisposition := "superseded"
+	if event.Kind == "delete" {
+		endReason = "deleted"
+		sourceDisposition = "deleted"
+	}
+	endEventID := hostChangeInvalidationEndEventID(stream.StreamKey, event.EventID)
+	outcome := &hostSessionExecutionOutcome{
+		ContractVersion:       HostSessionExecutionContractVersion,
+		HostInstanceID:        slot.ActiveHostInstanceID,
+		StableCharacterID:     slot.ActiveStableCharacterID,
+		HostChatID:            slot.ActiveHostChatID,
+		CanonicalSessionID:    slot.CanonicalSessionID,
+		BindingEpoch:          slot.ActiveBindingEpoch,
+		OperationID:           slot.ActiveOperationID,
+		ClaimEpoch:            slot.ClaimEpoch,
+		EndEventID:            endEventID,
+		RequestedEndReason:    endReason,
+		EndReason:             endReason,
+		TerminalPhase:         hostSessionExecutionTerminalPhase(endReason),
+		SourceDisposition:     sourceDisposition,
+		RequiredHostChangeSeq: slot.RequiredHostChangeSeq,
+		SafeHostChangeSeq:     finalSafeSeq,
+	}
+	if _, err := tx.ExecContext(ctx, `
+		INSERT INTO host_session_execution_outcomes (
+			contract_version, host_instance_id, stable_character_id, host_chat_id,
+			canonical_session_id, binding_epoch, operation_id, claim_epoch,
+			end_event_id, requested_end_reason, end_reason, terminal_phase, source_disposition,
+			final_required_host_change_seq, final_safe_host_change_seq
+		) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
+	`, outcome.ContractVersion, outcome.HostInstanceID, outcome.StableCharacterID,
+		outcome.HostChatID, outcome.CanonicalSessionID, outcome.BindingEpoch,
+		outcome.OperationID, outcome.ClaimEpoch, outcome.EndEventID,
+		outcome.RequestedEndReason, outcome.EndReason, outcome.TerminalPhase,
+		outcome.SourceDisposition, outcome.RequiredHostChangeSeq, outcome.SafeHostChangeSeq); err != nil {
+		return err
+	}
+	write, err := tx.ExecContext(ctx, `
+		UPDATE host_session_execution_slots
+		SET active_host_instance_id = NULL,
+		    active_stable_character_id = NULL,
+		    active_host_chat_id = NULL,
+		    active_binding_epoch = NULL,
+		    active_operation_id = NULL,
+		    phase = 'idle',
+		    required_host_change_seq = 0,
+		    ingested_host_change_seq = ?,
+		    safe_host_change_seq = ?,
+		    claimed_at = NULL
+		WHERE canonical_session_id = ?
+		  AND active_host_instance_id = ?
+		  AND active_operation_id = ?
+		  AND claim_epoch = ?
+	`, finalIngestedSeq, finalSafeSeq, slot.CanonicalSessionID,
+		slot.ActiveHostInstanceID, slot.ActiveOperationID, slot.ClaimEpoch)
+	if err != nil {
+		return err
+	}
+	rows, err := write.RowsAffected()
+	if err != nil {
+		return err
+	}
+	if rows != 1 {
+		return errors.New("host change invalidation lost execution compare-and-set")
+	}
+	return nil
+}
+
+func hostChangeInvalidationEndEventID(streamKey, eventID string) string {
+	sum := sha256.Sum256([]byte(streamKey + "\x1f" + eventID))
+	return "host_change_v1_" + hex.EncodeToString(sum[:])
+}
+
+func hostChangeConflictResult(stream *hostChangeStream, intent HostChangeIntent, reason string) *HostChangeResult {
+	result := hostChangeStreamResult(stream, HostChangeStatusConflict, reason)
+	result.EventID = intent.EventID
+	result.Seq = intent.Seq
+	return result
+}
+
+func selectHostChangeStreamByKey(ctx context.Context, queryer hostSessionExecutionQueryer, streamKey string, forUpdate bool) (*hostChangeStream, error) {
+	query := `
+		SELECT stream_key, contract_version, host_instance_id, stable_character_id,
+		       host_chat_id, binding_epoch, canonical_session_id, ingested_seq, safe_seq
+		FROM host_change_streams
+		WHERE stream_key = ?`
+	if forUpdate {
+		query += " FOR UPDATE"
+	}
+	var stream hostChangeStream
+	err := queryer.QueryRowContext(ctx, query, streamKey).Scan(
+		&stream.StreamKey, &stream.ContractVersion, &stream.HostInstanceID,
+		&stream.StableCharacterID, &stream.HostChatID, &stream.BindingEpoch,
+		&stream.CanonicalSessionID, &stream.IngestedSeq, &stream.SafeSeq,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &stream, nil
+}
+
+func selectHostChangeStreamForExecutionTx(ctx context.Context, tx *sql.Tx, request HostSessionExecutionAcquireRequest, canonicalSessionID string) (*hostChangeStream, error) {
+	identity := HostChangeStreamIdentity{
+		HostInstanceID: request.HostInstanceID, StableCharacterID: request.StableCharacterID,
+		HostChatID: request.HostChatID, BindingEpoch: request.ExpectedBindingEpoch,
+	}
+	stream, err := selectHostChangeStreamByKey(ctx, tx, HostChangeStreamKey(identity), true)
+	if errors.Is(err, ErrNotFound) {
+		return &hostChangeStream{
+			StreamKey: HostChangeStreamKey(identity), ContractVersion: HostChangeStreamContractVersion,
+			HostInstanceID: identity.HostInstanceID, StableCharacterID: identity.StableCharacterID,
+			HostChatID: identity.HostChatID, BindingEpoch: identity.BindingEpoch,
+			CanonicalSessionID: canonicalSessionID,
+		}, nil
+	}
+	if err != nil {
+		return nil, err
+	}
+	if !hostChangeStreamMatchesIdentity(stream, identity, canonicalSessionID) {
+		return nil, errors.New("host change stream does not match execution binding")
+	}
+	if stream.SafeSeq > stream.IngestedSeq {
+		return nil, errors.New("invalid host change stream watermarks")
+	}
+	return stream, nil
+}
+
+func syncActiveHostSessionExecutionWatermarksTx(ctx context.Context, tx *sql.Tx, stream *hostChangeStream) error {
+	_, err := tx.ExecContext(ctx, `
+		UPDATE host_session_execution_slots
+		SET ingested_host_change_seq = ?, safe_host_change_seq = ?
+		WHERE canonical_session_id = ?
+		  AND active_host_instance_id = ?
+		  AND active_stable_character_id = ?
+		  AND active_host_chat_id = ?
+		  AND active_binding_epoch = ?
+	`, stream.IngestedSeq, stream.SafeSeq, stream.CanonicalSessionID,
+		stream.HostInstanceID, stream.StableCharacterID, stream.HostChatID, stream.BindingEpoch)
+	return err
+}
+
+func selectHostChangeEvent(ctx context.Context, queryer hostSessionExecutionQueryer, streamKey, predicate string, forUpdate bool, argument any) (*hostChangeEvent, error) {
+	query := `
+		SELECT contract_version, stream_key, event_id, seq, previous_seq,
+		       COALESCE(operation_id, ''), event_kind,
+		       COALESCE(before_revision, ''), COALESCE(after_revision, ''),
+		       message_identities_json, COALESCE(source_generation, ''),
+		       committed_at, payload_ref, event_fingerprint, safety_state,
+		       COALESCE(safety_disposition, '')
+		FROM host_change_events
+		WHERE stream_key = ? AND ` + predicate
+	if forUpdate {
+		query += " FOR UPDATE"
+	}
+	var event hostChangeEvent
+	err := queryer.QueryRowContext(ctx, query, streamKey, argument).Scan(
+		&event.ContractVersion, &event.StreamKey, &event.EventID,
+		&event.Seq, &event.PreviousSeq, &event.OperationID, &event.Kind,
+		&event.BeforeRevision, &event.AfterRevision,
+		&event.MessageIdentitiesJSON, &event.SourceGeneration,
+		&event.CommittedAt, &event.PayloadRef, &event.Fingerprint,
+		&event.SafetyState, &event.SafetyDisposition,
+	)
+	if errors.Is(err, sql.ErrNoRows) {
+		return nil, ErrNotFound
+	}
+	if err != nil {
+		return nil, err
+	}
+	return &event, nil
+}
+
+func nullableTimeForHostChange(present bool, value time.Time) any {
+	if !present {
+		return nil
+	}
+	return value
+}
