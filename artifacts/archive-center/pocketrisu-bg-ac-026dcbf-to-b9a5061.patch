+func pocketRisuPreparedResultContainsPrivateContext(resultJSON string, material pocketRisuExecutionContextMaterial) bool {
+	endpoints := []string{
+		material.Device.Main.Endpoint, material.Device.Critic.Endpoint,
+		material.Device.Embedding.Endpoint, material.Device.SourceSearch.Endpoint,
+		material.Backend.Runtime.MainEndpoint, material.Backend.Runtime.CriticEndpoint,
+		material.Backend.Runtime.SupervisorEndpoint, material.Backend.Runtime.EmbeddingEndpoint,
+		material.Backend.Runtime.SourceSearchPlannerEndpoint, material.Backend.EmbeddingFallback.Endpoint,
+	}
+	privateJSON := []string{
+		material.Device.Main.ExtraHeadersJSON, material.Device.Main.ExtraBodyJSON,
+		material.Device.Critic.ExtraHeadersJSON, material.Device.Critic.ExtraBodyJSON,
+		material.Device.SourceSearch.ExtraHeadersJSON, material.Device.SourceSearch.ExtraBodyJSON,
+		material.Backend.Runtime.MainExtraHeadersJSON, material.Backend.Runtime.MainExtraBodyJSON,
+		material.Backend.Runtime.CriticExtraHeadersJSON, material.Backend.Runtime.CriticExtraBodyJSON,
+		material.Backend.Runtime.SupervisorExtraHeadersJSON, material.Backend.Runtime.SupervisorExtraBodyJSON,
+	}
+	privateValues := []string{
+		material.Device.Main.APIKey, material.Device.Main.Endpoint,
+		material.Device.Main.ExtraHeadersJSON, material.Device.Main.ExtraBodyJSON,
+		material.Device.Critic.APIKey, material.Device.Critic.Endpoint,
+		material.Device.Critic.ExtraHeadersJSON, material.Device.Critic.ExtraBodyJSON,
+		material.Device.Embedding.APIKey, material.Device.Embedding.Endpoint,
+		material.Device.SourceSearch.APIKey, material.Device.SourceSearch.Endpoint,
+		material.Device.SourceSearch.ExtraHeadersJSON, material.Device.SourceSearch.ExtraBodyJSON,
+		material.Backend.Runtime.MainAPIKey, material.Backend.Runtime.MainEndpoint,
+		material.Backend.Runtime.MainExtraHeadersJSON, material.Backend.Runtime.MainExtraBodyJSON,
+		material.Backend.Runtime.CriticAPIKey, material.Backend.Runtime.CriticEndpoint,
+		material.Backend.Runtime.CriticExtraHeadersJSON, material.Backend.Runtime.CriticExtraBodyJSON,
+		material.Backend.Runtime.SupervisorAPIKey, material.Backend.Runtime.SupervisorEndpoint,
+		material.Backend.Runtime.SupervisorExtraHeadersJSON, material.Backend.Runtime.SupervisorExtraBodyJSON,
+		material.Backend.Runtime.EmbeddingAPIKey, material.Backend.Runtime.EmbeddingEndpoint,
+		material.Backend.Runtime.SourceSearchPlannerAPIKey, material.Backend.Runtime.SourceSearchPlannerEndpoint,
+		material.Backend.EmbeddingFallback.APIKey, material.Backend.EmbeddingFallback.Endpoint,
+		material.Backend.Preprocessing.SharedPrompt,
+		material.Backend.SupervisorPrompt.Content, material.Backend.CriticPrompt.Content,
+	}
+	for _, role := range material.Backend.Preprocessing.Roles {
+		privateValues = append(privateValues, role.APIKey, role.Endpoint, role.Prompt)
+		endpoints = append(endpoints, role.Endpoint)
+	}
+	for _, endpoint := range endpoints {
+		privateValues = append(privateValues, pocketRisuEndpointPrivateValues(endpoint)...)
+	}
+	for _, raw := range privateJSON {
+		privateValues = append(privateValues, pocketRisuJSONPrivateValues(raw)...)
+	}
+	var decoded any
+	if json.Unmarshal([]byte(resultJSON), &decoded) != nil {
+		return true
+	}
+	resultStrings := []string{}
+	var collectResultStrings func(any)
+	collectResultStrings = func(value any) {
+		switch typed := value.(type) {
+		case string:
+			resultStrings = append(resultStrings, typed)
+		case []any:
+			for _, item := range typed {
+				collectResultStrings(item)
+			}
+		case map[string]any:
+			for _, item := range typed {
+				collectResultStrings(item)
+			}
+		}
+	}
+	collectResultStrings(decoded)
+	for _, privateValue := range privateValues {
+		privateValue = strings.TrimSpace(privateValue)
+		if len(privateValue) < 4 {
+			continue
+		}
+		for _, resultValue := range resultStrings {
+			if strings.Contains(resultValue, privateValue) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func normalizePocketRisuHostPreparedResult(raw json.RawMessage, prepare *store.HostPrepareResult) (string, error) {
+	if len(raw) == 0 || prepare == nil {
+		return "", errors.New("prepare result is missing")
+	}
+	var result pocketRisuHostPreparedResult
+	decoder := json.NewDecoder(bytes.NewReader(raw))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&result); err != nil {
+		return "", err
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		return "", errors.New("prepare result must contain one JSON document")
+	}
+	result.ContractVersion = strings.TrimSpace(result.ContractVersion)
+	result.Status = strings.TrimSpace(result.Status)
+	result.PayloadStage = strings.TrimSpace(result.PayloadStage)
+	result.AssembledPayloadSHA256 = strings.ToLower(strings.TrimSpace(result.AssembledPayloadSHA256))
+	if result.ContractVersion != pocketRisuHostPreparedResultVersion ||
+		(result.Status != "ready" && result.Status != "empty" && result.Status != "suppressed") ||
+		result.PayloadStage != "archive_center_prepare_response" ||
+		result.ExecutionContextID != prepare.ExecutionContextID ||
+		result.SettingsSnapshotDigest != prepare.SettingsSnapshotDigest ||
+		result.InputReceiptID != prepare.InputReceiptID ||
+		result.SourceRevision != prepare.SourceRevision ||
+		strings.ToLower(strings.TrimSpace(result.SemanticPayloadHash)) != prepare.SemanticPayloadHash ||
+		strings.ToLower(strings.TrimSpace(result.RequestType)) != prepare.RequestType ||
+		strings.TrimSpace(result.ProtocolVersion) != prepare.ProtocolVersion {
+		return "", errors.New("prepare result owner or contract mismatch")
+	}
+	var compactPayload bytes.Buffer
+	if len(result.AssembledPayload) == 0 || !json.Valid(result.AssembledPayload) || json.Compact(&compactPayload, result.AssembledPayload) != nil {
+		return "", errors.New("assembled payload is invalid")
+	}
+	payloadDigest := sha256.Sum256(compactPayload.Bytes())
+	if result.AssembledPayloadSHA256 != hex.EncodeToString(payloadDigest[:]) {
+		return "", errors.New("assembled payload hash mismatch")
+	}
+	result.AssembledPayload = append(json.RawMessage(nil), compactPayload.Bytes()...)
+	result.SemanticPayloadHash = prepare.SemanticPayloadHash
+	result.RequestType = prepare.RequestType
+	result.ProtocolVersion = prepare.ProtocolVersion
+	encoded, err := json.Marshal(result)
+	if err != nil {
+		return "", err
+	}
+	if len(encoded) > 1024*1024 {
+		return "", errors.New("prepare result exceeds the store bound")
+	}
+	return string(encoded), nil
+}
