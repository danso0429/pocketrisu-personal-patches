+	resolved, err := resolvePocketRisuExecutionContext(pocketRisuExecutionContextMaterialForTest("DEVICE_DIAGNOSTIC_SECRET", "BACKEND_DIAGNOSTIC_SECRET"))
+	if err != nil {
