+	Seq               uint64
+	PreviousSeq       uint64
+	OperationID       string
+	Kind              string
+	BeforeRevision    string
+	AfterRevision     string
+	MessageIdentities []string
+	SourceGeneration  string
+	CommittedAt       time.Time
+	PayloadRef        string
+}
+
+type HostChangeResult struct {
+	ContractVersion     string `json:"contract_version"`
+	Status              string `json:"status"`
+	ReasonCode          string `json:"reason_code"`
+	ResolvedSessionID   string `json:"resolved_session_id,omitempty"`
+	BindingEpoch        string `json:"binding_epoch,omitempty"`
+	CurrentBindingEpoch string `json:"current_binding_epoch,omitempty"`
+	EventID             string `json:"event_id,omitempty"`
+	Seq                 uint64 `json:"seq,omitempty"`
+	IngestedSeq         uint64 `json:"ingested_seq"`
+	SafeSeq             uint64 `json:"safe_seq"`
+	RequiredSeq         uint64 `json:"required_seq,omitempty"`
+	SafetyState         string `json:"safety_state,omitempty"`
+	SafetyDisposition   string `json:"safety_disposition,omitempty"`
+	Reused              bool   `json:"reused"`
+}
+
+type HostChangeSourceInvalidationRequest struct {
+	HostChangeStreamIdentity
+	EventID string
+}
+
+type HostChangeStreamStore interface {
+	IngestHostChangeIntent(context.Context, HostChangeIntent) (*HostChangeResult, error)
+	ApplyHostChangeSourceInvalidation(context.Context, HostChangeSourceInvalidationRequest) (*HostChangeResult, error)
+	GetHostChangeStream(context.Context, HostChangeStreamIdentity) (*HostChangeResult, error)
+}
+
+var _ HostChangeStreamStore = (*mariadbStore)(nil)
+
+type hostChangeStream struct {
+	StreamKey          string
+	ContractVersion    string
+	HostInstanceID     string
+	StableCharacterID  string
+	HostChatID         string
