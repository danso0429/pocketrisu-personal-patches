+	hash := hex.EncodeToString(sum[:])
+	gotJSON, gotHash, err := normalizeHostPrepareResult(raw, hash)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gotJSON != compact || gotHash != hash {
+		t.Fatalf("normalized result json=%q hash=%q", gotJSON, gotHash)
