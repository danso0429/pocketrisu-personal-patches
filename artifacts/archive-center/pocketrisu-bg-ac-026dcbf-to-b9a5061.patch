+package httpapi
+
+import (
+	"testing"
+
+	"github.com/risulongmemory/archive-center-go/internal/dto"
+)
+
+// C0 characterization probe: the existing Risu Host contract deliberately
+// rejects honest PocketRisu server provenance. Replace this expectation with
+// positive and negative versioned-host fixtures when the server contract is
+// implemented.
+func TestC0PocketRisuPrepareObservationNeedsVersionedServerContract(t *testing.T) {
+	user := "server-owned user input"
+	role := "user"
+	hash := prepareOR1CHash(user)
+	hashAlgorithm := "or1c_utf16_djb2.v1"
+	messageIndex := 1
+	requestType := "model"
+
+	request := dto.PrepareTurnContractRequest{
+		PrepareTurnRequest: dto.PrepareTurnRequest{
+			ChatSessionID: "session-c0",
+			RequestType:   &requestType,
+		},
+		HostObservations: &dto.PrepareTurnHostObservationsV1{
+			ContractVersion:         prepareHostObservationsVersion,
+			SessionID:               "session-c0",
+			RequestID:               "operation-c0",
+			RequestType:             "model",
+			PayloadWritable:         true,
+			PayloadObservationStage: "server_main_request_before_ac",
+			ActiveChat: []dto.PrepareTurnMessageObservationV1{{
+				ObservationRef:   "input-receipt-c0",
+				SourceKind:       "pocketrisu_canonical_chat",
+				ObservationStage: "server_input_committed",
+				MessageID:        stringPointer("user-message-c0"),
+				MessageIndex:     &messageIndex,
+				Role:             &role,
+				RawContent:       &user,
+				ContentHash:      &hash,
+				HashAlgorithm:    &hashAlgorithm,
+				EvidenceState:    "observed",
+			}},
+			Payload: []dto.PrepareTurnMessageObservationV1{{
+				ObservationRef: "payload-c0",
+				SourceKind:     "server_main_request_before_ac",
+				MessageIndex:   &messageIndex,
+				Role:           &role,
+				RawContent:     &user,
+				ContentHash:    &hash,
+				HashAlgorithm:  &hashAlgorithm,
+				EvidenceState:  "observed",
+			}},
+		},
+	}
+
+	decision, contractPresent := buildPrepareTurnCurrentInputDecision(request, "session-c0")
+	if !contractPresent {
+		t.Fatal("PocketRisu observation was treated as a missing contract")
+	}
+	if decision.Status != "failed" || decision.ReasonCode != "current_user_input_provenance_invalid" {
+		t.Fatalf("decision=%+v, want explicit provenance rejection", decision)
+	}
+	if decision.MemoryReadsAllowed || decision.ContextInjectionEligible {
+		t.Fatalf("rejected server provenance reached memory/injection: %+v", decision)
+	}
+}
+
+// C0 characterization probe: v1 has no server-host identity or durable commit
+// receipt fields. Unknown server fields disappear during decoding, so changing
+// them cannot affect acceptance or revision identity. The future v4 contract
+// must invert this result and reject an untrusted host or mismatched receipt.
+func TestC0CompleteV1IgnoresPocketRisuServerCommitIdentity(t *testing.T) {
+	request := completeTurnAnchoredAcceptanceTestRequest(
+		"session-c0", 2, "server-owned user input", "server-owned answer",
+		1000, "generation-c0", "not_streaming", 1, 2, 3,
+	)
+	observation := request.ClientMeta["source_acceptance_observation"].(map[string]any)
+	observation["host_kind"] = "pocketrisu_server"
+	observation["host_contract_version"] = "pocketrisu_server_commit.v1"
+	observation["operation_id"] = "operation-c0"
+	observation["commit_receipt_id"] = "receipt-c0"
+
+	trusted, err := completeTurnSourceObservationFromMeta(request.ClientMeta)
+	if err != nil {
+		t.Fatalf("decode trusted-shaped observation: %v", err)
+	}
+	trustedDecision := validateCompleteTurnSourceObservation(request, trusted)
+	if !trustedDecision.Accepted {
+		t.Fatalf("trusted-shaped v1 decision=%+v, want current v1 acceptance baseline", trustedDecision)
+	}
+
+	observation["host_kind"] = "untrusted_host"
+	observation["host_contract_version"] = "unrelated_contract.v9"
+	observation["operation_id"] = "different-operation"
+	observation["commit_receipt_id"] = "different-receipt"
+	untrusted, err := completeTurnSourceObservationFromMeta(request.ClientMeta)
+	if err != nil {
+		t.Fatalf("decode untrusted-shaped observation: %v", err)
+	}
+	untrustedDecision := validateCompleteTurnSourceObservation(request, untrusted)
+	if !untrustedDecision.Accepted {
+		t.Fatalf("untrusted-shaped v1 decision=%+v, want current v1 acceptance baseline", untrustedDecision)
+	}
+	if completeTurnSourceRevision("session-c0", 2, trusted) != completeTurnSourceRevision("session-c0", 2, untrusted) {
+		t.Fatal("unknown server identity unexpectedly changed the v1 source revision")
+	}
+}
