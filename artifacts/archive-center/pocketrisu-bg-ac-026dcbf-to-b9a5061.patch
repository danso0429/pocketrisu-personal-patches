+}
+
+func (s *pocketRisuHostTestStore) GetHostSessionExecution(_ context.Context, _, _ string) (*store.HostSessionExecutionResult, error) {
+	return cloneHostExecutionResult(s.execution), nil
+}
+
+func (s *pocketRisuHostTestStore) SettleHostSessionExecution(_ context.Context, request store.HostSessionExecutionSettleRequest) (*store.HostSessionExecutionResult, error) {
+	result := cloneHostExecutionResult(s.execution)
+	result.Status = store.HostSessionExecutionStatusTerminal
+	result.ReasonCode = "execution_terminal"
+	result.Phase = "settled"
+	result.EndEventID = request.EndEventID
+	result.EndReason = request.EndReason
+	result.SourceDisposition = request.SourceDisposition
+	s.execution = result
+	return cloneHostExecutionResult(result), nil
+}
+
+func (s *pocketRisuHostTestStore) RegisterHostPrepare(_ context.Context, request store.HostPrepareRegisterRequest) (*store.HostPrepareResult, error) {
+	s.registerRequests = append(s.registerRequests, request)
+	if s.registerErr != nil {
+		return nil, s.registerErr
+	}
+	result := &store.HostPrepareResult{
+		ContractVersion:         store.HostPrepareRegistryContractVersion,
+		Status:                  store.HostPrepareStatusRegistered,
+		ReasonCode:              "prepare_registered",
+		PrepareKey:              store.HostPrepareKey(request.HostPrepareIdentity),
+		RequestFingerprint:      strings.Repeat("f", 64),
+		HostInstanceID:          request.HostInstanceID,
+		StableCharacterID:       request.StableCharacterID,
+		HostChatID:              request.HostChatID,
+		ResolvedSessionID:       "session-1",
+		BindingEpoch:            request.BindingEpoch,
+		OperationID:             request.OperationID,
+		ClaimEpoch:              request.ClaimEpoch,
+		MainRequestID:           request.MainRequestID,
+		ExecutionContextID:      request.ExecutionContextID,
+		SettingsSnapshotDigest:  request.SettingsSnapshotDigest,
+		InputReceiptID:          request.InputReceiptID,
+		SourceRevision:          request.SourceRevision,
+		SemanticPayloadHash:     request.SemanticPayloadHash,
+		RequestType:             request.RequestType,
+		ProtocolVersion:         request.ProtocolVersion,
+		ExternalCallDisposition: "not_recorded",
+	}
+	if s.prepare != nil {
+		result.Reused = true
+		result.Status = s.prepare.Status
+		result.RunEpoch = s.prepare.RunEpoch
+		result.ExternalOperationID = s.prepare.ExternalOperationID
+	}
+	s.prepare = result
+	return cloneHostPrepareResult(result), nil
+}
+
+func (s *pocketRisuHostTestStore) StartHostPrepare(_ context.Context, request store.HostPrepareStartRequest) (*store.HostPrepareResult, error) {
+	result := cloneHostPrepareResult(s.prepare)
+	result.Status = store.HostPrepareStatusRunning
+	result.ReasonCode = "prepare_started"
+	result.RunEpoch++
+	result.ExternalOperationID = request.ExternalOperationID
+	result.StartAuthorized = true
+	s.prepare = result
+	return cloneHostPrepareResult(result), nil
+}
+
+func (s *pocketRisuHostTestStore) CompleteHostPrepare(_ context.Context, request store.HostPrepareCompleteRequest) (*store.HostPrepareResult, error) {
+	result := cloneHostPrepareResult(s.prepare)
+	result.Status = store.HostPrepareStatusReady
+	result.ReasonCode = "prepare_ready"
+	result.RunEpoch = request.RunEpoch
+	result.ResultJSON = request.ResultJSON
+	result.ResultHash = request.ResultHash
+	result.StartAuthorized = false
+	s.prepare = result
+	return cloneHostPrepareResult(result), nil
+}
+
+func (s *pocketRisuHostTestStore) FailHostPrepare(_ context.Context, request store.HostPrepareFailureRequest) (*store.HostPrepareResult, error) {
+	result := cloneHostPrepareResult(s.prepare)
+	result.Status = store.HostPrepareStatusFailedKnown
+	result.ReasonCode = "prepare_failed_known"
+	result.RunEpoch = request.RunEpoch
+	result.FailureCode = request.FailureCode
+	result.FailureRetryable = request.Retryable
+	s.prepare = result
+	return cloneHostPrepareResult(result), nil
+}
+
+func (s *pocketRisuHostTestStore) MarkHostPrepareOutcomeUnknown(_ context.Context, request store.HostPrepareOutcomeUnknownRequest) (*store.HostPrepareResult, error) {
+	result := cloneHostPrepareResult(s.prepare)
+	result.Status = store.HostPrepareStatusOutcomeUnknown
+	result.ReasonCode = "prepare_outcome_unknown"
+	result.RunEpoch = request.RunEpoch
+	s.prepare = result
+	return cloneHostPrepareResult(result), nil
+}
+
+func (s *pocketRisuHostTestStore) SkipHostPrepare(_ context.Context, request store.HostPrepareSkipRequest) (*store.HostPrepareResult, error) {
+	result := cloneHostPrepareResult(s.prepare)
+	result.Status = store.HostPrepareStatusSkipped
+	result.ReasonCode = "prepare_skipped"
+	result.SkipEventID = request.SkipEventID
+	result.SkipReason = request.SkipReason
+	result.ExecutionClaimReleased = true
+	s.prepare = result
+	return cloneHostPrepareResult(result), nil
+}
+
+func (s *pocketRisuHostTestStore) GetHostPrepare(_ context.Context, lookup store.HostPrepareLookup) (*store.HostPrepareResult, error) {
+	if s.prepare == nil || s.prepare.PrepareKey != lookup.PrepareKey || s.prepare.RequestFingerprint != lookup.RequestFingerprint {
+		return &store.HostPrepareResult{
+			ContractVersion:    store.HostPrepareRegistryContractVersion,
+			Status:             store.HostPrepareStatusRejected,
+			ReasonCode:         "prepare_not_found",
+			PrepareKey:         lookup.PrepareKey,
+			RequestFingerprint: lookup.RequestFingerprint,
+		}, nil
+	}
+	return cloneHostPrepareResult(s.prepare), nil
+}
+
+func (s *pocketRisuHostTestStore) GetHostPrepareByKey(_ context.Context, prepareKey string) (*store.HostPrepareResult, error) {
+	if s.prepare == nil || s.prepare.PrepareKey != prepareKey {
+		return nil, store.ErrNotFound
+	}
+	result := cloneHostPrepareResult(s.prepare)
+	result.Reused = true
+	return result, nil
+}
+
+func (s *pocketRisuHostTestStore) ListRunningHostPrepares(_ context.Context, limit int) ([]store.HostPrepareResult, error) {
+	if limit <= 0 {
+		return nil, store.ErrHostPrepareInvalid
+	}
+	if s.prepare == nil || s.prepare.Status != store.HostPrepareStatusRunning {
+		return []store.HostPrepareResult{}, nil
+	}
+	return []store.HostPrepareResult{*cloneHostPrepareResult(s.prepare)}, nil
+}
