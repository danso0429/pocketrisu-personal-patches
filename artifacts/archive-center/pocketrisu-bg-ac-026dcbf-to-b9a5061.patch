+func (s *Server) handlePocketRisuHostPrepareComplete(w http.ResponseWriter, r *http.Request) {
+	var request pocketRisuHostPrepareCompleteRequest
+	if !decodePocketRisuHostRequest(w, r, &request) || !requirePocketRisuHostTransportVersion(w, request.ContractVersion) {
+		return
+	}
+	_, prepares, ok := s.pocketRisuHostStores()
+	if !ok {
+		writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_store_unavailable", "PocketRisu host store is unavailable")
+		return
+	}
+	current, _, ok := s.requirePocketRisuHostPrepareContext(w, r, prepares, request.pocketRisuHostPrepareReference)
+	if !ok {
