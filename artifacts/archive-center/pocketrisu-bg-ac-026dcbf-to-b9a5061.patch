+
+func pocketRisuEndpointPrivateValues(endpoint string) []string {
+	parsed, err := url.Parse(strings.TrimSpace(endpoint))
+	if err != nil {
+		return nil
+	}
+	values := []string{}
+	if parsed.User != nil {
+		if password, ok := parsed.User.Password(); ok {
+			values = append(values, password)
+		}
+	}
+	for _, queryValues := range parsed.Query() {
+		values = append(values, queryValues...)
+	}
+	return values
+}
+
+func pocketRisuJSONPrivateValues(raw string) []string {
+	if strings.TrimSpace(raw) == "" {
+		return nil
+	}
+	var decoded any
+	if json.Unmarshal([]byte(raw), &decoded) != nil {
+		return []string{raw}
+	}
+	values := []string{}
+	var collect func(any)
+	collect = func(value any) {
+		switch typed := value.(type) {
+		case string:
+			values = append(values, typed)
+		case []any:
+			for _, item := range typed {
+				collect(item)
+			}
+		case map[string]any:
+			for _, item := range typed {
+				collect(item)
+			}
+		}
+	}
+	collect(decoded)
+	return values
+}
+
+func redactPocketRisuPrivateValues(text string, values ...string) string {
+	redacted := text
+	for _, value := range values {
+		value = strings.TrimSpace(value)
+		if len(value) < 4 {
+			continue
+		}
+		redacted = strings.ReplaceAll(redacted, value, "[redacted]")
+	}
+	return redacted
+}
+
+func redactPocketRisuLLMConfigTrace(trace map[string]any) map[string]any {
+	for _, role := range []string{"critic", "embedding"} {
+		roleTrace := mapFromAny(trace[role])
+		endpointConfigured := strings.TrimSpace(extractionStringFromAny(roleTrace["endpoint_host"])) != ""
+		delete(roleTrace, "endpoint_host")
+		roleTrace["endpoint_configured"] = endpointConfigured
+		trace[role] = roleTrace
+	}
+	return trace
+}
