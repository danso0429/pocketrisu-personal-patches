+		CreatedAt: now, UpdatedAt: now,
+	}
+}
+
+func expectHostSessionExecutionBinding(mock sqlmock.Sqlmock, binding SessionRouteBinding, forUpdate bool) {
+	pattern := `(?s)FROM session_route_bindings.*host_chat_id = \?`
+	if forUpdate {
