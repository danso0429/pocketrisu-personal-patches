+func buildPrepareTurnCurrentInputDecisionWithPocketRisuHost(
+	request dto.PrepareTurnContractRequest,
+	sessionID string,
+	consumer *pocketRisuHostConsumerContext,
+) (dto.PrepareTurnCurrentInputDecisionV1, bool) {
+	observation := request.PocketRisuHostObservation
+	if observation == nil && consumer == nil {
+		return buildPrepareTurnCurrentInputDecision(request, sessionID)
+	}
+	decision := dto.PrepareTurnCurrentInputDecisionV1{
+		ContractVersion:          "current_input_decision.v1",
+		Status:                   "failed",
+		ReasonCode:               "pocketrisu_host_observation_invalid",
+		RequestOwnership:         "unverified",
+		OriginalPayloadPreserved: true,
+		CapabilityCoverage:       prepareTurnCapabilityCoverage(request.CapabilityObservation),
+	}
+	if consumer == nil {
+		decision.ReasonCode = "pocketrisu_host_context_required"
+		return decision, true
+	}
+	if observation == nil {
+		decision.ReasonCode = "pocketrisu_host_observation_required"
+		return decision, true
+	}
+	prepare := consumer.Prepare
+	execution := consumer.Execution
+	identity := consumer.Reference.Identity
+	rawUserInput := stringPtrValue(request.RawUserInput, "")
+	requestType := strings.TrimSpace(stringPtrValue(request.RequestType, "model"))
+	if strings.TrimSpace(observation.ContractVersion) != preparePocketRisuHostObservationVersion {
+		decision.ReasonCode = "pocketrisu_host_observation_contract_incompatible"
+		return decision, true
+	}
+	if prepare == nil || execution == nil || strings.TrimSpace(prepare.ResolvedSessionID) != strings.TrimSpace(sessionID) ||
+		observation.HostInstanceID != identity.HostInstanceID ||
+		observation.StableCharacterID != identity.StableCharacterID ||
+		observation.HostChatID != identity.HostChatID ||
+		observation.BindingEpoch != identity.BindingEpoch ||
+		observation.OperationID != identity.OperationID ||
+		observation.ClaimEpoch != identity.ClaimEpoch ||
+		observation.InputReceiptID != prepare.InputReceiptID ||
+		observation.SourceRevision != prepare.SourceRevision ||
+		observation.SemanticPayloadHash != prepare.SemanticPayloadHash ||
+		observation.RequiredHostChangeSeq != execution.RequiredHostChangeSeq {
+		decision.ReasonCode = "pocketrisu_host_observation_owner_mismatch"
+		return decision, true
+	}
+	if requestType != "model" || strings.TrimSpace(observation.RequestType) != requestType || prepare.RequestType != requestType {
+		decision.Status = "not_applicable"
+		decision.ReasonCode = "current_user_input_request_not_applicable"
+		decision.RequestOwnership = "auxiliary"
+		return decision, true
+	}
+	if strings.TrimSpace(observation.ObservationStage) != "server_input_committed_before_ac_prepare" ||
+		!observation.PayloadWritable || observation.RawUserInput != rawUserInput ||
+		observation.RawInputSHA256 != preparePocketRisuSHA256(rawUserInput) {
+		decision.ReasonCode = "pocketrisu_host_observation_payload_mismatch"
+		return decision, true
+	}
+	requestID := identity.OperationID
+	messageID := prepare.InputReceiptID
+	hostChatID := identity.HostChatID
+	sourceRevision := prepare.SourceRevision
+	hash := preparePocketRisuSHA256(rawUserInput)
+	backendIDHash := sha256.Sum256([]byte(strings.Join([]string{
+		identity.HostInstanceID, identity.OperationID, prepare.InputReceiptID, hash,
+	}, "\x1f")))
+	envelope := dto.PrepareTurnMessageSourceEnvelopeV1{
+		ContractVersion: "message_source_envelope.v1",
+		BackendSourceID: "src_" + hex.EncodeToString(backendIDHash[:]),
+		Identity: dto.PrepareTurnMessageSourceIdentityV1{
+			SessionID: sessionID, ChatID: &hostChatID, RequestID: &requestID, MessageID: &messageID,
+		},
+		RawRole:          "user",
+		Channel:          "server_owned",
+		RawContent:       rawUserInput,
+		ContentHash:      hash,
+		HashAlgorithm:    "sha256.v1",
+		ObservedRevision: &sourceRevision,
+		SourceOrigin:     "current_input",
+		OriginProvenance: "pocketrisu_server_input_commit",
+		ObservationRef:   prepare.InputReceiptID,
+		LifecycleObservation: dto.PrepareTurnSourceLifecycleV1{
+			State: "observed", Streaming: "not_streaming", FinalDisplay: "not_applicable",
+		},
+	}
+	decision.Status = "eligible"
+	decision.ReasonCode = "current_user_input_server_commit_observed"
+	decision.RequestOwnership = "main"
+	decision.ContextInjectionEligible = true
+	decision.MemoryReadsAllowed = true
+	decision.EffectiveUserInput = rawUserInput
+	decision.SelectedObservationRef = &messageID
+	decision.Envelope = &envelope
+	return decision, true
+}
