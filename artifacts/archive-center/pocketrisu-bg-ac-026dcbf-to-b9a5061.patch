diff --git a/migrations/014_host_session_execution.sql b/migrations/014_host_session_execution.sql
new file mode 100644
index 0000000000000000000000000000000000000000..c5069160af66f32772aba573f7ce9692fc2f235b
--- /dev/null
+++ b/migrations/014_host_session_execution.sql
@@ -0,0 +1,57 @@
+-- PocketRisu server-host execution ownership.
+--
+-- One row per canonical Archive Center session is the active execution slot.
+-- Terminal outcomes live in a separate immutable ledger so an ACK loss or a
+-- late owner cannot make an already-settled operation claim the slot again.
+
+CREATE TABLE IF NOT EXISTS host_session_execution_slots (
+    canonical_session_id             VARCHAR(255)    NOT NULL PRIMARY KEY,
+    contract_version                 VARCHAR(80)     NOT NULL,
+    active_host_instance_id          VARCHAR(255)    NULL,
+    active_stable_character_id       VARCHAR(255)    NULL,
+    active_host_chat_id              VARCHAR(255)    NULL,
+    active_binding_epoch             VARCHAR(96)     NULL,
+    active_operation_id              VARCHAR(255)    NULL,
+    claim_epoch                      BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    phase                            VARCHAR(50)     NOT NULL DEFAULT 'idle',
+    required_host_change_seq         BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    ingested_host_change_seq         BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    safe_host_change_seq             BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    claimed_at                       DATETIME(3)      NULL,
+    created_at                       DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) NOT NULL,
+    updated_at                       DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3) NOT NULL,
+    UNIQUE KEY uq_host_session_execution_active_operation
+        (active_host_instance_id, active_operation_id),
+    INDEX idx_host_session_execution_active_binding
+        (active_stable_character_id, active_host_chat_id, phase)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
+  COMMENT='Durable one-owner execution slot and host-change safety watermarks per canonical session.';
+
+CREATE TABLE IF NOT EXISTS host_session_execution_outcomes (
+    outcome_id                       BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+    contract_version                 VARCHAR(80)     NOT NULL,
+    host_instance_id                VARCHAR(255)    NOT NULL,
+    stable_character_id             VARCHAR(255)    NOT NULL,
+    host_chat_id                    VARCHAR(255)    NOT NULL,
+    canonical_session_id            VARCHAR(255)    NOT NULL,
+    binding_epoch                   VARCHAR(96)     NOT NULL,
+    operation_id                    VARCHAR(255)    NOT NULL,
+    claim_epoch                     BIGINT UNSIGNED NOT NULL,
+    end_event_id                    VARCHAR(255)    NOT NULL,
+    requested_end_reason            VARCHAR(80)     NOT NULL,
+    end_reason                      VARCHAR(80)     NOT NULL,
+    terminal_phase                  VARCHAR(50)     NOT NULL,
+    source_disposition              VARCHAR(50)     NOT NULL,
+    final_required_host_change_seq  BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    final_safe_host_change_seq      BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    settled_at                      DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) NOT NULL,
+    UNIQUE KEY uq_host_session_execution_operation
+        (host_instance_id, operation_id),
+    UNIQUE KEY uq_host_session_execution_end_event
+        (host_instance_id, end_event_id),
+    INDEX idx_host_session_execution_outcome_session
+        (canonical_session_id, settled_at),
+    INDEX idx_host_session_execution_outcome_binding
+        (stable_character_id, host_chat_id, binding_epoch)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
+  COMMENT='Immutable terminal outcomes for idempotent PocketRisu host execution settle and status.';
diff --git a/migrations/015_host_change_stream.sql b/migrations/015_host_change_stream.sql
new file mode 100644
index 0000000000000000000000000000000000000000..c28f34d089a467c37fee4d53870b792189eb1c74
--- /dev/null
+++ b/migrations/015_host_change_stream.sql
@@ -0,0 +1,51 @@
+-- Ordered PocketRisu host-change delivery.
+--
+-- Streams are keyed by a SHA-256 digest of the exact host/binding identity so
+-- the full UTF-8 identifiers do not exceed MariaDB's composite-index ceiling.
+-- Events retain their immutable fingerprint and original host commit time.
+
+CREATE TABLE IF NOT EXISTS host_change_streams (
+    stream_key               CHAR(64)        NOT NULL PRIMARY KEY,
+    contract_version         VARCHAR(80)     NOT NULL,
+    host_instance_id        VARCHAR(255)    NOT NULL,
+    stable_character_id     VARCHAR(255)    NOT NULL,
+    host_chat_id            VARCHAR(255)    NOT NULL,
+    binding_epoch           VARCHAR(96)     NOT NULL,
+    canonical_session_id    VARCHAR(255)    NOT NULL,
+    ingested_seq            BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    safe_seq                BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    created_at              DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) NOT NULL,
+    updated_at              DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3) NOT NULL,
+    INDEX idx_host_change_stream_session (canonical_session_id, updated_at),
+    INDEX idx_host_change_stream_binding (stable_character_id, host_chat_id, binding_epoch)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
+  COMMENT='Durable contiguous ingest and safe watermarks for one PocketRisu host binding epoch.';
+
+CREATE TABLE IF NOT EXISTS host_change_events (
+    event_row_id             BIGINT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
+    contract_version         VARCHAR(80)     NOT NULL,
+    stream_key              CHAR(64)        NOT NULL,
+    event_id                VARCHAR(255)    NOT NULL,
+    seq                     BIGINT UNSIGNED NOT NULL,
+    previous_seq            BIGINT UNSIGNED NOT NULL,
+    operation_id            VARCHAR(255)    NULL,
+    event_kind              VARCHAR(50)     NOT NULL,
+    before_revision         VARCHAR(255)    NULL,
+    after_revision          VARCHAR(255)    NULL,
+    message_identities_json JSON            NOT NULL,
+    source_generation       VARCHAR(255)    NULL,
+    committed_at            DATETIME(3)      NOT NULL,
+    payload_ref             VARCHAR(255)    NOT NULL,
+    event_fingerprint       CHAR(64)        NOT NULL,
+    safety_state            VARCHAR(50)     NOT NULL DEFAULT 'pending',
+    safety_disposition      VARCHAR(80)     NULL,
+    safe_at                 DATETIME(3)      NULL,
+    ingested_at             DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) NOT NULL,
+    UNIQUE KEY uq_host_change_event_id (stream_key, event_id),
+    UNIQUE KEY uq_host_change_event_seq (stream_key, seq),
+    INDEX idx_host_change_event_safety (stream_key, safety_state, seq),
+    CONSTRAINT fk_host_change_event_stream
+        FOREIGN KEY (stream_key) REFERENCES host_change_streams(stream_key)
+        ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
+  COMMENT='Immutable ordered host mutation receipts and separately resolved source-safety state.';
diff --git a/migrations/016_host_prepare_registry.sql b/migrations/016_host_prepare_registry.sql
new file mode 100644
index 0000000000000000000000000000000000000000..3085e13eb298337e6aff02d6c8a8ee7b0e017265
--- /dev/null
+++ b/migrations/016_host_prepare_registry.sql
@@ -0,0 +1,54 @@
+-- Durable PocketRisu server-host prepare registry.
+--
+-- The registry separates paid-work ownership from HTTP request lifetime. A
+-- fixed prepare key has one immutable semantic fingerprint and one bounded
+-- state machine; response recovery reads the stored ready result instead of
+-- starting another preparation.
+
+CREATE TABLE IF NOT EXISTS host_prepare_requests (
+    prepare_key               VARCHAR(80)     NOT NULL PRIMARY KEY,
+    contract_version          VARCHAR(80)     NOT NULL,
+    host_instance_id          VARCHAR(255)    NOT NULL,
+    stable_character_id       VARCHAR(255)    NOT NULL,
+    host_chat_id              VARCHAR(255)    NOT NULL,
+    canonical_session_id      VARCHAR(255)    NOT NULL,
+    binding_epoch             VARCHAR(96)     NOT NULL,
+    operation_id              VARCHAR(255)    NOT NULL,
+    claim_epoch               BIGINT UNSIGNED NOT NULL,
+    main_request_id           VARCHAR(255)    NOT NULL,
+    request_fingerprint       CHAR(64)        NOT NULL,
+    execution_context_id      VARCHAR(255)    NOT NULL,
+    settings_snapshot_digest  CHAR(64)        NOT NULL,
+    input_receipt_id          VARCHAR(255)    NOT NULL,
+    source_revision           VARCHAR(255)    NULL,
+    semantic_payload_hash     CHAR(64)        NOT NULL,
+    request_type              VARCHAR(50)     NOT NULL,
+    protocol_version          VARCHAR(120)    NOT NULL,
+    status                    VARCHAR(50)     NOT NULL DEFAULT 'registered_not_started',
+    run_epoch                 BIGINT UNSIGNED NOT NULL DEFAULT 0,
+    external_operation_id     VARCHAR(255)    NULL,
+    result_json               LONGTEXT        NULL,
+    result_hash               CHAR(64)        NULL,
+    failure_code              VARCHAR(160)    NULL,
+    failure_retryable         BOOLEAN         NULL,
+    external_call_disposition VARCHAR(30)     NOT NULL DEFAULT 'not_recorded',
+    skip_event_id             VARCHAR(255)    NULL,
+    skip_reason               VARCHAR(80)     NULL,
+    execution_claim_released  BOOLEAN         NOT NULL DEFAULT FALSE,
+    started_at                DATETIME(3)      NULL,
+    finished_at               DATETIME(3)      NULL,
+    created_at                DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) NOT NULL,
+    updated_at                DATETIME(3)      DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3) NOT NULL,
+    UNIQUE KEY uq_host_prepare_skip_event (host_instance_id, skip_event_id),
+    INDEX idx_host_prepare_session_status (canonical_session_id(160), status, updated_at),
+    INDEX idx_host_prepare_operation (host_instance_id(120), operation_id(120), status),
+    CONSTRAINT chk_host_prepare_claim_epoch CHECK (claim_epoch > 0),
+    CONSTRAINT chk_host_prepare_status CHECK (status IN (
+        'registered_not_started', 'running', 'ready', 'failed_known',
+        'outcome_unknown', 'skipped', 'fenced'
+    )),
+    CONSTRAINT chk_host_prepare_external_call CHECK (
+        external_call_disposition IN ('not_recorded', 'not_started', 'started', 'unknown')
+    )
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
+  COMMENT='Durable exactly-one prepare ownership, result recovery, and late-result fence.';
diff --git a/migrations/README.md b/migrations/README.md
index 7cd0e0333330cd8d8a5bfa94a0bb381ee0e6b081..237f1513c1a58fca61ae90940162a2ed37e2a216 100644
--- a/migrations/README.md
+++ b/migrations/README.md
@@ -8,6 +8,25 @@ sibling `.sql` file in sorted order. Fresh and existing installations therefore
 use the same complete set; `001_schema.sql` does not have to repeat tables or
 columns that are owned by later files.
 
+`014_host_session_execution.sql` adds the PocketRisu server-host execution
+slot and immutable terminal-outcome ledger. These tables are coordination
+metadata, not story/session content: session migration explicitly excludes
+them, while a route-binding epoch change fences the old execution owner.
+
+`015_host_change_stream.sql` adds per-binding contiguous ingest and safe
+watermarks plus immutable host-change event receipts. The stream is
+coordination metadata excluded from session content migration; event rows are
+owned transitively by the stream and contain no raw chat text. A content
+mutation advances the safe watermark only after the existing source lifecycle,
+worker fence, vector-delete outbox, and canonical-tail read-exclusion owners
+commit in the same MariaDB transaction.
+
+`016_host_prepare_registry.sql` adds a durable prepare key/fingerprint state
+machine. Only the first registered-to-running compare-and-set authorizes work;
+ready results survive response loss, while unknown/skipped/fenced states retain
+their tombstones and do not authorize automatic replay. The registry is
+coordination metadata excluded from session content migration.
+
 `013_precise_memory_text_fields.sql` addresses GitHub #6 by widening the three
 unindexed Critic-derived text fields in `precise_memory_units` to LONGTEXT.
 Fresh schema and the Go compatibility pass use the same types. Existing text and
