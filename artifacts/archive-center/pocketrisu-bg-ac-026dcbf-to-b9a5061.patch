+	observed := []observedCall{}
+	oldClient := proxyHTTPClient
+	proxyHTTPClient = &http.Client{Transport: roundTripFunc(func(request *http.Request) (*http.Response, error) {
+		body, _ := io.ReadAll(request.Body)
+		var payload map[string]any
+		_ = json.Unmarshal(body, &payload)
+		call := observedCall{
+			Path: request.URL.Path, Authorization: request.Header.Get("Authorization"),
+			Model: extractionStringFromAny(payload["model"]),
+		}
+		messages := anySliceFromAny(payload["messages"])
+		if len(messages) > 0 {
+			call.SystemPrompt = extractionStringFromAny(mapFromAny(messages[0])["content"])
+		}
+		observed = append(observed, call)
+		response := `{"choices":[{"message":{"content":"{}"}}]}`
+		switch request.URL.Path {
+		case "/v1/embeddings":
+			response = `{"model":"backend-embedding-model","data":[{"embedding":[0.1,0.2]}]}`
+		case "/v1/responses":
+			response = `{"id":"search-response","status":"completed","output":[]}`
+		}
+		return &http.Response{
+			StatusCode: http.StatusOK, Header: make(http.Header),
+			Body: io.NopCloser(strings.NewReader(response)),
+		}, nil
+	})}
+	defer func() { proxyHTTPClient = oldClient }()
+
+	_, _, _ = server.runSupervisorLLMWithPrompt(
+		context.Background(), consumer.Prepare.ResolvedSessionID,
+		supervisorBoundaryTestPack("weak"), consumer.Resolved.Supervisor, &consumer.Resolved.SupervisorPrompt,
+	)
+	_, _, _ = server.runCompleteTurnCriticWithCapturedPrompt(
+		context.Background(), consumer.Prepare.ResolvedSessionID, 1,
+		"user input", "assistant output", nil, nil, consumer.Resolved.Critic, false,
+		completeTurnCriticInputPolicy{AuxiliaryMaxChars: 2000, ConfiguredChars: 2000, Source: "test"},
+		completeTurnCriticInputReplay{}, &consumer.Resolved.CriticPrompt,
+	)
+	multiSettings := consumer.Resolved.Preprocessing
+	publisherConfig := consumer.Resolved.Supervisor
+	multiSettings.PublisherOverride = &publisherConfig
+	_ = server.callMultiAgent(context.Background(), "event_recent", multiSettings, 1, map[string]any{
+		"contract_version": multiAgentContract, "role": "event_recent", "current_input": "test",
+	}, consumer.Prepare.ResolvedSessionID)
+	_, _, _ = callQueryEmbedding(context.Background(), consumer.Resolved.Embedding, "embedding input")
+	_, _, _ = server.discoverSourcesWithSearchLLMConfig(context.Background(), store.SourceDiscoveryInput{
+		WorkQuery: "captured work", WorkTitle: "captured work", WorkType: "novel",
+	}, consumer.Resolved.SourceSearch)
+
+	if len(observed) != 5 {
+		t.Fatalf("observed calls=%d calls=%+v", len(observed), observed)
+	}
+	if observed[0].Authorization != "Bearer BACKEND_ROUTE_SECRET-backend-supervisor" ||
+		observed[0].Model != "backend-supervisor-model" ||
+		observed[0].SystemPrompt != "FROZEN_ROLE_SUPERVISOR_PROMPT" {
+		t.Fatalf("supervisor call=%+v", observed[0])
+	}
+	if observed[1].Authorization != "Bearer BACKEND_ROUTE_SECRET-backend-critic" ||
+		observed[1].Model != "backend-critic-model" ||
+		observed[1].SystemPrompt != "FROZEN_ROLE_CRITIC_PROMPT" {
+		t.Fatalf("critic call=%+v", observed[1])
+	}
+	if observed[2].Authorization != "Bearer BACKEND_ROUTE_SECRET-backend-supervisor" ||
+		observed[2].Model != "backend-supervisor-model" ||
+		!strings.Contains(observed[2].SystemPrompt, "FROZEN_MULTI_SHARED_PROMPT") ||
+		!strings.Contains(observed[2].SystemPrompt, "FROZEN_MULTI_ROLE_PROMPT") {
+		t.Fatalf("preprocessing call=%+v", observed[2])
+	}
+	if observed[3].Authorization != "Bearer BACKEND_ROUTE_SECRET-backend-embedding" || observed[3].Model != "backend-embedding-model" {
+		t.Fatalf("embedding call=%+v", observed[3])
+	}
+	if observed[4].Authorization != "Bearer BACKEND_ROUTE_SECRET-backend-source" || observed[4].Model != "backend-source-model" {
+		t.Fatalf("source search call=%+v", observed[4])
+	}
+}
+
+var _ store.HostPrepareRegistryStore = (*pocketRisuHostTestStore)(nil)
diff --git a/go-service/internal/httpapi/pocketrisu_execution_context_resolver.go b/go-service/internal/httpapi/pocketrisu_execution_context_resolver.go
