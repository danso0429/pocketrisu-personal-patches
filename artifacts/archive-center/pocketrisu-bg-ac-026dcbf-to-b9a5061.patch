+	preprocessing.SharedPrompt = "FROZEN_CONSUMER_SHARED"
+	rawPreprocessing, _ := json.Marshal(preprocessing)
+	if err := os.WriteFile(filepath.Join(os.Getenv("ARCHIVE_CENTER_DATA_DIR"), "memory-preprocessing.json"), rawPreprocessing, 0o600); err != nil {
+		t.Fatal(err)
