+func TestHostSessionExecutionValidationAndTerminalPhases(t *testing.T) {
+	if _, err := normalizeHostSessionExecutionAcquireRequest(HostSessionExecutionAcquireRequest{
+		HostInstanceID: "host\ninvalid", StableCharacterID: "character", HostChatID: "chat",
+		OperationID: "operation", ExpectedBindingEpoch: "epoch",
+	}); !errors.Is(err, ErrHostSessionExecutionInvalid) {
+		t.Fatalf("control identifier error=%v", err)
+	}
+
+	wantPhases := map[string]string{
+		"completed": "settled", "invalid_input": "aborted", "source_changed": "invalidated",
+		"model_failed": "aborted", "cancelled": "cancelled", "deleted": "deleted",
+		"conflict_copy": "blocked_conflict", "ac_skipped_prepare_unavailable": "degraded",
+		"invalidated": "invalidated", "abandoned": "abandoned",
+	}
+	for reason, phase := range wantPhases {
+		if !hostSessionExecutionTerminalReasonAllowed(reason) {
+			t.Errorf("terminal reason %q rejected", reason)
+		}
+		if got := hostSessionExecutionTerminalPhase(reason); got != phase {
+			t.Errorf("terminal reason %q phase=%q want=%q", reason, got, phase)
+		}
+	}
+	if hostSessionExecutionTerminalReasonAllowed("awaiting_next_input") {
+		t.Fatal("nonterminal awaiting_next_input was accepted as settle reason")
+	}
+	slot := &hostSessionExecutionSlot{
+		ContractVersion:      HostSessionExecutionContractVersion,
+		ActiveHostInstanceID: "host", ActiveStableCharacterID: "character",
+		ActiveHostChatID: "chat", ActiveBindingEpoch: "epoch",
+		ActiveOperationID: "operation", RequiredHostChangeSeq: 4,
+	}
+	if hostSessionExecutionSlotMatchesAcquire(slot, HostSessionExecutionAcquireRequest{
+		HostInstanceID: "host", StableCharacterID: "character", HostChatID: "chat",
+		OperationID: "operation", ExpectedBindingEpoch: "epoch", RequiredHostChangeSeq: 3,
+	}) {
+		t.Fatal("same operation with a changed required host sequence reused the claim")
+	}
+}
