+)
+
+const (
+	HostChangeStreamContractVersion = "host_change_stream.v1"
+	HostChangeEventContractVersion  = "host_change_event.v1"
+
+	HostChangeStatusIngested       = "ingested"
+	HostChangeStatusPending        = "pending"
+	HostChangeStatusSequenceGap    = "sequence_gap"
+	HostChangeStatusConflict       = "conflict"
+	HostChangeStatusBindingChanged = "binding_changed"
+	HostChangeStatusRejected       = "rejected"
+
+	hostChangeMaxMessageIdentities = 256
+	hostChangeMaxMessageJSONBytes  = 64 * 1024
+)
+
+var ErrHostChangeIntentInvalid = errors.New("invalid host change intent")
+
+type HostChangeStreamIdentity struct {
+	HostInstanceID    string
+	StableCharacterID string
+	HostChatID        string
+	BindingEpoch      string
+}
+
+type HostChangeIntent struct {
+	HostChangeStreamIdentity
