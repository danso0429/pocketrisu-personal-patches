+func (s *Server) registerPocketRisuHostRoutes(mux *http.ServeMux) {
+	host := http.NewServeMux()
+	host.HandleFunc("GET /host/pocketrisu/v1/capabilities", s.handlePocketRisuHostCapabilities)
+	host.HandleFunc("POST /host/pocketrisu/v1/executions/acquire", s.handlePocketRisuHostExecutionAcquire)
+	host.HandleFunc("POST /host/pocketrisu/v1/contexts/capture", s.handlePocketRisuHostContextCapture)
+	host.HandleFunc("POST /host/pocketrisu/v1/prepares/start", s.handlePocketRisuHostPrepareStart)
+	host.HandleFunc("POST /host/pocketrisu/v1/prepares/status", s.handlePocketRisuHostPrepareStatus)
+	host.HandleFunc("POST /host/pocketrisu/v1/prepares/complete", s.handlePocketRisuHostPrepareComplete)
+	host.HandleFunc("POST /host/pocketrisu/v1/prepares/fail", s.handlePocketRisuHostPrepareFail)
+	host.HandleFunc("POST /host/pocketrisu/v1/prepares/unknown", s.handlePocketRisuHostPrepareUnknown)
+	host.HandleFunc("POST /host/pocketrisu/v1/prepares/skip", s.handlePocketRisuHostPrepareSkip)
+	host.HandleFunc("POST /host/pocketrisu/v1/executions/settle", s.handlePocketRisuHostExecutionSettle)
+	mux.Handle("/host/pocketrisu/", s.pocketRisuHostAuthMiddleware(host))
+}
+
+func (s *Server) pocketRisuHostAuthMiddleware(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Cache-Control", "no-store")
+		status := s.pocketRisuHostAuthorizationStatus(r)
+		if status == http.StatusServiceUnavailable {
+			writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_auth_unconfigured", "PocketRisu host authentication is unavailable")
+			return
+		}
+		if status != http.StatusOK {
+			writeError(w, http.StatusUnauthorized, "unauthorized", "invalid bearer token")
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func (s *Server) pocketRisuHostAuthorizationStatus(r *http.Request) int {
+	expected := strings.TrimSpace(s.Cfg.Auth.BearerToken)
+	if expected == "" {
+		return http.StatusServiceUnavailable
+	}
+	if r == nil {
+		return http.StatusUnauthorized
+	}
+	hdr := r.Header.Get("Authorization")
+	const prefix = "Bearer "
+	if !strings.HasPrefix(hdr, prefix) {
+		return http.StatusUnauthorized
+	}
+	supplied := strings.TrimSpace(strings.TrimPrefix(hdr, prefix))
+	if len(supplied) != len(expected) || subtle.ConstantTimeCompare([]byte(supplied), []byte(expected)) != 1 {
+		return http.StatusUnauthorized
+	}
+	return http.StatusOK
+}
+
+func decodePocketRisuHostRequest(w http.ResponseWriter, r *http.Request, target any) bool {
+	mediaType, _, err := mime.ParseMediaType(r.Header.Get("Content-Type"))
+	if err != nil || mediaType != "application/json" {
+		writeError(w, http.StatusUnsupportedMediaType, "pocketrisu_host_content_type_invalid", "content-type must be application/json")
+		return false
+	}
+	r.Body = http.MaxBytesReader(w, r.Body, pocketRisuHostMaxRequestBytes)
+	decoder := json.NewDecoder(r.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(target); err != nil {
+		writeError(w, http.StatusBadRequest, "pocketrisu_host_request_invalid", "PocketRisu host request is invalid: "+err.Error())
+		return false
+	}
+	var trailing any
+	if err := decoder.Decode(&trailing); !errors.Is(err, io.EOF) {
+		writeError(w, http.StatusBadRequest, "pocketrisu_host_request_invalid", "PocketRisu host request must contain one JSON document")
+		return false
+	}
+	return true
+}
+
+func requirePocketRisuHostTransportVersion(w http.ResponseWriter, version string) bool {
+	if strings.TrimSpace(version) != pocketRisuHostTransportContractVersion {
+		writeError(w, http.StatusBadRequest, "pocketrisu_host_version_unsupported", "unsupported PocketRisu host transport version")
+		return false
+	}
+	return true
+}
