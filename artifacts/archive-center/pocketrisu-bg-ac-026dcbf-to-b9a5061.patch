+
+	ctx := context.Background()
+	suffix := strconv.FormatInt(time.Now().UTC().UnixNano(), 36)
+	hostID := "c0-prepare-host-" + suffix
+	characterID := "c0-prepare-character-" + suffix
+	chatID := "c0-prepare-chat-" + suffix
+	sessionID := "c0-prepare-session-" + suffix
+
+	admin := openStore()
+	cleanup := func() {
+		statements := []struct {
+			query string
+			args  []any
