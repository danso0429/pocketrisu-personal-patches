+func TestPocketRisuHostAcquireCaptureStartCompleteAndSettle(t *testing.T) {
+	server, testStore, handler := newPocketRisuHostTestServer(t)
+	identity := validPocketRisuExecutionContextIdentity("operation-host-route-1")
+	acquire := pocketRisuHostExecutionRequest{
+		ContractVersion:       pocketRisuHostTransportContractVersion,
+		HostInstanceID:        identity.HostInstanceID,
+		StableCharacterID:     identity.StableCharacterID,
+		HostChatID:            identity.HostChatID,
+		OperationID:           identity.OperationID,
+		ExpectedBindingEpoch:  identity.BindingEpoch,
+		RequiredHostChangeSeq: 3,
+	}
+	acquireRecorder := pocketRisuHostJSONRequest(t, handler, http.MethodPost,
+		"/host/pocketrisu/v1/executions/acquire", "pocketrisu-host-token", acquire)
+	if acquireRecorder.Code != http.StatusOK || len(testStore.acquireRequests) != 1 {
+		t.Fatalf("acquire status=%d body=%s requests=%d", acquireRecorder.Code, acquireRecorder.Body.String(), len(testStore.acquireRequests))
+	}
+
+	captured := capturePocketRisuHostContext(t, handler)
+	if captured.Context.Status != pocketRisuExecutionContextStatusCaptured || captured.Prepare.Status != store.HostPrepareStatusRegistered {
+		t.Fatalf("capture response=%+v", captured)
+	}
+	if len(testStore.registerRequests) != 1 || testStore.registerRequests[0].ExecutionContextID != captured.Context.ExecutionContextID || testStore.registerRequests[0].SettingsSnapshotDigest != captured.Context.SettingsDigest {
+		t.Fatalf("register request=%+v", testStore.registerRequests)
+	}
+	if strings.Contains(captured.Prepare.ResultJSON, "DEVICE_ROUTE_SECRET") || strings.Contains(captured.Prepare.ResultJSON, "BACKEND_ROUTE_SECRET") || strings.Contains(string(mustMarshalPocketRisuHostTest(t, captured)), "DEVICE_ROUTE_SECRET") {
+		t.Fatal("capture response exposed secret material")
+	}
+	reference := prepareReferenceFromCapture(captured)
