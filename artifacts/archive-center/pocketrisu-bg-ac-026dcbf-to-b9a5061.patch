+			{`DELETE FROM host_session_execution_outcomes WHERE canonical_session_id = ?`, []any{sessionID}},
+			{`DELETE FROM host_session_execution_slots WHERE canonical_session_id = ?`, []any{sessionID}},
+			{`DELETE FROM session_route_bindings WHERE stable_character_id = ? AND host_chat_id = ?`, []any{characterID, chatID}},
+		}
+		for _, statement := range statements {
+			if _, err := admin.db.ExecContext(ctx, statement.query, statement.args...); err != nil {
+				t.Errorf("clean host prepare fixture: %v", err)
+			}
+		}
+	}
+	cleanup()
+	t.Cleanup(func() {
+		cleanup()
+		if err := admin.Close(); err != nil {
+			t.Errorf("close host prepare cleanup store: %v", err)
+		}
+	})
+
+	runtimeStore := openStore()
+	defer func() {
+		if err := runtimeStore.Close(); err != nil {
+			t.Errorf("close host prepare runtime store: %v", err)
+		}
+	}()
+	reopen := func() {
+		if err := runtimeStore.Close(); err != nil {
+			t.Fatalf("close host prepare store before restart: %v", err)
+		}
