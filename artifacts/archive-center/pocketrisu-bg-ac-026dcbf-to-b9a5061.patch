+	secondOperationID := "c0-fence-operation-2-" + suffix
+	nextClaim, err := runtimeStore.AcquireHostSessionExecution(ctx, HostSessionExecutionAcquireRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+		OperationID: secondOperationID, ExpectedBindingEpoch: identity.BindingEpoch,
+		RequiredHostChangeSeq: 1,
+	})
+	if err != nil || nextClaim.Status != HostSessionExecutionStatusAcquired || nextClaim.SafeHostChangeSeq != 1 {
+		t.Fatalf("claim after safe source invalidation=%+v err=%v", nextClaim, err)
+	}
+}
