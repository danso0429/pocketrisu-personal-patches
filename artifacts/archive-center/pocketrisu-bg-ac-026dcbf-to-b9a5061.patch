+	server.RuntimeConfig.MainAPIKey = "LATER_RUNTIME_SECRET"
+	diagnostics := server.completeTurnPersistenceDiagnosticsWithContext([]string{
+		"SaveDerived: provider rejected DEVICE_DIAGNOSTIC_SECRET",
+	}, resolved)
+	encodedDiagnostics, _ := json.Marshal(diagnostics)
+	if strings.Contains(string(encodedDiagnostics), "DEVICE_DIAGNOSTIC_SECRET") || !strings.Contains(string(encodedDiagnostics), "[redacted]") {
+		t.Fatalf("captured diagnostic secret was not redacted: %s", encodedDiagnostics)
+	}
+	trace := pocketRisuCapturedPromptAssemblyTrace(resolved)
+	encodedTrace, _ := json.Marshal(trace)
+	if trace["prompt_source"] != "execution_context_capture" || trace["prompt_dir"] != "" ||
+		strings.Contains(string(encodedTrace), "DEVICE_DIAGNOSTIC_SECRET") ||
+		strings.Contains(string(encodedTrace), "LATER_RUNTIME_SECRET") {
+		t.Fatalf("captured prompt trace reread or exposed mutable/private values: %s", encodedTrace)
+	}
+	leakyError := `Post "https://device.invalid/v1/responses?key=DEVICE_DIAGNOSTIC_SECRET-source": header private DEVICE_DIAGNOSTIC_SECRET-source`
+	redactedError := scrubPocketRisuLLMConfigError(leakyError, resolved.SourceSearch)
+	if strings.Contains(redactedError, "DEVICE_DIAGNOSTIC_SECRET") {
+		t.Fatalf("captured endpoint/header secret was not redacted: %s", redactedError)
+	}
+	wrappedError := newPocketRisuRedactedLLMError(context.DeadlineExceeded, resolved.SourceSearch)
+	if !errors.Is(wrappedError, context.DeadlineExceeded) {
+		t.Fatalf("redacted provider error lost cancellation identity: %v", wrappedError)
+	}
+	configTrace := redactPocketRisuLLMConfigTrace(completeTurnLLMConfigTrace(completeTurnExtractionConfig{
+		Critic: resolved.Critic, Embedder: resolved.Embedding,
+	}))
+	encodedConfigTrace, _ := json.Marshal(configTrace)
+	if strings.Contains(string(encodedConfigTrace), "device.invalid") || strings.Contains(string(encodedConfigTrace), "embedding.invalid") {
+		t.Fatalf("captured endpoint host leaked through config trace: %s", encodedConfigTrace)
+	}
+	selection := &multiAgentSelection{Roles: []multiAgentRoleResult{{
+		Role: "event_recent",
+		Calls: []multiAgentCall{{
+			Prompt: "PRIVATE_SYSTEM_PROMPT", Input: map[string]any{"private": "PRIVATE_INPUT"},
+			ModelInput: "PRIVATE_MODEL_INPUT", Raw: "PRIVATE_RAW_RESULT",
+		}},
+	}}}
+	redactPocketRisuMultiAgentSelection(selection)
+	encodedSelection, _ := json.Marshal(selection)
+	for _, secret := range []string{"PRIVATE_SYSTEM_PROMPT", "PRIVATE_INPUT", "PRIVATE_MODEL_INPUT", "PRIVATE_RAW_RESULT"} {
+		if strings.Contains(string(encodedSelection), secret) {
+			t.Fatalf("preprocessing trace leaked %s: %s", secret, encodedSelection)
+		}
+	}
+}
