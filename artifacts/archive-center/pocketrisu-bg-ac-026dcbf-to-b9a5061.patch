+)
+
+const (
+	HostPrepareRegistryContractVersion = "host_prepare_registry.v1"
+	HostPrepareProtocolVersion         = "pocketrisu_prepare_host_observation.v1"
+
+	HostPrepareStatusRegistered     = "registered_not_started"
+	HostPrepareStatusRunning        = "running"
+	HostPrepareStatusReady          = "ready"
+	HostPrepareStatusFailedKnown    = "failed_known"
+	HostPrepareStatusOutcomeUnknown = "outcome_unknown"
