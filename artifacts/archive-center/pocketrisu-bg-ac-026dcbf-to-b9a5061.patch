+		HostChatIDState:            "server_commit_observed",
+		UserMessageChatID:          "server-user-message-1",
+		UserMessageChatIDState:     "server_input_receipt",
+		UserObservedContentHash:    prepareOR1CHash(userInput),
+		UserPersistenceContentHash: prepareOR1CHash(userInput),
+		ObservedContentHash:        prepareOR1CHash(assistant),
+		PersistenceContentHash:     prepareOR1CHash(assistant),
+		HashAlgorithm:              "or1c_utf16_djb2.v1",
+		HostKind:                   "pocketrisu_server",
+		HostContractVersion:        completeTurnPocketRisuCommitContract,
+		HostInstanceID:             reference.Identity.HostInstanceID,
+		StableCharacterID:          reference.Identity.StableCharacterID,
