+	}
+	secondRegistry := deterministicPocketRisuContextRegistry()
+	second, err := secondRegistry.capture(
+		validPocketRisuExecutionContextRequest("operation-b", "SECRET_BETA"),
+		validPocketRisuExecutionBackendSnapshot("BACKEND_BETA"),
+	)
+	if err != nil {
+		t.Fatalf("second capture failed: %v", err)
+	}
+	if first.SettingsDigest != second.SettingsDigest {
+		t.Fatalf("public digest changed with secret bytes: %s != %s", first.SettingsDigest, second.SettingsDigest)
+	}
+	encoded, err := json.Marshal(first)
+	if err != nil {
+		t.Fatalf("marshal result: %v", err)
+	}
+	for _, marker := range []string{"SECRET_ALPHA", "BACKEND_ALPHA", "private prompt", "Authorization"} {
+		if strings.Contains(string(encoded), marker) {
+			t.Fatalf("public result contains secret marker %q: %s", marker, encoded)
+		}
+	}
+	changedPublic := validPocketRisuExecutionContextRequest("operation-c", "SECRET_GAMMA")
+	changedPublic.Device.Main.Model = "different-public-model"
+	thirdRegistry := deterministicPocketRisuContextRegistry()
+	third, err := thirdRegistry.capture(changedPublic, validPocketRisuExecutionBackendSnapshot("BACKEND_GAMMA"))
+	if err != nil {
+		t.Fatalf("third capture failed: %v", err)
+	}
+	if third.SettingsDigest == first.SettingsDigest {
+		t.Fatal("public digest ignored a non-secret model change")
+	}
