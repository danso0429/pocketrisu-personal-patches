+func (s *Server) requirePocketRisuHostPrepareContext(
+	w http.ResponseWriter,
+	r *http.Request,
+	prepares store.HostPrepareRegistryStore,
+	reference pocketRisuHostPrepareReference,
+) (*store.HostPrepareResult, *pocketRisuExecutionContextResult, bool) {
+	return s.lookupPocketRisuHostPrepareContext(w, r, prepares, reference, false)
+}
+
+func (s *Server) lookupPocketRisuHostPrepareContext(
+	w http.ResponseWriter,
+	r *http.Request,
+	prepares store.HostPrepareRegistryStore,
+	reference pocketRisuHostPrepareReference,
+	allowUnavailable bool,
+) (*store.HostPrepareResult, *pocketRisuExecutionContextResult, bool) {
+	result, err := prepares.GetHostPrepare(r.Context(), store.HostPrepareLookup{
+		PrepareKey:         reference.PrepareKey,
+		RequestFingerprint: reference.RequestFingerprint,
+	})
+	if err != nil {
+		writePocketRisuHostStoreError(w, err)
+		return nil, nil, false
+	}
+	if !pocketRisuHostPrepareMatchesReference(result, reference) {
+		writeError(w, http.StatusConflict, "pocketrisu_host_prepare_owner_conflict", "PocketRisu prepare does not match the requested owner")
+		return nil, nil, false
+	}
+	material, contextResult, err := s.HostExecutionContexts.load(reference.ExecutionContextID, reference.Identity)
+	if err != nil {
+		writeError(w, http.StatusBadRequest, "pocketrisu_execution_context_invalid", "PocketRisu execution context identity is invalid")
+		return nil, nil, false
+	}
+	if material == nil || contextResult.Status != pocketRisuExecutionContextStatusCaptured {
+		if allowUnavailable && contextResult != nil {
+			switch contextResult.Status {
+			case pocketRisuExecutionContextStatusReleased, pocketRisuExecutionContextStatusMissing:
+				return result, contextResult, true
+			}
+		}
+		writeJSON(w, http.StatusConflict, pocketRisuHostPrepareResponse{
+			ContractVersion: pocketRisuHostTransportContractVersion,
+			Prepare:         result,
+			Context:         contextResult,
+		})
+		return nil, nil, false
+	}
+	if _, err := resolvePocketRisuExecutionContext(*material); err != nil {
+		writeError(w, http.StatusInternalServerError, "pocketrisu_execution_context_resolution_failed", "PocketRisu execution context could not be resolved")
+		return nil, nil, false
+	}
+	return result, contextResult, true
+}
+
+func pocketRisuHostExecutionMatchesIdentity(result *store.HostSessionExecutionResult, identity pocketRisuExecutionContextIdentity) bool {
+	return result != nil && result.Status == store.HostSessionExecutionStatusAcquired &&
+		pocketRisuHostExecutionOwnerMatches(result, identity)
+}
+
+func pocketRisuHostExecutionOwnerMatches(result *store.HostSessionExecutionResult, identity pocketRisuExecutionContextIdentity) bool {
+	return result != nil &&
+		result.HostInstanceID == identity.HostInstanceID &&
+		result.StableCharacterID == identity.StableCharacterID &&
+		result.HostChatID == identity.HostChatID &&
+		result.BindingEpoch == identity.BindingEpoch &&
+		result.OperationID == identity.OperationID &&
+		result.ClaimEpoch == identity.ClaimEpoch
+}
+
+func pocketRisuHostPrepareMatchesReference(result *store.HostPrepareResult, reference pocketRisuHostPrepareReference) bool {
+	return result != nil && result.PrepareKey == reference.PrepareKey &&
+		result.RequestFingerprint == reference.RequestFingerprint &&
+		result.HostInstanceID == reference.Identity.HostInstanceID &&
+		result.StableCharacterID == reference.Identity.StableCharacterID &&
+		result.HostChatID == reference.Identity.HostChatID &&
+		result.BindingEpoch == reference.Identity.BindingEpoch &&
+		result.OperationID == reference.Identity.OperationID &&
+		result.ClaimEpoch == reference.Identity.ClaimEpoch &&
+		result.ExecutionContextID == reference.ExecutionContextID &&
+		result.SettingsSnapshotDigest == reference.SettingsSnapshotDigest
+}
+
+func pocketRisuHostPrepareSameOwner(result, expected *store.HostPrepareResult) bool {
+	return result != nil && expected != nil &&
+		result.PrepareKey == expected.PrepareKey &&
+		result.RequestFingerprint == expected.RequestFingerprint &&
+		result.HostInstanceID == expected.HostInstanceID &&
+		result.OperationID == expected.OperationID &&
+		result.ClaimEpoch == expected.ClaimEpoch &&
+		result.ExecutionContextID == expected.ExecutionContextID &&
+		result.SettingsSnapshotDigest == expected.SettingsSnapshotDigest
+}
+
+func pocketRisuHostPrepareRegistered(result *store.HostPrepareResult) bool {
+	if result == nil {
+		return false
+	}
+	switch result.Status {
+	case store.HostPrepareStatusRegistered, store.HostPrepareStatusRunning,
+		store.HostPrepareStatusReady, store.HostPrepareStatusFailedKnown,
+		store.HostPrepareStatusOutcomeUnknown, store.HostPrepareStatusSkipped:
+		return true
+	default:
+		return false
+	}
+}
+
+func pocketRisuHostExecutionHTTPStatus(result *store.HostSessionExecutionResult) int {
+	if result == nil {
+		return http.StatusInternalServerError
+	}
+	switch result.Status {
+	case store.HostSessionExecutionStatusAcquired, store.HostSessionExecutionStatusTerminal:
+		return http.StatusOK
+	case store.HostSessionExecutionStatusWait:
+		return http.StatusAccepted
+	case store.HostSessionExecutionStatusBindingChanged, store.HostSessionExecutionStatusRejected:
+		return http.StatusConflict
+	default:
+		return http.StatusInternalServerError
+	}
+}
+
+func pocketRisuHostPrepareHTTPStatus(result *store.HostPrepareResult) int {
+	if result == nil {
+		return http.StatusInternalServerError
+	}
+	switch result.Status {
+	case store.HostPrepareStatusRegistered, store.HostPrepareStatusReady,
+		store.HostPrepareStatusFailedKnown, store.HostPrepareStatusOutcomeUnknown,
+		store.HostPrepareStatusSkipped:
+		return http.StatusOK
+	case store.HostPrepareStatusRunning:
+		return http.StatusAccepted
+	case store.HostPrepareStatusConflict, store.HostPrepareStatusFenced,
+		store.HostPrepareStatusRejected:
+		return http.StatusConflict
+	default:
+		return http.StatusInternalServerError
+	}
+}
+
+func pocketRisuExecutionContextHTTPStatus(result *pocketRisuExecutionContextResult) int {
+	if result == nil {
+		return http.StatusInternalServerError
+	}
+	switch result.Status {
+	case pocketRisuExecutionContextStatusCaptured:
+		return http.StatusOK
+	case pocketRisuExecutionContextStatusCapacity:
+		return http.StatusServiceUnavailable
+	case pocketRisuExecutionContextStatusConflict, pocketRisuExecutionContextStatusReleased,
+		pocketRisuExecutionContextStatusMissing:
+		return http.StatusConflict
+	default:
+		return http.StatusInternalServerError
+	}
+}
+
+func writePocketRisuHostPrepareMutation(w http.ResponseWriter, result, expected *store.HostPrepareResult, err error) {
+	if err != nil {
+		writePocketRisuHostStoreError(w, err)
+		return
+	}
+	if !pocketRisuHostPrepareSameOwner(result, expected) {
+		writeError(w, http.StatusConflict, "pocketrisu_host_prepare_owner_conflict", "PocketRisu prepare owner changed during mutation")
+		return
+	}
+	writeJSON(w, pocketRisuHostPrepareHTTPStatus(result), pocketRisuHostPrepareResponse{
+		ContractVersion: pocketRisuHostTransportContractVersion,
+		Prepare:         result,
+	})
+}
+
+func writePocketRisuHostStoreError(w http.ResponseWriter, err error) {
+	switch {
+	case errors.Is(err, store.ErrHostSessionExecutionInvalid),
+		errors.Is(err, store.ErrHostPrepareInvalid):
+		writeError(w, http.StatusBadRequest, "pocketrisu_host_store_request_invalid", "PocketRisu host store request is invalid")
+	case errors.Is(err, store.ErrNotEnabled):
+		writeError(w, http.StatusServiceUnavailable, "pocketrisu_host_store_unavailable", "PocketRisu host store is unavailable")
+	default:
+		writeError(w, http.StatusInternalServerError, "pocketrisu_host_store_failed", "PocketRisu host store operation failed")
+	}
+}
