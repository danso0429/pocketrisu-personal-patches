+	wrongIdentity := validPocketRisuExecutionContextIdentity("operation-capacity-1")
+	wrongIdentity.HostChatID = "other-chat"
+	_, ownerConflict, err := registry.load(first.ExecutionContextID, wrongIdentity)
+	if err != nil || ownerConflict.Status != pocketRisuExecutionContextStatusConflict {
+		t.Fatalf("owner conflict = %+v, %v", ownerConflict, err)
+	}
+	restarted := deterministicPocketRisuContextRegistry()
+	_, unavailable, err := restarted.load(first.ExecutionContextID, validPocketRisuExecutionContextIdentity("operation-capacity-1"))
+	if err != nil || unavailable.Status != pocketRisuExecutionContextStatusMissing || unavailable.ReasonCode != "execution_context_unavailable" {
+		t.Fatalf("restart load = %+v, %v", unavailable, err)
+	}
+
+	byteRegistry := deterministicPocketRisuContextRegistry()
+	if _, err := byteRegistry.capture(
+		validPocketRisuExecutionContextRequest("operation-bytes-1", "SECRET"),
+		validPocketRisuExecutionBackendSnapshot("BACKEND"),
+	); err != nil {
+		t.Fatalf("byte baseline capture failed: %v", err)
+	}
+	_, usedBytes, _, _ := byteRegistry.stats()
+	byteRegistry.maxBytes = usedBytes
+	byteCapacity, err := byteRegistry.capture(
+		validPocketRisuExecutionContextRequest("operation-bytes-2", "SECRET"),
+		validPocketRisuExecutionBackendSnapshot("BACKEND"),
+	)
+	if err != nil || byteCapacity.Status != pocketRisuExecutionContextStatusCapacity {
+		t.Fatalf("byte capacity result = %+v, %v", byteCapacity, err)
+	}
+
+	oversizeBackend := validPocketRisuExecutionBackendSnapshot("BACKEND")
+	oversizeBackend.Preprocessing.SharedPrompt = strings.Repeat("x", pocketRisuExecutionContextMaxRecordBytes)
+	if _, err := deterministicPocketRisuContextRegistry().capture(
+		validPocketRisuExecutionContextRequest("operation-oversize", "SECRET"),
+		oversizeBackend,
+	); !errors.Is(err, errPocketRisuExecutionContextInvalid) {
+		t.Fatalf("oversize context error = %v, want invalid context", err)
+	}
+}
