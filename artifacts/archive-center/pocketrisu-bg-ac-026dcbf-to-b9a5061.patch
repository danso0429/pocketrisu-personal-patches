+func TestHostChangeMigrationDefinesOrderedImmutableReceipts(t *testing.T) {
+	raw, err := os.ReadFile("../../../migrations/015_host_change_stream.sql")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sqlText := string(raw)
+	for _, table := range []string{"host_change_streams", "host_change_events"} {
+		if count := strings.Count(sqlText, "CREATE TABLE IF NOT EXISTS "+table); count != 1 {
+			t.Errorf("%s create count=%d want=1", table, count)
+		}
+	}
+	for _, fragment := range []string{
+		"stream_key               CHAR(64)        NOT NULL PRIMARY KEY",
+		"ingested_seq            BIGINT UNSIGNED NOT NULL DEFAULT 0",
+		"safe_seq                BIGINT UNSIGNED NOT NULL DEFAULT 0",
+		"event_fingerprint       CHAR(64)        NOT NULL",
+		"UNIQUE KEY uq_host_change_event_id (stream_key, event_id)",
+		"UNIQUE KEY uq_host_change_event_seq (stream_key, seq)",
+		"FOREIGN KEY (stream_key) REFERENCES host_change_streams(stream_key)",
+	} {
+		if !strings.Contains(sqlText, fragment) {
+			t.Errorf("015 migration missing %q", fragment)
+		}
+	}
+}
