+++ b/go-service/internal/httpapi/pocketrisu_host_restart_integration_test.go
@@ -0,0 +1,148 @@
+package httpapi
+
+import (
+	"context"
+	"database/sql"
+	"os"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+
+	_ "github.com/go-sql-driver/mysql"
+
+	"github.com/risulongmemory/archive-center-go/internal/config"
+	"github.com/risulongmemory/archive-center-go/internal/store"
+)
+
+func TestPocketRisuHostRunningPrepareBecomesUnknownBeforeRestartReadiness(t *testing.T) {
+	if os.Getenv("AC_HOST_PREPARE_TEST_DISPOSABLE") != "YES" {
+		t.Skip("requires an explicitly disposable MariaDB")
+	}
+	dsn := strings.TrimSpace(os.Getenv("AC_HOST_PREPARE_TEST_DSN"))
+	if dsn == "" {
+		t.Fatal("AC_HOST_PREPARE_TEST_DSN is required")
+	}
+	ctx := context.Background()
+	suffix := strconv.FormatInt(time.Now().UTC().UnixNano(), 36)
+	hostID := "h2-restart-host-" + suffix
+	characterID := "h2-restart-character-" + suffix
+	chatID := "h2-restart-chat-" + suffix
+	sessionID := "h2-restart-session-" + suffix
+	operationID := "h2-restart-operation-" + suffix
+
+	admin, err := sql.Open("mysql", dsn)
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		for _, statement := range []struct {
+			query string
+			args  []any
+		}{
+			{`DELETE FROM host_prepare_requests WHERE host_instance_id = ?`, []any{hostID}},
+			{`DELETE FROM host_session_execution_outcomes WHERE canonical_session_id = ?`, []any{sessionID}},
+			{`DELETE FROM host_session_execution_slots WHERE canonical_session_id = ?`, []any{sessionID}},
+			{`DELETE FROM session_route_bindings WHERE stable_character_id = ? AND host_chat_id = ?`, []any{characterID, chatID}},
+		} {
+			if _, err := admin.ExecContext(ctx, statement.query, statement.args...); err != nil {
+				t.Errorf("cleanup restart fixture: %v", err)
+			}
+		}
+		_ = admin.Close()
+	})
+
+	openRuntime := func() store.Store {
+		t.Helper()
+		runtimeStore, err := store.OpenMariaDB(dsn)
+		if err != nil {
+			t.Fatalf("open disposable MariaDB: %v", err)
+		}
+		return runtimeStore
+	}
+	closeRuntime := func(runtimeStore store.Store) {
+		t.Helper()
+		closer, ok := runtimeStore.(interface{ Close() error })
+		if !ok {
+			t.Fatalf("store type %T does not expose Close", runtimeStore)
+		}
+		if err := closer.Close(); err != nil {
+			t.Fatalf("close disposable MariaDB: %v", err)
+		}
+	}
+
+	first := openRuntime()
+	bindingStore := first.(store.SessionRouteBindingStore)
+	executionStore := first.(store.HostSessionExecutionStore)
+	prepareStore := first.(store.HostPrepareRegistryStore)
+	binding, err := bindingStore.BindSessionRoute(ctx, store.SessionRouteBindingRequest{
+		StableCharacterID: characterID, HostChatID: chatID,
+		RequestedSessionID: sessionID, Mode: store.SessionRouteBindingModeResolveOrCreate,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	bindingEpoch := store.SessionRouteBindingEpoch(binding.Binding)
+	claim, err := executionStore.AcquireHostSessionExecution(ctx, store.HostSessionExecutionAcquireRequest{
+		HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+		OperationID: operationID, ExpectedBindingEpoch: bindingEpoch,
+	})
+	if err != nil || claim.Status != store.HostSessionExecutionStatusAcquired {
+		t.Fatalf("claim=%+v err=%v", claim, err)
+	}
+	registered, err := prepareStore.RegisterHostPrepare(ctx, store.HostPrepareRegisterRequest{
+		HostPrepareIdentity: store.HostPrepareIdentity{
+			HostInstanceID: hostID, StableCharacterID: characterID, HostChatID: chatID,
+			BindingEpoch: bindingEpoch, OperationID: operationID, ClaimEpoch: claim.ClaimEpoch,
+			MainRequestID: "h2-restart-main-" + suffix,
+		},
+		ExecutionContextID:     "h2-restart-context-" + suffix,
+		SettingsSnapshotDigest: strings.Repeat("a", 64),
+		InputReceiptID:         "h2-restart-input-" + suffix,
+		SourceRevision:         "h2-restart-source-" + suffix,
+		SemanticPayloadHash:    strings.Repeat("b", 64),
+		RequestType:            "model", ProtocolVersion: store.HostPrepareProtocolVersion,
+	})
+	if err != nil || registered.Status != store.HostPrepareStatusRegistered {
+		t.Fatalf("registered=%+v err=%v", registered, err)
+	}
+	started, err := prepareStore.StartHostPrepare(ctx, store.HostPrepareStartRequest{
+		HostPrepareLookup: store.HostPrepareLookup{
+			PrepareKey: registered.PrepareKey, RequestFingerprint: registered.RequestFingerprint,
+		},
+		ExternalOperationID: "h2-restart-provider-" + suffix,
+	})
+	if err != nil || started.Status != store.HostPrepareStatusRunning || !started.StartAuthorized {
+		t.Fatalf("started=%+v err=%v", started, err)
+	}
+	closeRuntime(first)
+
+	restartedStore := openRuntime()
+	t.Cleanup(func() { closeRuntime(restartedStore) })
+	cfg := config.Default()
+	cfg.StoreMode = config.StoreModeMariaDBAuthority
+	server := NewServer(cfg)
+	if generated, ok := server.Store.(interface{ Close() error }); ok {
+		_ = generated.Close()
+	}
+	server.Store = restartedStore
+	server.StoreOpenError = nil
+	durable, err := restartedStore.(store.HostPrepareRecoveryStore).GetHostPrepareByKey(ctx, registered.PrepareKey)
+	if err != nil || durable.ExecutionContextID != registered.ExecutionContextID ||
+		durable.RequestFingerprint != registered.RequestFingerprint || !durable.Reused {
+		t.Fatalf("durable recovery=%+v err=%v", durable, err)
+	}
+	if err := server.ValidateRuntimeDependencies(ctx); err != nil {
+		t.Fatalf("restart preflight: %v", err)
+	}
+	recovered, err := restartedStore.(store.HostPrepareRegistryStore).GetHostPrepare(ctx, store.HostPrepareLookup{
+		PrepareKey: registered.PrepareKey, RequestFingerprint: registered.RequestFingerprint,
+	})
+	if err != nil || recovered.Status != store.HostPrepareStatusOutcomeUnknown || recovered.RunEpoch != started.RunEpoch {
+		t.Fatalf("recovered=%+v err=%v", recovered, err)
+	}
+	running, err := restartedStore.(store.HostPrepareRestartRecoveryStore).ListRunningHostPrepares(ctx, 128)
+	if err != nil || len(running) != 0 {
+		t.Fatalf("running=%+v err=%v", running, err)
+	}
+}
