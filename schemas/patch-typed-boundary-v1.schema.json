{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/patch-typed-boundary-v1.schema.json",
  "title": "Patch Typed Boundary v1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "version",
    "surface",
    "resource",
    "direction",
    "providers",
    "consumers",
    "inputClasses",
    "validation",
    "fallback"
  ],
  "properties": {
    "schema": { "const": "patch-typed-boundary-v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "surface": {
      "enum": [
        "selection",
        "file",
        "region",
        "state",
        "symbol",
        "environment",
        "history",
        "target"
      ]
    },
    "resource": { "type": "string", "minLength": 1 },
    "direction": { "enum": ["provider-to-consumer", "bidirectional"] },
    "providers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "consumers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "inputClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation": {
      "type": "object",
      "required": ["completeness", "validator"],
      "properties": {
        "completeness": { "enum": ["complete", "incomplete", "unknown"] },
        "validator": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "fallback": { "enum": ["component-union", "global-exhaustive", "reject"] }
  },
  "additionalProperties": false
}
