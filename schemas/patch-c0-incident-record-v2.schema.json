{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketrisu.local/schemas/patch-c0-incident-record-v2.schema.json",
  "title": "PocketRisu C0 incident record with frozen-attempt identity v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "incidentId", "recordedAt", "sequence", "previousIncidentSha256", "materialInputKey", "cohortId", "executionAttemptId", "evidenceBundleId", "globalRunId", "localRunId", "bundleObjectSha256", "cohortClass", "syntheticMutation", "productionDefectEligible", "firstFailure", "detectors", "attribution", "rootCause", "fix", "negativeEvidenceObjectSha256s", "disposition", "integrity"],
  "properties": {
    "schema": { "const": "patch-c0-incident-record-v2" },
    "incidentId": { "$ref": "#/$defs/hash" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "sequence": { "type": "integer", "minimum": 0 },
    "previousIncidentSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "materialInputKey": { "$ref": "#/$defs/hash" },
    "cohortId": { "$ref": "#/$defs/hash" },
    "executionAttemptId": { "$ref": "#/$defs/hash" },
    "evidenceBundleId": { "$ref": "#/$defs/hash" },
    "globalRunId": { "$ref": "#/$defs/hash" },
    "localRunId": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "bundleObjectSha256": { "$ref": "#/$defs/hash" },
    "cohortClass": { "enum": ["stable-release", "patch", "relation", "core", "audit"] },
    "syntheticMutation": { "type": "boolean" },
    "productionDefectEligible": { "type": "boolean" },
    "firstFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "mask", "worker", "message", "stdoutObjectSha256", "stderrObjectSha256"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "mask": { "type": ["integer", "null"], "minimum": 0 },
        "worker": { "type": ["integer", "null"], "minimum": 0 },
        "message": { "type": "string", "minLength": 1 },
        "stdoutObjectSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
        "stderrObjectSha256": { "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] }
      }
    },
    "detectors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focused", "global", "product"],
      "properties": {
        "focused": { "$ref": "#/$defs/detector" },
        "global": { "$ref": "#/$defs/detector" },
        "product": { "$ref": "#/$defs/detector" }
      }
    },
    "attribution": { "enum": ["implementation-defect", "target-defect", "environment-defect", "harness-defect", "synthetic-mutation", "unknown"] },
    "rootCause": { "type": ["string", "null"] },
    "fix": { "type": ["string", "null"] },
    "negativeEvidenceObjectSha256s": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "disposition": { "enum": ["current-active", "historical", "incomplete", "invalid", "superseded", "diagnostic-only", "defect-reproduction"] },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "detector": { "enum": ["caught", "missed", "not-run", "not-applicable", "unknown"] },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "algorithm", "payloadSha256"],
      "properties": {
        "schema": { "const": "patch-verification-receipt-integrity-v1" },
        "algorithm": { "const": "sha256-over-canonical-json-v1" },
        "payloadSha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
