{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketrisu.local/schemas/patch-toolchain-shadow-contract-v1.schema.json",
  "title": "PocketRisu toolchain-hardening shadow B candidate contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "candidate",
    "target",
    "component",
    "manifestExecution",
    "operations",
    "state",
    "symbols",
    "boundaries",
    "runtimeCapabilities",
    "fallback",
    "canonicalProtection",
    "declarationSha256"
  ],
  "properties": {
    "schema": { "const": "patch-toolchain-shadow-contract-v1" },
    "version": { "const": 1 },
    "candidate": { "$ref": "#/$defs/candidate" },
    "target": { "$ref": "#/$defs/target" },
    "component": { "$ref": "#/$defs/component" },
    "manifestExecution": { "type": "object" },
    "operations": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/operation" }
    },
    "state": { "type": "object" },
    "symbols": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "boundaries": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "runtimeCapabilities": { "type": "object" },
    "fallback": { "type": "object" },
    "canonicalProtection": { "$ref": "#/$defs/canonicalProtection" },
    "declarationSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packId", "manifestVersion", "productionClass", "shadowClass", "label"],
      "properties": {
        "packId": { "const": "toolchain-hardening" },
        "manifestVersion": { "const": "0.1.3" },
        "productionClass": { "const": "G" },
        "shadowClass": { "const": "B" },
        "label": { "const": "shadow B candidate" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "packageVersion", "commit", "applicationTreeSha256", "files"],
      "properties": {
        "packageName": { "const": "pocketrisu" },
        "packageVersion": { "const": "1.9.0" },
        "commit": { "pattern": "^[0-9a-f]{40}$" },
        "applicationTreeSha256": { "$ref": "#/$defs/sha256" },
        "files": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "object" } }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "packIds", "visiblePackIds", "unitIds"],
      "properties": {
        "id": { "const": "component:toolchain-hardening-shadow-v1" },
        "packIds": { "const": ["toolchain-hardening"] },
        "visiblePackIds": { "const": ["toolchain-hardening"] },
        "unitIds": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "string" } }
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "bytes", "sha256"],
          "properties": {
            "kind": { "const": "file" },
            "path": { "type": "string", "minLength": 1 },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "bytes", "sha256"],
          "properties": {
            "kind": { "const": "literal" },
            "text": { "type": "string" },
            "bytes": { "type": "integer", "minimum": 1 },
            "sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file", "type", "where", "requires", "markerNeedle", "anchor", "managed"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "file": { "enum": ["package.json", "pnpm-lock.yaml", "vitest.setup.ts"] },
        "type": { "enum": ["insert", "replace"] },
        "where": { "enum": ["after", null] },
        "requires": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "markerNeedle": { "type": "string", "minLength": 1 },
        "anchor": { "$ref": "#/$defs/source" },
        "managed": { "$ref": "#/$defs/source" }
      }
    },
    "canonicalProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalGate", "productionClassification", "defaultChanged", "c0RoutingChanged", "productionStateChanged", "productionCertificates", "canonicalMasksSkipped", "c1Authorized"],
      "properties": {
        "canonicalGate": { "const": "Global Exhaustive" },
        "productionClassification": { "const": "G" },
        "defaultChanged": { "const": false },
        "c0RoutingChanged": { "const": false },
        "productionStateChanged": { "const": false },
        "productionCertificates": { "const": 0 },
        "canonicalMasksSkipped": { "const": 0 },
        "c1Authorized": { "const": false }
      }
    }
  }
}
