{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patch-exact-component-certificate-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "key", "keySha256", "componentManifest", "leaves", "merkleRoot", "sourceReceiptHashes", "canonicalProtection", "certificateSha256"],
  "properties": {
    "schema": { "const": "patch-exact-component-certificate-v1" },
    "mode": { "const": "write-only-shadow" },
    "key": { "type": "object" },
    "keySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "componentManifest": { "type": "object" },
    "leaves": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "merkleRoot": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceReceiptHashes": { "type": "object" },
    "canonicalProtection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalGate", "canonicalWorkSkipped", "productionCertificate", "productionStateWritten", "defaultChanged"],
      "properties": {
        "canonicalGate": { "const": "Global Exhaustive" },
        "canonicalWorkSkipped": { "const": false },
        "productionCertificate": { "const": false },
        "productionStateWritten": { "const": false },
        "defaultChanged": { "const": false }
      }
    },
    "certificateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
