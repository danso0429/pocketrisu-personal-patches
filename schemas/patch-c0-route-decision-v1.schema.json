{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketrisu.local/schemas/patch-c0-route-decision-v1.schema.json",
  "title": "PocketRisu C0 route decision",
  "type": "object",
  "required": [
    "schema",
    "policyVersion",
    "outcome",
    "requestedLane",
    "effectiveLane",
    "gate",
    "blocking",
    "reasons",
    "failureClass",
    "changeCategories",
    "canonicalProtection",
    "decisionSha256"
  ],
  "properties": {
    "schema": { "const": "patch-c0-route-decision-v1" },
    "policyVersion": { "const": 1 },
    "outcome": { "enum": ["global-exhaustive-required", "admission-rejected"] },
    "requestedLane": { "type": ["string", "null"] },
    "effectiveLane": { "type": ["string", "null"] },
    "gate": { "enum": ["Global Exhaustive", null] },
    "blocking": { "const": true },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "failureClass": { "enum": ["correctness", "budget", null] },
    "changeCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonicalProtection": {
      "type": "object",
      "required": [
        "globalFallbackRetained",
        "defaultChanged",
        "productionStateChanged",
        "certificatesUsed",
        "masksSkipped"
      ],
      "properties": {
        "globalFallbackRetained": { "const": true },
        "defaultChanged": { "const": false },
        "productionStateChanged": { "const": false },
        "certificatesUsed": { "const": 0 },
        "masksSkipped": { "const": 0 }
      },
      "additionalProperties": false
    },
    "decisionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
