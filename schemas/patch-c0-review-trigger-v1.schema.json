{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketrisu.local/schemas/patch-c0-review-trigger-v1.schema.json",
  "title": "PocketRisu C0 evidence review-trigger report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generatedAt", "thresholds", "observed", "conditions", "recommendation", "c1Authorized", "integrity"],
  "properties": {
    "schema": { "const": "patch-c0-review-trigger-v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableReleases", "patchCohorts", "relationCohorts", "coreCohorts", "auditCohorts", "performanceP95Trials", "performanceP99Trials", "maximumCorrectnessMismatches", "maximumIntegrityFailures", "maximumFalsePasses"],
      "properties": {
        "stableReleases": { "type": "integer", "minimum": 1 },
        "patchCohorts": { "type": "integer", "minimum": 1 },
        "relationCohorts": { "type": "integer", "minimum": 1 },
        "coreCohorts": { "type": "integer", "minimum": 1 },
        "auditCohorts": { "type": "integer", "minimum": 1 },
        "performanceP95Trials": { "type": "integer", "minimum": 1 },
        "performanceP99Trials": { "type": "integer", "minimum": 1 },
        "maximumCorrectnessMismatches": { "type": "integer", "minimum": 0 },
        "maximumIntegrityFailures": { "type": "integer", "minimum": 0 },
        "maximumFalsePasses": { "type": "integer", "minimum": 0 }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stableReleases", "patchCohorts", "relationCohorts", "coreCohorts", "auditCohorts", "performanceTrials", "correctnessMismatches", "integrityFailures", "falsePasses", "unresolvedIncidents"],
      "properties": {
        "stableReleases": { "type": "integer", "minimum": 0 },
        "patchCohorts": { "type": "integer", "minimum": 0 },
        "relationCohorts": { "type": "integer", "minimum": 0 },
        "coreCohorts": { "type": "integer", "minimum": 0 },
        "auditCohorts": { "type": "integer", "minimum": 0 },
        "performanceTrials": { "type": "integer", "minimum": 0 },
        "correctnessMismatches": { "type": "integer", "minimum": 0 },
        "integrityFailures": { "type": "integer", "minimum": 0 },
        "falsePasses": { "type": "integer", "minimum": 0 },
        "unresolvedIncidents": { "type": "integer", "minimum": 0 }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "satisfied", "required", "observed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "satisfied": { "type": "boolean" },
          "required": { "type": "number", "minimum": 0 },
          "observed": { "type": "number", "minimum": 0 }
        }
      }
    },
    "recommendation": { "enum": ["not-ready", "ready-for-read-only-phase-9-review"] },
    "c1Authorized": { "const": false },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "algorithm", "payloadSha256"],
      "properties": {
        "schema": { "const": "patch-verification-receipt-integrity-v1" },
        "algorithm": { "const": "sha256-over-canonical-json-v1" },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
