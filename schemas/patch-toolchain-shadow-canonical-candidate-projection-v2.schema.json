{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketrisu.local/schemas/patch-toolchain-shadow-canonical-candidate-projection-v2.schema.json",
  "title": "Canonical toolchain shadow candidate projection v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "candidateId", "mask", "active", "target", "packIdentity",
    "managedFiles", "candidateState", "semanticFieldSetSha256", "projectionSha256"
  ],
  "properties": {
    "schema": { "const": "patch-toolchain-shadow-canonical-candidate-projection-v2" },
    "candidateId": { "const": "toolchain-hardening" },
    "mask": { "enum": [0, 1] },
    "active": { "type": "boolean" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageName", "packageVersion", "applicability"],
      "properties": {
        "packageName": { "const": "pocketrisu" },
        "packageVersion": { "const": "1.9.0" },
        "applicability": { "const": "verified" }
      }
    },
    "packIdentity": { "$ref": "patch-toolchain-shadow-candidate-pack-identity-v1.schema.json" },
    "managedFiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "patch-toolchain-shadow-canonical-file-observation-v1.schema.json" }
    },
    "candidateState": { "$ref": "patch-toolchain-shadow-canonical-candidate-state-v2.schema.json" },
    "semanticFieldSetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "projectionSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
