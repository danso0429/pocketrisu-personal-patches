{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketrisu.local/schemas/patch-toolchain-shadow-local-receipt-v2.schema.json",
  "title": "PocketRisu toolchain-hardening fresh local shadow receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "status", "disposition", "recordedAt", "candidate", "declarationSha256",
    "buildBoundary", "target", "component", "boundaryClasses", "coverage", "observations",
    "boundaryConsensus", "isolation", "resources", "canonicalProtection", "integrity"
  ],
  "properties": {
    "schema": { "const": "patch-toolchain-shadow-local-receipt-v2" },
    "status": { "enum": ["passed", "failed"] },
    "disposition": { "enum": ["synthetic-known-answer", "dry-run", "material-shadow", "defect-reproduction"] },
    "recordedAt": { "type": "string", "format": "date-time" },
    "candidate": {
      "const": {
        "packId": "toolchain-hardening",
        "productionClass": "G",
        "shadowClass": "B",
        "admission": "not-production-admitted"
      }
    },
    "declarationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "buildBoundary": { "type": "object" },
    "target": { "type": "object" },
    "component": { "type": "object" },
    "boundaryClasses": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true },
    "coverage": {
      "const": { "localMasks": 2, "boundaryClasses": 4, "expectedExecutions": 8, "processedExecutions": 8 }
    },
    "observations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["schema", "mask", "boundaryClassId", "candidateProjection"]
      }
    },
    "boundaryConsensus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "boundaryClasses", "references"],
      "properties": {
        "schema": { "const": "patch-toolchain-shadow-boundary-consensus-v2" },
        "boundaryClasses": { "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true },
        "references": {
          "type": "object",
          "additionalProperties": false,
          "required": ["0", "1"],
          "properties": {
            "0": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "1": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "isolation": { "type": "object" },
    "resources": { "type": "object" },
    "canonicalProtection": { "type": "object" },
    "integrity": { "type": "object" }
  }
}
