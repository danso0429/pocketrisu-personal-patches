{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketrisu.local/schemas/patch-toolchain-shadow-qualification-execution-state-v2.schema.json",
  "title": "Toolchain shadow qualification execution state v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "qualificationRunId", "qualificationRunIdentitySha256", "sequence",
    "status", "phase", "provisioningReceiptSha256", "local", "global", "failure"
  ],
  "properties": {
    "schema": { "const": "patch-toolchain-shadow-qualification-execution-state-v2" },
    "qualificationRunId": { "$ref": "#/$defs/hash" },
    "qualificationRunIdentitySha256": { "$ref": "#/$defs/hash" },
    "sequence": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["running", "passed", "failed"] },
    "phase": {
      "enum": [
        "initialized-before-execution",
        "provisioning-retained",
        "local-launch-recorded-before-execution",
        "local-receipt-retained",
        "global-launch-recorded-before-execution",
        "global-receipt-retained",
        "comparison-passed",
        "verification-and-registration-started",
        "registration-complete",
        "operating-preflight-complete",
        "completed",
        "failed"
      ]
    },
    "provisioningReceiptSha256": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }]
    },
    "local": { "$ref": "#/$defs/local" },
    "global": { "$ref": "#/$defs/global" },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["phase", "code", "message"],
          "properties": {
            "phase": { "type": "string", "minLength": 1 },
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" }
          }
        }
      ]
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "local": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launches", "casesCompleted", "receiptRetained"],
      "properties": {
        "launches": { "enum": [0, 1] },
        "casesCompleted": { "type": ["integer", "null"], "minimum": 0 },
        "receiptRetained": { "type": "boolean" }
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launches", "masksCompleted", "receiptRetained"],
      "properties": {
        "launches": { "enum": [0, 1] },
        "masksCompleted": { "type": ["integer", "null"], "minimum": 0 },
        "receiptRetained": { "type": "boolean" }
      }
    }
  }
}
